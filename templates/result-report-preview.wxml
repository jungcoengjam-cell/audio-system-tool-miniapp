<canvas id="resultReportCanvas" canvas-id="resultReportCanvas" class="result-report-canvas-offscreen" width="{{resultReportCanvasWidth}}" height="{{resultReportCanvasHeight}}" style="width:{{resultReportCanvasWidth}}px;height:{{resultReportCanvasHeight}}px;"></canvas>

<view wx:if="{{resultReportPreviewVisible}}" class="result-report-preview-overlay result-sheet-overlay" bindtap="closeResultReportPreview" catchtouchmove="preventTouchMove">
  <view class="result-report-preview-sheet result-sheet result-share" catchtap="stopTap">
    <view class="result-report-preview-header result-header">
      <view>
        <view class="result-report-preview-title result-title">结果图片已生成</view>
        <view class="result-report-preview-subtitle result-copy">点击图片可查看原图</view>
      </view>
      <button class="result-report-preview-close panel-close-control" aria-label="关闭结果图片预览" bindtap="closeResultReportPreview"><view class="panel-close-icon" aria-hidden="true"></view></button>
    </view>
    <scroll-view class="result-report-preview-scroll result-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <image class="result-report-preview-image" src="{{resultReportImagePath}}" mode="widthFix" bindtap="previewResultReportImage"></image>
    </scroll-view>
    <view class="result-report-preview-actions result-footer">
      <button class="result-report-preview-action result-report-preview-action-primary" bindtap="shareResultReportImage">分享图片</button>
      <button class="result-report-preview-action result-report-preview-action-secondary" bindtap="saveResultReportImage">保存到相册</button>
    </view>
  </view>
</view>
