<view wx:if="{{batchVisible}}" class="batch-sheet-overlay"><view class="batch-sheet-backdrop" bindtap="closeBatchPlacement"></view><scroll-view class="batch-sheet" scroll-y="{{isLandscape}}" enhanced show-scrollbar="{{false}}" catchtap="stopTap"><view class="batch-sheet-content"><view class="batch-sheet-header"><view><view class="batch-sheet-title">批量上杆</view><view class="batch-sheet-subtitle">{{paletteGroups[paletteGroupIndex].name}} · 仅含尚未布置灯具</view></view><button class="batch-sheet-close" bindtap="closeBatchPlacement">关闭</button></view><view class="batch-field-label">连续地址范围</view><view class="batch-picker-row"><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchStartIndex}}" bindchange="onBatchStartChange"><view class="batch-picker-value">起始 {{batchStartOptions[batchStartIndex]}} ›</view></picker><text class="batch-range-arrow">至</text><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchEndIndex}}" bindchange="onBatchEndChange"><view class="batch-picker-value">结束 {{batchStartOptions[batchEndIndex]}} ›</view></picker></view><view class="batch-field-label">目标灯位</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchPositionOptions}}" value="{{batchPositionIndex}}" bindchange="onBatchPositionChange"><view class="batch-picker-value">{{batchPositionOptions[batchPositionIndex]}} ›</view></picker><view class="batch-field-label">物理排列方向</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchDirectionOptions}}" value="{{batchDirectionIndex}}" bindchange="onBatchDirectionChange"><view class="batch-picker-value">{{batchDirectionOptions[batchDirectionIndex]}}（同杆分组均匀交错）›</view></picker><view class="batch-preview">{{batchPreviewText}}</view><view class="batch-sheet-actions"><button class="batch-clear-button" bindtap="clearBatchPosition">清空本杆</button><button class="batch-apply-button" bindtap="applyBatchPlacement">确认上杆</button></view></view></scroll-view></view>