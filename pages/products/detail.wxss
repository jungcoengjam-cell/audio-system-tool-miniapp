nt-size:18rpx;line-height:1.55}.lighting-spec-list{margin-top:20rpx;overflow:hidden;border-radius:20rpx;background:var(--tc)}.lighting-spec-row{display:flex;justify-content:space-between;gap:24rpx;padding:18rpx 20rpx;border-bottom:1rpx solid var(--td)}.lighting-spec-row:last-child{border-bottom:0}.lighting-spec-label{flex:0 0 180rpx;color:var(--ts);font-size:18rpx}.lighting-spec-value{flex:1;color:var(--tx);font-size:20rpx;font-weight:620;line-height:1.45;text-align:right;word-break:break-all}.lighting-mode-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.lighting-mode-chip{padding:12rpx 18rpx;border:1rpx solid #b9d9ff;border-radius:999rpx;background:#eef6ff;color:#006fd6;font-size:19rpx;font-weight:680}.dmx-guide-mode-summary{display:flex;flex-wrap:wrap;gap:10rpx 18rpx;margin-top:17rpx;color:var(--ts);font-size:19rpx;line-height:1.5}.dmx-guide-mode-summary text:first-child{color:var(--tt)}.dmx-guide-source{margin-top:14rpx;color:var(--ts);font-size:17rpx;line-height:1.45}.data-note-card{border-color:#dbeaff;background:#f7faff;box-shadow:none}.missing-card{border-color:#f2dfb5;background:#fffaf0;box-shadow:none}.missing-list{display:flex;flex-wrap:wrap;margin-top:17rpx}.missing-item{margin:0 10rpx 10rpx 0;padding:8rpx 13rpx;border-radius:999rpx;background:#fff0c8;color:#8a5700;font-size:18rpx}.missing-note{margin-top:7rpx;color:#806a43;font-size:19rpx;line-height:1.55}.module-list{margin-top:16rpx}.module-row{display:flex;align-items:center;min-height:92rpx;border-bottom:1rpx solid #ededf0}.module-row:last-child{border-bottom:0}.module-copy{flex:1;min-width:0}.module-title{font-size:22rpx;font-weight:620}.module-description{margin-top:5rpx;color:var(--ts);font-size:18rpx}.module-action{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:126rpx;height:64rpx;min-height:44px;margin:0 0 0 6px;padding:0 17rpx;border:0;border-radius:16rpx;background:var(--tp);color:#fff;font-size:18rpx;font-weight:600;line-height:1}.module-action::after{border:0}.module-info{margin-left:6px;color:var(--ts);font-size:18rpx}.source-card{margin-top:20rpx;padding:24rpx 27rpx}.source-label{color:var(--ta);font-size:17rpx;font-weight:700;letter-spacing:1rpx}.source-text,.source-extra{margin-top:10rpx;color:var(--tx);font-size:20rpx;line-height:1.5;word-break:break-all}.source-extra{color:var(--ts)}.source-review{margin-top:14rpx;padding-top:14rpx;border-top:1rpx solid var(--td);color:var(--ts);font-size:18rpx}.disclaimer{padding:22rpx 14rpx 0;color:#818188;font-size:18rpx;line-height:1.6;text-align:center}.not-found{margin:100rpx 28rpx 0;padding:65rpx 30rpx;border-radius:26rpx;background:var(--tv);text-align:center}.not-found-mark{display:inline-flex;align-items:center;justify-content:center;width:55rpx;height:55rpx;border-radius:50%;background:#fff0e8;color:#c3441b;font-size:28rpx;font-weight:700}.not-found-title{margin-top:18rpx;font-size:27rpx;font-weight:680}.not-found-text{margin-top:10rpx;color:#7d7d84;font-size:20rpx;line-height:1.55}@media (prefers-color-scheme: dark){.page-scroll{background:var(--theme-page-bg)}.hero,.missing-card{border-color:var(--td);background:var(--tv)}.hero-category{background:var(--tc);color:var(--tx)}.hero-status-partial,.product-status-partial,.missing-item,.not-found-mark{background:var(--tws);color:var(--tw)}.power-section-last,.module-row,.power-cell,.spec-cell,.coverage-primary,.band-row,.camera-view-row{border-color:var(--td)}.power-title,.camera-spec-grid view,.camera-source-rule,.band-note,.data-note-text,.coverage-empty,.coverage-role,.not-found-text,.disclaimer{color:var(--ts)}.split-band-warning,.lighting-mode-chip{border-color:var(--td);background:var(--as);color:var(--ta)}.band-name,.coverage-value{color:var(--ta)}.band-spec,.camera-spec-value{color:var(--tx)}.camera-missing,.missing-note{color:var(--tw)}.product-status-ready{background:var(--tc);color:var(--ty)}}

.dmx-import-overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.42)}
.dmx-import-sheet{box-sizing:border-box;display:flex;flex-direction:column;width:100%;max-height:92vh;padding:16rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));border:1rpx solid var(--td);border-bottom:0;border-radius:30rpx 30rpx 0 0;background:var(--tv);color:var(--tx);box-shadow:0 -12rpx 48rpx rgba(0,0,0,.2)}
.dmx-import-handle{align-self:center;width:72rpx;height:8rpx;flex:0 0 auto;border-radius:999rpx;background:var(--td)}
.dmx-import-header{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0 12rpx}
.dmx-import-heading{flex:1;min-width:0}
.dmx-import-title{font-size:31rpx;font-weight:700;line-height:1.3}
.dmx-import-product{margin-top:6rpx;color:var(--ts);font-size:18rpx;line-height:1.4}
.dmx-import-close{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px;height:44px;min-width:44px;margin:0;padding:0;border:0;border-radius:50%;background:var(--tc);color:var(--tx);font-size:30rpx;line-height:1}
.dmx-import-close::after{border:0}
.dmx-import-scroll{flex:0 1 auto;height:54vh;max-height:64vh;min-height:180rpx}
.dmx-import-section{margin:8rpx 0 17rpx;padding:20rpx;border:1rpx solid var(--td);border-radius:20rpx;background:var(--tc)}
.dmx-import-section-title{font-size:21rpx;font-weight:680;line-height:1.4}
.dmx-import-hint{margin-top:8rpx;color:var(--ts);font-size:17rpx;line-height:1.5}
.dmx-import-warning{color:#9b6400}
.dmx-import-mode-list,.dmx-import-action-list{display:flex;flex-direction:column;gap:8rpx;margin-top:14rpx}
.dmx-import-choice{box-sizing:border-box;display:flex;align-items:center;gap:12rpx;min-height:44px;padding:8rpx 14rpx;border:1rpx solid var(--td);border-radius:14rpx;background:var(--tv);color:var(--tx);font-size:20rpx;font-weight:620}
.dmx-import-choice-selected,.dmx-import-action-selected{border-color:#007aff;background:rgba(0,122,255,.08)}
.dmx-import-radio-mark{box-sizing:border-box;width:20px;height:20px;flex:0 0 auto;border:2px solid #92929a;border-radius:50%}
.dmx-import-choice-selected .dmx-import-radio-mark{border:6px solid #007aff}
.dmx-import-count-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:12rpx}
.dmx-import-count-copy{color:var(--ts);font-size:19rpx}
.dmx-import-count-input-wrap{display:flex;align-items:center;box-sizing:border-box;min-width:150rpx;height:44px;padding:0 15rpx;border:1rpx solid var(--td);border-radius:14rpx;background:var(--tv)}
.dmx-import-count-input{box-sizing:border-box;width:110rpx;height:42px;color:var(--tx);font-size:20rpx;text-align:right}
.dmx-import-count-unit{margin-left:8rpx;color:var(--ts);font-size:18rpx}
.dmx-import-action{box-sizing:border-box;min-height:64px;padding:13rpx 15rpx;border:1rpx solid var(--td);border-radius:14rpx;background:var(--tv)}
.dmx-import-action-disabled{opacity:.48}
.dmx-import-action-title{font-size:19rpx;font-weight:650;line-height:1.4}
.dmx-import-action-copy{margin-top:4rpx;color:var(--ts);font-size:16rpx;line-height:1.45}
.dmx-import-empty-note{color:var(--ts);font-size:18rpx;line-height:1.5}
.dmx-import-allocation-hint{margin:0 2rpx 10rpx}
.dmx-import-error{margin:6rpx 0 12rpx;padding:13rpx 15rpx;border:1rpx solid #e7b6ad;border-radius:14rpx;background:#fff2ef;color:#a43d2a;font-size:18rpx;line-height:1.5}
.dmx-import-footer{display:flex;gap:12rpx;padding-top:12rpx}
.dmx-import-cancel,.dmx-import-confirm{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:1;height:48px;min-height:44px;margin:0;padding:0 18rpx;border:0;border-radius:16rpx;font-size:20rpx;font-weight:650;line-height:1}
.dmx-import-cancel{background:var(--tc);color:var(--tx)}
.dmx-import-confirm{background:#007aff;color:#fff}
.dmx-import-cancel::after,.dmx-import-confirm::after{border:0}
.dmx-import-cancel[disabled],.dmx-import-confirm[disabled]{opacity:.55}
@media (prefers-color-scheme: dark){.dmx-import-overlay{background:rgba(0,0,0,.64)}.dmx-import-sheet{border-color:var(--td);background:var(--tv);box-shadow:0 -12rpx 48rpx rgba(0,0,0,.55)}.dmx-import-handle{background:#55555b}.dmx-import-choice-selected,.dmx-import-action-selected{border-color:#4da3ff;background:rgba(0,122,255,.19)}.dmx-import-radio-mark{border-color:#85858d}.dmx-import-choice-selected .dmx-import-radio-mark{border-color:#4da3ff}.dmx-import-error{border-color:#69352e;background:#321b18;color:#ffc4b9}.dmx-import-warning{color:#f0c56e}.dmx-import-confirm{background:#0a84ff}}
.dmx-import-overlay{animation:dmx-import-mask-in 180ms ease-out both}
.dmx-import-sheet{animation:dmx-import-sheet-in 180ms cubic-bezier(.2,.72,.25,1) both}
.dmx-import-overlay.dmx-import-closing{animation:dmx-import-mask-out 180ms ease-in both}
.dmx-import-closing .dmx-import-sheet{animation:dmx-import-sheet-out 180ms ease-in both;pointer-events:none}
@keyframes dmx-import-mask-in{from{opacity:0}to{opacity:1}}
@keyframes dmx-import-mask-out{from{opacity:1}to{opacity:0}}
@keyframes dmx-import-sheet-in{from{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
@keyframes dmx-import-sheet-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}}
@media(prefers-reduced-motion:reduce){.dmx-import-overlay,.dmx-import-sheet,.dmx-import-overlay.dmx-import-closing,.dmx-import-closing .dmx-import-sheet{animation-duration:1ms!important;animation-iteration-count:1!important}}
