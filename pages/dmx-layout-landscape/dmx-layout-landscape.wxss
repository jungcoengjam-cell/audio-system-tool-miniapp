.fixture-chip-placed .fixture-chip-address{padding-top:5px;color:#fff}
.fixture-chip-check{position:absolute;top:3px;right:3px;display:flex;width:11px;height:11px;align-items:center;justify-content:center;border-radius:50%;background:#fff;color:#007aff;font-size:8px;font-weight:800}
