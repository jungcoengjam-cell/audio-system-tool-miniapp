page{height:100%;overflow:hidden;background:var(--theme-page-bg,#f2f2f7);color:var(--theme-text,#1d1d1f)}
.layout-page{position:relative;display:flex;width:100%;height:100vh;min-height:0;flex-direction:column;overflow:hidden;background:var(--theme-page-bg,#f2f2f7);color:var(--theme-text,#1d1d1f);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC","Segoe UI",sans-serif}
.layout-scroll{height:calc(100vh - 82px);min-height:0;flex:1}
.layout-content{box-sizing:border-box;padding:16px 14px calc(104px + env(safe-area-inset-bottom));}
.layout-header{display:flex;min-height:62px;align-items:center;justify-content:space-between;gap:14px;padding:4px 4px 15px}
.header-copy{min-width:0}
.eyebrow{color:var(--theme-accent,#007aff);font-size:10px;font-weight:750;letter-spacing:1.6px}
.page-title{margin-top:3px;color:var(--theme-text,#1d1d1f);font-size:28px;font-weight:750;letter-spacing:-.7px;line-height:1.15}
.page-subtitle{overflow:hidden;margin-top:4px;color:var(--theme-text-secondary,#6e6e73);font-size:12px;text-overflow:ellipsis;white-space:nowrap}
.landscape-button{display:flex;box-sizing:border-box;min-width:82px;height:44px;margin:0;padding:0 12px;align-items:center;justify-content:space-between;border:0;border-radius:999px;background:var(--theme-control,#e8e8ed);color:var(--theme-accent-text,#005eb8);font-size:14px;font-weight:650;line-height:1}
.landscape-button text{margin-left:7px;font-size:24px}
.save-notice{display:flex;align-items:center;justify-content:space-between;margin:0 2px 10px;padding:10px 13px;border-radius:14px;background:var(--theme-success-soft,rgba(52,199,89,.12));color:var(--theme-success,#1f744c);font-size:12px;line-height:1.45}
.save-notice-retry{background:var(--theme-warning-soft,#fff0d6);color:var(--theme-warning,#9a5b00)}
.retry-label{margin-left:10px;flex:0 0 auto;font-weight:750}
.empty-card{margin:30px 4px;padding:32px 22px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:24px;background:var(--theme-surface,#fff);text-align:center}
.empty-mark{color:#8a2bff;font-size:42px}
.empty-title{margin-top:12px;font-size:20px;font-weight:720}
.empty-text{margin-top:8px;color:var(--theme-text-secondary,#6e6e73);font-size:14px;line-height:1.5}
.summary-row{display:flex;align-items:center;gap:8px;margin:0 2px 11px}
.summary-chip{display:flex;min-width:58px;padding:7px 9px;align-items:center;justify-content:center;gap:5px;border-radius:14px;background:var(--theme-surface,#fff);color:var(--theme-text-secondary,#6e6e73);font-size:11px;white-space:nowrap}
.summary-number{color:var(--theme-text,#1d1d1f);font-size:14px;font-weight:750}
.summary-hint{margin-left:auto;color:var(--theme-text-tertiary,#86868b);font-size:10px;text-align:right}
.search-row{display:flex;height:46px;align-items:center;gap:7px;margin:0 2px 11px;padding:0 7px 0 13px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:16px;background:var(--theme-surface,#fff)}
.search-icon{color:var(--theme-text-tertiary,#86868b);font-size:24px;line-height:1}
.search-input{height:44px;min-width:0;flex:1;color:var(--theme-text,#1d1d1f);font-size:14px}
.search-button{display:flex;box-sizing:border-box;width:62px;height:34px;margin:0;align-items:center;justify-content:center;border:0;border-radius:11px;background:#8a2bff;color:#fff;font-size:13px;font-weight:650;line-height:1}
.search-result{display:flex;min-height:35px;margin:-4px 5px 10px;align-items:center;gap:7px;color:var(--theme-accent-text,#005eb8);font-size:12px}
.stage-card,.rod-summary-card{box-sizing:border-box;margin:0 0 11px;padding:13px;border:1px solid var(--theme-divider,rgba(255,255,255,.86));border-radius:22px;background:var(--theme-surface,rgba(255,255,255,.96));box-shadow:0 9px 26px rgba(22,34,58,.055)}
.stage-card-heading,.rod-summary-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1px 2px 10px}
.stage-heading-title,.rod-summary-title{color:var(--theme-text,#1d1d1f);font-size:16px;font-weight:720}
.stage-heading-subtitle,.rod-summary-note{margin-top:3px;color:var(--theme-text-secondary,#6e6e73);font-size:11px}
.stage-live-badge{display:flex;align-items:center;gap:5px;color:var(--theme-success,#248a3d);font-size:10px;font-weight:650;white-space:nowrap}
.live-dot,.manipulation-pulse{width:7px;height:7px;border-radius:50%;background:#34c759}
.canvas-shell{position:relative;width:100%;min-height:280px;overflow:hidden;border-radius:15px;background:#f5f5f7}
.layout-canvas{display:block;width:100%;height:100%}
.canvas-zoom-hint{position:absolute;right:8px;bottom:7px;padding:4px 7px;border-radius:999px;background:rgba(255,255,255,.76);color:#73737a;font-size:9px;pointer-events:none}
.manipulation-indicator{position:absolute;top:9px;left:50%;display:flex;padding:7px 11px;align-items:center;gap:7px;transform:translateX(-50%);border:1px solid rgba(255,255,255,.6);border-radius:999px;background:rgba(30,30,34,.74);box-shadow:0 4px 16px rgba(0,0,0,.16);color:#fff;font-size:11px;white-space:nowrap;pointer-events:none}
.manipulation-pulse{background:#0a84ff;box-shadow:0 0 0 4px rgba(10,132,255,.18)}
.rod-summary-head{padding-bottom:8px}
.rod-count-pill{max-width:45%;overflow:hidden;padding:6px 9px;border-radius:999px;background:var(--theme-accent-soft,#eaf3ff);color:var(--theme-accent-text,#005eb8);font-size:10px;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.rod-chip-scroll,.placement-rods{width:100%;white-space:nowrap}
.rod-chip-track,.placement-rod-track{display:inline-flex;gap:7px;padding:2px 3px 3px}
.rod-chip{display:flex;height:34px;padding:0 10px;align-items:center;gap:6px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:999px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-secondary,#5f5f64);font-size:11px;white-space:nowrap}
.rod-chip-active{border-color:#8a2bff;background:rgba(138,43,255,.12);color:#8a2bff;font-weight:680}
.rod-chip-front{color:#8a2bff}
.rod-chip-side{color:#00b8ba}
.rod-chip-mark,.rod-dot{width:7px;height:7px;border-radius:50%;background:#838a98}
.rod-chip-front .rod-chip-mark,.placement-rod-front .rod-dot{background:#8a2bff}
.rod-chip-side .rod-chip-mark,.placement-rod-side .rod-dot{background:#00b8ba}
.export-trigger{display:flex;box-sizing:border-box;width:100%;height:44px;min-height:44px;margin:0 0 12px;align-items:center;justify-content:center;border:1px solid rgba(138,43,255,.23);border-radius:15px;background:var(--theme-accent-soft,#f1e8ff);color:#8a2bff;font-size:13px;font-weight:700;line-height:1}
.bottom-actions{position:fixed;z-index:20;right:0;bottom:0;left:0;display:flex;box-sizing:border-box;height:calc(74px + env(safe-area-inset-bottom));padding:8px 14px calc(8px + env(safe-area-inset-bottom));align-items:center;gap:9px;border-top:1px solid var(--theme-divider,rgba(0,0,0,.06));background:var(--theme-page-bg,rgba(248,248,250,.94))}
.bottom-action{display:flex;box-sizing:border-box;height:48px;min-height:44px;margin:0;flex:1;align-items:center;justify-content:center;gap:7px;border:0;border-radius:16px;font-size:15px;font-weight:680;line-height:1}
.bottom-action-secondary{background:var(--theme-control,#e8e8ed);color:var(--theme-accent-text,#005eb8)}
.bottom-action-primary{background:#8a2bff;color:#fff;box-shadow:0 8px 20px rgba(138,43,255,.22)}
.action-icon{font-size:18px;font-weight:400}
button::after{border:0}
button:active{opacity:.78;transform:scale(.99)}
.overlay,.export-overlay{position:fixed;z-index:100;top:0;right:0;bottom:0;left:0;display:flex;box-sizing:border-box;padding:24px 12px calc(12px + env(safe-area-inset-bottom));align-items:flex-end;justify-content:center;overflow:hidden;background:rgba(14,16,24,.34);animation:overlay-in .16s ease-out}
.overlay-closing{animation:overlay-out .18s ease-in forwards}
@keyframes overlay-in{from{opacity:0}to{opacity:1}}
@keyframes overlay-out{to{opacity:0}}
.placement-card,.settings-card,.export-sheet{position:relative;z-index:1;display:flex;box-sizing:border-box;width:100%;max-height:88vh;flex-direction:column;overflow:hidden;border:1px solid rgba(255,255,255,.68);border-radius:27px 27px 21px 21px;background:rgba(255,255,255,.92);box-shadow:0 24px 80px rgba(18,25,42,.25);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);animation:sheet-in .22s cubic-bezier(.2,.8,.2,1)}
@keyframes sheet-in{from{transform:translateY(22px);opacity:.8}to{transform:translateY(0);opacity:1}}
.sheet-handle{width:38px;height:4px;margin:8px auto 12px;border-radius:99px;background:rgba(120,120,128,.35);flex:0 0 auto}
.placement-heading,.settings-heading,.export-heading{display:flex;padding:0 17px 12px;align-items:center;justify-content:space-between;gap:10px;flex:0 0 auto}
.placement-title,.settings-title,.export-title{color:var(--theme-text,#1d1d1f);font-size:19px;font-weight:740}
.placement-subtitle,.settings-subtitle,.export-subtitle{overflow:hidden;margin-top:4px;color:var(--theme-text-secondary,#6e6e73);font-size:11px;text-overflow:ellipsis;white-space:nowrap}
.sheet-close{display:flex;box-sizing:border-box;min-width:58px;height:40px;min-height:40px;margin:0;padding:0 11px;align-items:center;justify-content:center;border:0;border-radius:13px;background:var(--theme-control,#e8e8ed);color:var(--theme-accent-text,#005eb8);font-size:12px;line-height:1}
.placement-rods{box-sizing:border-box;padding:0 14px 8px;flex:0 0 auto}
.placement-rod{display:flex;height:34px;padding:0 11px;align-items:center;gap:6px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:999px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-secondary,#5f5f64);font-size:11px}
.placement-rod-active{border-color:#8a2bff;background:rgba(138,43,255,.12);color:#8a2bff;font-weight:700}
.placement-rod-front{color:#8a2bff}.placement-rod-side{color:#00b8ba}
.rod-overview{margin:0 16px;padding:9px 10px 10px;border-radius:13px;background:var(--theme-control,#f2f2f7);flex:0 0 auto}
.overview-label{display:flex;justify-content:space-between;color:var(--theme-text-secondary,#6e6e73);font-size:10px}
.overview-track{position:relative;height:7px;margin-top:7px;border-radius:999px;background:linear-gradient(90deg,rgba(138,43,255,.14),rgba(0,122,168,.14))}
.overview-tick{position:absolute;top:-2px;width:3px;height:11px;border-radius:3px;transform:translateX(-50%)}
.overview-empty{position:absolute;top:-3px;right:0;bottom:0;left:0;color:var(--theme-text-tertiary,#86868b);font-size:9px;text-align:center}
.placement-preview-strip{width:100%;height:49px;margin-top:8px;flex:0 0 auto;white-space:nowrap}
.preview-track{display:inline-flex;min-width:100%;height:45px;padding:3px 16px;align-items:center;gap:6px}
.preview-address{display:flex;box-sizing:border-box;height:34px;padding:0 9px;align-items:center;gap:6px;border:1px solid;border-radius:11px;background:var(--theme-surface,#fff);font-size:11px;font-weight:700}
.preview-color{width:6px;height:6px;border-radius:50%}
.preview-empty{color:var(--theme-text-tertiary,#86868b);font-size:11px}
.fixture-thumbnail{position:relative;display:block;box-sizing:border-box;width:35px;height:35px;flex:0 0 35px;overflow:hidden;border-radius:8px}
.fixture-thumbnail-small{width:22px;height:22px;flex-basis:22px;border-radius:5px}
.fixture-type-profile{}
.fixture-type-soft{}
.fixture-type-moving{}
.fixture-sprite-image{position:absolute;top:0;left:0;width:105px;height:35px;max-width:none}
.fixture-type-soft .fixture-sprite-image{transform:translateX(-35px)}
.fixture-type-moving .fixture-sprite-image{transform:translateX(-70px)}
.fixture-thumbnail-small .fixture-sprite-image{width:66px;height:22px}
.fixture-thumbnail-small.fixture-type-soft .fixture-sprite-image{transform:translateX(-22px)}
.fixture-thumbnail-small.fixture-type-moving .fixture-sprite-image{transform:translateX(-44px)}
.selection-heading{display:flex;padding:7px 17px 8px;align-items:center;justify-content:space-between;color:var(--theme-text,#1d1d1f);font-size:14px;font-weight:700;flex:0 0 auto}
.selection-hint{color:var(--theme-text-tertiary,#86868b);font-size:10px;font-weight:400}
.fixture-selection-list{box-sizing:border-box;min-height:95px;margin:0 12px;flex:1}
.fixture-group{margin-bottom:8px}
.fixture-group-heading{display:flex;padding:8px 5px 5px;align-items:center;gap:7px}
.group-color-dot{width:8px;height:8px;border-radius:50%}
.fixture-group-name{overflow:hidden;color:var(--theme-text-secondary,#5f5f64);font-size:11px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.fixture-group-count{margin-left:auto;color:var(--theme-text-tertiary,#86868b);font-size:9px;white-space:nowrap}
.fixture-address-grid{display:flex;flex-direction:column;gap:5px}
.fixture-address-row{display:flex;min-height:52px;padding:7px 8px;align-items:center;gap:8px;border:1px solid var(--theme-divider,rgba(120,120,128,.12));border-radius:13px;background:var(--theme-surface,#fff)}
.fixture-address-current{border-color:rgba(138,43,255,.45);background:rgba(138,43,255,.055)}
.fixture-address-selected{box-shadow:0 0 0 2px rgba(0,122,255,.22)}
.fixture-address-color{width:4px;height:31px;border-radius:4px;flex:0 0 auto}
.fixture-address-copy{min-width:0;flex:1}
.fixture-address{color:var(--theme-text,#1d1d1f);font-size:13px;font-weight:720}
.fixture-address-model{overflow:hidden;margin-top:2px;color:var(--theme-text-tertiary,#86868b);font-size:9px;text-overflow:ellipsis;white-space:nowrap}
.fixture-check-state,.fixture-origin-state,.fixture-unplaced-state{flex:0 0 auto;color:var(--theme-text-secondary,#6e6e73);font-size:9px}
.fixture-check-state{color:var(--theme-success,#248a3d)}
.fixture-action{display:flex;min-width:42px;height:31px;padding:0 7px;align-items:center;justify-content:center;border-radius:10px;background:var(--theme-control,#f2f2f7);color:var(--theme-accent-text,#005eb8);font-size:10px;font-weight:650}
.fixture-address-current .fixture-action{background:#8a2bff;color:#fff}
.placement-footnote{padding:9px 16px 12px;color:var(--theme-text-tertiary,#86868b);font-size:9px;text-align:center;flex:0 0 auto}
.settings-overlay{z-index:110}
.settings-card{max-height:90vh}
.settings-scroll{min-height:100px;padding:0 16px;flex:1}
.settings-section{margin:0 0 12px;padding:13px;border:1px solid var(--theme-divider,rgba(120,120,128,.12));border-radius:17px;background:var(--theme-surface,#fff)}
.settings-section-title{color:var(--theme-text,#1d1d1f);font-size:14px;font-weight:720}
.dimension-fields{display:flex;margin-top:10px;gap:10px}
.dimension-field{min-width:0;flex:1;color:var(--theme-text-secondary,#6e6e73);font-size:10px}
.dimension-input-wrap,.rod-distance-input{display:flex;height:42px;margin-top:5px;padding:0 10px;align-items:center;gap:6px;border-radius:12px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-secondary,#6e6e73);font-size:12px}
.dimension-input-wrap input,.rod-distance-input input{width:0;height:40px;min-width:0;flex:1;color:var(--theme-text,#1d1d1f);font-size:15px}
.apron-title{margin-top:15px}
.direction-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:9px}
.direction-choice{display:flex;height:49px;flex-direction:column;align-items:center;justify-content:center;gap:1px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:12px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-secondary,#5f5f64);font-size:11px}
.direction-choice-active{border-color:#8a2bff;background:rgba(138,43,255,.12);color:#8a2bff;font-weight:700}
.direction-arrow{font-size:18px;line-height:1}
.direction-note,.rod-editor-note{margin-top:7px;color:var(--theme-text-tertiary,#86868b);font-size:10px;line-height:1.4}
.rod-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}
.rod-editor-heading .rod-editor-note{margin-top:3px}
.small-add-button{display:flex;height:37px;min-height:37px;margin:0;padding:0 11px;align-items:center;justify-content:center;border:0;border-radius:11px;background:var(--theme-accent-soft,#eaf3ff);color:var(--theme-accent-text,#005eb8);font-size:11px;font-weight:700;line-height:1}
.rod-editor-row{display:flex;margin-top:9px;align-items:center;gap:8px}
.rod-editor-label{min-width:60px;color:var(--theme-text-secondary,#5f5f64);font-size:11px}
.rod-distance-input{width:92px;height:38px;margin:0;padding:0 8px}
.rod-distance-input input{height:36px;font-size:13px}
.rod-remove-button{display:flex;height:36px;min-height:36px;margin:0;padding:0 10px;align-items:center;justify-content:center;border:0;border-radius:10px;background:rgba(255,69,58,.1);color:var(--theme-danger,#c63a32);font-size:10px;line-height:1}
.distribute-button{display:flex;width:100%;height:37px;min-height:37px;margin:10px 0 0;padding:0;align-items:center;justify-content:center;border:0;border-radius:11px;background:var(--theme-control,#f2f2f7);color:var(--theme-accent-text,#005eb8);font-size:11px;font-weight:650;line-height:1}
.settings-bottom-space{height:10px}
.settings-actions{padding:10px 16px calc(12px + env(safe-area-inset-bottom));flex:0 0 auto}
.settings-apply{display:flex;width:100%;height:48px;min-height:44px;margin:0;align-items:center;justify-content:center;border:0;border-radius:15px;background:#8a2bff;color:#fff;font-size:15px;font-weight:700;line-height:1}
.reduction-overlay{position:absolute;z-index:5;top:0;right:0;bottom:0;left:0;display:flex;padding:22px;align-items:center;justify-content:center;background:rgba(0,0,0,.42)}
.reduction-card{display:flex;box-sizing:border-box;width:100%;max-height:75vh;padding:18px;flex-direction:column;overflow:hidden;border:1px solid var(--theme-divider,#e5e5ea);border-radius:22px;background:var(--theme-surface,#fff);box-shadow:0 20px 70px rgba(0,0,0,.28)}
.reduction-title{color:var(--theme-text,#1d1d1f);font-size:18px;font-weight:750}
.reduction-note{margin:6px 0 10px;color:var(--theme-text-secondary,#6e6e73);font-size:11px;line-height:1.45}
.reduction-rod{padding:5px 0;color:var(--theme-danger,#c63a32);font-size:11px;font-weight:650}
.reduction-fixtures{min-height:50px;margin-top:3px;flex:1}
.reduction-fixture{display:flex;padding:7px 2px;justify-content:space-between;border-bottom:1px solid var(--theme-divider,#e5e5ea);color:var(--theme-text,#1d1d1f);font-size:11px}
.reduction-fixture text:last-child{color:var(--theme-text-secondary,#6e6e73)}
.reduction-actions{display:flex;margin-top:12px;gap:7px}
.reduction-cancel,.reduction-confirm{display:flex;box-sizing:border-box;height:44px;min-height:44px;margin:0;align-items:center;justify-content:center;border:0;border-radius:12px;font-size:11px;font-weight:650;line-height:1}
.reduction-cancel{width:38%;background:var(--theme-control,#e8e8ed);color:var(--theme-text-secondary,#6e6e73)}
.reduction-confirm{flex:1;background:#8a2bff;color:#fff}
.export-overlay{z-index:130;align-items:flex-end;background:rgba(10,12,18,.56)}
.export-sheet{max-height:93vh;padding-bottom:calc(10px + env(safe-area-inset-bottom))}
.export-page-nav{display:flex;padding:0 15px 10px;align-items:center;justify-content:space-between;color:var(--theme-text-secondary,#6e6e73);font-size:11px}
.page-nav-button{display:flex;min-width:82px;height:38px;margin:0;padding:0 9px;align-items:center;justify-content:center;border:0;border-radius:11px;background:var(--theme-control,#e8e8ed);color:var(--theme-accent-text,#005eb8);font-size:10px;line-height:1}
.page-nav-button[disabled]{opacity:.38}
.export-image-scroll{height:55vh;min-height:220px;margin:0 12px;overflow:hidden;border-radius:14px;background:var(--theme-control,#e8e8ed);flex:1}
.export-image{display:block;width:100%}
.export-actions{display:flex;padding:12px 12px 0;gap:6px;flex:0 0 auto}
.export-share,.export-save-current,.export-save-all{display:flex;min-width:0;height:43px;min-height:43px;margin:0;flex:1;align-items:center;justify-content:center;border:0;border-radius:12px;font-size:10px;font-weight:650;line-height:1}
.export-share{background:#8a2bff;color:#fff}.export-save-current,.export-save-all{background:var(--theme-control,#e8e8ed);color:var(--theme-accent-text,#005eb8)}
.export-canvas{position:fixed;z-index:0;top:0;right:0;width:1px;height:1px;opacity:.01;pointer-events:none}
@media(min-width:700px){.layout-content{max-width:1000px;margin:0 auto;padding-right:24px;padding-left:24px}.bottom-actions{padding-right:24px;padding-left:24px}.placement-card,.settings-card,.export-sheet{max-width:680px}}
@media(prefers-color-scheme:dark){
