page{height:100%;background:#f5f5f7;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Arial,sans-serif}
.landscape-page{height:100vh;box-sizing:border-box;padding:6px calc(6px + env(safe-area-inset-right)) 6px calc(6px + env(safe-area-inset-left));overflow:hidden}
.landscape-workspace{height:100%;display:flex;gap:8px}
.landscape-tools{width:210px;height:100%;flex:0 0 210px;box-sizing:border-box;padding:10px;border:1px solid rgba(0,0,0,.06);border-radius:16px;background:#fff}
.tool-heading{padding:1px 1px 10px}
.tool-title{font-size:22px;font-weight:720;letter-spacing:-.3px}
.tool-summary{margin-top:3px;color:#6e6e73;font-size:13px}
.tool-action-grid{display:flex;flex-wrap:wrap;gap:7px}
.tool-action,.search-action,.progress-action,.generate-action{min-height:44px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:11px;background:#edf5ff;color:#0066cc;font-size:14px;font-weight:650;transition:opacity .12s ease,transform .12s ease}
.tool-action,.search-action,.progress-action{height:44px;border:0}
.tool-action{flex:1 1 calc(50% - 4px)}
.tool-action-danger{color:#d70015;background:#fff2f1}
.view-reset-action{color:#005eb8;background:#f2f8ff}
.tool-action-pressed{opacity:.66;transform:scale(.985)}
.tool-section,.selected-panel{margin-top:10px;padding-top:10px;border-top:1px solid #ececf0}
.tool-section-head,.selected-head{display:flex;align-items:flex-start;justify-content:space-between;gap:7px}
.tool-section-title{font-size:16px;font-weight:680}
.tool-section-note,.selected-name,.selected-meta{margin-top:2px;color:#6e6e73;font-size:12px}
.palette-count,.selected-status{padding:4px 7px;border-radius:999px;color:#5856d6;background:#f0efff;font-size:11px;white-space:nowrap}
.palette-head-actions{display:flex;align-items:center;gap:6px}
.batch-open-action{height:44px;min-height:44px;padding:0 10px;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border-radius:10px;color:#fff;background:#0066cc;font-size:12px;font-weight:650;white-space:nowrap}
.selected-status-done{color:#1f744c;background:#ebf8ef}
.palette-horizontal{width:100%;margin-top:7px;white-space:nowrap}
.palette-track{display:inline-flex;gap:6px;padding-right:8px}
.palette-group,.palette-fixture{height:44px;min-height:44px;padding:0 11px;display:flex;align-items:center;box-sizing:border-box;border:0;border-radius:10px;background:#f7f7f9;color:#3a3a3c;font-size:13px}
.palette-group-active{color:#fff;background:#5856d6}
.palette-fixture{min-width:58px;justify-content:center;background:#fff;color:#1d1d1f;font-weight:650}
.palette-more,.search-result{margin-top:5px;color:#6e6e73;font-size:11px}
.search-row{margin-top:6px;display:flex;gap:6px}
.search-input{min-width:0;height:44px;min-height:44px;flex:1;padding:0 10px;box-sizing:border-box;border:0;border-radius:10px;background:#f5f5f7;color:#1d1d1f;font-size:14px}
.search-action{width:52px;flex:0 0 52px}
.selected-address{font-size:20px;font-weight:720}
.selected-meta{margin:5px 0}
.progress-action{height:44px;min-height:44px}
.generate-action{height:44px;min-height:44px;margin:12px 0 4px;color:#fff;background:#0066cc}
.generate-action-disabled{opacity:.45}
.landscape-stage{min-width:0;height:100%;flex:1;box-sizing:border-box;display:flex;padding:6px;border:1px solid rgba(0,0,0,.06);border-radius:16px;background:#fff}
.layout-canvas-shell{min-height:0;flex:1;overflow:hidden;border:1px solid #e5e5ea;border-radius:13px;background:#f5f5f7}
.layout-canvas{width:100%;height:100%;display:block}
.fixture-drag-ghost{position:fixed;z-index:60;min-width:66px;height:44px;margin-left:-33px;margin-top:-22px;padding:0 10px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border-radius:22px;background:#5856d6;color:#fff;font-size:15px;font-weight:700;box-shadow:0 8px 24px rgba(45,45,65,.28);pointer-events:none}
.export-canvas{position:fixed;left:-9999px;top:-9999px}
.landscape-page .result-report-preview-overlay{padding:calc(8px + env(safe-area-inset-top)) calc(8px + env(safe-area-inset-right)) calc(8px + env(safe-area-inset-bottom)) calc(8px + env(safe-area-inset-left));align-items:center;justify-content:center}
.landscape-preview-sheet{width:100%;height:calc(100vh - 16px - env(safe-area-inset-top) - env(safe-area-inset-bottom));max-height:100%;padding:10px;flex-direction:row;gap:10px;border-radius:16px}
.landscape-preview-media{height:100%;min-width:0;min-height:0;flex:1;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:12px;background:var(--theme-control)}
.result-report-preview-image{width:100%;height:100%;object-fit:contain}
.landscape-preview-controls{width:140px;min-width:140px;height:100%;display:flex;flex-direction:column;justify-content:space-between}
.landscape-preview-controls .result-report-preview-header{padding:2px 0 8px;align-items:flex-start;gap:6px}
.landscape-preview-controls .result-report-preview-title{font-size:16px}
.landscape-preview-controls .result-report-preview-subtitle{margin-top:3px;font-size:11px}
.landscape-preview-controls .result-report-preview-close{width:44px;height:44px;flex:0 0 44px;font-size:12px}
.landscape-preview-controls .result-report-preview-actions{padding-top:8px;flex-direction:column}
.landscape-preview-controls .result-report-preview-action + .result-report-preview-action{margin-top:8px}
.landscape-preview-controls .result-report-preview-action{width:100%;height:44px;flex:0 0 44px;margin-left:0;font-size:13px}
.landscape-empty{width:80vw;max-width:330px;margin:20vh auto 0;padding:28px;box-sizing:border-box;text-align:center;border-radius:18px;background:#fff}
.landscape-empty-title{font-size:20px;font-weight:700}
.landscape-empty-note{margin-top:8px;color:#6e6e73;font-size:14px}
.batch-sheet-overlay{position:fixed;z-index:90;left:0;right:0;top:0;bottom:0;display:flex;align-items:flex-end;overflow:hidden}
.batch-sheet-backdrop{position:absolute;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.28)}
.batch-sheet{position:relative;z-index:1;width:100%;height:90vh;max-height:calc(100vh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 12px);box-sizing:border-box;overflow:hidden;border-radius:20px 20px 0 0;background:#fff;box-shadow:0 -10px 30px rgba(30,30,40,.16)}
.batch-sheet-content{box-sizing:border-box;padding:18px 22px calc(18px + env(safe-area-inset-bottom))}
.batch-sheet-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.batch-sheet-title{font-size:20px;font-weight:700}
.batch-sheet-subtitle{margin-top:4px;color:#6e6e73;font-size:12px}
.batch-sheet-close{width:70px;height:44px;min-height:44px;margin:0;border:0;border-radius:10px;background:#f2f2f7;color:#005eb8;font-size:13px;line-height:44px}
.batch-field-label{margin:14px 0 6px;color:#6e6e73;font-size:12px}
.batch-picker-row{display:flex;align-items:center;gap:8px}
.batch-picker{min-width:0;flex:1}
.batch-picker-wide{display:block;width:100%}
.batch-picker-value{display:flex;box-sizing:border-box;height:44px;min-height:44px;padding:0 12px;align-items:center;justify-content:space-between;border:0;border-radius:10px;background:#f5f5f7;color:#1d1d1f;font-size:13px}
.batch-range-arrow{color:#6e6e73;font-size:12px}
.batch-preview{margin-top:12px;padding:9px 12px;border-radius:9px;background:#edf5ff;color:#005eb8;font-size:13px}
.batch-sheet-actions{display:flex;gap:8px;margin-top:12px}
.batch-clear-button,.batch-apply-button{display:flex;box-sizing:border-box;height:44px;margin:0;align-items:center;justify-content:center;border-radius:11px;font-size:14px;font-weight:650;line-height:44px}
.batch-clear-button{width:34%;border:0;color:#d70015;background:#fff2f1}
.batch-apply-button{flex:1;color:#fff;background:#0066cc}
@media (prefers-color-scheme:dark){.landscape-page,.landscape-workspace,.landscape-stage{background:var(--theme-page-bg);color:var(--theme-text)}
.landscape-tools,.tool-section,.selected-panel,.landscape-empty{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
.search-input,.batch-picker-value{border:0;background:var(--theme-control);color:var(--theme-text)}
.layout-canvas-shell{border-color:var(--theme-divider);background:var(--theme-control);color:var(--theme-text)}
.tool-summary,.tool-section-note,.palette-more,.batch-field-label{color:var(--theme-text-secondary)}
.palette-group.palette-group-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.selected-status.selected-status-done{background:rgba(99,211,145,.14);color:var(--theme-success)}
.tool-action-danger,.batch-clear-button{background:rgba(255,69,58,.14);color:var(--theme-danger)}
.tool-action:not(.tool-action-danger),.batch-apply-button,.generate-action{background:var(--theme-primary-fill);color:#fff}
.batch-sheet-backdrop,.result-report-preview-overlay{background:rgba(0,0,0,.58)}
.batch-sheet,.result-report-preview-sheet{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
}
@media (prefers-color-scheme: dark){page{background:var(--theme-page-bg);color:var(--theme-text)}
page .selected-status.selected-status{background:var(--theme-control);color:var(--theme-text-secondary)}
page .selected-status.selected-status-done{background:rgba(99,211,145,.14);color:var(--theme-success)}
page .tool-action.tool-action,page .view-reset-action.view-reset-action,page .search-action.search-action,page .progress-action.progress-action{background:var(--theme-control);color:var(--theme-accent-text)}
page .tool-action.tool-action-danger{background:rgba(255,69,58,.14);color:var(--theme-danger)}
page .batch-open-action.batch-open-action,page .generate-action.generate-action,page .batch-apply-button.batch-apply-button{background:var(--theme-primary-fill);color:#fff}
page .batch-sheet-close.batch-sheet-close{background:var(--theme-control);color:var(--theme-text-secondary)}
page .landscape-empty-note.landscape-empty-note{color:var(--theme-text-secondary)}
}
@media (prefers-color-scheme:dark){page .palette-group.palette-group,page .palette-fixture.palette-fixture,page .palette-count.palette-count{background:var(--theme-control);color:var(--theme-text-secondary)}
page .selected-name.selected-name,page .selected-meta.selected-meta{color:var(--theme-text-secondary)}
page .batch-sheet-subtitle.batch-sheet-subtitle,page .batch-range-arrow.batch-range-arrow{color:var(--theme-text-secondary)}
page .batch-preview.batch-preview{background:var(--theme-control);color:var(--theme-text-secondary)}
page .palette-group.palette-group-active{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text)}
}
.position-summary-lines{display:flex;flex-direction:column;gap:3px;margin-top:6px}
.position-source-line,.position-progress-line{color:var(--theme-text-secondary);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.tool-action.undo-layout-action{background:#e7f7ec;color:#1f744c}
@media (prefers-color-scheme:dark){page .tool-action.undo-layout-action{background:var(--theme-control);color:var(--theme-success)}}
