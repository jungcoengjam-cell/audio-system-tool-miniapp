.fixture-chip-origin{position:absolute;right:2px;bottom:2px;left:2px;overflow:hidden;color:var(--theme-text-tertiary,#86868b);font-size:7px;line-height:9px;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.fixture-address-selected{box-shadow:0 0 0 2px rgba(0,122,255,.24)}
.dark-mode .preview-light-head{background-color:#1c1c1e}
.dark-mode .fixture-chip-placed{background:var(--fixture-color,#8a2bff)}
.dark-mode .overview-track{background:#242426}
.rod-distance-caption{margin-left:auto;color:var(--theme-text-secondary,#6e6e73);font-size:10px;white-space:nowrap}

/* Compact, flat layout settings sheet aligned with the layout reference. */
.settings-overlay{padding:0 0 env(safe-area-inset-bottom);align-items:flex-end}
.settings-card{height:680px;max-height:88vh;padding-bottom:0;border:0;border-radius:22px 22px 0 0;background:var(--theme-surface,#fff);box-shadow:0 -8px 34px rgba(0,0,0,.18);backdrop-filter:none;-webkit-backdrop-filter:none}
.settings-actions{box-sizing:border-box;width:100%}
.settings-actions button.settings-apply{box-sizing:border-box;display:flex;width:100%;max-width:none;min-width:0;flex:1 1 auto;margin:0}
.settings-card .sheet-handle{margin:7px auto 7px}
.settings-heading{display:flex;min-height:35px;padding:0 18px 6px;align-items:center;justify-content:space-between;flex:0 0 auto}
.settings-heading button.sheet-close{box-sizing:border-box;display:flex;width:58px;min-width:58px;max-width:58px;height:40px;flex:0 0 58px;margin:0;padding:0;align-items:center;justify-content:center}
.settings-title{color:#1b2b4c;font-size:18px;font-weight:700}
.settings-scroll{box-sizing:border-box;height:52vh;max-height:58vh;min-height:90px;padding:0 18px;flex:0 1 auto;overflow-y:auto}
.settings-section{margin:0;padding:7px 0 8px;border:0;border-bottom:1px solid var(--theme-divider,#e5e5ea);border-radius:0;background:transparent}
.settings-section-title{color:#1b2b4c;font-size:13px;font-weight:700}
.dimension-fields{margin-top:5px;gap:12px}
.dimension-field{font-size:10px}
.dimension-input-wrap{height:34px;margin-top:3px;padding:0 8px;border:1px solid var(--theme-divider,#d8d8dd);border-radius:8px;background:transparent;font-size:11px}
.dimension-input-wrap input{height:32px;font-size:13px}
.apron-title{margin-top:8px}
.direction-grid{display:flex;margin-top:5px;gap:6px}
.direction-choice{display:flex;box-sizing:border-box;height:34px;min-width:0;flex:1;flex-direction:row;gap:4px;border-radius:8px;background:transparent;font-size:11px}
.direction-arrow{font-size:14px}
.rod-editor-heading{min-height:20px}
.rod-count-control{margin:4px 0 1px;font-size:10px}
.count-stepper{height:27px;gap:3px;border:1px solid var(--theme-divider,#dedee3);background:transparent}
.count-stepper button{width:27px;height:25px;font-size:15px}
.count-stepper text{min-width:12px;font-size:11px}
.rod-editor-row{margin-top:4px;gap:6px}
.rod-editor-label{min-width:61px;font-size:10px}
.rod-distance-caption{width:52px;margin-left:auto;text-align:right;font-size:9px}
.rod-distance-input{width:auto;height:30px;margin:0;padding:0 6px;flex:1;border:1px solid var(--theme-divider,#dedee3);border-radius:7px;background:transparent;font-size:10px}
.rod-distance-input input{height:28px;font-size:12px}
.arrangement-options{margin-top:5px;gap:6px}
.arrangement-choice{min-height:32px;padding:0 7px;border-radius:8px;font-size:10px}
.settings-bottom-space{height:2px}
.settings-actions{padding:7px 18px calc(8px + env(safe-area-inset-bottom));}
.settings-apply{height:42px;min-height:42px;border-radius:9px;font-size:14px}
.dark-mode .settings-card{background:#1c1c1e}
.dark-mode .dimension-input-wrap,.dark-mode .rod-distance-input,.dark-mode .count-stepper,.dark-mode .direction-choice,.dark-mode .arrangement-choice{background:transparent}
.layout-page .nav-title,.layout-page .context-selector{color:#1b2b4c}
.layout-page.dark-mode .nav-title,.layout-page.dark-mode .context-selector,.layout-page.dark-mode .settings-title,.layout-page.dark-mode .settings-section-title{color:#fff}
.placement-title-wrap,.placement-titlebar{width:100%;min-width:0}
.placement-title{max-width:calc(100% - 82px);font-size:18px}
@media(max-height:700px){
 .settings-card{height:94vh;max-height:94vh}
 .settings-section{padding-top:4px;padding-bottom:5px}
 .settings-actions{padding-top:5px;padding-bottom:calc(6px + env(safe-area-inset-bottom))}
 .settings-apply{height:38px;min-height:38px}
 .direction-choice{height:30px}
}
@media(prefers-reduced-motion:reduce){
 .overlay,.export-overlay,.overlay-closing,.placement-card,.settings-card,.export-sheet,.locate-card{animation:none!important;transition:none!important}
 button:active{transform:none!important;transition:none!important}
}

/* Keep sheets inside the live capsule and safe-area bounds on rotation. */
.overlay,.export-overlay{padding:12px 12px 0}
.settings-overlay{padding:12px;align-items:flex-end}
.placement-card,.settings-card,.export-sheet,.locate-card{max-height:100%}
.placement-card{height:88vh;max-height:100%}
.settings-card{height:auto;max-height:100%}
.settings-scroll{height:auto;min-height:0;flex:0 1 auto}
.settings-actions{padding-bottom:8px}
.locate-card{height:auto;max-height:100%}
.locate-results{height:auto;min-height:0;flex:0 1 auto}
.export-sheet{height:78vh;max-height:100%;padding-bottom:10px}
.export-image-scroll{height:0;min-height:0;max-height:none;flex:1 1 0}
.sheet-close{box-sizing:border-box;width:58px;min-width:58px;max-width:58px;height:44px;min-height:44px;flex:0 0 58px;margin:0;padding:0}
.settings-heading button.sheet-close{height:44px;min-height:44px}
.locate-search-row{height:48px;min-height:48px}
.locate-search-row button.search-button{box-sizing:border-box;width:62px;min-width:62px;max-width:62px;height:44px;min-height:44px;max-height:44px;flex:0 0 62px;margin:0;padding:0}
.locate-search-row .search-input{height:44px;min-height:44px}
.fixture-group{min-width:0}
.fixture-address-grid{display:flex;box-sizing:border-box;width:100%;min-width:0;padding:0 8px 8px;flex-flow:row wrap;gap:7px;overflow:hidden}
.fixture-address-chip{box-sizing:border-box;width:calc((100% - 35px) / 6);max-width:none;min-width:0;flex:0 0 calc((100% - 35px) / 6)}
.fixture-chip-address{max-width:100%;min-width:0}
@media(max-height:700px){.settings-card{height:auto;max-height:100%}}

/* Preserve the fixture grid and its summary on short landscape viewports. */
@media(max-height:460px){
 .placement-card{height:100%;padding-top:4px;border-radius:20px 20px 0 0}
 .placement-card .sheet-handle{height:3px;margin:4px auto}
 .placement-heading{padding:0 12px 4px}
 .placement-title{font-size:16px}
 .placement-subtitle{margin-top:0;font-size:10px}
 .rod-overview{margin:0 12px}
 .overview-track{height:9px}
 .overview-rail{top:3px}
 .overview-tick{top:0;height:7px}
 .placement-preview-strip{height:44px;margin:2px 0 3px}
 .preview-track{height:42px;padding:0 10px}
 .preview-rail{top:19px}
 .preview-light-column{width:48px;height:42px;flex-basis:48px}
 .preview-light-head{top:7px;width:20px;height:20px}
 .preview-light-head .fixture-sprite-image{width:60px;height:20px}
 .preview-light-head.fixture-type-soft .fixture-sprite-image{transform:translateX(-20px)}
 .preview-light-head.fixture-type-moving .fixture-sprite-image{transform:translateX(-40px)}
 .preview-light-address{bottom:0;font-size:9px}
 .placement-search{height:32px;margin:0 12px 4px}
 .placement-search input{height:30px}
 .fixture-selection-list{box-sizing:border-box;height:0;max-height:none;min-height:0;margin:0 6px;flex:1 1 0;overflow-y:auto}
 .fixture-group-heading{min-height:31px;padding:4px 8px 3px}
 .fixture-address-grid{row-gap:5px;padding-bottom:6px}
 .fixture-address-chip{height:37px}
}
.layout-page.landscape .nav-title{left:62px!important;transform:none!important}
.layout-page.landscape .context-row{position:absolute;left:118px;width:auto;height:44px;min-height:44px;padding:0;z-index:3;flex:none}

/* Placement panel controls and modal motion. */
.context-row{position:relative;justify-content:center;padding:0;gap:0}
.context-native-picker{position:absolute;left:50%;width:calc(100% - 112px);height:44px;transform:translateX(-50%);flex:none}
.context-selector{width:100%;min-width:0}
.context-share{position:absolute;top:0;right:12px}
.export-heading-copy{min-width:0;flex:1 1 auto;overflow:hidden}
.export-heading-copy .export-title,.export-heading-copy .export-subtitle{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.export-heading button.sheet-close{box-sizing:border-box;display:flex;width:58px;min-width:58px;max-width:58px;height:44px;min-height:44px;flex:0 0 58px;margin:0;padding:0;align-items:center;justify-content:center;line-height:1}
.placement-card{border-radius:25px}
.settings-card{border-radius:22px}
button.placement-clear-button{display:flex;box-sizing:border-box;width:auto;min-width:92px;max-width:none;height:44px;min-height:44px;max-height:44px;flex:0 0 auto;margin:0;padding:0 12px;align-items:center;justify-content:center;border:1px solid rgba(220,55,55,.2);border-radius:10px;background:rgba(220,55,55,.08);color:#c63a32;font-size:11px;line-height:1}
button.placement-clear-button[disabled]{opacity:.4}
.overview-tick-selected{z-index:3;width:5px;height:15px;top:-4px;box-shadow:0 0 0 3px rgba(0,122,255,.18)}
.reduction-overlay{animation:dialog-overlay-in .16s ease-out}
.reduction-card{animation:dialog-in .2s cubic-bezier(.2,.8,.2,1)}
.sheet-closing{animation:sheet-out .18s ease-in forwards!important}
.reduction-closing{animation:dialog-overlay-out .16s ease-in forwards}
.reduction-closing .reduction-card{animation:dialog-out .16s ease-in forwards}
@keyframes sheet-out{to{transform:translateY(16px);opacity:0}}
@keyframes dialog-overlay-in{from{opacity:0}to{opacity:1}}
@keyframes dialog-overlay-out{to{opacity:0}}
@keyframes dialog-in{from{transform:translateY(10px);opacity:.75}to{transform:translateY(0);opacity:1}}
@keyframes dialog-out{to{transform:translateY(10px);opacity:0}}
@media(prefers-reduced-motion:reduce){
 .overlay,.export-overlay,.overlay-closing,.placement-card,.settings-card,.export-sheet,.locate-card,.sheet-closing,.reduction-overlay,.reduction-card,.reduction-closing{animation:none!important;transition:none!important}
}

.placement-overlay{padding-right:16px;padding-left:16px}
.placement-card{height:70vh;max-height:600px}
.placement-card .fixture-selection-list{height:0;max-height:none;min-height:0;flex:1 1 0}
.placement-titlebar{display:flex;width:100%;min-width:0;align-items:center;justify-content:space-between;gap:8px}
.placement-heading .placement-title{max-width:none;min-width:0;overflow:hidden;flex:1 1 auto;text-overflow:ellipsis;white-space:nowrap}
.fixture-selection-list{box-sizing:border-box;width:calc(100% - 32px);min-width:0;margin:0 16px;align-self:stretch}
.fixture-address-grid{padding:0}
.fixture-list-tail{height:8px;flex:0 0 8px}
.export-sheet{height:auto;max-height:100%}
.export-image-scroll{min-height:0;max-height:none;flex:0 1 auto}
