/* Reference layout: the canvas is the page, with only navigation and the two-action toolbar around it. */
page,.layout-page{background:#fff;color:#1d1d1f}
.layout-page{height:100vh;min-height:0;--theme-page-bg:#fff}
.layout-page.dark-mode{background:#000;color:#fff;--theme-page-bg:#000;--theme-surface:#1c1c1e;--theme-surface-muted:#2c2c2e;--theme-text:#fff;--theme-text-secondary:#c7c7cc;--theme-text-tertiary:#98989d;--theme-divider:#38383a;--theme-control:#2c2c2e;--theme-accent:#0a84ff;--theme-accent-text:#8ac8ff;--theme-accent-soft:#193b60;--theme-danger:#ff6961;--theme-success:#63d391}
.layout-page.dark-mode page,.layout-page.dark-mode .canvas-shell{background:#000}
.layout-nav{position:relative;z-index:2;display:flex;box-sizing:border-box;min-height:44px;padding:0 14px;align-items:center;justify-content:space-between;background:inherit;flex:0 0 auto}
.nav-back{display:flex;box-sizing:border-box;width:44px;height:44px;align-items:center;justify-content:center;color:#007aff}
.nav-back{position:absolute;left:12px;font-size:0}
.nav-back-icon{position:relative;width:18px;height:18px}
.nav-back-icon:before{position:absolute;top:8px;left:2px;width:15px;height:1.5px;background:currentColor;content:""}
.nav-back-icon:after{position:absolute;top:4px;left:2px;width:8px;height:8px;transform:rotate(45deg);border-bottom:1.5px solid currentColor;border-left:1.5px solid currentColor;content:""}
.nav-title{position:absolute;left:50%;transform:translateX(-50%);color:var(--theme-text,#1d1d1f);font-size:17px;font-weight:700}
.share-glyph{position:relative;width:23px;height:24px}
.share-tray{position:absolute;right:2px;bottom:2px;left:2px;height:11px;border:1.6px solid currentColor;border-top:0;border-radius:0 0 3px 3px}
.share-stem{position:absolute;top:2px;left:10px;width:1.7px;height:14px;background:currentColor}
.share-head{position:absolute;top:1px;left:7px;width:7px;height:7px;transform:rotate(45deg);border-top:1.7px solid currentColor;border-left:1.7px solid currentColor}
.context-row{display:flex;box-sizing:border-box;width:100%;height:44px;min-height:44px;padding:0 12px;align-items:center;gap:8px;flex:0 0 44px}
.context-native-picker{display:block;box-sizing:border-box;width:0;min-width:0;height:44px;flex:1 1 auto}
.context-selector{display:flex;box-sizing:border-box;width:100%;height:44px;min-height:44px;padding:0 5px;align-items:center;justify-content:center;gap:5px;border:0;background:transparent;color:var(--theme-text-secondary,#6e6e73);font-size:18px;font-weight:650;flex:0 0 auto}
.context-selector text:first-child{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.context-share{position:relative;display:flex;box-sizing:border-box;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;flex:0 0 44px;align-items:center;justify-content:center;color:#007aff}
.context-share-disabled{opacity:.45}
.context-chevron{color:#007aff;font-size:14px}
.empty-card{margin:auto 22px;padding:24px 15px;border:0;border-radius:0;background:transparent}
.canvas-shell{position:relative;box-sizing:border-box;width:100%;min-width:0;min-height:0;margin:0;overflow:hidden;border:0;border-radius:0;background:#fff;flex:1 1 auto}
.layout-page.dark-mode .canvas-shell{background:#000}
.layout-canvas{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%}
.canvas-badge{position:absolute;top:10px;left:12px;max-width:70%;padding:5px 8px;border:1px solid rgba(120,120,128,.18);border-radius:7px;background:rgba(255,255,255,.9);color:#55565c;font-size:10px;pointer-events:none}
.dark-mode .canvas-badge{border-color:#353539;background:rgba(28,28,30,.92);color:#d1d1d6}
.canvas-legend{position:absolute;bottom:10px;left:10px;z-index:1;box-sizing:border-box;width:48vw;max-width:190px;max-height:calc(100% - 20px);overflow:hidden;padding:6px 8px 5px;border:1px solid rgba(120,120,128,.2);border-radius:9px;background:rgba(255,255,255,.9);box-shadow:0 2px 9px rgba(0,0,0,.08);color:var(--theme-text,#1d1d1f);pointer-events:none}
.canvas-shell-has-undo .canvas-legend{bottom:66px;max-height:calc(100% - 76px)}
.canvas-shell-has-save-notice .canvas-legend{bottom:52px;max-height:calc(100% - 62px)}
.canvas-shell-has-undo.canvas-shell-has-save-notice .canvas-legend{bottom:106px;max-height:calc(100% - 116px)}
.dark-mode .canvas-legend{border-color:#38383a;background:rgba(28,28,30,.92);box-shadow:0 2px 9px rgba(0,0,0,.3);color:#f5f5f7}
.canvas-legend-title{height:14px;overflow:hidden;color:var(--theme-text-secondary,#6e6e73);font-size:9px;font-weight:700;line-height:14px;white-space:nowrap}
.canvas-legend-row{display:flex;box-sizing:border-box;height:18px;min-width:0;align-items:center;gap:4px}
.canvas-legend-color{width:6px;height:6px;border-radius:50%;flex:0 0 6px}
.canvas-legend-sprite{position:relative;width:18px;height:18px;overflow:hidden;flex:0 0 18px;border-width:1px;border-style:solid;border-radius:4px}
.canvas-legend-sprite .fixture-sprite-image{width:54px;height:18px}
.canvas-legend-sprite.fixture-type-soft .fixture-sprite-image{transform:translateX(-18px)}
.canvas-legend-sprite.fixture-type-moving .fixture-sprite-image{transform:translateX(-36px)}
.canvas-legend-name{min-width:0;overflow:hidden;color:var(--theme-text,#1d1d1f);font-size:9px;line-height:13px;text-overflow:ellipsis;white-space:nowrap;flex:1}
.canvas-legend-count{color:var(--theme-text-secondary,#6e6e73);font-size:9px;line-height:13px;white-space:nowrap;flex:0 0 auto}
.canvas-legend-overflow{overflow:hidden;padding-top:2px;color:var(--theme-text-tertiary,#86868b);font-size:8px;line-height:12px;text-overflow:ellipsis;white-space:nowrap}
.save-notice{position:absolute;right:12px;bottom:10px;left:12px;z-index:2;margin:0;padding:8px 10px;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.08);font-size:10px}
.layout-undo-note{position:absolute;right:12px;bottom:12px;left:12px;z-index:3;display:flex;min-height:44px;padding:0 11px;align-items:center;justify-content:space-between;border:1px solid rgba(0,122,255,.18);border-radius:11px;background:rgba(255,255,255,.96);box-shadow:0 3px 14px rgba(0,0,0,.09);color:var(--theme-text-secondary,#6e6e73);font-size:11px}
.dark-mode .layout-undo-note{border-color:#254d76;background:rgba(28,28,30,.96)}
.layout-undo-note button.layout-undo-action{display:flex;box-sizing:border-box;width:76px;min-width:76px;max-width:76px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;flex:0 0 76px;align-items:center;justify-content:center;border:0;border-radius:8px;background:rgba(0,122,255,.1);color:#007aff;font-size:12px;font-weight:650;line-height:1;text-align:center}
.manipulation-indicator{top:48px}
.bottom-toolbar{display:flex;box-sizing:border-box;height:calc(62px + env(safe-area-inset-bottom));min-height:62px;padding:4px 20px calc(4px + env(safe-area-inset-bottom));align-items:center;justify-content:center;gap:0;border-top:1px solid rgba(120,120,128,.16);background:#fff;flex:0 0 auto}
.dark-mode .bottom-toolbar{border-color:#242426;background:#000}
.toolbar-action{display:flex;box-sizing:border-box;height:50px;margin:0;flex:1;align-items:center;justify-content:center;gap:7px;border:0;background:transparent;color:#007aff;font-size:14px;font-weight:550;line-height:1}
.toolbar-icon{display:flex;width:24px;height:24px;align-items:center;justify-content:center;border:1.4px solid currentColor;border-radius:7px;font-size:15px;line-height:1}
.settings-icon{height:22px;border:0;border-radius:0;flex-direction:column;gap:4px}
.settings-icon view{position:relative;width:17px;height:1.5px;background:currentColor}
.settings-icon view:after{position:absolute;top:-2px;left:4px;width:4px;height:4px;border:1px solid currentColor;border-radius:50%;background:#fff;content:""}
.dark-mode .settings-icon view:after{background:#000}
.settings-icon view:nth-child(2):after{left:10px}
.settings-icon view:nth-child(3):after{left:7px}
.placement-card{height:88vh;max-height:88vh;border-radius:25px 25px 0 0}
.placement-heading{padding-bottom:7px}
.rod-overview{margin-top:0}
.placement-preview-strip{height:43px;margin-top:4px}
.selection-heading{padding-top:5px}
.placement-search{display:flex;box-sizing:border-box;height:36px;margin:0 14px 6px;padding:0 10px;align-items:center;gap:8px;border:1px solid var(--theme-divider,#e5e5ea);border-radius:10px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-tertiary,#86868b);flex:0 0 auto}
.placement-search text{font-size:19px}
.placement-search input{height:34px;min-width:0;flex:1;color:var(--theme-text,#1d1d1f);font-size:12px}
.fixture-selection-list{box-sizing:border-box;height:38vh;max-height:46vh;min-height:90px;flex:0 1 auto;overflow-y:auto}
.no-fixture-results{padding:18px;color:var(--theme-text-tertiary,#86868b);font-size:12px;text-align:center}
.search-button{background:#007aff}
.settings-apply,.reduction-confirm,.export-share{background:#007aff}
.direction-choice-active{border-color:#007aff;background:rgba(0,122,255,.1);color:#007aff}
.rod-count-control{display:flex;margin:10px 0 5px;align-items:center;justify-content:space-between;color:var(--theme-text-secondary,#6e6e73);font-size:11px}
.count-stepper{display:flex;height:31px;align-items:center;gap:11px;border-radius:9px;background:var(--theme-control,#f2f2f7)}
.count-stepper button{display:flex;width:34px;height:31px;margin:0;align-items:center;justify-content:center;border:0;background:transparent;color:#007aff;font-size:17px}
.count-stepper text{min-width:16px;color:var(--theme-text,#1d1d1f);font-size:12px;text-align:center}
.arrangement-options{display:flex;margin-top:9px;gap:8px}
.arrangement-choice{display:flex;min-height:38px;padding:0 10px;align-items:center;justify-content:center;border:1px solid var(--theme-divider,#e5e5ea);border-radius:10px;background:var(--theme-control,#f2f2f7);color:var(--theme-text-secondary,#6e6e73);font-size:11px;flex:1}
.arrangement-choice-active{border-color:#007aff;background:rgba(0,122,255,.1);color:#007aff;font-weight:650}
.locate-overlay{z-index:105}
.locate-card{position:relative;display:flex;box-sizing:border-box;width:100%;max-height:76vh;padding-bottom:10px;flex-direction:column;overflow:hidden;border:1px solid var(--theme-divider,#e5e5ea);border-radius:22px 22px 0 0;background:var(--theme-surface,#fff);box-shadow:0 20px 70px rgba(0,0,0,.24);animation:sheet-in .22s cubic-bezier(.2,.8,.2,1)}
.locate-heading{display:flex;padding:0 16px 9px;align-items:center;justify-content:space-between;flex:0 0 auto}
.locate-search-row{height:42px;margin:0 14px 8px}
.locate-search-row .search-input{height:40px}
.locate-results{box-sizing:border-box;height:34vh;max-height:46vh;min-height:90px;margin:0 12px;flex:0 1 auto;overflow-y:auto}
.locate-result-row{display:flex;box-sizing:border-box;height:74px;min-height:74px;padding:8px;align-items:center;gap:9px;border-bottom:1px solid var(--theme-divider,#e5e5ea)}
.locate-result-copy{min-width:0;flex:1}
.locate-result-address{color:var(--theme-text,#1d1d1f);font-size:13px;font-weight:700}
.locate-result-detail{overflow:hidden;margin-top:3px;color:var(--theme-text-tertiary,#86868b);font-size:10px;text-overflow:ellipsis;white-space:nowrap}
.locate-result-rod{max-width:82px;color:var(--theme-accent-text,#005eb8);font-size:10px;text-align:right}
.search-error{padding:16px;color:var(--theme-text-tertiary,#86868b);font-size:12px;text-align:center}
.layout-page.landscape .canvas-shell{min-height:0;height:auto!important;flex:1 1 auto}
.layout-page.landscape .bottom-toolbar{height:calc(58px + env(safe-area-inset-bottom));min-height:58px}
.layout-page.landscape .layout-nav{min-height:44px}
@media(prefers-color-scheme:dark){
 page,.layout-page{background:#fff;color:#1d1d1f}
 .dark-mode.layout-page{background:#000;color:#fff}
}
.context-chevron{font-size:15px}
.placement-card{padding-top:8px}
.placement-heading{padding:3px 18px 8px;align-items:center}
.placement-titlebar{display:flex;align-items:center;justify-content:space-between;gap:12px}
.placement-title{max-width:65vw;font-size:18px;white-space:nowrap}
.placement-subtitle{margin-top:2px;font-size:11px}
.rod-overview{margin:0 18px;padding:0;background:transparent}
.overview-track{height:13px;margin-top:0;border:1px solid var(--theme-divider,#d8d8dd);border-radius:5px;background:var(--theme-control,#f2f2f7);overflow:hidden}
.overview-rail{position:absolute;top:5px;right:7px;left:7px;height:2px;border-radius:2px;background:#858b96}
.overview-tick{top:2px;width:3px;height:8px;z-index:1;border-radius:2px}
.overview-viewport{position:absolute;top:-2px;bottom:-2px;z-index:2;box-sizing:border-box;min-width:18px;border:1.5px solid #007aff;border-radius:3px;background:rgba(0,122,255,.06)}
.placement-preview-strip{height:82px;margin:4px 0 6px;overflow:hidden;flex:0 0 auto}
.preview-track{position:relative;display:inline-flex;box-sizing:border-box;min-width:100%;width:max-content;height:78px;padding:0 14px;align-items:stretch;gap:0}
.preview-rail{position:absolute;top:37px;right:16px;left:16px;z-index:0;height:5px;border:1px solid #717987;border-radius:3px;background:linear-gradient(180deg,#c6cbd2,#868e99 45%,#d2d6dc 55%,#858d98)}
.preview-light-column{position:relative;display:flex;box-sizing:border-box;width:56px;height:78px;flex:0 0 56px;align-items:center;justify-content:flex-start;flex-direction:column}
.preview-light-head{position:absolute;top:25px;z-index:1;box-sizing:border-box;width:27px;height:27px;border-width:1px;border-radius:6px;background-color:var(--theme-surface,#fff)}
.preview-light-head .fixture-sprite-image{width:81px;height:27px}
.preview-light-head.fixture-type-soft .fixture-sprite-image{transform:translateX(-27px)}
.preview-light-head.fixture-type-moving .fixture-sprite-image{transform:translateX(-54px)}
.preview-light-address{position:absolute;right:0;bottom:4px;left:0;overflow:hidden;font-size:10px;font-weight:650;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.preview-light-selected .preview-light-head{outline:2px solid #007aff;outline-offset:2px}
.preview-empty{display:flex;height:76px;align-items:center;justify-content:center}
.placement-search{height:36px;margin:1px 16px 7px;border-radius:11px;flex:0 0 auto}
.fixture-selection-list{box-sizing:border-box;height:38vh;max-height:46vh;min-height:90px;margin:0 8px;flex:0 1 auto;overflow-y:auto}
.fixture-group{margin-bottom:4px}
.fixture-group-heading{min-height:38px;padding:6px 9px 4px;gap:7px}
.group-color-dot{width:9px;height:9px;flex:0 0 9px}
.fixture-group-copy{display:flex;min-width:0;align-items:flex-start;flex-direction:column;gap:2px;flex:1}
.fixture-group-name{max-width:100%;overflow:hidden;color:var(--theme-text,#1d1d1f);font-size:12px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.fixture-group-meta{color:var(--theme-text-secondary,#6e6e73);font-size:10px;line-height:12px;white-space:nowrap}
.fixture-address-grid{display:grid;box-sizing:border-box;padding:0 8px 8px;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}
.fixture-address-chip{position:relative;display:flex;box-sizing:border-box;height:42px;min-width:0;padding:0 2px;align-items:center;justify-content:center;border:1px solid var(--theme-divider,#dbdbe0);border-radius:8px;background:var(--theme-control,#f4f4f6);color:var(--fixture-color,#8a2bff);flex:0 0 auto}
.fixture-chip-address{max-width:100%;overflow:hidden;font-size:10px;font-weight:650;text-align:center;text-overflow:ellipsis;white-space:nowrap}
