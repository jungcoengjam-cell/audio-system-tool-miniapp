<view class="landscape-page"><view wx:if="{{!hasPlan}}" class="landscape-empty"><view class="landscape-empty-title">暂无可用编址方案</view><view class="landscape-empty-note">{{errorText}}</view></view><view wx:if="{{hasPlan}}" class="landscape-workspace"><scroll-view class="landscape-tools" scroll-y="{{scrollEnabled}}" enhanced show-scrollbar="{{false}}"><view class="tool-heading"><view class="tool-title">横屏布置</view><view class="tool-summary">{{totalGroups}} 组 · {{totalFixtures}} 台 · {{addressRangeText}}</view></view><view class="tool-action-grid"><view class="tool-action" role="button" bindtap="toggleAddressLabels" hover-class="tool-action-pressed">{{addressLabelModeText}}</view><view class="tool-action" role="button" bindtap="applyAutomaticLayout" hover-class="tool-action-pressed">自动排布</view><view class="tool-action tool-action-danger" role="button" bindtap="clearLayout" hover-class="tool-action-pressed">清空位置</view><view wx:if="{{viewZoomed}}" class="tool-action view-reset-action" role="button" bindtap="resetCanvasView" hover-class="tool-action-pressed">适应屏幕</view></view><view wx:if="{{unplacedFixtureCount > 0}}" class="tool-section fixture-palette"><view class="tool-section-head"><view><view class="tool-section-title">待布置灯具</view><view class="tool-section-note">按住地址拖到右侧灯位</view></view><view class="palette-head-actions"><view class="palette-count">{{unplacedFixtureCount}} 台</view><view class="batch-open-action" role="button" bindtap="openBatchPlacement" hover-class="tool-action-pressed">批量上杆</view></view></view><scroll-view class="palette-horizontal" scroll-x enhanced show-scrollbar="{{false}}"><view class="palette-track"><view wx:for="{{paletteGroups}}" wx:key="groupIndex" class="palette-group {{item.groupIndex === paletteGroupIndex ? 'palette-group-active' : ''}}" data-group-index="{{item.groupIndex}}" bindtap="selectPaletteGroup">{{item.name}} · {{item.remainingCount}}</view></view></scroll-view><scroll-view class="palette-horizontal" scroll-x enhanced show-scrollbar="{{false}}"><view class="palette-track"><view wx:for="{{paletteFixtures}}" wx:key="key" class="palette-fixture" data-key="{{item.key}}" bindtouchstart="onPaletteTouchStart" catchtouchmove="onPaletteTouchMove" bindtouchend="onPaletteTouchEnd" bindtouchcancel="cancelPaletteDrag">{{item.addressText}}</view></view></scroll-view><view wx:if="{{paletteMoreText}}" class="palette-more">{{paletteMoreText}}</view></view><view class="tool-section"><view class="tool-section-title">搜索定位</view><view class="search-row"><input class="search-input" value="{{searchText}}" placeholder="A001 或灯具组" confirm-type="search" bindinput="onSearchInput" bindconfirm="searchFixture" /><view class="search-action" role="button" bindtap="searchFixture" hover-class="tool-action-pressed">定位</view></view><view wx:if="{{searchResultText}}" class="search-result">{{searchResultText}}</view></view><view wx:if="{{selectedFixture}}" class="selected-panel"><view class="selected-head"><view><view class="selected-address">{{selectedFixture.addressText}}</view><view class="selected-name">{{selectedFixture.groupName}} · 第 {{selectedFixture.fixtureIndex}} 台</view></view><view class="selected-status {{selectedFixture.completed ? 'selected-status-done' : ''}}">{{selectedFixture.completed ? '已设置' : '待设置'}}</view></view><view class="selected-meta">占用 {{selectedFixture.rangeText}} · {{selectedFixture.channelCount}} CH</view><view class="progress-action" role="button" bindtap="toggleSelectedProgress" hover-class="tool-action-pressed">{{selectedFixture.completed ? '取消完成标记' : '标记为已设置'}}</view></view><view class="generate-action {{isGeneratingImage ? 'generate-action-disabled' : ''}}" role="button" bindtap="generateLayoutImage" hover-class="tool-action-pressed">{{isGeneratingImage ? '正在生成…' : '生成横屏位置图'}}</view></scroll-view><view class="landscape-stage"><view id="dmxLayoutCanvasShell" class="layout-canvas-shell"><canvas hidden="{{previewVisible || batchVisible}}" id="dmxLayoutCanvas" canvas-id="dmxLayoutCanvas" class="layout-canvas" width="{{canvasWidth}}" height="{{canvasHeight}}" disable-scroll="{{!scrollEnabled}}" bindtouchstart="onCanvasTouchStart" bindtouchmove="onCanvasTouchMove" bindtouchend="onCanvasTouchEnd" bindtouchcancel="onCanvasTouchCancel"></canvas></view></view></view><cover-view wx:if="{{paletteDragging}}" class="fixture-drag-ghost" style="left: {{paletteDragLeft}}px; top: {{paletteDragTop}}px;">{{paletteDragAddress}}</cover-view><view wx:if="{{batchVisible}}" class="batch-sheet-overlay" bindtap="closeBatchPlacement" catchtouchmove="preventTouchMove"><view class="batch-sheet" catchtap="stopTap"><view class="batch-sheet-header"><view><view class="batch-sheet-title">批量上杆</view><view class="batch-sheet-subtitle">{{paletteGroups[paletteGroupIndex].name}} · 仅含尚未布置灯具</view></view><button class="batch-sheet-close" bindtap="closeBatchPlacement">关闭</button></view><view class="batch-field-label">连续地址范围</view><view class="batch-picker-row"><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchStartIndex}}" bindchange="onBatchStartChange"><view class="batch-picker-value">起始 {{batchStartOptions[batchStartIndex]}} ›</view></picker><text class="batch-range-arrow">至</text><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchEndIndex}}" bindchange="onBatchEndChange"><view class="batch-picker-value">结束 {{batchStartOptions[batchEndIndex]}} ›</view></picker></view><view class="batch-field-label">目标灯位</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchPositionOptions}}" value="{{batchPositionIndex}}" bindchange="onBatchPositionChange"><view class="batch-picker-value">{{batchPositionOptions[batchPositionIndex]}} ›</view></picker><view class="batch-field-label">物理排列</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchDirectionOptions}}" value="{{batchDirectionIndex}}" bindchange="onBatchDirectionChange"><view class="batch-picker-value">{{batchDirectionOptions[batchDirectionIndex]}}（按地址排序）›</view></picker><view class="batch-preview">{{batchPreviewText}}</view><view class="batch-sheet-actions"><button class="batch-clear-button" bindtap="clearBatchPosition">清空本杆</button><button class="batch-apply-button" bindtap="applyBatchPlacement">确认上杆</button></view></view></view><canvas hidden="{{!exportCanvasActive}}" id="dmxLayoutExportCanvas" canvas-id="dmxLayoutExportCanvas" class="export-canvas" width="{{canvasWidth}}" height="{{canvasHeight}}" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"></canvas><view wx:if="{{previewVisible}}" class="result-report-preview-overlay" bindtap="closePreview" catchtouchmove="preventTouchMove"><view class="result-report-preview-sheet landscape-preview-sheet" catchtap="stopTap"><view class="landscape-preview-media"><image class="result-report-preview-image" src="{{layoutImagePath}}" mode="aspectFit" bindtap="previewImage"></image></view><view class="landscape-preview-controls"><view class="result-report-preview-header"><view><view class="result-report-preview-title">横屏位置图已生成</view><view class="result-report-preview-subtitle">点击图片可放大</view></view><button class="result-report-preview-close" bindtap="closePreview">关闭</button></view><view class="result-report-preview-actions"><button class="result-report-preview-action result-report-preview-action-primary" bindtap="shareImage">转发图片</button><button class="result-report-preview-action result-report-preview-action-secondary" bindtap="saveImage">保存到相册</button></view></view></view></view></view>