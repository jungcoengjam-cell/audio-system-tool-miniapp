<view class="page-root page-scroll {{calculationState === 'invalid' ? 'page-root-validation' : ''}}">
  <view class="result-pane">
    <view class="action-rail">
      <button class="action-button" aria-label="重置本次计算" disabled="{{!canReset}}" bindtap="requestReset"><view class="action-icon icon-reset"></view></button>
      <button class="action-button" aria-label="分享结果图片" disabled="{{!hasValidResult}}" bindtap="openSharePreview"><view class="action-icon icon-share"><view class="icon-share-box"></view></view></button>
      <button class="action-button" aria-label="收藏当前配置" disabled="{{!hasValidResult}}" bindtap="toggleCurrentFavorite"><view class="action-icon icon-bookmark {{currentFavorite ? 'icon-bookmark-active' : ''}}"></view></button>
      <button class="action-button" aria-label="保存到项目" disabled="{{!hasValidResult}}" bindtap="openProjectSheet"><view class="action-icon icon-folder"><view></view></view></button>
    </view>
    <view class="result-card">
    <view class="result-heading">
      <view wx:if="{{hasValidResult}}" class="output-status result-success-status">{{outputStatus}}</view>
      <view class="threshold-copy">
        <view class="threshold-summary">
          <view class="threshold-value-group">
            <text class="result-label">限幅阈值</text>
            <view class="threshold {{hasValidResult ? 'result-value-valid' : ''}}">{{thresholdText}}<text class="threshold-unit"> dBFS</text></view>
            <text class="calibration-label">0 dBFS = +18.4 dBu</text>
          </view>
        </view>
        <view class="result-timing">
          <view class="result-time-grid">
            <view class="result-time-item"><text class="result-time-label">建立 Attack</text><view class="result-time-value {{timingReady ? 'result-value-valid' : ''}}" aria-label="{{attackText}}">{{timingReady ? result.attackTimeMs : '—'}}<text class="result-time-unit"> ms</text></view></view>
            <view class="result-time-item"><text class="result-time-label">释放 Release</text><view class="result-time-value {{timingReady ? 'result-value-valid' : ''}}" aria-label="{{releaseText}}">{{timingReady ? result.releaseTimeMs : '—'}}<text class="result-time-unit"> ms</text></view></view>
          </view>
          <view class="result-time-source">{{timingReady ? '保护时间 · HPF ' + highPassText + ' 推荐 · ' + result.timingBand + ' · Release = Attack × 16' : '保护时间未就绪 · HPF：' + highPassText}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{!hasValidResult || reminderActive}}" class="result-status-row">
      <view wx:if="{{!hasValidResult}}" class="output-status-wrap"><view class="output-status {{calculationState === 'invalid' ? 'output-status-invalid' : ''}}">{{outputStatus}}</view></view>
      <view wx:if="{{reminderActive}}" class="reminder-strip" aria-label="{{reminderText}}">其他组沿用现值</view>
    </view>

    <scroll-view class="result-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="result-content">
        <view wx:if="{{outputHint}}" class="output-hint">{{outputHint}}</view>
        <view class="result-grid">
          <view class="metric"><view class="metric-value">{{impedanceText}}</view><view class="metric-label">总阻抗</view></view>
          <view class="metric"><view class="metric-value">{{powerText}}</view><view class="metric-label">音箱总额定功率</view></view>
          <view class="metric"><view class="metric-value">{{voltageText}}</view><view class="metric-label">目标输出电压</view></view>
          <view class="metric"><view class="metric-value">{{dbuText}}</view><view class="metric-label">DSP 模拟输出</view></view>
        </view>
      </view>
    </scroll-view>
    </view>
  </view>

  <view class="input-pane">
    <view class="editor-heading">
      <text class="editor-title">输入配置</text>
    </view>
    <view class="group-tabs">
      <view wx:for="{{groupTabs}}" wx:key="key" class="group-tab {{activeGroup === item.key ? 'group-tab-active' : ''}}" data-group="{{item.key}}" bindtap="onGroupTap">
        <text>{{item.label}}</text><view wx:if="{{item.reminded}}" class="reminder-dot"></view>
      </view>
    </view>
    <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{activeGroup === 'device'}}" class="editor-group editor-group-two">
        <view class="field-row">
          <text class="field-label">功放型号</text>
          <view class="field-control" data-type="amplifier" bindtap="openEquipmentSelector"><text class="field-value">{{selectedAmplifier ? selectedAmplifier.model : '请选择功放'}}</text><text class="field-arrow">›</text></view>
        </view>
        <view class="field-row">
          <text class="field-label">音箱型号</text>
          <view class="field-control" data-type="speaker" bindtap="openEquipmentSelector"><text class="field-value">{{selectedSpeaker ? selectedSpeaker.model : '请选择音箱'}}</text><text class="field-arrow">›</text></view>
        </view>
      </view>

      <view wx:elif="{{activeGroup === 'load'}}" class="editor-group">
        <view class="field-row">
          <text class="field-label">每通道音箱数量</text>
          <view class="field-control count-stepper">
            <button class="stepper-button" aria-label="减少音箱数量" disabled="{{countIndex <= 0}}" data-step="-1" bindtap="onCountStep">−</button>
            <text class="count-value">{{countIndex < 0 ? '—' : counts[countIndex] + ' 只'}}</text>
            <button class="stepper-button" aria-label="增加音箱数量" disabled="{{countIndex >= counts.length - 1}}" data-step="1" bindtap="onCountStep">＋</button>
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">连接方式</text>
          <picker wx:if="{{countIndex >= 0 && counts[countIndex] > 1}}" class="field-picker" range="{{wirings}}" range-key="label" value="{{wiringIndex < 0 ? 0 : wiringIndex}}" data-field="wiringIndex" bindtap="pauseReminderForPicker" bindcancel="cancelPicker" bindchange="onPickerChange">
            <view class="field-control"><text class="field-value">{{wiringIndex < 0 ? '请选择连接方式' : wirings[wiringIndex].label}}</text><text class="field-arrow">⌄</text></view>
          </picker>
          <view wx:elif="{{countIndex >= 0}}" class="field-control field-control-static"><text class="field-value">单只连接</text></view>
          <view wx:else class="field-control field-control-disabled"><text class="field-value">先选择音箱数量</text></view>
        </view>
        <view class="field-row field-row-choice">
          <text class="field-label">功放模式</text>
          <view class="choice-options">
            <button wx:for="{{modes}}" wx:key="value" class="choice-button {{modeIndex === index ? 'choice-button-active' : ''}}" aria-label="{{item.label}}" aria-pressed="{{modeIndex === index}}" data-field="modeIndex" data-index="{{index}}" bindtap="onChoiceTap">{{item.label}}</button>
          </view>
        </view>
      </view>

      <view wx:else class="editor-group editor-group-two">
        <view class="field-row field-row-choice">
          <text class="field-label">输入灵敏度</text>
          <view class="choice-options">
            <button wx:for="{{sensitivities}}" wx:key="value" class="choice-button {{sensitivityIndex === index ? 'choice-button-active' : ''}}" aria-label="{{item.label}}" aria-pressed="{{sensitivityIndex === index}}" data-field="sensitivityIndex" data-index="{{index}}" bindtap="onChoiceTap">{{item.label}}</button>
          </view>
        </view>
        <view class="field-row">
          <text class="field-label">通道 HPF</text>
          <picker class="field-picker" range="{{highPassFrequencies}}" range-key="label" value="{{highPassFrequencyIndex < 0 ? 0 : highPassFrequencyIndex}}" data-field="highPassFrequencyIndex" bindtap="pauseReminderForPicker" bindcancel="cancelPicker" bindchange="onPickerChange">
            <view class="field-control"><text class="field-value">{{highPassText}}</text><text class="field-arrow">⌄</text></view>
          </picker>
        </view>
      </view>
    </scroll-view>
  </view>

  <page-container
    show="{{pageContainerSupported && (selectorVisible || detailsVisible || shareSheetVisible || projectSheetVisible)}}"
    position="bottom" overlay="true" z-index="100" round="{{false}}" close-on-slide-down="{{false}}"
    overlay-style="background-color: rgba(18, 20, 27, .55);" custom-style="background-color: transparent; padding: 0;"
    bind:beforeleave="onPageContainerBeforeLeave" bind:afterleave="onPageContainerAfterLeave"
    bind:clickoverlay="onPageContainerClickOverlay">
    <view class="page-container-sheet-content {{projectKeyboardActive ? 'project-keyboard-open' : ''}}" catchtouchmove="preventTouchMove"><include src="./limiter-overlays.wxml" /></view>
  </page-container>
  <view wx:if="{{!pageContainerSupported && (selectorVisible || detailsVisible || shareSheetVisible || projectSheetVisible)}}" class="sheet-mask {{projectKeyboardActive ? 'project-keyboard-open' : ''}} {{pageContainerFallbackClosing ? 'sheet-mask-closing' : ''}}" catchtap="onPageContainerClickOverlay" catchtouchmove="preventTouchMove">
    <include src="./limiter-overlays.wxml" />
  </view>

  <canvas id="resultReportCanvas" canvas-id="resultReportCanvas" class="result-report-canvas-offscreen" width="{{resultReportCanvasWidth}}" height="{{resultReportCanvasHeight}}" style="width:{{resultReportCanvasWidth}}px;height:{{resultReportCanvasHeight}}px;"></canvas>
  <include src="../../templates/editor-navigation-guard.wxml" />
</view>
