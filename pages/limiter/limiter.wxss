.icon-share-box,.icon-folder>view{display:none}
.icon-share,.icon-folder,.icon-bookmark:not(.icon-bookmark-active){color:var(--theme-accent-text)}
.result-status-row{display:flex;box-sizing:border-box;flex:0 0 auto;min-width:0;min-height:22px;align-items:center;justify-content:space-between;gap:6px}
.result-success-status{position:absolute;top:20px;left:20px}
.output-status-wrap{min-width:0;flex:1}
.output-status{overflow-wrap:anywhere;color:var(--theme-success);font-size:12px;font-weight:600;line-height:1.2}
.output-status-invalid{color:var(--theme-warning)}
.output-hint{flex:none;margin:2px 0;color:var(--theme-warning);font-size:12px;line-height:1.25}
.reminder-strip{box-sizing:border-box;flex:none;max-width:45%;margin-left:auto;padding:2px 7px;border:1rpx solid var(--theme-divider);border-radius:999rpx;background:linear-gradient(135deg,var(--theme-warning-soft),var(--theme-surface));color:var(--theme-warning);font-size:12px;line-height:1.2;white-space:nowrap}
.result-scroll{box-sizing:border-box;flex:0 0 auto;min-height:0;max-height:none;margin-top:8px}
.result-content{display:flex;box-sizing:border-box;min-height:0;flex-direction:column}
.result-grid{display:grid;box-sizing:border-box;flex:none;height:128px;min-height:128px;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(2,minmax(0,1fr));gap:0;border-radius:12px;background:transparent}
.metric{box-sizing:border-box;display:flex;min-width:0;min-height:0;padding:8px 10px;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.metric:nth-child(odd){border-right:1rpx solid var(--theme-divider)}
.metric:nth-child(-n+2){border-bottom:1rpx solid var(--theme-divider)}
.result-card .metric.metric,.result-card .metric-value.metric-value,.result-card .metric-label.metric-label{background:transparent}
.metric-value{max-width:100%;color:var(--theme-text);font-size:20px;font-weight:650;line-height:1.15;text-align:center;overflow-wrap:anywhere}
.metric-label{margin-top:0;color:var(--theme-text-secondary);font-size:13px;line-height:1.2;text-align:center}
.result-timing{width:100%;min-width:0;margin-top:0}
.result-timing-heading{display:flex;align-items:center;justify-content:center;gap:6px}
.result-timing-title{color:var(--theme-text-secondary);font-size:12px;font-weight:600}
.result-timing-band{padding:1px 7px;border-radius:999rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:11px;line-height:1.2}
.result-time-grid{display:grid;width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-top:0}
.result-time-item{display:flex;box-sizing:border-box;min-width:0;min-height:80px;padding:6px 3px;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:1rpx solid var(--theme-divider);border-radius:10px;background:linear-gradient(135deg,var(--theme-surface),var(--theme-accent-soft))}
.result-time-label{color:var(--theme-text-secondary);font-size:13px;line-height:1.15;white-space:nowrap}
.result-time-value{display:flex;align-items:baseline;justify-content:center;gap:1px;color:var(--theme-text);font-size:32px;font-weight:650;line-height:1.05;white-space:nowrap}
.result-time-unit{font-size:14px;font-weight:550;line-height:1}
.threshold.result-value-valid,.result-time-value.result-value-valid{color:var(--theme-success)}
.result-time-source{max-width:100%;margin-top:5px;color:var(--theme-text-tertiary);font-size:12px;line-height:1.25;overflow-wrap:anywhere}
.text-action.text-action{display:flex;box-sizing:border-box;flex:0 1 auto;width:auto;max-width:100%;min-width:44px;height:auto;min-height:44px;margin:0;padding:0 8rpx;align-items:center;justify-content:center;border:0;background:transparent;color:var(--theme-accent-text);font-size:13px;line-height:1.3;text-align:center;white-space:normal;word-break:break-all}
.text-action.text-action::after{border:0}
.editor-heading{display:flex;box-sizing:border-box;flex:0 0 26px;height:26px;min-height:26px;align-items:center;justify-content:space-between}
.editor-title{color:var(--theme-text);font-size:18px;font-weight:600;line-height:25px}
.group-tabs{display:flex;box-sizing:border-box;flex:0 0 44px;height:44px;min-height:44px;align-items:stretch;border-bottom:1rpx solid var(--theme-divider)}
.group-tab{position:relative;display:flex;flex:1;min-width:0;min-height:44px;align-items:center;justify-content:center;gap:6px;color:var(--theme-text-secondary);font-size:13px}
.group-tab-active{color:var(--theme-accent-text);font-weight:650}
.group-tab-active::after{position:absolute;right:20%;bottom:-1rpx;left:20%;height:2px;border-radius:2px 2px 0 0;background:var(--theme-accent);content:""}
.reminder-dot{width:11rpx;height:11rpx;border-radius:50%;background:var(--theme-warning)}
.editor-scroll{box-sizing:border-box;flex:1;min-height:0}
.editor-group{display:flex;box-sizing:border-box;height:156px;min-height:0;flex:0 0 156px;padding-bottom:0;flex-direction:column;gap:0}
.editor-group-two .field-row,.editor-group-two .field-row-choice{height:78px;min-height:78px;max-height:78px;flex:0 0 78px}
.editor-group-two .field-control,.editor-group-two .choice-button.choice-button{height:56px;min-height:56px;max-height:56px}
.field-row{display:flex;box-sizing:border-box;height:52px;min-height:52px;max-height:52px;padding:2px 0;flex:0 0 52px;align-items:center;gap:8px;border-bottom:1rpx solid var(--theme-divider)}
.field-label{box-sizing:border-box;flex:0 0 32%;min-width:0;color:var(--theme-text-secondary);font-size:13px;line-height:1.25;overflow-wrap:anywhere}
.field-control{box-sizing:border-box;display:flex;flex:1 1 0;height:48px;min-width:0;min-height:48px;padding:0 10px;align-items:center;justify-content:space-between;gap:6px;border:1rpx solid var(--theme-divider);border-radius:12px;background:var(--theme-control);color:var(--theme-text)}
.field-picker.field-picker{box-sizing:border-box;display:flex;flex:1 1 0;width:0;max-width:100%;min-width:0;align-items:stretch}
.field-picker.field-picker .field-control.field-control{box-sizing:border-box;display:flex;flex:1 1 0;width:100%;max-width:100%;min-width:0}
.field-control:active{background:var(--theme-accent-soft)}
.field-value{min-width:0;color:var(--theme-text);font-size:13px;overflow-wrap:anywhere}
.field-arrow{flex:none;color:var(--theme-text-tertiary);font-size:31rpx;line-height:1}
.field-control-static{background:transparent}
.field-control-disabled{background:var(--theme-surface-muted);color:var(--theme-text-tertiary)}
.count-stepper.count-stepper{box-sizing:border-box;display:flex;flex:1 1 0;width:0;max-width:100%;min-width:0;min-height:44px;gap:6px}
.stepper-button.stepper-button{box-sizing:border-box;display:flex;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:12rpx;background:var(--theme-surface-muted);color:var(--theme-text);font-size:28rpx;line-height:1}
.stepper-button.stepper-button::after{border:0}
.stepper-button.stepper-button[disabled]{background:transparent;color:var(--theme-text-tertiary);opacity:.45}
.count-value{flex:1;color:var(--theme-text);font-size:15px;text-align:center;white-space:nowrap}
.field-row-choice{height:52px;min-height:52px;max-height:52px;padding:2px 0;flex:0 0 52px;flex-direction:row;align-items:center;gap:8px}
.field-row-choice .field-label{flex:0 0 32%;width:auto}
.choice-options{display:flex;box-sizing:border-box;min-width:0;flex:1 1 0;gap:3px;padding:0;border:1rpx solid var(--theme-divider);border-radius:13px;background:var(--theme-surface-muted)}
.choice-button.choice-button{box-sizing:border-box;display:flex;flex:1 1 0;width:0;max-width:100%;min-width:0;height:48px;min-height:48px;margin:0;padding:0 4px;align-items:center;justify-content:center;border:1rpx solid transparent;border-radius:10px;background:transparent;color:var(--theme-text-secondary);font-size:12px;line-height:1.2;text-align:center;white-space:normal;overflow-wrap:anywhere}
.choice-button.choice-button::after{border:0}
.choice-button-active.choice-button-active{border-color:var(--theme-accent);background:linear-gradient(180deg,var(--theme-surface),var(--theme-accent-soft));color:var(--theme-accent-text);font-weight:650}
.page-container-sheet-content{display:flex;box-sizing:border-box;width:100%;max-height:90vh;flex-direction:column;align-items:stretch;background:transparent}
.page-container-sheet-content.project-keyboard-open{max-height:100vh}
.sheet-mask{position:fixed;z-index:100;inset:0;display:flex;box-sizing:border-box;padding:32rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(18,20,27,.55)}
.sheet-mask.project-keyboard-open{padding:0 20rpx}
.sheet-panel{display:flex;box-sizing:border-box;width:100%;max-height:90vh;min-height:160rpx;padding:22rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;border:1rpx solid var(--theme-divider);border-radius:28rpx;background:var(--theme-surface);color:var(--theme-text)}
.sheet-header{display:flex;flex:none;min-height:48rpx;margin-bottom:14rpx;align-items:center;justify-content:space-between;gap:12rpx}
.sheet-title{color:var(--theme-text);font-size:28rpx;font-weight:700}
.sheet-subtitle{display:block;margin-top:4rpx;color:var(--theme-text-secondary);font-size:18rpx}
.sheet-close.sheet-close{box-sizing:border-box;display:flex;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--theme-control);color:var(--theme-text-secondary);font-size:35rpx;line-height:1}
.sheet-close.sheet-close::after{border:0}
.selector-search{box-sizing:border-box;width:100%;height:48px;min-height:48px;padding:0 16rpx;border:0;border-radius:13rpx;background:var(--theme-control);color:var(--theme-text);font-size:13px}
.category-scroll{flex:none;margin-top:12rpx;white-space:nowrap}
.category-list{display:flex;gap:8rpx}
.category-chip{display:inline-flex;box-sizing:border-box;min-height:44px;padding:0 15rpx;align-items:center;border-radius:999rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:13px}
.category-chip-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.selector-count{flex:none;margin:10rpx 0;color:var(--theme-text-tertiary);font-size:19rpx}
.selector-list{box-sizing:border-box;flex:1;min-height:100rpx;max-height:58vh;overflow:hidden;border-radius:14rpx;background:var(--theme-control)}
.selector-row{display:flex;box-sizing:border-box;min-height:66rpx;padding:8rpx 12rpx;align-items:center;justify-content:space-between;gap:10rpx;border-bottom:1rpx solid var(--theme-divider)}
.selector-row-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:2rpx}
.selector-model{overflow:hidden;color:var(--theme-text);font-size:13px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.selector-meta{color:var(--theme-text-secondary);font-size:17rpx}
.selector-detail.selector-detail{box-sizing:border-box;display:flex;flex:0 1 auto;width:auto;max-width:100%;min-width:44px;height:auto;min-height:44px;margin:0;padding:0 12rpx;align-items:center;justify-content:center;border:0;border-radius:10rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:13px;line-height:1.3;white-space:normal}
.selector-detail.selector-detail::after{border:0}
.selector-empty,.project-state{padding:24rpx 12rpx;color:var(--theme-text-secondary);font-size:20rpx;line-height:1.5;text-align:center}
.details-copy{padding:8rpx 2rpx 20rpx;color:var(--theme-text-secondary);font-size:23rpx;line-height:1.65;white-space:pre-wrap}
.share-panel{max-height:90vh}
.share-image-scroll{box-sizing:border-box;flex:1;min-height:100rpx;max-height:60vh;text-align:center}
.share-image{display:block;width:100%;height:auto;border-radius:12rpx}
.share-state{display:flex;min-height:180rpx;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;color:var(--theme-text-secondary);font-size:21rpx}
.loading-dot{width:28rpx;height:28rpx;border:4rpx solid var(--theme-divider);border-top-color:var(--theme-accent);border-radius:50%;animation:limiter-spin .8s linear infinite}
@keyframes limiter-spin{to{transform:rotate(360deg)}}
.share-error{color:var(--theme-warning)}
.share-reminder{display:block;margin:8rpx 0;color:var(--theme-warning);font-size:19rpx;line-height:1.4}
.share-actions,.form-actions{display:flex;flex:none;align-items:stretch;gap:10rpx;margin-top:12rpx}
.share-action.share-action{box-sizing:border-box;display:flex;flex:0 1 auto;width:auto;max-width:100%;min-width:44px;height:auto;min-height:44px;margin:0;padding:0 12rpx;align-items:center;justify-content:center;border:0;border-radius:15rpx;background:var(--theme-control);color:var(--theme-text);font-size:13px;font-weight:600;line-height:1.35;text-align:center;white-space:normal;word-break:break-word}
.share-actions .share-action.share-action,.form-actions .share-action.share-action{flex:1 1 0;width:0;max-width:100%;min-width:0;height:auto;min-height:44px}
.project-step>.share-action.share-action{flex:0 0 auto;width:100%;max-width:100%;min-width:0}
.share-action.share-action::after{border:0}
.share-action-primary.share-action-primary{background:var(--theme-primary-fill);color:#fff}
.share-action.share-action[disabled]{background:var(--theme-surface-muted);color:var(--theme-text-tertiary)}
.share-retry.share-retry{box-sizing:border-box;display:flex;flex:0 1 auto;width:auto;max-width:100%;min-width:44px;height:auto;min-height:44px;margin:0;padding:0 16rpx;align-items:center;justify-content:center;border:0;border-radius:12rpx;background:var(--theme-control);color:var(--theme-accent-text);font-size:13px;line-height:1.35;text-align:center;white-space:normal}
.share-retry.share-retry::after{border:0}
.project-step{box-sizing:border-box;min-height:0;overflow:visible}
.project-list{box-sizing:border-box;margin:8rpx 0 10rpx;border-radius:14rpx;background:var(--theme-control)}
.project-row{display:flex;box-sizing:border-box;min-height:54px;padding:0 14rpx;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--theme-divider);color:var(--theme-text);font-size:13px}
.project-target{display:flex;min-height:44px;align-items:center;gap:10rpx;color:var(--theme-text-secondary);font-size:20rpx}
.project-target-name{flex:1;overflow:hidden;color:var(--theme-text);font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.form-label{display:block;margin-top:12rpx}
.project-note{box-sizing:border-box;width:100%;min-height:84px;margin-top:8rpx;padding:12rpx;border:0;border-radius:13rpx;background:var(--theme-control);color:var(--theme-text);font-size:13px;line-height:1.45}
.project-preview{display:flex;margin-top:12rpx;padding:12rpx;flex-direction:column;gap:5rpx;border-radius:13rpx;background:var(--theme-surface-muted);color:var(--theme-text-secondary);font-size:18rpx;line-height:1.4}
.preview-title{color:var(--theme-text);font-weight:650}
.form-error{display:block;margin-top:5rpx;color:var(--theme-warning);font-size:18rpx;line-height:1.4}
.project-success{display:flex;min-height:200rpx;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:var(--theme-text-secondary);font-size:13px}
.project-success .form-actions{align-self:stretch;width:100%;box-sizing:border-box}
.project-success>text{box-sizing:border-box;max-width:100%;word-break:break-all}
.success-title{color:var(--theme-success);font-size:26rpx;font-weight:700}
.saved-config-name{color:var(--theme-text);font-weight:600}
.saved-at{color:var(--theme-text-tertiary);font-size:12px}
.project-panel .sheet-title,.share-panel .sheet-title{font-size:20px;line-height:1.4}
.project-panel .sheet-subtitle,.share-panel .sheet-subtitle{font-size:14px;line-height:1.45}
.project-panel .project-step{box-sizing:border-box;min-height:0;overflow:visible}
.project-panel .project-sheet-body{box-sizing:border-box;display:block;height:auto;max-height:55vh;min-height:0;flex:0 1 auto;overflow:hidden}
.project-panel .project-footer{box-sizing:border-box;flex:none;padding-top:10rpx}
.project-panel .project-footer .form-actions{margin-top:0}
.project-panel .project-footer>.share-action.share-action{flex:0 0 auto;width:100%;max-width:100%;min-width:0}
.project-panel.project-keyboard-open{min-height:0;padding-bottom:16rpx}
.project-panel .selector-search{box-sizing:border-box;height:52px;min-height:52px;padding:0 16rpx;font-size:16px;line-height:52px}
.project-panel .field-label,.project-panel .form-label{font-size:16px;line-height:1.45}
.project-panel .project-state{font-size:16px;line-height:1.45}
.project-panel .form-error,.project-panel .saved-at{font-size:14px;line-height:1.45;overflow-wrap:anywhere}
.project-panel .project-row{min-height:54px;padding:6rpx 14rpx;gap:12rpx;font-size:16px;line-height:1.45}
.project-panel .project-row>text:first-child{min-width:0;flex:1;overflow-wrap:anywhere;word-break:break-word}
.project-panel .project-target{align-items:flex-start;flex-wrap:wrap;font-size:16px;line-height:1.45}
.project-panel .project-target-name{min-width:120px;overflow:visible;white-space:normal;text-overflow:clip;overflow-wrap:anywhere;word-break:break-word}
.project-panel .text-action.text-action{min-height:44px;font-size:16px;line-height:1.45}
.project-panel .project-note{font-size:16px;line-height:1.45}
.project-panel.project-keyboard-open .project-note{height:84px}
.project-panel .project-preview{font-size:16px;line-height:1.45;overflow-wrap:anywhere}
.project-panel .preview-title{font-size:16px;line-height:1.45}
.project-panel .project-success{justify-content:flex-start;font-size:16px;line-height:1.45}
.project-panel .success-title{font-size:20px;line-height:1.4}
.project-panel .saved-config-name{font-size:16px;line-height:1.45;overflow-wrap:anywhere}
.project-panel .share-action.share-action,.project-panel .share-retry.share-retry{min-height:48px;height:auto;padding-top:8rpx;padding-bottom:8rpx;font-size:16px;line-height:1.45;white-space:normal;overflow-wrap:anywhere}
.share-panel .share-state{font-size:16px;line-height:1.45}
.share-panel .share-reminder{font-size:14px;line-height:1.45}
.share-panel .share-action.share-action,.share-panel .share-retry.share-retry{min-height:48px;height:auto;padding-top:8rpx;padding-bottom:8rpx;font-size:16px;line-height:1.45;white-space:normal;overflow-wrap:anywhere}
.result-report-canvas-offscreen{position:fixed;z-index:-1;top:0;left:-2000px;pointer-events:none}

@media(max-height:690px){
  .result-card{justify-content:flex-start}
  .result-success-status{top:6px;left:12px}
  .result-heading{position:relative;flex:0 0 auto;height:auto;min-height:200px;max-height:none}
  .threshold-copy{justify-content:flex-start;gap:12px;padding:8px 52px}
  .threshold-summary{flex:none;min-height:0;justify-content:center;gap:0}
  .threshold{font-size:40px}
  .result-time-value{font-size:27px}
  .result-time-unit{font-size:12px}
  .result-time-grid{gap:12px}
  .result-time-item{min-height:60px}
  .metric-value{font-size:18px}
  .result-scroll{flex:1 1 29px;min-height:29px}
}
@media(max-height:640px){
  .input-pane{flex:0 0 calc(219px + env(safe-area-inset-bottom));height:calc(219px + env(safe-area-inset-bottom))}
  .editor-heading{flex-basis:22px;height:22px;min-height:22px}
  .editor-title{line-height:22px}
  .editor-group{height:153px;flex:0 0 153px}
  .field-row,.field-row-choice{height:51px;min-height:51px;max-height:51px;flex-basis:51px}
  .editor-group-two .field-row,.editor-group-two .field-row-choice{height:76.5px;min-height:76.5px;max-height:76.5px;flex-basis:76.5px}
  .field-control{height:44px;min-height:44px}
  .choice-button.choice-button{height:44px;min-height:44px}
  .editor-group-two .field-control,.editor-group-two .choice-button.choice-button{height:56px;min-height:56px;max-height:56px}
}
@media(max-height:600px){
  .result-pane{padding:0 0 8px;border-bottom:0}
  .result-card{padding:0 8px}
  .result-heading{flex:0 0 182px;height:182px;min-height:182px;max-height:182px;padding:0}
  .result-success-status{top:6px;left:12px}
  .threshold-copy{justify-content:flex-start;gap:8px;padding:8px 52px}
  .threshold-summary{flex:none;min-height:0;justify-content:center;gap:0}
  .threshold-value-group{gap:1px}
  .action-rail{top:1px;right:6px;gap:1px}
  .threshold{font-size:34px}
  .threshold-unit{font-size:12px}
  .result-label,.result-time-label{font-size:11px}
  .calibration-label,.result-time-source{font-size:10px}
  .result-time-value{font-size:23px}
  .result-time-grid{gap:8px}
  .result-time-item{min-height:56px;padding:3px 2px;gap:2px}
  .result-time-unit{font-size:12px}
  .result-time-source{margin-top:2px;line-height:1.15}
  .result-status-row{flex:0 0 auto;min-height:18px}
  .reminder-strip{padding:1px 6px;line-height:1}
  .result-scroll{flex:1 1 29px;min-height:29px;max-height:none;margin-top:0}
  .metric-value{font-size:15px}
  .metric-label{font-size:11px}
  .page-root-validation{height:auto;min-height:100vh;overflow-y:auto}
  .page-root-validation .result-pane{flex:0 0 auto;height:auto;min-height:0;max-height:none}
  .page-root-validation .result-card{flex:0 0 auto;height:auto;min-height:0;max-height:none}
  .page-root-validation .result-heading{flex:0 0 182px;height:182px;min-height:182px;max-height:182px}
  .page-root-validation .result-scroll{flex:0 0 90px;min-height:90px;max-height:160px}
  .page-root-validation .input-pane{flex:0 0 auto;height:auto;min-height:0}
  .page-root-validation .editor-scroll{flex:0 0 auto;min-height:0}
  .page-root-validation .editor-group{height:auto;min-height:0;flex:0 0 auto}
}
@media(max-height:479px){
  .page-root.page-scroll{height:auto;min-height:100vh;overflow-y:auto}
  .result-pane{flex:0 0 auto;height:auto;min-height:228px;max-height:none}
  .result-card{flex:0 0 auto;height:auto;min-height:0;max-height:none}
  .input-pane{flex:0 0 auto;height:auto;min-height:0}
  .editor-scroll{flex:0 0 auto;min-height:0}
  .editor-group{height:auto;min-height:0;flex:0 0 auto}
}
@media (prefers-color-scheme: dark){
  .page-root,.page-scroll{background:var(--theme-page-bg);color:var(--theme-text)}
  .result-pane,.input-pane,.sheet-panel{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
  .result-card.result-card{background:linear-gradient(145deg,var(--theme-accent-soft),var(--theme-surface) 72%)}
  .result-time-item{background:linear-gradient(145deg,var(--theme-surface),var(--theme-accent-soft))}
  .project-preview{background:var(--theme-control)}
  .result-timing-band{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
  .metric-value,.result-timing-title,.result-time-value,.sheet-title,.field-value,.project-row,.project-target-name{color:var(--theme-text)}
  .metric-label,.result-time-label,.result-time-source,.result-label,.calibration-label,.field-label,.sheet-subtitle{color:var(--theme-text-secondary)}
  .field-control,.selector-search,.selector-list,.project-list,.project-note{background:var(--theme-control);color:var(--theme-text)}
  .field-control-static,.selector-row{background:transparent;color:var(--theme-text)}
  .field-control-disabled{background:var(--theme-surface-muted);color:var(--theme-text-tertiary)}
  .stepper-button{background:var(--theme-surface-muted);color:var(--theme-text)}
  .choice-button{border-color:var(--theme-divider);background:var(--theme-control);color:var(--theme-text-secondary)}
  .choice-button-active{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text)}
  .category-chip,.share-action,.share-retry,.sheet-close{background:var(--theme-control);color:var(--theme-text)}
  .category-chip-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
  .share-action-primary{background:var(--theme-primary-fill);color:#fff}
  .selector-detail{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
  .output-status-invalid,.output-hint,.form-error,.share-reminder{color:var(--theme-warning)}
  .reminder-strip{background:var(--theme-warning-soft);color:var(--theme-warning)}
  .icon-bookmark-active{background:var(--theme-accent);color:#fff}
}
.sheet-mask{animation:limiter-page-container-mask-in 180ms ease-out both}
.sheet-mask .sheet-panel{animation:limiter-page-container-sheet-in 180ms cubic-bezier(.2,.72,.25,1) both}
.sheet-mask.sheet-mask-closing{animation:limiter-page-container-mask-out 180ms ease-in both}
.sheet-mask.sheet-mask-closing .sheet-panel{animation:limiter-page-container-sheet-out 180ms ease-in both;pointer-events:none}
@keyframes limiter-page-container-mask-in{from{opacity:0}to{opacity:1}}
@keyframes limiter-page-container-mask-out{from{opacity:1}to{opacity:0}}
@keyframes limiter-page-container-sheet-in{from{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
@keyframes limiter-page-container-sheet-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}}
@media(prefers-reduced-motion:reduce){.sheet-mask,.sheet-mask .sheet-panel,.sheet-mask.sheet-mask-closing,.sheet-mask.sheet-mask-closing .sheet-panel{animation-duration:1ms!important;animation-iteration-count:1!important}}
