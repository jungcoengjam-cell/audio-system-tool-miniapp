@import "../../styles/theme-page-shared.wxss";

.page-root,.page-scroll{box-sizing:border-box;width:100%;height:100vh;min-height:0;overflow:hidden;background:var(--theme-page-bg);color:var(--theme-text)}
.page-root{display:flex;flex-direction:column;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC","Helvetica Neue",sans-serif}
.result-pane,.input-pane{box-sizing:border-box;min-height:0;display:flex;flex-direction:column;background:var(--theme-surface)}
.result-pane{position:relative;flex:1 1 0;height:auto;max-height:none;padding:6px 12px 12px;border-bottom:1rpx solid var(--theme-divider)}
.result-card{position:relative;box-sizing:border-box;display:flex;flex:1 1 0;min-height:0;padding:8px;flex-direction:column;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:18px}
.result-card.result-card{border-color:var(--theme-divider);background:#eef3f8;box-shadow:0 4px 14px rgba(0,94,184,.07)}
.input-pane{flex:0 0 calc(226px + env(safe-area-inset-bottom));height:calc(226px + env(safe-area-inset-bottom));min-height:0;padding:0 12px env(safe-area-inset-bottom)}
.action-rail{position:absolute;z-index:3;top:8px;right:12px;display:flex;box-sizing:border-box;width:44px;flex-direction:column;align-items:center;justify-content:flex-start;gap:2px}
.result-heading{position:static;display:flex;box-sizing:border-box;flex:0 0 auto;height:auto;min-height:250px;max-height:none;align-items:stretch;justify-content:center;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}
.threshold-copy{display:flex;box-sizing:border-box;width:100%;min-width:0;flex:1;flex-direction:column;align-items:center;justify-content:flex-start;gap:24px;padding:8px 52px 16px;text-align:center}
.threshold-summary{display:flex;box-sizing:border-box;flex:1 1 0;min-width:0;min-height:100px;flex-direction:column;align-items:center;justify-content:flex-end;gap:0}
.threshold-value-group{display:flex;box-sizing:border-box;min-width:0;flex:none;flex-direction:column;align-items:center;gap:4px}
.result-label{display:block;color:var(--theme-text-secondary);font-size:13px;line-height:1.2}
.threshold{margin-top:0;color:var(--theme-text);font-size:56px;font-weight:700;line-height:1.05;white-space:nowrap}
.result-value-valid{color:var(--theme-success)}
.threshold-unit{font-size:14px;font-weight:550}
.calibration-label{display:block;margin-top:0;color:var(--theme-text-tertiary);font-size:12px;line-height:1.2}
.action-button.action-button{box-sizing:border-box;display:flex;flex:0 0 44px;align-items:center;justify-content:center;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;border:1rpx solid var(--theme-divider);border-radius:50%;background:var(--theme-surface);box-shadow:0 2px 8px rgba(0,0,0,.10);color:var(--theme-text-secondary);line-height:1}
.action-button.action-button::after{border:0}
.action-button.action-button[disabled]{opacity:.34}
.action-button.action-button:active{background:var(--theme-accent-soft);opacity:.72}
.action-icon{position:relative;display:flex;flex:none;align-items:center;justify-content:center;box-sizing:border-box;width:22px;height:22px;border-radius:50%;background:transparent;color:var(--theme-text-secondary);font-size:0;line-height:1}
