.camera-input-panel .installation-control-grid{grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:10px}
.camera-input-panel .margin-field{margin-bottom:0}
.camera-input-panel .margin-field .picker-value{padding:0 12px}
.camera-input-panel .fixed-height-field{margin-top:12px}
.camera-optics-source{margin:6px 0;color:var(--theme-text-secondary);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
@media(max-width:350px){.camera-input-panel{padding-right:12px;padding-left:12px}.camera-input-panel .field-grid-three{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}.camera-input-panel .field-grid-three .field-third:last-child{grid-column:1 / -1}}

/* V4 library selector: clear rows, compact metadata and accessible touch targets. */
.selector-mask{position:fixed;inset:0;z-index:1000;display:flex;box-sizing:border-box;padding:0;align-items:flex-end;background:rgba(18,20,27,.56);animation:camera-selector-mask-in 180ms ease both}
.selector-panel{display:flex;box-sizing:border-box;width:100%;height:auto;max-height:86vh;min-height:0;flex:0 1 auto;padding:20rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;border:1px solid var(--theme-divider);border-radius:28px 28px 0 0;border-bottom:0;background:var(--theme-surface);color:var(--theme-text);box-shadow:0 -12px 40px rgba(0,0,0,.2);animation:camera-selector-sheet-in 300ms cubic-bezier(.2,.72,.25,1) both}
.selector-header{display:flex;box-sizing:border-box;min-height:48px;flex:0 0 auto;margin-bottom:10px;align-items:center;justify-content:space-between;gap:12px}
.selector-title{min-width:0;flex:1 1 auto;overflow-wrap:anywhere;color:var(--theme-text);font-size:20px;font-weight:700;line-height:1.4}
.selector-close{box-sizing:border-box;display:flex;width:44px;min-width:44px;height:44px;min-height:44px;flex:0 0 44px;flex-shrink:0;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--theme-control);color:var(--theme-text-secondary);font-size:30px;line-height:1;white-space:nowrap}
.selector-close:active{background:var(--theme-accent-soft)}
.selector-search{box-sizing:border-box;width:100%;height:52px;min-height:52px;flex:none;margin:0;padding:0 14px;border:0;border-radius:13px;background:var(--theme-control);color:var(--theme-text);font-size:16px;line-height:52px}
.selector-count{margin:10px 2px 8px;color:var(--theme-text-tertiary);font-size:12px;line-height:1.3}
.selector-list{display:block;box-sizing:border-box;width:100%;max-height:60vh;min-height:0;flex:1 1 auto;overflow:hidden;border:1px solid var(--theme-divider);border-radius:14px;background:var(--theme-surface-muted)}
.selector-row{display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:56px;margin:0;padding:7px 10px;align-items:center;justify-content:space-between;border:0;border-bottom:1px solid var(--theme-divider);border-radius:0;background:transparent;color:var(--theme-text);text-align:left;transition:background-color .14s ease}
.selector-row:active{background:var(--theme-accent-soft)}
.selector-row-info{display:flex;min-width:0;flex:1;flex-direction:column;gap:2px;overflow:hidden}
.selector-model,.selector-meta,.selector-optics{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.selector-model{color:var(--theme-text);font-size:15px;font-weight:650;line-height:1.3}
.selector-meta{margin-top:1px;color:var(--theme-text-secondary);font-size:12px;line-height:1.3}
.selector-optics{margin-top:2px;color:var(--theme-text-tertiary);font-size:11px;line-height:1.3}
.selector-row-arrow{flex:none;margin-left:10px;color:var(--theme-accent-text);font-size:24px;line-height:1}
.selector-empty{padding:24px 16px;color:var(--theme-text-secondary);font-size:14px;line-height:1.45;text-align:center}
@keyframes camera-selector-mask-in{from{opacity:0}to{opacity:1}}
@keyframes camera-selector-sheet-in{from{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
.selector-panel{animation-duration:180ms}
.selector-mask.selector-closing{animation:camera-selector-mask-out 180ms ease-in both}
.selector-closing .selector-panel{animation:camera-selector-sheet-out 180ms ease-in both;pointer-events:none}
@keyframes camera-selector-mask-out{from{opacity:1}to{opacity:0}}
@keyframes camera-selector-sheet-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}}

/* Cable-matched share preview sheet. */
@keyframes camera-report-sheet-in{from{transform:translateY(calc(100% + 16rpx + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
@keyframes camera-report-sheet-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + 16rpx + env(safe-area-inset-bottom)))}}
@keyframes camera-overlay-in{from{opacity:0}to{opacity:1}}
@keyframes camera-overlay-out{from{opacity:1}to{opacity:0}}
.page-root .result-report-preview-overlay{z-index:1000;padding:32rpx 0 0;background:rgba(18,20,27,.52);opacity:1;animation:camera-overlay-in 180ms ease-out both}
.page-root.camera-report-preview-closing .result-report-preview-overlay{opacity:1;animation:camera-overlay-out 320ms ease-in both}
.page-root.camera-report-preview-closing .result-report-preview-sheet{animation-name:camera-report-sheet-out;animation-timing-function:ease-in;pointer-events:none}
.page-root .result-report-preview-sheet{box-sizing:border-box;height:auto;max-height:var(--camera-report-sheet-max-height,86vh);padding:20rpx 18rpx calc(16rpx + env(safe-area-inset-bottom));border:1px solid var(--theme-divider);border-radius:28px 28px 0 0;border-bottom:0;background:var(--theme-surface);box-shadow:0 20px 65px rgba(0,0,0,.22);animation:camera-report-sheet-in 320ms cubic-bezier(.2,.72,.25,1) both}
.page-root .result-report-preview-header{flex:none;padding:0 2px 12px}
.page-root .result-report-preview-title{font-size:17px;font-weight:650}
.page-root .result-report-preview-subtitle{margin-top:3px;font-size:12px;line-height:1.35}
.page-root .result-report-preview-close{box-sizing:border-box;width:60px;height:44px;min-height:44px;margin:0;padding:0;border:0;border-radius:999px;background:var(--theme-control);color:var(--theme-text-secondary);font-size:13px}
.page-root .result-report-preview-scroll{box-sizing:border-box;width:100%;height:var(--camera-report-scroll-height,calc(86vh - 118px - 36rpx));max-height:var(--camera-report-scroll-height,calc(86vh - 118px - 36rpx));min-height:0;flex:none;overflow-y:auto;border:1px solid var(--theme-divider);border-radius:17px;background:var(--theme-control)}
.page-root .result-report-preview-image{display:block;width:100%}
.page-root .result-report-preview-actions{display:flex;flex:none;gap:8px;padding-top:12px}
.page-root .result-report-preview-action{box-sizing:border-box;display:flex;height:48px;min-height:44px;flex:1;margin:0;padding:0 9px;align-items:center;justify-content:center;border:0;border-radius:15px;font-size:13px;font-weight:600;line-height:1}
.page-root .result-report-preview-action + .result-report-preview-action{margin-left:0}
.page-root .result-report-preview-action-primary{background:var(--theme-primary-fill);color:#fff}
.page-root .result-report-preview-action-secondary{background:var(--theme-control);color:var(--theme-accent-text)}
.page-root .result-report-preview-action:active{opacity:.75}

/* Project sheets match the Cable project list and confirmation layouts. */
@keyframes camera-project-sheet-in{from{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
@keyframes camera-project-sheet-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}}
.camera-project-overlay{position:fixed;z-index:1100;inset:0;display:flex;box-sizing:border-box;padding:0;align-items:flex-end;justify-content:center;background:rgba(18,20,27,.55);opacity:1;animation:camera-overlay-in 180ms ease-out both}
.camera-project-overlay.camera-project-dialog-closing{opacity:1;animation:camera-overlay-out 320ms ease-in both;pointer-events:auto}
.camera-project-dialog-closing .camera-project-sheet{animation-name:camera-project-sheet-out;animation-timing-function:ease-in;pointer-events:none}
.camera-project-sheet{display:flex;box-sizing:border-box;width:100%;max-height:90vh;min-height:0;padding:22rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;border:1px solid var(--theme-divider);border-radius:28px 28px 0 0;border-bottom:0;background:var(--theme-surface);color:var(--theme-text);box-shadow:0 12px 36px rgba(0,0,0,.2);animation:camera-project-sheet-in 320ms cubic-bezier(.2,.72,.25,1) both}
.camera-project-keyboard-open{padding:4px 22rpx}
.camera-project-overlay.camera-project-keyboard-open{padding:0}
.camera-project-header{display:flex;box-sizing:border-box;min-height:48px;flex:none;margin-bottom:14rpx;align-items:center;justify-content:space-between;gap:12rpx}
.camera-project-title{min-width:0;flex:1;color:var(--theme-text);font-size:20px;font-weight:700;line-height:1.4}
.camera-project-close{box-sizing:border-box;display:flex;width:44px;min-width:44px;height:44px;min-height:44px;flex:0 0 44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--theme-control);color:var(--theme-text-secondary);font-size:30px;line-height:1}
.camera-project-close::after,.camera-project-button::after{border:0}
.camera-project-close:active,.camera-project-button:active{background:var(--theme-accent-soft)}
.camera-project-body{display:block;box-sizing:border-box;width:100%;height:auto;max-height:55vh;min-height:0;flex:0 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch}
.camera-project-keyboard-open .camera-project-body{max-height:none;flex:1 1 auto}
.camera-project-search,.camera-project-name-input{box-sizing:border-box;display:block;width:100%;height:52px;min-height:52px;flex:none;margin:0;padding:0 16rpx;border:0;border-radius:13px;background:var(--theme-control);color:var(--theme-text);font-size:16px;line-height:52px}
.camera-project-note-input{box-sizing:border-box;display:block;width:100%;height:84px;min-height:84px;margin:5rpx 0 0;padding:12rpx 16rpx;border:0;border-radius:13px;background:var(--theme-control);color:var(--theme-text);font-size:16px;line-height:1.45}
.camera-project-placeholder{color:var(--theme-text-tertiary);font-size:16px;line-height:1.45}
.camera-project-list{box-sizing:border-box;width:100%;height:auto;min-height:0;margin-top:10rpx;padding:0 14rpx;border:0;border-radius:13px;background:var(--theme-surface-muted)}
.camera-project-row{display:flex;box-sizing:border-box;width:100%;min-height:54px;margin:0;padding:6rpx 0;align-items:center;justify-content:space-between;border:0;border-bottom:1px solid var(--theme-divider);border-radius:0;background:transparent;color:var(--theme-text);text-align:left;transition:background-color .14s ease}
.camera-project-row:active{background:var(--theme-accent-soft)}
.camera-project-row-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:2px}
.camera-project-row-name{color:var(--theme-text);font-size:16px;font-weight:550;line-height:1.4;overflow-wrap:anywhere}
.camera-project-row-arrow{flex:none;margin-left:10px;color:var(--theme-accent-text);font-size:22px;line-height:1}
.camera-project-empty,.camera-project-error-state{display:flex;box-sizing:border-box;min-height:88px;padding:16rpx;align-items:center;justify-content:center;flex-direction:column;color:var(--theme-text-secondary);font-size:15px;line-height:1.45;text-align:center}
.camera-project-muted{margin-top:4px;color:var(--theme-text-tertiary);font-size:13px;line-height:1.45}
.camera-project-error-state,.camera-project-error{color:var(--theme-warning)}
.camera-project-error{margin-top:8px;font-size:13px;line-height:1.45;overflow-wrap:anywhere}
.camera-project-field{margin-top:10px}
.camera-project-target{margin-bottom:10px}
.camera-project-field-label{color:var(--theme-text-secondary);font-size:14px;line-height:1.45}
.camera-project-target-name{margin-top:2px;color:var(--theme-text);font-size:16px;font-weight:650;line-height:1.45;overflow-wrap:anywhere}
.camera-project-field-error{margin-top:4px;color:var(--theme-warning);font-size:13px;line-height:1.45}
.camera-project-preview{box-sizing:border-box;width:100%;margin-top:12px;padding:12rpx;border-radius:13px;background:var(--theme-surface-muted)}
.camera-project-preview-title,.camera-project-preview-summary{color:var(--theme-text);font-size:15px;font-weight:650;line-height:1.45;overflow-wrap:anywhere}
.camera-project-preview-summary{margin-top:5px;font-weight:400}
.camera-project-footer{display:flex;box-sizing:border-box;flex:none;gap:10rpx;padding-top:10rpx}
.camera-project-keyboard-open .camera-project-footer{padding-top:0}
.camera-project-button{box-sizing:border-box;display:flex;width:0;min-width:0;min-height:48px;flex:1 1 0;margin:0;padding:8rpx 12rpx;align-items:center;justify-content:center;border:0;border-radius:15px;background:var(--theme-control);color:var(--theme-text);font-size:15px;font-weight:600;line-height:1.4;text-align:center;white-space:normal}
.camera-project-button-primary{background:var(--theme-primary-fill);color:#fff}
.camera-project-button[disabled]{opacity:.42}
.camera-project-success{min-height:0}
.camera-project-success-title{color:var(--theme-success);font-size:20px;font-weight:650;line-height:1.4;text-align:center}
.camera-project-success-detail{margin-top:6px;color:var(--theme-text-secondary);font-size:15px;line-height:1.45;text-align:center;overflow-wrap:anywhere}

@media(max-height:420px){
  .selector-panel{max-height:92vh}
  .selector-list{max-height:45vh;min-height:0}
  .camera-project-sheet{max-height:96vh}
  .camera-project-keyboard-open .camera-project-header{display:none}
  .camera-project-keyboard-open .camera-project-body{max-height:none}
  .camera-project-keyboard-open .camera-project-note-input{height:72px;min-height:72px}
}
@media(prefers-reduced-motion:reduce){
  .selector-mask,.selector-panel,.camera-project-sheet{animation-duration:1ms}
  .selector-mask.selector-closing,.selector-closing .selector-panel{animation-duration:1ms!important}
  .page-root .result-report-preview-overlay,.page-root.camera-report-preview-closing .result-report-preview-overlay,
  .camera-project-overlay,.camera-project-overlay.camera-project-dialog-closing{animation-duration:1ms!important}
  .camera-preview-tab,button.camera-action-button,.camera-project-row,.camera-project-button{transition-duration:1ms}
}

/* Final V4 polish: keep the input transition compact and metadata intact. */
button.selector-close::after,button.selector-row::after{border:0}
button.selector-row{width:100%;min-width:0;text-align:left}
button.selector-row:focus-visible,.selector-close:focus-visible,.camera-project-close:focus-visible,.camera-project-button:focus-visible,
.page-root .result-report-preview-close:focus-visible,.page-root .result-report-preview-action:focus-visible{outline:2px solid var(--theme-accent);outline-offset:2px}

.camera-input-panel .installation-control-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:auto 52px;column-gap:10px;row-gap:6px;align-items:stretch}
.camera-input-panel #cameraInstallHeightLabel{grid-column:1 / span 2}
.camera-input-panel #cameraInstallMarginLabel{grid-column:3}
.camera-input-panel .installation-mode-choice,.camera-input-panel .installation-control-value{box-sizing:border-box;width:100%;height:52px;min-height:52px;max-height:52px;margin:0;padding:0 5px;align-items:center;justify-content:center;border:1px solid transparent;border-radius:13px;background:var(--theme-control);color:var(--theme-text-secondary);font-size:13px;font-weight:550;line-height:1.2;text-align:center}
.camera-input-panel .installation-mode-choice{min-width:0;white-space:normal;overflow-wrap:anywhere}
.camera-input-panel .installation-mode-choice.choice-item-active{border-color:rgba(0,122,255,.22);background:var(--theme-accent-soft);color:var(--theme-accent-text);font-weight:650}
.camera-input-panel .installation-margin-picker{display:block;box-sizing:border-box;width:100%;height:52px;min-height:52px;min-width:0;margin:0;padding:0}
.camera-input-panel .installation-control-value{display:flex;flex-wrap:nowrap;white-space:nowrap}
.camera-input-panel .installation-control-value .picker-arrow{margin-left:3px;color:var(--theme-text-secondary);font-size:18px;line-height:1}
.camera-input-panel .fixed-height-field{margin-top:12px}
@media(max-width:350px){.camera-input-panel .installation-control-grid{column-gap:8px}.camera-input-panel .installation-mode-choice,.camera-input-panel .installation-control-value{padding-right:4px;padding-left:4px}}

@media (prefers-color-scheme: light){
  .camera-result-screen{border-color:var(--theme-divider);background:radial-gradient(circle at 96% 0,rgba(0,122,255,.09),transparent 38%),linear-gradient(150deg,var(--theme-surface),var(--theme-surface-muted));color:var(--theme-text);box-shadow:0 8rpx 24rpx var(--theme-shadow)}
  .camera-result-heading,.camera-summary-primary{color:var(--theme-text)}
  .camera-preview-tabs{border-color:var(--theme-divider);background:var(--theme-surface-muted)}
  .camera-preview-tab{color:var(--theme-text-secondary)}
  .camera-preview-tab-active{background:var(--theme-accent-soft);color:var(--theme-accent-text);box-shadow:0 2px 8px var(--theme-shadow)}
  .camera-preview-tab:active{background:var(--theme-accent-soft)}
  .camera-preview-tab:focus-visible{box-shadow:inset 0 0 0 2px var(--theme-accent)}
  .camera-fov-canvas{background:var(--theme-surface-muted)}
  .camera-result-pending-mask{background:rgba(255,255,255,.96);color:var(--theme-text)}
  .camera-pending-mark{border-color:var(--theme-accent);color:var(--theme-accent-text)}
  .camera-pending-title{color:var(--theme-text)}
  .camera-pending-text{color:var(--theme-text-secondary)}
  .camera-result-empty-reserved{border-color:var(--theme-divider);background:radial-gradient(circle at 96% 0,rgba(0,122,255,.09),transparent 38%),linear-gradient(150deg,var(--theme-surface),var(--theme-surface-muted));color:var(--theme-text);box-shadow:0 6rpx 20rpx var(--theme-shadow)}
  .camera-result-empty-reserved .camera-empty-message{color:var(--theme-text)}
  .camera-result-empty-reserved .camera-empty-error{color:var(--theme-danger)}
  .camera-result-empty-reserved .camera-empty-hint{color:var(--theme-text-secondary)}
}

/* One scene spans the full result width. Actions float above it; they do not
   reserve a column or change the orthographic scene's centre. */
.camera-theme-dark .page-scroll,.camera-theme-dark .camera-result-screen,.camera-theme-dark .camera-fov-canvas{background:#000000}
.camera-theme-light .page-scroll,.camera-theme-light .camera-result-screen,.camera-theme-light .camera-fov-canvas{background:#f6f7f9}
.camera-page .camera-result-screen{width:100%;margin:0;padding:0;border:0;border-radius:0;box-shadow:none;overflow:visible}
.camera-page .camera-result-heading{width:100%;min-height:44px;margin:0;padding:0 54px 0 3px;justify-content:flex-start;text-align:left}
.camera-page .camera-summary-primary{overflow:visible;font-size:26rpx;font-weight:550;line-height:1.4;text-align:left;text-overflow:clip;white-space:normal;overflow-wrap:anywhere}
.camera-theme-dark .camera-summary-primary{color:#eef2f6}
.camera-theme-light .camera-summary-primary{color:#243746}
.camera-page .camera-chart-panel{width:100%;padding:0;margin:0}
.camera-page .camera-fov-canvas{width:100%;height:760rpx;min-height:340px;border-radius:0}
.camera-page .camera-result-rail{top:0;right:0;gap:3px}
.camera-theme-dark button.camera-action-button{background:#10171f;border-color:#263343;box-shadow:none}
.camera-theme-light button.camera-action-button{background:#fff;border-color:#d0d9e4;box-shadow:none}
.camera-theme-dark .camera-result-pending-mask{background:rgba(0,0,0,.96)}
@media(max-width:350px){.camera-page .camera-fov-canvas{height:800rpx;min-height:340px}}
.camera-presentation-summary{box-sizing:border-box;padding:8rpx 16rpx 4rpx;color:var(--theme-text-secondary);font-size:21rpx;line-height:1.5;word-break:break-all;overflow-wrap:anywhere}
.camera-presentation-status{box-sizing:border-box;margin:4rpx 12rpx 12rpx;padding:12rpx 16rpx;border-radius:12rpx;background:var(--theme-surface-muted);color:var(--theme-text-secondary);font-size:21rpx;line-height:1.5;word-break:break-all;overflow-wrap:anywhere}
.camera-theme-dark .camera-presentation-status-warning{background:#2b2110;color:#e9b654}
.camera-theme-light .camera-presentation-status-warning{background:#fff5e8;color:#80530f}
