.camera-input-panel .field-third{min-width:0;margin-bottom:0}
.camera-input-panel .field-grid-three .field-label{font-size:12px;line-height:1.25}
.camera-input-panel .input-wrap,.camera-input-panel .picker-value{box-sizing:border-box;min-height:52px;height:52px;border:1px solid transparent;border-radius:13px;background:var(--theme-control);color:var(--theme-text)}
