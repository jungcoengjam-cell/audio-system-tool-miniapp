.camera-input-panel .choice-item-active{border-color:rgba(0,122,255,.22);background:var(--theme-accent-soft);color:var(--theme-accent-text);font-weight:650}
.camera-input-panel .choice-item:active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.camera-input-panel .choice-item:focus-visible{outline:2px solid var(--theme-accent);outline-offset:1px}
.camera-input-panel .camera-section-heading{margin:3px 0 8px;color:var(--theme-text);font-size:13px;font-weight:650}
