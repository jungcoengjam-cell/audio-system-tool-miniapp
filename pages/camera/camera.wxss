/* V4 result: the diagram carries more weight inside a compact, centered card. */
.camera-page-content{padding-top:4rpx}
.camera-result-pane{position:relative;min-width:0;margin:0 0 10rpx}
.camera-result-heading{display:flex;box-sizing:border-box;width:calc(100% - 56px);margin:0 auto 4rpx;align-items:center;justify-content:center;text-align:center}
.camera-summary-primary{display:block;box-sizing:border-box;width:100%;max-width:100%;overflow:hidden;color:#f3f7fb;font-size:28rpx;font-weight:700;line-height:1.25;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.camera-result-rail{position:absolute;z-index:5;top:2px;right:0;display:flex;box-sizing:border-box;width:44px;flex-direction:column;align-items:center;justify-content:flex-start;gap:2px}
button.camera-action-button{box-sizing:border-box;display:flex;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;flex:0 0 44px;margin:0;padding:0;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:50%;background:var(--theme-surface);box-shadow:0 2px 8px rgba(0,0,0,.14);color:var(--theme-accent-text);line-height:1;transition:background-color .14s ease,box-shadow .14s ease,opacity .14s ease}
button.camera-action-button::after{border:0}
button.camera-action-button[disabled]{opacity:.38}
button.camera-action-button:active{background:var(--theme-accent-soft);opacity:.78}
button.camera-action-button:focus-visible{outline:2px solid #60a5fa;outline-offset:2px}
.camera-chart-panel{box-sizing:border-box;width:100%;margin:0 auto;padding:0;border:0;border-radius:0;background:transparent}
.camera-preview-tabs{display:flex;box-sizing:border-box;width:208px;max-width:100%;height:44px;margin:0 auto 5rpx;padding:0;border:1rpx solid rgba(203,222,240,.13);border-radius:14px;background:rgba(235,244,252,.07)}
.camera-preview-tab{display:flex;box-sizing:border-box;min-width:0;height:44px;min-height:44px;flex:1;align-items:center;justify-content:center;border-radius:12px;color:#b9cad9;font-size:25rpx;font-weight:600;line-height:1;transition:background-color .14s ease,color .14s ease,box-shadow .14s ease}
.camera-preview-tab-active{background:rgba(96,165,250,.22);color:#eff6ff;font-weight:700;box-shadow:0 2px 8px rgba(0,0,0,.14)}
.camera-preview-tab:active{background:rgba(96,165,250,.3)}
.camera-preview-tab:focus{outline:none}
.camera-preview-tab:focus-visible{box-shadow:inset 0 0 0 2px #7dd3fc}
.camera-fov-canvas{display:block;box-sizing:border-box;width:100%;height:520rpx;border-radius:14px;background:#10243a}
.camera-result-empty>.camera-legacy-title,.camera-result-empty>.camera-empty-message,.camera-result-empty>.camera-empty-hint,.camera-result-empty>.camera-legacy-selector-button{max-width:calc(100% - 76px);align-self:center;text-align:center}
.camera-legacy-unsupported,.camera-operation-unsupported{align-items:center;justify-content:center;text-align:center}
.camera-legacy-unsupported{border-color:rgba(155,190,222,.16);background:radial-gradient(circle at 96% 0,rgba(63,133,198,.25),transparent 38%),linear-gradient(150deg,#142c45,#0b1d30);color:#e8f1fb}
.camera-legacy-title{color:#fff;font-size:28rpx;font-weight:700;line-height:1.4}
.camera-legacy-unsupported .camera-empty-message{color:#d5e3f1;font-size:24rpx;font-weight:500;line-height:1.5}
.camera-operation-unsupported .camera-empty-message{color:var(--theme-text);font-size:24rpx;font-weight:500;line-height:1.5}
.camera-legacy-selector-button{box-sizing:border-box;display:flex;min-width:44px;min-height:44px;margin:4rpx 0 0;padding:0 18rpx;align-items:center;justify-content:center;border:0;border-radius:14rpx;background:var(--theme-accent);color:#fff;font-size:25rpx;font-weight:650;line-height:1.35}
.camera-legacy-selector-button::after{border:0}
.camera-legacy-input-note{padding:16rpx;border:1rpx solid var(--theme-divider);border-radius:16rpx;background:var(--theme-surface-muted);color:var(--theme-warning);font-size:24rpx;line-height:1.5}
.camera-input-disabled{pointer-events:none;opacity:.55}
@media(max-width:350px){.camera-result-screen{padding:6rpx}.camera-result-heading{width:calc(100% - 52px)}.camera-preview-tabs{width:200px}.camera-result-empty>.camera-legacy-title,.camera-result-empty>.camera-empty-message,.camera-result-empty>.camera-empty-hint,.camera-result-empty>.camera-legacy-selector-button{max-width:calc(100% - 80px)} }

/* V4 input hierarchy: one surface, tidy tabs, consistent control heights. */
.camera-input-card{overflow:hidden;padding:0;border:1rpx solid var(--theme-divider);border-radius:24rpx;background:var(--theme-surface);box-shadow:0 8rpx 22rpx var(--theme-shadow)}
.camera-input-tabs{display:flex;box-sizing:border-box;gap:4rpx;padding:6rpx;border:0;border-bottom:1rpx solid var(--theme-divider);border-radius:20rpx 20rpx 0 0;background:var(--theme-surface-muted)}
.camera-input-tab{position:relative;display:flex;box-sizing:border-box;min-width:0;min-height:46px;flex:1;align-items:center;justify-content:center;gap:5rpx;padding:0 5rpx;border-radius:13px;color:var(--theme-text-secondary);font-size:24rpx;line-height:1.2;text-align:center;transition:background-color .14s ease,color .14s ease,box-shadow .14s ease}
.camera-input-tab-active{background:var(--theme-surface);color:var(--theme-text);font-weight:650;box-shadow:0 2px 8px var(--theme-shadow)}
.camera-input-tab:active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.camera-input-tab:focus{outline:none}
.camera-input-tab:focus-visible{box-shadow:inset 0 0 0 2px var(--theme-accent)}
.camera-tab-error{display:inline-flex;box-sizing:border-box;width:20px;height:20px;flex:0 0 20px;align-items:center;justify-content:center;border-radius:50%;background:var(--theme-danger);color:#fff;font-size:12px;font-weight:800;line-height:1}
.camera-tab-error-hint{box-sizing:border-box;min-height:16px;padding:0 12px;color:var(--theme-danger);font-size:12px;line-height:16px}
.camera-input-panel{padding:0 16px 18px;background:transparent}
.camera-input-panel .input-section-first{margin-top:0;padding-top:6px;border-top:0}
