.camera-input-panel .picker-value{justify-content:space-between;padding:0 12px;font-size:16px;font-weight:550;line-height:1.3}
.camera-input-panel .picker-value .picker-arrow{margin-left:10px;color:var(--theme-text-secondary);font-size:23px;line-height:1}
.camera-input-panel .equipment-value{box-sizing:border-box;min-height:60px;height:60px;max-height:60px;align-items:center}
.camera-input-panel .equipment-info{display:flex;min-width:0;flex:1;flex-direction:column}
.camera-input-panel .picker-arrow{flex:none}
.camera-input-panel .equipment-model{max-width:100%;overflow:hidden;color:var(--theme-text);font-size:15px;font-weight:650;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.camera-input-panel .equipment-category{max-width:100%;margin-top:3px;overflow:hidden;color:var(--theme-text-secondary);font-size:11px;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.camera-input-panel .choice-grid{display:flex;gap:6px}
