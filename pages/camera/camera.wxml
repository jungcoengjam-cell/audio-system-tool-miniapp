<view class="page-root camera-page camera-theme-{{theme}} {{resultReportPreviewClosing ? 'camera-report-preview-closing' : ''}}" style="{{resultReportPreviewStyle}}">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" aria-label="摄像机安装计算">
    <view class="page-content camera-page-content">
      <view id="cameraResultPane" class="camera-result-pane">
        <view id="cameraResultRail" class="camera-result-rail" aria-label="结果操作">
          <button id="cameraReset" class="camera-action-button" aria-label="恢复默认选项并清空输入" disabled="{{operationSnapshot || operationActive}}" bindtap="resetToDefaults"><view class="camera-action-icon icon-reset" aria-hidden="true"></view></button>
          <button id="cameraShare" class="camera-action-button" aria-label="生成结果图片" disabled="{{!result || legacyCustomUnsupported || resultUpdating || isGeneratingResultReport}}" bindtap="generateResultReportImage"><view class="camera-action-icon icon-share" aria-hidden="true"></view></button>
          <button id="cameraFavorite" class="camera-action-button" aria-label="{{currentFavorite ? '取消常用收藏' : '收藏常用'}}" aria-pressed="{{currentFavorite}}" disabled="{{!result || legacyCustomUnsupported || resultUpdating || operationSnapshot || operationActive}}" bindtap="toggleCurrentFavorite"><view class="camera-action-icon icon-bookmark {{currentFavorite ? 'icon-bookmark-active' : ''}}" aria-hidden="true"></view></button>
          <button id="cameraProject" class="camera-action-button" aria-label="选择项目保存结果" disabled="{{!result || legacyCustomUnsupported || resultUpdating || operationSnapshot || operationActive}}" bindtap="saveToActiveProject"><view class="camera-action-icon icon-folder" aria-hidden="true"></view></button>
        </view>

        <view wx:if="{{result}}" id="cameraResultHero" class="camera-result-screen">
          <view class="camera-result-heading">
            <view class="camera-summary-primary">{{result.displayModel}} · {{result.displayView}}</view>
          </view>

          <view class="camera-chart-panel">
            <canvas type="2d" id="cameraFovCanvas" class="camera-fov-canvas" aria-label="{{result.displayModel}}，统一正交三维示意。{{result.distanceReferenceText}} {{result.presentationDistanceText}}；{{result.heightDisplayLabel}} {{result.presentationHeightText}}；{{result.presentationPitchLabel}}；取景余量 {{result.marginPercent}}%。{{result.presentationStatusText}}"></canvas>
            <view class="camera-presentation-summary">展示值：距离 {{result.presentationDistanceText}}；高度 {{result.presentationHeightText}}；{{result.presentationPitchLabel}}</view>
            <view class="camera-presentation-status {{result.presentationStatusKind == 'display-unverified' ? 'camera-presentation-status-warning' : ''}}" role="status" aria-live="polite">{{result.presentationStatusText}}</view>
          </view>

          <view wx:if="{{resultUpdating}}" class="camera-result-pending-mask" role="status" aria-live="polite" catchtap="stopTap">
            <view class="camera-pending-mark">↻</view>
            <view class="camera-pending-title">正在更新安装建议</view>
            <view class="camera-pending-text">输入已变化；当前示意图与距离暂不可用，请稍候。</view>
          </view>
        </view>

        <view wx:elif="{{legacyCustomUnsupported}}" id="cameraLegacyUnsupported" class="camera-result-empty camera-legacy-unsupported" role="status">
          <view class="camera-legacy-title">旧自定义配置暂不支持</view>
          <view class="camera-empty-message">此旧配置无法在当前版本计算，也不能用于生成图片、收藏或写入项目；既有记录会原样保留。请选择库内型号继续。</view>
          <button id="cameraLegacySelectorButton" class="camera-legacy-selector-button" bindtap="openCameraSelector">选择库内型号</button>
        </view>

        <view wx:elif="{{operationUnsupportedMessage}}" id="cameraOperationUnsupported" class="camera-result-empty camera-operation-unsupported" role="status">
          <view class="camera-empty-message" role="alert">{{operationUnsupportedMessage}}</view>
          <button class="camera-legacy-selector-button" bindtap="openCameraSelector">选择库内型号</button>
        </view>

        <view wx:else id="cameraResultEmpty" class="camera-result-empty {{resultZoneReserved ? 'camera-result-empty-reserved' : ''}}" style="{{resultZoneReserved ? resultPlaceholderStyle : ''}}" role="status">
          <view wx:if="{{calculationError}}" class="camera-empty-message camera-empty-error" role="alert">{{calculationError}}</view>
          <view wx:else class="camera-empty-message">{{resultEmptyText || '输入有效的库内摄像机与拍摄条件后显示安装位置参考。'}}</view>
          <view wx:if="{{inputErrors.groundWidthText || inputErrors.groundDepthText || inputErrors.subjectHeightText || inputErrors.planeWidthText || inputErrors.planeHeightText || inputErrors.planeBottomHeightText || inputErrors.fixedCameraHeightText}}" class="camera-empty-hint">请在带“!”标记的输入分组检查并修正高亮项目。</view>
        </view>
      </view>

      <view id="cameraInputCard" class="card camera-input-card">
        <view id="cameraInputTabs" class="camera-input-tabs" role="tablist" aria-label="计算输入分组">
          <view wx:for="{{inputTabs}}" wx:key="value" class="camera-input-tab {{index == inputTabIndex ? 'camera-input-tab-active' : ''}}" role="tab" tabindex="0" aria-selected="{{index == inputTabIndex}}" data-index="{{index}}" bindtap="onInputTabTap">
            <text>{{item.label}}</text>
            <text wx:if="{{index == 1 && (inputErrors.groundWidthText || inputErrors.groundDepthText || inputErrors.subjectHeightText || inputErrors.planeWidthText || inputErrors.planeHeightText || inputErrors.planeBottomHeightText)}}" class="camera-tab-error" aria-label="本组有输入错误">!</text>
            <text wx:if="{{index == 2 && inputErrors.fixedCameraHeightText}}" class="camera-tab-error" aria-label="本组有输入错误">!</text>
          </view>
        </view>
        <view class="camera-tab-error-hint" role="status">{{!legacyCustomUnsupported && (inputErrors.groundWidthText || inputErrors.groundDepthText || inputErrors.subjectHeightText || inputErrors.planeWidthText || inputErrors.planeHeightText || inputErrors.planeBottomHeightText || inputErrors.fixedCameraHeightText) ? '带“!”的分组有待修正项。' : ''}}</view>

        <view wx:if="{{inputTabIndex == 0}}" id="cameraInputPanelCamera" class="camera-input-panel">
          <view class="input-section input-section-first">
            <view wx:if="{{legacyCustomUnsupported}}" class="camera-legacy-input-note">旧自定义配置未加载；先选择库内型号。</view>
            <view wx:else class="field">
              <view class="field-label">摄像机型号</view>
              <view id="cameraModelPicker" class="picker-value equipment-value" bindtap="openCameraSelector">
                <view class="equipment-info">
                  <view class="equipment-model">{{selectedCamera.model}}</view>
                  <view class="equipment-category">{{selectedCamera.category}} · {{selectedMountLabel}} · {{selectedCamera.sensor}}</view>
                </view>
                <view class="picker-arrow">›</view>
              </view>
            </view>
            <view wx:if="{{!legacyCustomUnsupported && viewOptions.length > 1}}" class="field">
              <view class="field-label">摄像机视角</view>
              <view class="choice-grid">
              <view wx:for="{{viewOptions}}" wx:key="label" class="choice-item {{index == viewIndex ? 'choice-item-active' : ''}}" tabindex="0" data-index="{{index}}" bindtap="onViewTap">{{item.label}}</view>
              </view>
            </view>
            <view wx:if="{{!legacyCustomUnsupported}}" wx:for="{{selectedOpticsLines}}" wx:key="*this" class="camera-optics-source">{{item}}</view>
          </view>
        </view>

        <view wx:if="{{inputTabIndex == 1}}" id="cameraInputPanelTarget" class="camera-input-panel {{legacyCustomUnsupported ? 'camera-input-disabled' : ''}}">
          <view class="input-section input-section-first">
            <view class="camera-section-heading">拍摄场景</view>
            <view class="choice-grid camera-scene-choice">
              <view wx:for="{{sceneModes}}" wx:key="value" class="choice-item {{index == sceneModeIndex ? 'choice-item-active' : ''}}" tabindex="0" data-index="{{index}}" bindtap="onSceneModeTap"><view>{{item.label}}</view><view class="camera-choice-description">{{item.value == 'ground' ? '坐席区、舞台区' : '屏幕、黑板、背景墙'}}</view></view>
            </view>
            <block wx:if="{{sceneModeIndex == 0}}">
              <view class="field-grid field-grid-three compact-dimension-grid">
                <view class="field field-third"><view class="field-label">区域宽度</view><view class="input-wrap {{inputErrors.groundWidthText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{groundWidthText}}" disabled="{{legacyCustomUnsupported}}" data-field="groundWidthText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.groundWidthText}}" class="input-error">{{inputErrors.groundWidthText}}</view></view>
                <view class="field field-third"><view class="field-label">区域纵深</view><view class="input-wrap {{inputErrors.groundDepthText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{groundDepthText}}" disabled="{{legacyCustomUnsupported}}" data-field="groundDepthText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.groundDepthText}}" class="input-error">{{inputErrors.groundDepthText}}</view></view>
                <view class="field field-third"><view class="field-label">最高点离地</view><view class="input-wrap {{inputErrors.subjectHeightText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{subjectHeightText}}" disabled="{{legacyCustomUnsupported}}" data-field="subjectHeightText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.subjectHeightText}}" class="input-error">{{inputErrors.subjectHeightText}}</view></view>
              </view>
              <view class="field-tip">水平距离从镜头中心量到实际拍摄区前沿；区域按宽度中心线居中。</view>
            </block>
            <block wx:else>
              <view class="field-grid field-grid-three compact-dimension-grid">
                <view class="field field-third"><view class="field-label">目标宽度</view><view class="input-wrap {{inputErrors.planeWidthText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{planeWidthText}}" disabled="{{legacyCustomUnsupported}}" data-field="planeWidthText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.planeWidthText}}" class="input-error">{{inputErrors.planeWidthText}}</view></view>
                <view class="field field-third"><view class="field-label">目标高度</view><view class="input-wrap {{inputErrors.planeHeightText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{planeHeightText}}" disabled="{{legacyCustomUnsupported}}" data-field="planeHeightText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.planeHeightText}}" class="input-error">{{inputErrors.planeHeightText}}</view></view>
                <view class="field field-third"><view class="field-label">底边离地</view><view class="input-wrap {{inputErrors.planeBottomHeightText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{planeBottomHeightText}}" disabled="{{legacyCustomUnsupported}}" data-field="planeBottomHeightText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view><view wx:if="{{inputErrors.planeBottomHeightText}}" class="input-error">{{inputErrors.planeBottomHeightText}}</view></view>
              </view>
              <view class="field-tip">水平距离从镜头中心量到目标平面。</view>
            </block>
          </view>
        </view>

        <view wx:if="{{inputTabIndex == 2}}" id="cameraInputPanelInstall" class="camera-input-panel {{legacyCustomUnsupported ? 'camera-input-disabled' : ''}}">
          <view class="input-section input-section-first">
            <view class="installation-control-grid">
              <view id="cameraInstallHeightLabel" class="field-label installation-mode-label">镜头中心高度</view>
              <view id="cameraInstallMarginLabel" class="field-label installation-margin-label">取景余量</view>
              <view wx:for="{{heightModes}}" wx:key="value" class="choice-item installation-mode-choice {{index == heightModeIndex ? 'choice-item-active' : ''}}" role="button" tabindex="0" aria-label="{{item.label}}" aria-pressed="{{index == heightModeIndex}}" data-index="{{index}}" bindtap="onHeightModeTap">{{item.value == 'auto' ? '自动' : '固定'}}</view>
              <picker class="field margin-field installation-margin-picker" range="{{marginOptions}}" value="{{marginIndex}}" disabled="{{legacyCustomUnsupported}}" aria-label="取景余量" bindchange="onMarginChange">
                <view class="picker-value installation-control-value"><text>{{marginOptions[marginIndex]}}%</text><view class="picker-arrow" aria-hidden="true">›</view></view>
              </picker>
            </view>
            <view id="cameraFixedHeightField" wx:if="{{heightModeIndex == 1}}" class="field fixed-height-field">
              <view class="field-label">已有镜头中心高度</view>
              <view class="input-wrap {{inputErrors.fixedCameraHeightText ? 'input-wrap-error' : ''}}"><input type="digit" value="{{fixedCameraHeightText}}" disabled="{{legacyCustomUnsupported}}" data-field="fixedCameraHeightText" bindinput="onFieldInput" bindblur="onFieldBlur" /><text>m</text></view>
              <view wx:if="{{inputErrors.fixedCameraHeightText}}" class="input-error">{{inputErrors.fixedCameraHeightText}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{selectorVisible}}" class="selector-mask {{selectorClosing ? 'selector-closing' : ''}}" catchtap="closeCameraSelector">
    <view class="selector-panel {{selectorClosing ? 'selector-panel-closing' : ''}}" catchtap="stopTap">
      <view class="selector-header"><view class="selector-title">选择摄像机型号</view><button class="selector-close" aria-label="关闭型号选择" catchtap="closeCameraSelector">×</button></view>
      <input class="selector-search" value="{{selectorKeyword}}" placeholder="输入型号，例如 TV-620、TS-0663" confirm-type="search" bindinput="onSelectorInput" />
      <view class="selector-count">共 {{selectorItems.length}} 个型号</view>
      <scroll-view class="selector-list" scroll-y>
        <button wx:for="{{selectorItems}}" wx:key="model" class="selector-row" data-index="{{item.index}}" catchtap="selectCamera">
          <view class="selector-row-info"><view class="selector-model">{{item.model}}</view><view class="selector-meta">{{item.category}} · {{item.sensor}}</view><view wx:for="{{item.opticsLines}}" wx:for-item="opticsLine" wx:key="*this" class="selector-optics">{{opticsLine}}</view></view>
          <view class="selector-row-arrow">›</view>
        </button>
        <view wx:if="{{selectorItems.length == 0}}" class="selector-empty">没有匹配型号，请尝试缩短关键词。</view>
      </scroll-view>
    </view>
  </view>

  <include src="./camera-overlays.wxml" />
  <include src="../../templates/result-report-preview.wxml" />
  <include src="../../templates/editor-navigation-guard.wxml" />
</view>
