@import "../../styles/theme-page-shared.wxss";

.page-root{--page-bg:#fff;--surface:#fff;--control:#f5f5f7;--line:#e4e4e8;--text:#17171a;--muted:#707077;--subtle:#929299;--accent:#007aff;--overlay-safe-top:76px;--overlay-safe-bottom:12px;--overlay-max-height:calc(100vh - 88px);--overlay-center-top:50vh;--overlay-search-max-height:88vh;--overlay-search-sheet-height:78vh;--overlay-pending-max-height:80vh;--overlay-add-max-height:88vh;--overlay-save-max-height:66vh;--overlay-guide-height:82vh;--overlay-report-height:84vh;--overlay-save-list-max-height:34vh;box-sizing:border-box;display:flex;width:100%;height:100vh;overflow:hidden;flex-direction:column;background:#fff;color:#17171a;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",sans-serif}
.page-header{position:relative;box-sizing:border-box;width:100%;flex-shrink:0;background:var(--page-bg)}
.header-back{position:absolute;display:flex;box-sizing:border-box;width:42px;height:40px;align-items:center;justify-content:center;color:#007aff}
.header-back{left:8px;font-size:31px;font-weight:300;line-height:1}
.page-title{position:absolute;left:50%;display:flex;height:40px;align-items:center;justify-content:center;transform:translateX(-50%);color:#101d63;font-size:20px;font-weight:700;line-height:1;white-space:nowrap}
.page-scroll{width:100%;height:0;min-height:0;flex:1;background:var(--page-bg)}
.page-content{box-sizing:border-box;width:100%;padding:0 16px calc(28px + env(safe-area-inset-bottom))}
.context-row{position:relative;display:flex;height:62px;align-items:center;justify-content:center;border-bottom:1px solid var(--line)}
.context-picker{display:block;max-width:68%;min-width:0}
.context-selector{display:flex;min-height:48px;padding:0 10px;align-items:center;justify-content:center;gap:8px;color:#111d63;font-size:23px;font-weight:700;white-space:nowrap}
.context-chevron{color:var(--muted);font-size:14px}
.save-project-trigger{position:absolute;right:0;display:flex;height:44px;padding:0 3px;align-items:center;color:var(--accent);font-size:14px;white-space:nowrap}
.project-name-input{box-sizing:border-box;min-width:0;height:40px;flex:1;padding:0 10px;border-radius:8px;background:var(--control);color:var(--text);font-size:14px}
.save-project-submit,.save-project-cancel{display:flex;height:40px;min-width:46px;padding:0 10px;align-items:center;justify-content:center;color:var(--accent);font-size:13px;font-weight:600}
.save-project-submit{border-radius:8px;background:#007aff;color:#fff}
.save-project-submit.is-disabled{opacity:.5}
.save-project-cancel{color:var(--muted)}
.inline-error{position:absolute;top:100%;left:6px;z-index:3;padding:4px 0;color:#ff3b30;font-size:12px}
.status-error{display:flex;box-sizing:border-box;min-height:34px;margin:4px 0;padding:6px 10px;align-items:center;justify-content:space-between;gap:10px;border-radius:8px;background:#fff1f0;color:#b42318;font-size:12px;line-height:1.35}
.status-retry{flex-shrink:0;color:#007aff;font-weight:650}
.setup-row{display:flex;box-sizing:border-box;min-height:58px;padding:6px 0;align-items:center;gap:8px;border-bottom:1px solid var(--line)}
.allocation-picker{display:block;max-width:43%;min-width:103px}
.setup-select{display:flex;box-sizing:border-box;min-height:44px;padding:0 9px;align-items:center;justify-content:space-between;gap:6px;border:1px solid #c9d7f2;border-radius:9px;color:#101d63;font-size:15px;font-weight:650;white-space:nowrap}
.select-chevron{color:var(--accent);font-size:15px}
.setup-divider{color:#101d63;font-size:21px;font-weight:500}
.setup-start-label{flex-shrink:0;color:#101d63;font-size:14px;font-weight:600;white-space:nowrap}
.start-address-box{display:flex;box-sizing:border-box;height:44px;min-width:80px;flex:1;padding:0 8px;align-items:center;gap:0;border:1px solid #c9d7f2;border-radius:9px;color:#101d63;font-size:15px;font-weight:600}
.start-address-input{box-sizing:border-box;width:48px;height:42px;min-height:42px;padding:0;color:#101d63;font-size:17px;font-weight:700;text-align:left}
.add-group-button{display:flex;box-sizing:border-box;height:44px;min-width:76px;padding:0 10px;align-items:center;justify-content:center;border-radius:9px;background:#007aff;color:#fff;font-size:14px;font-weight:650;white-space:nowrap;transition:opacity .12s ease,transform .12s ease}
.add-group-button:active{transform:scale(.97);opacity:.8}
.occupancy-strip{display:grid;box-sizing:border-box;min-height:54px;margin:9px 0;padding:8px 9px;grid-template-columns:47px minmax(28px,1fr) auto;align-items:center;gap:9px;border:1px solid #d4dff3;border-radius:11px}
.occupancy-domain-picker{display:block}
.occupancy-domain{display:flex;min-height:38px;align-items:center;gap:4px;color:#101d63;font-size:15px;font-weight:700;white-space:nowrap}
.occupancy-domain text{color:#007aff;font-size:14px}
.occupancy-track{position:relative;box-sizing:border-box;height:13px;min-width:28px;overflow:hidden;border-radius:8px;background:#e6e8ed}
.occupancy-segment{position:absolute;top:0;bottom:0;min-width:1px;border-radius:3px}
.occupancy-summary{min-width:0;color:#101d63;font-size:11px;font-weight:600;white-space:nowrap}
.is-disabled{opacity:.45}
.empty-state{padding:24px 8px 28px;color:var(--muted);font-size:13px;text-align:center}
.validation-note{margin:0 0 8px;padding:8px 10px;border-radius:8px;background:#fff1f0;color:#b42318;font-size:12px;line-height:1.4}
.group-list{display:flex;flex-direction:column;gap:9px}
.group-swipe-wrap{position:relative;isolation:isolate;overflow:hidden;border-radius:12px;background:transparent}
.fixture-card{position:relative;z-index:1;box-sizing:border-box;width:100%;padding:8px 9px 7px;border:1px solid #d2def4;border-radius:12px;background:var(--surface);transition:transform .2s ease,background-color .12s ease,border-color .12s ease;will-change:transform}
.fixture-card-pressed{background:var(--control)}
.fixture-card-main{display:grid;grid-template-columns:58px minmax(0,1fr) 118px;align-items:center;gap:6px}
.fixture-thumb{position:relative;box-sizing:border-box;width:58px;height:58px;overflow:hidden;border-radius:0;background-color:transparent}
.fixture-sprite{position:absolute;top:0;left:0;width:300%;height:100%}
.fixture-description{min-width:0;align-self:center}
.fixture-identity{display:flex;min-width:0;align-items:baseline;flex-wrap:nowrap;column-gap:5px;line-height:1.1;white-space:nowrap}
.fixture-name{flex-shrink:0;color:var(--text);font-size:16px;font-weight:720;white-space:nowrap}
.fixture-model{flex-shrink:0;color:#7184b7;font-size:12px;font-weight:500;white-space:nowrap}
.fixture-range{margin-top:5px;color:var(--group-color);font-size:20px;font-weight:700;line-height:1.12;overflow-wrap:anywhere;word-break:break-word}
.fixture-range-empty{color:var(--subtle);font-weight:500}
.fixture-controls{display:flex;min-width:0;flex-direction:column;align-items:stretch;gap:3px}
.fixture-control-row{display:grid;height:35px;min-height:35px;grid-template-columns:28px minmax(0,1fr);align-items:center;gap:4px}
.fixture-control-label{color:#101d63;font-size:12px;font-weight:650;white-space:nowrap}
.fixture-control-picker{display:block;min-width:0}
.fixture-control-box,.quantity-box{display:flex;box-sizing:border-box;width:100%;height:35px;min-height:35px;padding:0 6px;align-items:center;justify-content:space-between;border:1px solid #cfdbf2;border-radius:7px;color:#101d63;font-size:13px;font-weight:700;white-space:nowrap}
.quantity-box{gap:3px;padding:0 7px}
.quantity-box input{box-sizing:border-box;width:0;height:33px;min-height:33px;flex:1;padding:0;color:#101d63;font-size:15px;font-weight:700;text-align:center}
.quantity-box text{flex-shrink:0;color:#101d63;font-size:13px;font-weight:650}
.legacy-readonly{padding:10px 0;color:var(--muted);font-size:11px;text-align:center}
.address-chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}
.address-chips-preview{display:grid;grid-auto-rows:30px;gap:4px;overflow:hidden}
.address-chips-preview .chips-pending{grid-column:1/-1}
.address-chip{display:flex;box-sizing:border-box;min-width:38px;min-height:30px;padding:0 3px;align-items:center;justify-content:center;gap:2px;border:1px solid transparent;border-radius:7px;background:var(--group-tint);color:var(--group-color);font-size:12px;font-weight:650;line-height:1;white-space:nowrap;transition:background-color .12s ease,transform .12s ease}
.address-chip-preview{width:100%;min-width:0;padding:0 1px;overflow:hidden;font-size:10px}
.address-chip-preview-label{display:block;max-width:100%;overflow:hidden;white-space:nowrap;line-height:1}
.address-chip:active{transform:scale(.96)}
.address-chip-checked{border-color:var(--group-color);background:var(--group-color);color:#fff}
.chip-check{font-size:10px;font-weight:700}
.chip-guide{display:flex;width:20px;height:26px;margin-left:2px;align-items:center;justify-content:center;border-left:1px solid currentColor;font-size:9px;font-weight:650;opacity:.78}
.chips-pending{padding:4px 0;color:var(--subtle);font-size:10px}
.swipe-delete{position:absolute;z-index:0;top:0;right:0;bottom:0;display:flex;width:76px;align-items:center;justify-content:center;background:#ff3b30;color:#fff;font-size:13px;font-weight:700}
.undo-row{display:flex;min-height:38px;margin-top:7px;padding:0 3px;align-items:center;justify-content:space-between;color:var(--muted);font-size:12px}
.undo-row view{padding:8px 10px;color:var(--accent);font-weight:650}
.layout-entry{display:flex;box-sizing:border-box;min-height:60px;margin-top:11px;padding:0 13px;align-items:center;gap:14px;border:1px solid var(--line);border-radius:12px;color:var(--text);font-size:16px;font-weight:600}
.layout-entry:active{color:var(--accent)}
.layout-entry-icon{position:relative;display:flex;width:43px;height:37px;flex-shrink:0;align-items:center;justify-content:center}
.layout-map-panel{position:absolute;box-sizing:border-box;width:14px;height:27px;border:2px solid #007aff;border-radius:2px}
.layout-map-left{left:1px;top:6px;transform:skewY(-20deg)}
.layout-map-middle{left:14px;top:3px;transform:skewY(20deg)}
.layout-map-right{left:27px;top:6px;transform:skewY(-20deg)}
.layout-entry-title{color:var(--text)}
.layout-entry-arrow{margin-left:auto;color:#101d63;font-size:25px;font-weight:300}
.fixture-search-overlay,.pending-overlay,.fixture-channel-guide-overlay,.result-report-preview-overlay{position:fixed;z-index:70;top:0;right:0;bottom:0;left:0;display:flex;box-sizing:border-box;padding:var(--overlay-safe-top) 14px var(--overlay-safe-bottom);align-items:flex-end;justify-content:center;background:rgba(0,0,0,.42)}
.fixture-search-overlay,.pending-overlay,.save-project-overlay,.floating-backdrop{display:block;padding:0;background:rgba(0,0,0,.42)}
.fixture-search-sheet,.pending-sheet,.add-confirm-sheet,.save-project-sheet{position:fixed;z-index:71;left:50%;box-sizing:border-box;width:calc(100% - 28px);max-width:560px;transform:translateX(-50%);padding:16px 15px 14px;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:20px 20px 16px 16px;background:var(--surface);color:var(--text)}
.fixture-search-sheet,.pending-sheet{bottom:var(--overlay-safe-bottom);display:flex}
.fixture-search-sheet{height:var(--overlay-search-sheet-height);max-height:var(--overlay-search-max-height)}
.pending-sheet{max-height:var(--overlay-pending-max-height)}
.pending-sheet-delete{height:var(--overlay-pending-max-height)}
.fixture-channel-guide-sheet,.result-report-preview-sheet{display:flex;box-sizing:border-box;width:100%;max-width:560px;padding:16px 15px 14px;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:20px 20px 16px 16px;background:var(--surface);color:var(--text)}
.save-project-sheet{z-index:77;bottom:var(--overlay-safe-bottom);display:flex;max-height:var(--overlay-save-max-height);padding:14px 15px 12px;border-radius:18px 18px 14px 14px}
.add-confirm-sheet{top:var(--overlay-center-top);display:flex;max-height:var(--overlay-add-max-height);transform:translate(-50%,-50%);padding:12px 15px 10px;border-radius:19px}
.pending-content-scroll,.add-confirm-content-scroll{height:0;min-height:0;flex:1;overflow-y:auto}
.pending-content-scroll{margin-top:2px}
.add-confirm-content-scroll{margin-top:2px}
.add-confirm-header{display:grid;min-height:40px;flex-shrink:0;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;color:var(--text);font-size:16px;font-weight:650;text-align:center}
.add-confirm-reselect{justify-self:start;padding:7px 5px;color:#007aff;font-size:13px;font-weight:550;white-space:nowrap}
.add-confirm-header-spacer{width:68px}
.add-confirm-product{display:grid;grid-template-columns:58px minmax(0,1fr) 118px;align-items:center;gap:7px;padding:9px 0 11px;border-bottom:1px solid var(--line)}
.add-confirm-thumb{width:58px;height:58px}
.add-confirm-description{align-self:center}
.add-confirm-controls{gap:3px}
.add-preview-chip-list{min-width:0;margin-top:10px}
.add-preview-chips{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px;padding-bottom:4px}
.add-preview-chips .address-chip{width:100%;min-width:0;min-height:28px;padding:0 1px;font-size:11px}
.add-preview-total{display:flex;min-height:36px;margin-top:5px;align-items:center;justify-content:center;border-top:1px solid var(--line);color:var(--muted);font-size:12px;font-weight:600}
.sheet-title-row{display:flex;min-height:36px;flex-shrink:0;align-items:center;justify-content:space-between;color:var(--text);font-size:16px;font-weight:650}
.sheet-dismiss{display:flex;min-width:48px;height:40px;padding:0 7px;align-items:center;justify-content:center;color:var(--accent);font-size:13px;font-weight:600}
.fixture-search-content-scroll{box-sizing:border-box;width:100%;min-width:0;min-height:1px;flex:none;overflow-y:auto}
.fixture-search-box{display:flex;box-sizing:border-box;height:44px;min-height:44px;margin-top:5px;padding:0 10px;align-items:center;gap:8px;border-radius:10px;background:var(--control)}
.search-glyph{color:var(--muted);font-size:22px;line-height:1}
.fixture-search-box input{min-width:0;height:42px;flex:1;color:var(--text);font-size:14px}
.search-clear{padding:8px;color:var(--accent);font-size:12px}
.fixture-category-scroll{height:42px;min-height:42px;margin-top:7px}
.fixture-category-list{display:flex;height:42px;align-items:center;gap:6px}
.fixture-category{display:flex;height:30px;padding:0 10px;align-items:center;gap:4px;border-radius:16px;background:var(--control);color:var(--muted);font-size:11px;white-space:nowrap}
.fixture-category text{font-size:9px;opacity:.75}
.fixture-category-active{background:#007aff;color:#fff}
.fixture-search-count{height:28px;min-height:28px;color:var(--muted);font-size:11px;line-height:28px}
.fixture-search-results{height:auto;min-width:0;min-height:0;overflow:hidden}
.fixture-search-row{display:flex;box-sizing:border-box;min-width:0;min-height:82px;padding:8px 3px;align-items:center;gap:10px;border-bottom:1px solid var(--line)}
.fixture-search-thumb{position:relative;box-sizing:border-box;width:64px;height:64px;flex-shrink:0;overflow:hidden;background:transparent}
.fixture-search-row-selected{background:var(--control)}
.fixture-result-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:5px;overflow:hidden}
.fixture-result-identity{display:flex;min-width:0;align-items:baseline;flex-wrap:wrap;gap:3px 6px;white-space:normal}
.fixture-result-name{min-width:0;flex-shrink:1;color:var(--text);font-size:15px;font-weight:650;white-space:normal;overflow-wrap:anywhere}
.fixture-result-model{min-width:0;flex-shrink:1;color:var(--muted);font-size:12px;font-weight:500;white-space:normal;overflow-wrap:anywhere}
.fixture-result-modes{max-width:100%;min-width:0;color:var(--muted);font-size:10px;text-align:left;white-space:normal;overflow-wrap:anywhere}
.fixture-search-check{color:var(--accent);font-size:16px;font-weight:700}
.fixture-search-empty{padding:28px 8px;color:var(--muted);font-size:13px;text-align:center}
.pending-model{margin-top:3px;color:var(--muted);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.pending-delete-card{display:grid;box-sizing:border-box;min-width:0;margin-top:3px;padding:8px;grid-template-columns:46px minmax(0,1fr);gap:4px 9px;border:1px solid var(--line);border-radius:11px;background:var(--surface)}
.pending-delete-thumb{grid-row:1 / span 2;width:46px;height:46px}
.pending-delete-copy{display:flex;min-width:0;flex-direction:column;justify-content:center;gap:4px}
.pending-delete-identity{display:flex;min-width:0;align-items:baseline;flex-wrap:wrap;gap:3px 6px}
.pending-delete-name{color:var(--text);font-size:14px;font-weight:700;overflow-wrap:anywhere}
.pending-delete-model{color:var(--muted);font-size:10px;overflow-wrap:anywhere}
.pending-delete-quantity{color:var(--group-color);font-size:17px;font-weight:750;line-height:1.1}
.pending-delete-range{display:flex;min-width:0;grid-column:2;align-items:center;gap:5px;color:var(--muted);font-size:9px}
.pending-delete-range text:nth-child(2){min-width:0;padding:4px 6px;border-radius:6px;background:var(--group-tint);color:var(--group-color);font-size:10px;font-weight:700;overflow-wrap:anywhere}
.pending-delete-remove-label{margin-left:auto;flex-shrink:0;color:#d92d20;font-size:9px;font-weight:650}
.pending-delete-risks{display:flex;margin-top:7px;padding:0 2px;flex-direction:column;gap:3px;color:var(--muted);font-size:10px;line-height:1.35}
.pending-delete-risks text{overflow-wrap:anywhere}
.pending-delete-groups-title{margin-top:10px;padding-bottom:5px;border-bottom:1px solid var(--line);color:var(--text);font-size:12px;font-weight:700}
.pending-delete-group-row{padding:8px 1px;border-bottom:1px solid var(--line)}
.pending-delete-group-name{display:flex;min-width:0;align-items:baseline;flex-wrap:wrap;gap:3px 6px}
.pending-delete-group-name text:first-child{color:var(--text);font-size:12px;font-weight:650;overflow-wrap:anywhere}
.pending-delete-group-name text:last-child{color:var(--muted);font-size:10px;overflow-wrap:anywhere}
.pending-delete-addresses{display:grid;min-width:0;margin-top:6px;grid-template-columns:minmax(0,1fr) 16px minmax(0,1fr);align-items:center;gap:4px}
.pending-delete-address{display:flex;box-sizing:border-box;min-width:0;min-height:34px;padding:4px 6px;flex-direction:column;justify-content:center;gap:2px;border-radius:7px;background:var(--group-tint);color:var(--group-color)}
.pending-delete-address text:first-child{font-size:9px;font-weight:550}
.pending-delete-address text:last-child{font-size:10px;font-weight:700;overflow-wrap:anywhere}
.pending-delete-address-arrow{color:var(--muted);font-size:13px;text-align:center}
.pending-delete-empty{padding:12px 2px;color:var(--muted);font-size:11px}
.pending-delete-next{margin-top:6px;border-top:1px solid var(--line);font-size:11px}
.pending-delete-details{margin-top:9px}
.pending-removed-disclosure{display:flex;min-height:38px;align-items:center;justify-content:space-between;gap:8px;color:var(--text);font-size:10px;font-weight:600}
.pending-removed-disclosure text:last-child{flex-shrink:0;color:var(--accent);font-size:11px}
.pending-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
.pending-field{display:flex;min-width:0;flex-direction:column;gap:7px;color:var(--muted);font-size:11px}
.pending-picker,.pending-quantity{display:flex;box-sizing:border-box;width:100%;height:44px;min-height:44px;padding:0 11px;align-items:center;justify-content:space-between;border-radius:9px;background:var(--control);color:var(--text);font-size:14px;font-weight:600}
.pending-quantity{display:block;padding-top:10px}
.effect-preview{display:flex;min-height:67px;margin-top:16px;padding:8px 10px;align-items:center;justify-content:space-between;border:1px solid var(--line);border-radius:10px}
.effect-preview view{display:flex;min-width:0;flex-direction:column;gap:5px}
.effect-preview view text,.effect-next text:first-child{color:var(--muted);font-size:10px}
.effect-range{color:var(--text);font-size:12px;font-weight:650;overflow-wrap:anywhere}
.effect-arrow{padding:0 7px;color:var(--accent);font-size:16px}
.effect-next{display:flex;min-height:36px;align-items:center;justify-content:space-between;color:var(--text);font-size:11px}
.pending-mode-value{margin-top:12px;padding:10px 11px;border-radius:9px;background:var(--control);color:var(--text);font-size:12px;font-weight:600}
.pending-affected-list{height:auto;min-height:0;margin-top:4px;border-top:1px solid var(--line)}
.pending-affected-row{padding:8px 1px;border-bottom:1px solid var(--line)}
.pending-affected-name{color:var(--text);font-size:11px;line-height:1.4;overflow-wrap:anywhere}
.pending-affected-meta{margin-top:3px;color:var(--muted);font-size:10px;line-height:1.35}
.pending-removed-list{height:auto;min-height:0;margin-top:5px;padding:0 7px;border-radius:8px;background:var(--control)}
.pending-removed-title{padding:7px 0;color:var(--muted);font-size:10px;font-weight:600}
.pending-removed-row{display:flex;min-height:29px;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid var(--line);color:var(--text);font-size:10px}
.pending-removed-row text:first-child{min-width:0;overflow-wrap:anywhere}
.pending-removed-row text:last-child{flex-shrink:0;color:var(--muted)}
.pending-error{padding:5px 0;color:#ff3b30;font-size:11px;line-height:1.4}
.pending-confirm{display:flex;height:46px;min-height:46px;margin-top:10px;flex-shrink:0;align-items:center;justify-content:center;border-radius:10px;background:#007aff;color:#fff;font-size:14px;font-weight:650}
.pending-confirm:active{opacity:.8}
.save-project-overlay{position:fixed;z-index:76;top:0;right:0;bottom:0;left:0}
.project-save-list{height:auto;max-height:var(--overlay-save-list-max-height);min-height:0;margin-top:5px}
.project-save-row{display:flex;box-sizing:border-box;min-height:50px;padding:6px 4px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
.project-save-row view{display:flex;min-width:0;flex-direction:column;gap:3px}
.project-save-name{color:var(--text);font-size:14px;font-weight:600}
.project-save-status{color:var(--muted);font-size:10px}
.project-save-arrow{padding:8px;color:var(--muted);font-size:20px}
.new-project-entry{display:flex;min-height:44px;margin-top:7px;align-items:center;justify-content:center;border:1px solid var(--line);border-radius:9px;color:var(--accent);font-size:13px;font-weight:600}
.new-project-inline{display:flex;margin-top:10px;gap:7px}
.project-save-error{padding:8px 2px;color:#ff3b30;font-size:11px;line-height:1.4}
.save-retry-row{display:flex;min-height:38px;align-items:center;justify-content:space-between;color:#b42318;font-size:12px}
.save-retry-row view{padding:8px;color:var(--accent);font-weight:650}
.batch-footer{display:flex;box-sizing:border-box;max-height:28vh;margin-top:6px;flex-shrink:0;flex-direction:column}
.batch-selected-list{height:0;min-height:0;flex:none}
.batch-selected-row{display:flex;min-height:36px;align-items:center;justify-content:space-between;color:var(--text);font-size:11px}
.batch-quantity-control{display:flex;align-items:center;gap:12px;color:var(--accent)}
.batch-quantity-control view{display:flex;width:30px;height:32px;align-items:center;justify-content:center;font-size:16px}
.batch-confirm{display:flex;height:42px;min-height:42px;margin-top:6px;align-items:center;justify-content:center;border-radius:9px;background:#007aff;color:#fff;font-size:13px;font-weight:650}
.batch-fixture-check{color:var(--accent);font-size:17px;font-weight:700}
.floating-backdrop{position:fixed;z-index:60;inset:0;animation:backdrop-in .18s ease both}
.floating-card{position:fixed;z-index:61;display:flex;box-sizing:border-box;padding:12px 13px 8px;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:0 14px 42px rgba(0,0,0,.23);transition:left .23s cubic-bezier(.2,.8,.2,1),top .23s cubic-bezier(.2,.8,.2,1),width .23s cubic-bezier(.2,.8,.2,1),height .23s cubic-bezier(.2,.8,.2,1),border-radius .23s ease,transform .2s ease}
.floating-card-gesture-dragging{transition:none!important}
.floating-card-main{flex-shrink:0;padding-top:16px;padding-bottom:9px;border-bottom:1px solid var(--line)}
.floating-check-count{position:absolute;top:7px;right:12px;z-index:2;display:flex;min-height:20px;padding:0 7px;align-items:center;justify-content:center;border-radius:10px;background:var(--group-tint);color:var(--group-color);font-size:11px;font-weight:700}
.floating-card-meta{min-height:18px;padding-top:4px;color:var(--muted);font-size:10px;font-weight:500}
.floating-chip-scroll{height:0;min-height:0;margin-top:3px;flex:1}
.floating-chips{padding-bottom:4px}
.floating-chips .address-chip{min-width:48px;min-height:44px;padding:0 6px;font-size:14px}
.fixture-channel-guide-overlay{z-index:82}
.fixture-channel-guide-sheet{height:var(--overlay-guide-height);max-height:var(--overlay-max-height)}
.fixture-channel-guide-head{display:flex;flex-shrink:0;align-items:flex-start;justify-content:space-between;gap:10px}
.fixture-channel-guide-copy{min-width:0;flex:1}
.fixture-channel-guide-title{color:var(--text);font-size:17px;font-weight:650}
.fixture-channel-guide-meta{margin-top:5px;color:var(--muted);font-size:11px;line-height:1.3}
.fixture-channel-guide-scroll{height:0;min-height:0;margin-top:12px;flex:1}
.fixture-channel-guide-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding-bottom:8px}
.fixture-channel-guide-row{box-sizing:border-box;min-width:0;min-height:112px;padding:9px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
.fixture-channel-guide-row-head{display:grid;min-height:32px;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:4px}
.fixture-channel-guide-number,.fixture-channel-guide-address{color:var(--accent);font-size:11px;font-weight:650}
.fixture-channel-guide-address{color:var(--text)}
.fixture-channel-guide-name{margin-top:5px;color:var(--text);font-size:12px;font-weight:600;line-height:1.3;overflow-wrap:anywhere}
.fixture-channel-guide-summary{margin-top:4px;color:var(--muted);font-size:10px;line-height:1.35;overflow-wrap:anywhere}
.fixture-channel-guide-expand{display:flex;min-width:42px;height:32px;align-items:center;justify-content:center;border-radius:7px;background:var(--control);color:var(--accent);font-size:10px}
.fixture-channel-guide-expand-selected{background:#007aff;color:#fff}
.fixture-channel-guide-detail{flex-shrink:0;margin-top:8px;padding:9px;border-radius:10px;background:var(--control)}
.fixture-channel-guide-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.fixture-channel-guide-detail-copy{min-width:0;flex:1}
.fixture-channel-guide-detail-title{color:var(--accent);font-size:12px;font-weight:650}
.fixture-channel-guide-detail-name{margin-top:3px;color:var(--text);font-size:11px}
.fixture-channel-guide-detail-close{display:flex;min-width:44px;height:36px;align-items:center;justify-content:center;color:var(--accent);font-size:11px}
.fixture-channel-guide-detail-ranges{height:100px;margin-top:6px}
.fixture-channel-guide-detail-range{display:grid;grid-template-columns:74px minmax(0,1fr);gap:7px;padding:5px 0;border-bottom:1px solid var(--line);color:var(--muted);font-size:10px;line-height:1.3}
.fixture-channel-guide-source{margin-top:10px;color:var(--muted);font-size:10px;line-height:1.4}
.result-report-preview-overlay{z-index:90}
.result-report-preview-sheet{height:var(--overlay-report-height);max-height:var(--overlay-max-height)}
.result-report-preview-header{display:flex;min-height:42px;flex-shrink:0;align-items:center;justify-content:space-between}
.result-report-preview-title{color:var(--text);font-size:16px;font-weight:650}
.result-report-preview-close,.result-report-preview-action{display:flex;min-height:42px;padding:0 12px;align-items:center;justify-content:center;border:0;border-radius:9px;background:var(--control);color:var(--text);font-size:12px}
.result-report-preview-close::after,.result-report-preview-action::after{border:0}
.result-report-preview-scroll{height:0;min-height:0;margin-top:8px;flex:1;overflow:auto;border-radius:8px;background:var(--control)}
.result-report-preview-image{display:block;width:100%;height:auto}
.result-report-preview-actions{display:flex;min-height:48px;margin-top:10px;flex-shrink:0;gap:8px}
.result-report-preview-action{flex:1}
.result-report-preview-action-primary{background:#007aff;color:#fff}
.result-report-preview-action-secondary{color:var(--text)}

.main-modal-backdrop{animation:main-modal-backdrop-in 180ms ease-out both}
.main-modal-backdrop.main-modal-closing{animation:main-modal-backdrop-out 180ms ease-in both}
.main-modal-bottom-sheet{animation:main-modal-bottom-in 180ms cubic-bezier(.2,.8,.2,1) both}
.main-modal-bottom-sheet.main-modal-card-closing{animation:main-modal-bottom-out 180ms ease-in both;pointer-events:none}
.main-modal-center-sheet{animation:main-modal-center-in 180ms cubic-bezier(.2,.8,.2,1) both}
.main-modal-center-sheet.main-modal-card-closing{animation:main-modal-center-out 180ms ease-in both;pointer-events:none}
.main-modal-panel{animation:main-modal-panel-in 180ms cubic-bezier(.2,.8,.2,1) both}
.main-modal-panel.main-modal-card-closing{animation:main-modal-panel-out 180ms ease-in both;pointer-events:none}

@keyframes backdrop-in{from{opacity:0}to{opacity:1}}
@keyframes main-modal-backdrop-in{from{opacity:0}to{opacity:1}}
@keyframes main-modal-backdrop-out{from{opacity:1}to{opacity:0}}
@keyframes main-modal-bottom-in{from{opacity:0;transform:translate(-50%,12px)}to{opacity:1;transform:translate(-50%,0)}}
@keyframes main-modal-bottom-out{from{opacity:1;transform:translate(-50%,0)}to{opacity:0;transform:translate(-50%,12px)}}
@keyframes main-modal-center-in{from{opacity:0;transform:translate(-50%,-50%) translateY(12px)}to{opacity:1;transform:translate(-50%,-50%)}}
@keyframes main-modal-center-out{from{opacity:1;transform:translate(-50%,-50%)}to{opacity:0;transform:translate(-50%,-50%) translateY(12px)}}
@keyframes main-modal-panel-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes main-modal-panel-out{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(12px)}}

@media (max-width:350px){
  .page-title{left:40.5%}
  .page-content{padding-right:12px;padding-left:12px}
  .setup-row{gap:5px}
  .allocation-picker{max-width:42%;min-width:92px}
  .setup-select{padding:0 6px;font-size:13px}
  .setup-start-label{font-size:12px}
  .start-address-box{min-width:62px;padding:0 5px}
  .start-address-input{width:37px;font-size:15px}
  .add-group-button{min-width:66px;padding:0 7px;font-size:12px}
  .occupancy-strip{grid-template-columns:42px minmax(22px,1fr) auto;gap:6px;padding:7px}
  .occupancy-summary{font-size:9px}
  .fixture-card-main{grid-template-columns:42px minmax(0,1fr) 96px;gap:4px}
  .fixture-thumb{width:42px;height:42px}
  .fixture-identity{flex-wrap:nowrap;column-gap:3px;white-space:nowrap}
  .fixture-name{font-size:15px}
  .fixture-model{font-size:11px}
  .fixture-range{font-size:17px}
  .fixture-control-row{grid-template-columns:27px minmax(0,1fr);gap:2px}
  .fixture-control-label{font-size:9px}
  .fixture-control-box,.quantity-box{padding-right:3px;padding-left:3px;font-size:11px}
  .quantity-box input{font-size:13px}
  .add-confirm-product{grid-template-columns:46px minmax(0,1fr) 102px;gap:4px}
  .add-confirm-thumb{width:46px;height:46px}
  .add-confirm-description .fixture-name{font-size:14px}
  .add-confirm-description .fixture-model{font-size:10px}
  .add-confirm-product .fixture-control-row{grid-template-columns:25px minmax(0,1fr)}
  .add-confirm-product .fixture-control-label{font-size:9px}
  .add-confirm-product .fixture-control-box,.add-confirm-product .quantity-box{font-size:10px}
  .add-preview-chips .address-chip{min-width:0;min-height:27px;font-size:10px}
}

@media (max-height:360px){
  .fixture-search-sheet{padding:4px 12px}
  .fixture-search-sheet .sheet-title-row{height:34px;min-height:34px}
  .fixture-search-sheet .sheet-dismiss{height:34px;min-height:34px;padding:0 5px}
  .fixture-search-box{height:36px;min-height:36px;margin-top:2px}
  .fixture-search-box input{height:34px;min-height:34px}
  .fixture-category-scroll,.fixture-category-list{height:28px;min-height:28px;margin-top:2px}
  .fixture-category{height:24px;padding:0 8px;font-size:10px}
  .fixture-search-count{height:20px;min-height:20px;line-height:20px}
}

@media (prefers-color-scheme:dark){
  .page-root{--page-bg:#000;--surface:#111;--control:#1c1c1e;--line:#3a3a3c;--text:#fff;--muted:#c4c4c9;--subtle:#8e8e93;background:#000;color:#fff}
  .page-title,.context-selector,.setup-select,.setup-divider,.setup-start-label,.start-address-box,.start-address-input,.fixture-control-label,.fixture-control-box,.quantity-box,.quantity-box input,.quantity-box text,.occupancy-domain,.occupancy-summary{color:#fff}
  .context-row{border-color:#333}
  .occupancy-strip,.fixture-card{border-color:#30343f}
  .fixture-card{background:#111}
  .fixture-name{color:#fff}
  .fixture-model{color:#9eabd0}
  .fixture-result-model{color:var(--text)}
  .fixture-range{filter:brightness(1.15)}
  .occupancy-track{background:#28282b}
  .start-address-box,.fixture-control-box,.quantity-box{border-color:#3c4250}
  .fixture-thumb{background-color:transparent}
  .address-chip{background:var(--group-tint)}
  .context-selector,.setup-select{color:#fff}
  .layout-entry{border-color:#333;color:#fff}
  .status-error,.validation-note{background:#250e0d;color:#ff8b83}
  .save-project-submit,.add-group-button,.pending-confirm,.fixture-category-active,.fixture-channel-guide-expand-selected,.result-report-preview-action-primary{background:#007aff;color:#fff}
  .fixture-card-pressed{background:#111}
  .address-chip-checked{color:#fff}
}

.fixture-category-active,.fixture-channel-guide-expand-selected{background:#005eb8;color:#fff}
.fixture-category-active text{opacity:1}

@media (prefers-reduced-motion: reduce){
  .floating-backdrop,.floating-card,.fixture-card,.address-chip,.add-group-button{animation:none;transition:none}
  .main-modal-backdrop,.main-modal-bottom-sheet,.main-modal-center-sheet,.main-modal-panel{animation:none!important;transition:none!important}
  .fixture-card{transition:none!important}
  .fixture-card-pressed,.address-chip:active,.add-group-button:active{transform:none}
}
