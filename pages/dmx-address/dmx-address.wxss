@import "../../styles/theme-page-shared.wxss";.page-root{height:100vh}
.page-scroll{height:100vh;background:radial-gradient(circle at 94% 4%,rgba(88,86,214,.16),transparent 30%),radial-gradient(circle at 2% 28%,rgba(0,122,255,.08),transparent 26%),#f5f5f7}
.page-content{box-sizing:border-box;width:100%;padding:28rpx 32rpx calc(52rpx + env(safe-area-inset-bottom))}
.page-header{display:flex;min-height:116rpx;padding:8rpx 4rpx 16rpx;align-items:center}
.page-title{color:#1d1d1f;font-size:54rpx;font-weight:700;letter-spacing:-2rpx}
.card{margin-bottom:24rpx;padding:30rpx;border:1rpx solid #e7e7eb;border-radius:26rpx;background:#fff;box-shadow:0 9rpx 24rpx rgba(28,45,73,.07)}
.card-title,.result-title{color:#1d1d1f;font-size:34rpx;font-weight:700;line-height:1.2}
.section-head{display:flex;align-items:center;justify-content:space-between}
.group-count{padding:8rpx 13rpx;border-radius:999rpx;background:#f0f0fa;color:#5856d6;font-size:18rpx;font-weight:650}
.allocation-mode-switch,.result-view-switch{display:grid;box-sizing:border-box;grid-template-columns:repeat(2,minmax(0,1fr));height:54px;min-height:54px;gap:5px;padding:5px;border:0;border-radius:18rpx;background:var(--tc)}
.allocation-mode-switch{margin-top:18rpx}
.result-view-switch{width:100%;margin-top:0}
.allocation-mode-option,.result-view-option{display:flex;box-sizing:border-box;height:44px;min-height:44px;padding:0 8rpx;align-items:center;justify-content:center;border:0;border-radius:14rpx;background:var(--tc);color:var(--ts);font-size:22rpx;font-weight:650;text-align:center;transition:background-color .14s ease,color .14s ease,transform .14s ease}
.allocation-mode-option:active,.result-view-option:active{transform:scale(.98)}
.allocation-mode-option-active,.result-view-option-active{background:var(--as);box-shadow:0 3rpx 10rpx rgba(0,0,0,.08);color:var(--ta)}
.field-label{color:#696970;font-size:21rpx;font-weight:560}
.input-shell{display:flex;box-sizing:border-box;min-height:86rpx;margin-top:10rpx;padding:0 20rpx;align-items:center;border:1rpx solid transparent;border-radius:18rpx;background:#f2f2f7}
.input-unit{color:var(--ts);font-size:22rpx;font-weight:650}
.number-input{min-width:0;height:44px;min-height:44px;flex:1;color:#1d1d1f;font-size:29rpx;font-weight:650}
.start-address-row{display:flex;align-items:flex-end;gap:18rpx;margin-top:18rpx}
.start-address-copy{min-width:0;flex:1;padding-bottom:5rpx}
.start-address-note{margin-top:6rpx;color:#8e8e93;font-size:18rpx;line-height:1.35}
.start-address-input{width:230rpx;min-height:44px;height:44px;flex:0 0 230;margin-top:0}
.start-address-input .number-input{height:44px;font-size:25rpx;font-weight:500}
.group-list-head{display:flex;align-items:center;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #e5e5ea}
.group-editor-grid{margin-top:12rpx;border-top:1rpx solid #e5e5ea}
.groups-card{padding:26rpx}
.group-editor-summary{display:flex;box-sizing:border-box;min-height:104rpx;padding:17rpx 4rpx;align-items:center;gap:16rpx;border-bottom:1rpx solid #e5e5ea;transition:background-color .12s ease,transform .12s ease}
.group-editor-summary-pressed{background:#f2f7ff;transform:scale(.99)}
.group-summary-index{width:38rpx;color:#8e8e93;font-size:18rpx;font-weight:650;text-align:center}
.group-summary-copy{min-width:0;flex:1}
.group-summary-name{overflow:hidden;color:#1d1d1f;font-size:24rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.group-summary-meta{margin-top:7rpx;color:var(--ts);font-size:19rpx;line-height:1.3}
.group-summary-edit{display:flex;min-width:88rpx;height:68rpx;align-items:center;justify-content:flex-end;color:var(--ta);font-size:19rpx;font-weight:650}
.group-summary-edit text{margin-left:4rpx;color:#8e8e93;font-size:30rpx;line-height:1}
.channel-mode-picker{display:block;width:100%}
.universe-picker{display:block;width:100%}
.add-button{display:grid;box-sizing:border-box;width:100%;min-height:44px;height:44px;margin:16rpx 0 0;padding:0 18rpx;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;border:0;border-radius:20rpx;background:var(--as);color:var(--ta);font-size:23rpx;font-weight:650;line-height:1;transition:background-color .14s ease,border-color .14s ease,opacity .14s ease,transform .14s ease}
.add-button-copy{display:flex;grid-column:2;align-items:center;justify-self:center}
.add-button-plus{margin-right:8rpx;font-size:28rpx;line-height:1}
.add-button-arrow{grid-column:3;margin-left:18rpx;font-size:34rpx;font-weight:400;justify-self:end;line-height:1}
.add-button-pressed{background:var(--as);opacity:.72;transform:scale(.98)}
.error-card{margin-bottom:24rpx;padding:25rpx 28rpx;border-radius:23rpx}
.error-card{border:1rpx solid #ffb7b3;background:#fff2f2}
.error-title{color:#b42318;font-size:26rpx;font-weight:680}
.error-text{margin-top:9rpx;color:#7a271a;font-size:21rpx;line-height:1.55}
.result-card{margin-bottom:24rpx;padding:29rpx;border:1rpx solid #e7e7eb;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(28,45,73,.08)}
.result-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.result-top-meta{display:flex;flex-shrink:0;align-items:center;gap:8rpx}
.result-mode-badge{padding:5rpx 11rpx;border-radius:999rpx;background:#efefff;color:#5856d6;font-size:16rpx;font-weight:650}
.result-count{flex-shrink:0;padding:8rpx 14rpx;border-radius:999rpx;background:#f2f2f7;color:#6e6e73;font-size:18rpx;font-weight:620}
.result-warnings{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #e5e5ea}
.result-warning{margin-top:7rpx;color:#6e6e73;font-size:18rpx;line-height:1.5}
.result-domain-section{margin-top:18rpx}
.universe-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:18rpx}
.universe-tab{box-sizing:border-box;min-width:0;min-height:44px;padding:15rpx 12rpx 12rpx;border:0;border-radius:18rpx;background:var(--tc);transition:background-color .14s ease,border-color .14s ease,transform .14s ease}
.universe-tab:active{transform:scale(.98)}
.universe-tab-active{background:var(--as)}
.universe-tab-label{color:var(--tx);font-size:24rpx;font-weight:680}
.universe-tab-active .universe-tab-label{color:var(--ta)}
.universe-tab-active .universe-tab-progress{background:var(--theme-accent)}
.universe-tab-meta{margin-top:5rpx;color:#8e8e93;font-size:20rpx;line-height:1.35;white-space:normal}
.universe-tab-track{overflow:hidden;height:5rpx;margin-top:10rpx;border-radius:999rpx;background:var(--td)}
.universe-tab-progress{height:100%;border-radius:inherit;background:#7775ef}
.selected-universe{margin-top:18rpx;padding:23rpx;border:1rpx solid #e5e5ea;border-radius:22rpx;background:#fafafd}
.group-result-tabs{box-sizing:border-box;width:100%;height:122rpx;margin-top:18rpx;white-space:nowrap}
.group-result-tab-list{display:inline-flex;gap:10rpx;min-width:100%;padding-right:8rpx;box-sizing:border-box}
.group-result-tab{box-sizing:border-box;width:205rpx;min-width:205rpx;padding:14rpx 15rpx;border:0;border-radius:17rpx;background:var(--tc)}
.group-result-tab-active{background:var(--as)}
.group-result-tab-index{color:#007aff;font-size:15rpx;font-weight:700}
.group-result-tab-name{overflow:hidden;margin-top:4rpx;color:#1d1d1f;font-size:18rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.group-result-tab-meta{margin-top:5rpx;color:#8e8e93;font-size:14rpx}
.selected-group-address{display:flex;gap:16rpx;padding:16rpx 18rpx;border:1rpx solid rgba(88,86,214,.16);border-radius:17rpx;background:#f3f2ff;align-items:center;justify-content:space-between}
.selected-group-address-label{flex-shrink:0;color:#8e8e93;font-size:18rpx}
.selected-group-address-value{overflow:hidden;color:#5856d6;font-size:27rpx;font-weight:720;text-align:right;text-overflow:ellipsis;white-space:nowrap}
.universe-group-table{margin-top:0}
.universe-group-row{display:grid;grid-template-columns:minmax(0,1.35fr) .55fr minmax(0,1fr);gap:12rpx;padding:16rpx 4rpx;align-items:center;border-bottom:1rpx solid #e5e5ea;color:#6e6e73;font-size:18rpx}
.universe-group-row:last-child{border-bottom:0}
.universe-group-head{padding-top:0;color:#8e8e93;font-size:16rpx}
.universe-group-name{min-width:0;color:#1d1d1f;font-weight:650}
.universe-group-name view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.universe-group-name text{display:block;margin-top:4rpx;color:#8e8e93;font-size:15rpx;font-weight:500}
.universe-group-range{color:#5856d6;font-weight:650;text-align:right}
.universe-empty{margin-top:19rpx;padding:20rpx;border-radius:16rpx;background:#f2f2f7;color:#6e6e73;font-size:18rpx;line-height:1.5}
.universe-detail-toggle{display:grid;box-sizing:border-box;width:100%;min-height:44px;height:44px;margin:18rpx 0 0;padding:0 24rpx;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;border:0;border-radius:20rpx;background:var(--as);color:var(--ta);font-size:23rpx;font-weight:650;line-height:1;transition:background-color .14s ease,border-color .14s ease,opacity .14s ease,transform .14s ease}
.detail-toggle-label{grid-column:2;justify-self:center}
.universe-detail-toggle:active{background:var(--as);opacity:.72;transform:scale(.98)}
.detail-toggle-trailing{display:flex;grid-column:3;align-items:center;color:#5d8fca;font-size:21rpx;font-weight:600;justify-self:end}
.detail-toggle-arrow{margin-left:12rpx;color:#007aff;font-size:32rpx;font-weight:400}
.universe-detail-overlay{position:fixed;z-index:52;top:0;right:0;bottom:0;left:0;display:flex;padding:110rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(18,18,24,.34)}
.universe-detail-sheet{display:flex;box-sizing:border-box;width:100%;height:86vh;max-height:86vh;flex-direction:column;overflow:hidden;padding:13rpx 25rpx calc(20rpx + env(safe-area-inset-bottom));border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:#fbfbfd;box-shadow:0 24rpx 70rpx rgba(25,25,35,.22)}
.universe-detail-handle{width:70rpx;height:8rpx;margin:0 auto 17rpx;border-radius:999rpx;background:#d3d3d9}
.universe-detail-head{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding-bottom:14rpx;border-bottom:1rpx solid #e8e8ed}
.universe-detail-copy{min-width:0;flex:1}
.universe-detail-title{color:#1d1d1f;font-size:34rpx;font-weight:710}
.universe-detail-summary{margin-top:6rpx;color:#85858b;font-size:21rpx}
.universe-detail-progress-text{color:#3a3a40;font-weight:650}
.universe-detail-actions{display:flex;flex-shrink:0;align-items:center;gap:8px}
.universe-detail-close{display:flex;width:44px;height:44px;min-height:44px;min-width:44px;flex-shrink:0;align-items:center;justify-content:center;border:0;border-radius:999rpx;background:var(--tc);color:var(--ts);font-size:34rpx}
.universe-detail-close:active{opacity:.58}
.fixture-progress-clear{display:flex;min-height:44px;height:44px;box-sizing:border-box;align-items:center;padding:0 15rpx;border:0;border-radius:999rpx;background:#f0f0f4;color:#ff3b30;font-size:18rpx;font-weight:650}
.fixture-progress-clear:active{opacity:.55}
.fixture-progress-clear-disabled{color:#b7b7bd}
.fixture-progress-track{height:8rpx;overflow:hidden;margin-top:12rpx;border-radius:999rpx;background:#e8e8ed}
.fixture-progress-fill{height:100%;border-radius:inherit;background:#34c759;transition:width .2s ease}
.fixture-progress-hint{margin-top:7rpx;color:#8e8e93;font-size:17rpx;line-height:1.45}
.universe-detail-scroll{box-sizing:border-box;height:0;min-height:0;flex:1;padding-top:18rpx}
.universe-fixture-group-list{padding-bottom:10rpx}
.fixture-load-more{padding:18rpx 12rpx 24rpx;color:#8e8e93;font-size:18rpx;line-height:1.45;text-align:center}
.universe-fixture-group{margin-bottom:14rpx;padding:14rpx;border:1rpx solid;border-color:var(--gs);border-radius:20rpx;background:var(--gb)}
.universe-fixture-group:last-child{margin-bottom:0}
.universe-fixture-group-head{display:flex;min-width:0;align-items:flex-start;justify-content:space-between;gap:12rpx}
.universe-fixture-group-copy{min-width:0;flex:1}
.universe-fixture-group-badge{display:inline-flex;padding:7rpx 11rpx;border-radius:999rpx;color:#fff;font-size:17rpx;font-weight:700}
.universe-fixture-group-name{overflow:hidden;margin-top:8rpx;color:#2d2d33;font-size:22rpx;font-weight:680;text-overflow:ellipsis;white-space:nowrap}
.universe-fixture-group-meta{flex-shrink:0;padding-top:5rpx;color:#77777f;font-size:18rpx;font-weight:600}
.universe-fixture-group .universe-fixture-list{margin-top:12rpx;padding-bottom:0}
.universe-fixture-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7rpx;padding-bottom:10rpx}
.universe-fixture-row{display:block;min-width:0;padding:12rpx 6rpx;border:1rpx solid #e7e7ec;border-radius:14rpx;background:#f5f5f8;text-align:center;transition:background .16s ease,border-color .16s ease,transform .12s ease}
.universe-fixture-row:active{transform:scale(.97)}
.universe-fixture-row-grouped{background:rgba(255,255,255,.82)}
.universe-fixture-row-selected{border-color:#34c759;background:#e9f8ee;box-shadow:inset 0 0 0 1rpx rgba(52,199,89,.26),0 4rpx 10rpx rgba(52,199,89,.12)}
.universe-fixture-row-head{display:flex;min-width:0;align-items:center;justify-content:center;gap:5rpx}
.universe-fixture-name{overflow:hidden;color:#3f3f45;font-size:20rpx;font-weight:600;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.fixture-selection-check{display:flex;width:24rpx;height:24rpx;flex:0 0 24rpx;align-items:center;justify-content:center;border:0;border-radius:999rpx;background:#f7f7f9;color:transparent;font-size:16rpx;font-weight:800;line-height:1}
.fixture-selection-check-active{background:#34c759;color:#fff}
.universe-fixture-body{display:flex;min-width:0;align-items:center;gap:6rpx}
.universe-fixture-address{min-width:0;flex:1;margin-top:7rpx;color:#1d1d1f;font-size:30rpx;font-weight:720;text-align:center}
.universe-fixture-address text{display:block;min-width:0;overflow:hidden;margin-top:4rpx;color:#1d1d1f;font-size:17rpx;font-weight:560;line-height:1.35;text-align:center;text-overflow:ellipsis;white-space:nowrap}
.universe-fixture-row-selected .universe-fixture-address{color:#1d1d1f}
.dmx-solution-actions{box-sizing:border-box;margin-bottom:22rpx;padding:24rpx;border:1rpx solid rgba(29,29,31,.06);border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(25,70,120,.07)}
.dmx-solution-actions-head{margin-bottom:18rpx}
.dmx-solution-actions-title{color:#1d1d1f;font-size:29rpx;font-weight:700;line-height:1.2}
.page-content button{box-sizing:border-box;margin-left:0;margin-right:0}

.result-image-button{border:0;background:var(--tp);color:#fff}
.copy-result-button{border:0;background:var(--tc);color:var(--ta)}
.group-editor-overlay{position:fixed;z-index:60;top:0;right:0;bottom:0;left:0;display:flex;padding:80rpx 0 env(safe-area-inset-bottom);align-items:flex-end;background:rgba(18,18,24,.34)}
.group-editor-sheet{display:flex;box-sizing:border-box;width:100%;max-height:88vh;padding:26rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));flex-direction:column;border:1rpx solid rgba(255,255,255,.88);border-radius:30rpx 30rpx 0 0;background:rgba(250,250,252,.98);box-shadow:0 -20rpx 70rpx rgba(15,15,25,.22)}
.group-editor-sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.group-editor-sheet-title{color:#1d1d1f;font-size:30rpx;font-weight:700}
.group-editor-close{display:flex;width:44px;height:44px;min-width:44px;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--tc);color:var(--ts);font-size:34rpx}
.group-editor-scroll{min-height:0;height:58vh;max-height:58vh;margin-top:16rpx;flex:1}
.group-editor-source-switch{display:grid;box-sizing:border-box;height:54px;min-height:54px;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;padding:5px;border-radius:17rpx;background:var(--tc)}
.group-editor-source-option{display:flex;box-sizing:border-box;height:44px;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:13rpx;color:var(--ts);font-size:20rpx;font-weight:650}
.group-editor-source-option-active{background:var(--as);color:var(--ta);box-shadow:0 3rpx 10rpx rgba(0,0,0,.08)}
.group-editor-field{min-width:0;margin-top:20rpx}
.group-editor-field-label{margin-bottom:8rpx;color:#696970;font-size:20rpx;font-weight:560}
.group-editor-fixture-select{display:flex;box-sizing:border-box;height:44px;min-height:44px;padding:0 18rpx;align-items:center;border:0;border-radius:18rpx;background:var(--tc)}
.group-editor-fixture-select-pressed{background:var(--as);transform:scale(.985)}
.group-editor-fixture-copy{min-width:0;flex:1}
.group-editor-fixture-model{overflow:hidden;color:var(--tx);font-size:23rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.group-editor-fixture-name{overflow:hidden;margin-top:5rpx;color:var(--ts);font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}
.group-editor-arrow{margin-left:8rpx;color:var(--ta);font-size:30rpx;line-height:1}
.group-editor-custom-input{box-sizing:border-box;width:100%;height:44px;min-height:44px;padding:0 18rpx;border:0;border-radius:18rpx;background:var(--tc);color:var(--tx);font-size:23rpx}
.group-editor-input-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}
.group-editor-input-shell{display:flex;box-sizing:border-box;height:44px;min-height:44px;padding:0 18rpx;align-items:center;border:0;border-radius:18rpx;background:var(--tc);color:var(--ts);font-size:21rpx;font-weight:620}
.group-editor-picker-shell{justify-content:space-between;color:#1d1d1f}
.group-editor-number-input{min-width:0;height:44px;min-height:44px;flex:1;color:#1d1d1f;font-size:27rpx;font-weight:650}
.group-editor-actions{display:grid;grid-template-columns:1fr 1.3fr;gap:14rpx;margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #e5e5ea}
.group-editor-delete,.group-editor-done{display:flex;box-sizing:border-box;height:88rpx;margin:0;align-items:center;justify-content:center;border-radius:20rpx;font-size:22rpx;font-weight:650;line-height:1}
.group-editor-delete{border:0;background:var(--tc);color:var(--tg)}
.group-editor-done{border:0;background:var(--tp);color:#fff}
.group-editor-delete:active,.group-editor-done:active{opacity:.72;transform:scale(.99)}
.fixture-search-overlay{position:fixed;z-index:70;top:0;right:0;bottom:0;left:0;display:flex;padding:110rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(18,18,24,.34)}
.fixture-search-sheet{box-sizing:border-box;width:100%;max-height:78vh;padding:27rpx 25rpx 22rpx;border:1rpx solid rgba(255,255,255,.88);border-radius:30rpx;background:rgba(250,250,252,.96);box-shadow:0 28rpx 70rpx rgba(15,15,25,.22)}
.fixture-search-head{display:flex;align-items:flex-start;justify-content:space-between}
.fixture-search-title{color:var(--tx);font-size:30rpx;font-weight:700}
.workspace-switch{display:grid;box-sizing:border-box;width:100%;height:54px;min-height:54px;margin:20rpx 0 16rpx;padding:5px;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;border:0;border-radius:20rpx;background:var(--tc)}
.workspace-option{display:flex;box-sizing:border-box;height:44px;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--tc);color:var(--ts);font-size:23rpx;font-weight:650;transition:background-color .12s ease,color .12s ease,box-shadow .12s ease,transform .12s ease}
.workspace-option-active{background:var(--as);color:var(--ta);box-shadow:0 4rpx 14rpx rgba(0,0,0,.08)}
.workspace-option:active{transform:scale(.98)}
.workspace-panel{margin-top:0}
.workspace-error-card{margin-top:0}
.fixture-batch-overlay{z-index:72}
.fixture-batch-sheet{max-height:86vh}
.fixture-batch-results{max-height:36vh}
.batch-fixture-check{display:flex;width:44px;height:44px;min-width:44px;min-height:44px;margin-left:12rpx;align-items:center;justify-content:center;border:0;border-radius:50%;color:var(--ts);font-size:27rpx;font-weight:700}
.batch-fixture-check-active{background:var(--theme-accent);color:#fff}
.batch-selected-list{max-height:18vh;margin-top:12rpx;padding:10rpx 14rpx;overflow-y:auto;border-radius:17rpx;background:var(--tc)}
.batch-selected-title{margin-bottom:7rpx;color:#6e6e73;font-size:18rpx;font-weight:650}
.batch-selected-row{display:flex;min-height:68rpx;align-items:center;justify-content:space-between;gap:12rpx;border-bottom:1rpx solid var(--td)}
.batch-selected-row:last-child{border-bottom:0}
.batch-selected-copy{display:flex;min-width:0;flex-direction:column;gap:3rpx}
.batch-selected-copy text:first-child{overflow:hidden;color:var(--tx);font-size:20rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.batch-selected-copy text:last-child{overflow:hidden;color:#8e8e93;font-size:17rpx;text-overflow:ellipsis;white-space:nowrap}
.batch-quantity-control{display:flex;flex-shrink:0;min-width:164rpx;height:44px;min-height:44px;align-items:center;justify-content:space-between;border-radius:16rpx;background:var(--tv);color:var(--tx);font-size:21rpx;font-weight:650}
.batch-quantity-button{display:flex;width:44px;height:44px;min-width:44px;min-height:44px;align-items:center;justify-content:center;color:#007aff;font-size:32rpx}
.batch-quantity-button:active{opacity:.6}
.batch-search-footer{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:12rpx;margin-top:14rpx;align-items:center}
.batch-custom-entry,.batch-confirm-button{display:flex;box-sizing:border-box;width:100%;height:44px;min-height:44px;margin:0;padding:0 12rpx;align-items:center;justify-content:center;border-radius:20rpx;font-size:20rpx;font-weight:650;line-height:1.2;text-align:center}
.batch-custom-entry{border:0;background:var(--as);color:var(--ta)}
.batch-confirm-button{border:0;background:var(--tp);color:#fff}
.batch-confirm-button[disabled]{background:var(--tmm);color:var(--tt)}
.batch-custom-entry:active,.batch-confirm-button:not([disabled]):active{opacity:.72;transform:scale(.98)}
.fixture-search-close{display:flex;width:44px;height:44px;min-height:44px;min-width:44px;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--tc);color:var(--ts);font-size:34rpx}
.fixture-search-box{display:flex;box-sizing:border-box;height:44px;min-height:44px;margin-top:20rpx;padding:0 19rpx;align-items:center;border:0;border-radius:19rpx;background:var(--tv)}
.fixture-search-icon{margin-right:11rpx;color:#8e8e93;font-size:31rpx}
.fixture-search-input{height:44px;min-height:44px;flex:1;border:0;color:#1d1d1f;font-size:22rpx}
.fixture-category-scroll{box-sizing:border-box;width:100%;height:72rpx;margin-top:15rpx;white-space:nowrap}
.fixture-category-list{display:inline-flex;min-width:100%;gap:9rpx;padding-right:8rpx;box-sizing:border-box}
.fixture-category-chip{display:inline-flex;box-sizing:border-box;height:44px;min-height:44px;flex-shrink:0;gap:8rpx;padding:0 17rpx;align-items:center;border:0;border-radius:999rpx;background:var(--tc);color:var(--ts);font-size:18rpx;font-weight:620;transition:background-color .12s ease,border-color .12s ease,color .12s ease,transform .12s ease}
.fixture-category-chip-active{background:var(--theme-primary-fill);color:#fff}
.fixture-category-chip-pressed{transform:scale(.94)}
.fixture-category-count{color:var(--ts);font-size:16rpx;font-weight:600}
.fixture-category-chip-active .fixture-category-count{color:#fff}
.fixture-search-count{margin:13rpx 3rpx 9rpx;color:#8e8e93;font-size:17rpx}
.fixture-search-results{max-height:52vh}
.fixture-search-row{display:flex;min-height:64rpx;padding:15rpx 4rpx;align-items:center;border-bottom:1rpx solid var(--td);background:var(--tv)}
.fixture-search-row:last-child{border-bottom:0}
.fixture-search-row-selected{background:transparent}
.fixture-search-row:active{background:rgba(0,122,255,.07)}
.fixture-search-row-pressed{background:rgba(0,122,255,.11)}
.fixture-search-row-main{min-width:0;flex:1}
.fixture-search-model{color:var(--tx);font-size:22rpx;font-weight:680}
.fixture-search-name{overflow:hidden;margin-top:5rpx;color:var(--ts);font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}
.fixture-search-modes{max-width:230rpx;margin-left:15rpx;color:var(--ta);font-size:17rpx;font-weight:620;line-height:1.4;text-align:right}
.fixture-search-check{margin-left:11rpx;color:#34c759;font-size:23rpx;font-weight:750}
.fixture-search-empty{padding:55rpx 20rpx;color:#8e8e93;font-size:20rpx;text-align:center}
.fixture-channel-guide-button{display:flex;min-width:88rpx;height:88rpx;margin-top:-14rpx;margin-bottom:-14rpx;align-items:center;justify-content:center;position:relative;color:transparent;font-size:17rpx;font-weight:650}
.fixture-channel-guide-button::after{content:'通道';display:flex;width:72rpx;height:42rpx;align-items:center;justify-content:center;border:0;border-radius:12rpx;background:var(--as);color:var(--ta)}
.fixture-channel-guide-overlay{position:fixed;z-index:82;top:0;right:0;bottom:0;left:0;display:flex;padding:90rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(18,18,24,.36)}
.fixture-channel-guide-sheet{display:flex;box-sizing:border-box;width:100%;height:82vh;max-height:82vh;padding:24rpx 25rpx calc(20rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:#fbfbfd;box-shadow:0 24rpx 70rpx rgba(25,25,35,.22)}
.fixture-channel-guide-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}
.fixture-channel-guide-copy{min-width:0;flex:1}
.fixture-channel-guide-title{color:var(--tx);font-size:30rpx;font-weight:710}
.fixture-channel-guide-meta{margin-top:6rpx;overflow:hidden;color:var(--ts);font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}
.fixture-channel-guide-close{display:flex;width:44px;height:44px;min-height:44px;min-width:44px;flex-shrink:0;align-items:center;justify-content:center;border:0;border-radius:999rpx;background:var(--tc);color:var(--ts);font-size:34rpx}
.fixture-channel-guide-scroll{height:0;min-height:0;margin-top:16rpx;flex:1}
.fixture-channel-guide-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx;padding-bottom:8rpx}
.fixture-channel-guide-row{box-sizing:border-box;width:100%;height:138rpx;min-width:0;padding:13rpx 12rpx;overflow:hidden;border:1rpx solid var(--td);border-radius:16rpx;background:var(--tc)}
.fixture-channel-guide-row-head{display:grid;min-height:48rpx;grid-template-columns:55rpx minmax(0,1fr) auto;align-items:center;gap:6rpx}
.fixture-channel-guide-number{min-width:0;color:var(--theme-accent);font-size:18rpx;font-weight:700}
.fixture-channel-guide-address{min-width:0;color:var(--tx);font-size:18rpx;font-weight:700}
.fixture-channel-guide-name{min-width:0;margin-top:7rpx;overflow:hidden;color:var(--tx);font-size:22rpx;font-weight:650;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.fixture-channel-guide-expand{display:flex;box-sizing:border-box;min-width:68rpx;width:68rpx;height:48rpx;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:12rpx;background:var(--as);color:var(--ta);font-size:17rpx;font-weight:620}
.fixture-channel-guide-expand-selected{background:var(--theme-primary-fill);color:#fff}
.fixture-channel-guide-summary{margin-top:5rpx;overflow:hidden;color:var(--ts);font-size:17rpx;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}
.fixture-channel-guide-detail{box-sizing:border-box;flex-shrink:0;margin-top:10rpx;padding:12rpx;border:1rpx solid var(--td);border-radius:16rpx;background:var(--as)}
.fixture-channel-guide-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}
.fixture-channel-guide-detail-copy{min-width:0;flex:1}
.fixture-channel-guide-detail-title{color:var(--ta);font-size:19rpx;font-weight:700}
.fixture-channel-guide-detail-name{margin-top:4rpx;overflow:hidden;color:var(--tx);font-size:20rpx;font-weight:650;text-overflow:ellipsis;white-space:nowrap}
.fixture-channel-guide-detail-close{display:flex;box-sizing:border-box;min-width:44px;width:44px;height:44px;min-height:44px;align-items:center;justify-content:center;border:0;border-radius:11rpx;background:var(--as);color:var(--ta);font-size:17rpx}
.fixture-channel-guide-detail-ranges{box-sizing:border-box;height:122rpx;margin-top:8rpx;padding:0 10rpx;border-radius:10rpx;background:var(--tv)}
.fixture-channel-guide-detail-range{display:grid;grid-template-columns:104rpx minmax(0,1fr);gap:12rpx;padding:7rpx 0;border-bottom:1rpx solid var(--td);color:var(--ts);font-size:17rpx;line-height:1.35}
.fixture-channel-guide-detail-range:last-child{border-bottom:0}
.fixture-channel-guide-detail-range text:first-child{min-width:104rpx;color:var(--tx);font-weight:650}
.fixture-channel-guide-source{margin-top:13rpx;color:var(--ts);font-size:17rpx;line-height:1.45}
.dmx-layout-entry-button{display:grid;box-sizing:border-box;width:100%;min-height:94rpx;margin:0;padding:16rpx 22rpx;grid-template-columns:58rpx minmax(0,1fr) 58rpx;align-items:center;border:0;border-radius:22rpx;background:var(--tc);box-shadow:none;text-align:left}
.dmx-layout-entry-button:active,.dmx-layout-entry-button-pressed{background:var(--as);opacity:.72;transform:scale(.99)}
.dmx-layout-entry-title{color:var(--tx);font-size:25rpx;font-weight:650;line-height:1.2;text-align:center}
.dmx-layout-entry-icon{display:flex;grid-column:1;flex:0 0 58rpx;width:58rpx;height:58rpx;align-items:center;justify-content:center;border-radius:18rpx;background:var(--as);color:var(--ta);font-size:25rpx;font-weight:700;line-height:1}
.dmx-layout-entry-copy{grid-column:2;min-width:0;text-align:center}
.dmx-layout-entry-arrow{grid-column:3;color:var(--ta);font-size:38rpx;font-weight:400;justify-self:end}


@media (prefers-color-scheme: dark){.page-root,.page-scroll{background:var(--theme-page-bg);color:var(--tx)}
.groups-card,.group-editor-sheet,.fixture-search-sheet,.fixture-channel-guide-sheet,.universe-detail-sheet,.result-report-preview-sheet,.dmx-solution-actions{border-color:var(--td);background:var(--tv);color:var(--tx)}
.fixture-search-sheet .fixture-search-row,.fixture-channel-guide-sheet .fixture-channel-guide-row,.fixture-channel-guide-sheet .fixture-channel-guide-detail-ranges,.universe-detail-sheet .universe-fixture-row,.result-report-preview-title,.result-report-preview-scroll{border-color:var(--td);background:var(--tc);color:var(--tx)}
.fixture-search-sheet input,.group-editor-input-shell input{border:0;background:var(--tc);color:var(--tx)}
.result-report-preview-close,.result-report-preview-action-secondary{border:0;background:var(--tc);color:var(--tx)}
.group-editor-input-shell{border:0;background:var(--tc);color:var(--tx)}
page .universe-fixture-name.universe-fixture-name,page .universe-fixture-address.universe-fixture-address,page .universe-fixture-address text,page .group-editor-custom-input.group-editor-custom-input,page .group-summary-name.group-summary-name,page .group-editor-sheet-title.group-editor-sheet-title{color:var(--tx)}
page .group-editor-custom-input.group-editor-custom-input{background:var(--tc);border:0;border-color:var(--theme-divider);color:var(--tx)}
page .group-editor-field-label.group-editor-field-label{color:var(--ts)}
page .fixture-channel-guide-expand-selected.fixture-channel-guide-expand-selected{border:0;background:var(--tc);color:var(--ta)}
page .fixture-channel-guide-number.fixture-channel-guide-number{color:var(--ta)}
}

@media (prefers-color-scheme: dark){page .group-editor-summary.group-editor-summary-pressed{background:var(--as)}
page .group-editor-fixture-select.group-editor-fixture-select-pressed,page .group-editor-fixture-select:active{background:var(--as);color:var(--tx)}
page .fixture-search-row:active,page .fixture-search-row.fixture-search-row-pressed,page .fixture-search-row.fixture-search-row-selected{background:var(--as);color:var(--tx)}
page .group-editor-picker-shell:active{background:var(--tc);color:var(--tx)}
page .selected-universe{border-color:var(--td);background:var(--tv);color:var(--tx)}
page .selected-group-address{border-color:var(--td);background:var(--tc)}
page .result-mode-badge{background:var(--as);color:var(--ta)}
page .result-count{background:var(--tc);color:var(--ts)}
page .group-result-tab-name,page .universe-group-name,page .universe-fixture-group-name{color:var(--tx)}
page .group-result-tab-meta,page .universe-group-row,page .universe-group-name text,page .universe-fixture-group-meta{color:var(--ts)}
page .selected-group-address-label{color:var(--ts)}
page .selected-group-address-value,page .universe-group-range{color:var(--ta)}
page .universe-fixture-group{border-color:var(--td);background:var(--tv)}
page .group-result-tab-index{color:var(--ta)}
page .universe-tab-meta{color:var(--ts)}
page .universe-empty{background:var(--tc);color:var(--ts)}
page .universe-detail-title,page .universe-detail-summary,page .dmx-solution-actions-title{color:var(--tx)}
page .fixture-selection-check{border:0;border-color:#74747a;background:var(--tc);color:transparent}
page .universe-detail-sheet .universe-fixture-row{border-color:#74747a;background:var(--tc)}
page .universe-detail-sheet .universe-fixture-address{background:transparent}
page .universe-detail-sheet .universe-fixture-row-selected{border-color:var(--ty);background:#17382a}
page .universe-detail-progress-text{color:var(--tx)}
page .fixture-progress-clear{border:0;background:var(--tc);color:var(--ts)}
page .detail-toggle-trailing{color:var(--ts)}
page .detail-toggle-arrow{color:var(--ta)}
page .fixture-selection-check-active{border:0;background:#1f744c;color:#fff}
.universe-group-row,.universe-detail-head{border-color:var(--td)}
.fixture-progress-track{background:var(--td)}
}


.error-return-button{display:flex;box-sizing:border-box;height:44px;min-height:44px;margin:18rpx 0 0;padding:0 20rpx;align-items:center;justify-content:center;border:0;border-radius:18rpx;background:var(--as);color:var(--ta);font-size:22rpx;font-weight:650}

@media (max-width:350px){.universe-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}
}

.group-editor-close{width:44px;height:44px;min-width:44px;min-height:44px}
.group-editor-source-option,.group-editor-fixture-select,.group-editor-delete,.group-editor-done,.result-view-option,.universe-detail-toggle,.dmx-layout-entry-button{min-height:44px}
