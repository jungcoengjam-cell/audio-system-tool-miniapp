@import "../../styles/theme-page-shared.wxss";.page{height:100vh;background:radial-gradient(circle at 92% 0,rgba(0,122,255,.1),transparent 29%),#f5f5f7}
.content{box-sizing:border-box;min-height:100%;padding:24rpx 28rpx calc(64rpx + env(safe-area-inset-bottom))}
.hero,.card{border:1rpx solid #e6e6ea;border-radius:28rpx;background:#fff;box-shadow:0 9rpx 25rpx rgba(28,45,73,.065)}
.hero{padding:27rpx;border-color:#dbeaff;background:#f2f7ff}
.title{margin-top:9rpx;color:#1d1d1f;font-size:42rpx;font-weight:720}
.product-name{margin-top:5rpx;color:#34343a;font-size:22rpx}
.meta{margin-top:15rpx;color:#6e6e73;font-size:17rpx;line-height:1.45}
.card{margin-top:20rpx;padding:25rpx}
.section-title{color:#1d1d1f;font-size:29rpx;font-weight:680}
.modes{display:flex;flex-wrap:wrap;gap:6px;margin-top:17rpx}
.mode{display:flex;min-width:112rpx;height:44px;min-height:44px;align-items:center;justify-content:center;box-sizing:border-box;border:0;border-radius:16rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:19rpx;font-weight:650}
.mode-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.channel-list{margin-top:18rpx;overflow:hidden;border-radius:18rpx;background:#f2f2f7}
.channel{display:grid;grid-template-columns:70rpx minmax(150rpx,.8fr) minmax(0,1.6fr);gap:10rpx;box-sizing:border-box;min-width:0;padding:13rpx 12rpx;border-bottom:1rpx solid #dedee3;align-items:start}
.channel:last-child{border-bottom:0}
.channel-number{color:#007aff;font-size:18rpx;font-weight:700}
.channel-name{min-width:0;color:#1d1d1f;font-size:20rpx;font-weight:650;line-height:1.4;overflow-wrap:anywhere}
.range-list{min-width:0;color:#55555c;font-size:17rpx;line-height:1.4}
.range{display:grid;grid-template-columns:90rpx minmax(0,1fr);gap:8rpx;padding:2rpx 0}
.range-empty{color:#8e8e93}
.range:last-child{border-bottom:0}
.range text:first-child{color:#1d1d1f;font-weight:650}
.empty{margin-top:20rpx;padding:70rpx 20rpx;border:1rpx solid #e6e6ea;border-radius:28rpx;background:#fff;color:#6e6e73;font-size:22rpx;text-align:center}
@media (prefers-color-scheme: dark){.page{background:var(--theme-page-bg);color:var(--theme-text)}
.hero,.card,.channel-list,.empty{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
.channel-name.channel-name,.range.range,.range text:first-child{color:var(--theme-text)}
page .mode.mode-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
page .product-name.product-name,page .channel-name.channel-name,page .range.range,page .range text:first-child{background:transparent;color:var(--theme-text)}
page .channel-number.channel-number{color:var(--theme-accent-text)}
}
