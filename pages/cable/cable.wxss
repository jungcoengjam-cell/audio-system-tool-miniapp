@import "../../styles/theme-page-shared.wxss";.page-root{height:100vh}.page-scroll{height:100vh;background:radial-gradient(circle at 8% 2%,rgba(255,159,10,.08),transparent 30%),#f5f5f7}.page-content{padding:28rpx 32rpx calc(52rpx + env(safe-area-inset-bottom))}.mode-tabs{display:flex;gap:6px;margin-bottom:26rpx;padding:4rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:18rpx;background:rgba(229,229,234,.62);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%)}.mode-tab{display:flex;align-items:center;justify-content:center;flex:1;min-height:44px;padding:10rpx 18rpx;flex-direction:column;border:0;border-radius:16rpx;background:transparent;box-shadow:none}.mode-tab-active{border:0;background:rgba(255,255,255,.94);box-shadow:0 2rpx 8rpx rgba(0,0,0,.12)}.mode-label{color:#344054;font-size:26rpx;font-weight:400}.mode-subtitle{margin-top:5rpx;color:var(--theme-text-secondary);font-size:20rpx;line-height:1.25;text-align:center}.mode-tab-active .mode-label{color:#1d1d1f;font-weight:500}.card,.warning-card{margin-bottom:24rpx;padding:30rpx;border:1rpx solid #e4eaf2;border-radius:24rpx;background:#ffffff;box-shadow:0 10rpx 28rpx rgba(41,58,85,0.06)}.field{margin-bottom:24rpx}.field-label{margin-bottom:10rpx;color:#6e6e73;font-size:24rpx}.input-wrap,.picker-value{box-sizing:border-box;min-height:88rpx;border:1rpx solid transparent;border-radius:18rpx;background:rgba(242,242,247,.92);box-shadow:none}.input-wrap{display:flex;align-items:center;min-height:88rpx;padding-left:22rpx}.number-input{flex:1;height:76rpx;font-size:28rpx}.input-unit{padding:0 22rpx;color:var(--theme-text-secondary);font-size:27rpx;font-weight:650}.picker-value{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;padding:0 22rpx;font-size:27rpx}.picker-value:active{background:#e9e9ee}.picker-arrow{color:#a8a8ad;font-size:42rpx;line-height:1}.result-card{margin-top:30rpx;margin-bottom:24rpx;padding:34rpx;overflow:hidden;border:1rpx solid #e7e7eb;border-radius:30rpx;background:#fff;color:#1d1d1f;box-shadow:0 10rpx 30rpx rgba(28,45,73,.08)}.result-heading{display:flex;align-items:flex-start;justify-content:space-between}.result-label{color:var(--theme-text-secondary);font-size:22rpx;font-weight:400;letter-spacing:0}.status-chip{flex-shrink:0;margin-left:20rpx;padding:9rpx 16rpx;border-radius:999rpx;font-size:20rpx}.status-chip-good{border:1rpx solid #ccebd7;background:#eef9f2;color:#248a3d}.status-chip-warning{border:1rpx solid #ffd8a8;background:#fff5e8;color:#a55b00}.cable-spec{margin-top:20rpx;color:#1d1d1f;font-size:58rpx;font-weight:700;letter-spacing:-1rpx;line-height:1.15}.result-subtitle{margin-top:15rpx;color:#6e6e73;font-size:22rpx;line-height:1.6}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rpx;margin-top:28rpx;overflow:hidden;border-radius:16rpx;background:#e5e5ea}.metric{min-height:92rpx;padding:20rpx;background:#f5f5f7}.metric-value{color:#1d1d1f;font-size:27rpx;font-weight:400;line-height:1.35}.metric-label{margin-top:7rpx;color:#6e6e73;font-size:20rpx}.formula-card{margin-bottom:24rpx;padding:28rpx 30rpx;border:1rpx solid rgba(255,255,255,.72);border-radius:24rpx;background:rgba(247,247,250,.88);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.formula-title{color:var(--theme-accent-text);font-size:24rpx;font-weight:700}.formula-value{margin-top:12rpx;color:#173d7a;font-size:35rpx;font-weight:750}.formula-text{margin-top:12rpx;color:var(--theme-text-secondary);font-size:21rpx;line-height:1.65}.formula-text text{color:#173d7a;font-weight:700}.warning-card{border-color:#ffd79b;border-radius:24rpx;background:#fff8e8;box-shadow:none}.warning-title{color:#9a5b00;font-size:29rpx;font-weight:700}.warning-text{margin-top:13rpx;color:#7a5421;font-size:23rpx;line-height:1.65}.warning-row::before{content:'• '}.page-header{display:flex;align-items:center;justify-content:space-between;min-height:116rpx;padding:8rpx 4rpx 16rpx}.page-title{color:#1d1d1f;font-size:54rpx;font-weight:700;letter-spacing:-2rpx}.section-label{margin:8rpx 8rpx 14rpx;color:#1d1d1f;font-size:28rpx;font-weight:650}.settings-card{padding:0 28rpx;border:0;border-radius:28rpx;box-shadow:0 8rpx 26rpx rgba(0,0,0,.055)}.settings-card .compact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx;padding:22rpx 0 24rpx}.settings-card .parameter-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx 20rpx}.settings-card .parameter-grid .field:last-child{grid-column:1 / -1}.settings-card .field{min-width:0;margin:0}.settings-card .field-label{overflow:hidden;margin-bottom:12rpx;color:#6e6e73;font-size:24rpx;text-overflow:ellipsis;white-space:normal}.settings-card picker{display:block}.settings-card .input-wrap,.settings-card .picker-value{min-height:44px;border:0;border-radius:17rpx;background:#f2f2f7}.settings-card .input-wrap{padding-left:16rpx}.settings-card .number-input{min-width:0;height:44px;font-size:26rpx}.settings-card .input-unit{padding:0 14rpx 0 6rpx;font-size:22rpx;font-weight:400}.settings-card .picker-value{justify-content:space-between;padding:0 14rpx;font-size:22rpx;text-align:left}.settings-card .picker-arrow{margin-left:5rpx;font-size:28rpx}.settings-card .parameter-grid .field-label{font-size:20rpx}.settings-card .parameter-grid .number-input,.settings-card .parameter-grid .picker-value{font-size:20rpx}.result-trust{display:flex;align-items:flex-start;gap:14rpx;margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #e5e5ea}.result-trust-badge{flex-shrink:0;padding:6rpx 11rpx;border-radius:999rpx;background:#fff2dc;color:#a45b00;font-size:17rpx}.result-trust-text{color:#8e8e93;font-size:19rpx;line-height:1.5}@media (prefers-color-scheme: dark){.page-root,.page-scroll{background:var(--theme-page-bg);color:var(--theme-text)}.mode-tabs,.formula-card,.result-card,.warning-card,.result-trust{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}}@media (prefers-color-scheme: dark){page .mode-tab.mode-tab-active .mode-label.mode-label,page .mode-label.mode-label,page .cable-spec.cable-spec{color:var(--theme-text)}}@media (prefers-color-scheme: dark){page .formula-value.formula-value{color:var(--theme-text)}page .formula-result,.page .formula-result text{color:var(--theme-accent-text)}}@media (prefers-color-scheme: dark){page .formula-text text{color:var(--theme-accent-text)}}
.field-error-group{margin:0 0 20rpx;padding:10rpx 14rpx;border-radius:14rpx;background:rgba(198,58,50,.08);color:var(--theme-danger);font-size:22rpx;line-height:1.45}.result-actions-after-main{margin:0 auto 24rpx}