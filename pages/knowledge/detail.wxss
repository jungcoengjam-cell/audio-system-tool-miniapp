@import "../../styles/theme-page-shared.wxss";@import "./demo-scenes.wxss";.distance-conclusion{display:flex;margin-top:18rpx;padding:22rpx 24rpx;align-items:center;justify-content:space-between;border:1rpx solid var(--td);border-radius:20rpx;background:var(--as)}
.distance-conclusion-main{color:var(--tx);font-size:23rpx}
.distance-conclusion-value{color:var(--ta);font-size:27rpx;font-weight:700}
.distance-actions{display:flex;justify-content:space-between;gap:6px;margin-top:18rpx}
.distance-action-button{display:flex;box-sizing:border-box;width:calc((100% - 6px) / 2);height:82rpx;min-height:44px;margin:0;padding:0 14rpx;align-items:center;justify-content:center;border:0;border-radius:20rpx;background:var(--tc);color:var(--ta);font-size:23rpx;font-weight:600;line-height:1}
.distance-action-button::after{border:0}
.distance-actions-demo .distance-action-button{width:calc((100% - 12px) / 3);font-size:20rpx}
.distance-action-button:active{opacity:.68;transform:scale(.985)}
.distance-formula-detail{margin-top:16rpx;padding:22rpx 24rpx;border:1rpx solid var(--td);border-radius:20rpx;background:var(--tc)}
.distance-formula-line,.distance-formula-note{display:block}
.distance-formula-line{color:var(--ta);font-size:24rpx;font-weight:650;line-height:1.55;overflow-wrap:anywhere;word-break:break-word}
.distance-formula-note{margin-top:10rpx;color:var(--ts);font-size:21rpx;line-height:1.6}
.demo-card{margin-top:16rpx}
.demo-card-title{color:var(--tx);font-size:24rpx;font-weight:650}
.demo-card-note,.demo-caption{margin-top:8rpx;color:var(--ts);font-size:22rpx;line-height:1.45}
.demo-steps{display:flex;gap:6px;margin-top:14rpx}
.demo-step{display:flex;box-sizing:border-box;min-width:0;height:80rpx;min-height:44px;flex:1;margin:0;padding:0 8rpx;align-items:center;justify-content:center;border:0;border-radius:12rpx;background:var(--tv);color:var(--ts);font-size:22rpx;line-height:1}
.demo-step::after{border:0}
.demo-step-active{background:var(--as);color:var(--ta)}
.demo-actions{display:flex;gap:6px;margin-top:12rpx}
.demo-actions .demo-action-button{display:flex;box-sizing:border-box;height:68rpx;min-height:44px;flex:1;margin:0;align-items:center;justify-content:center;border:0;border-radius:14rpx;background:var(--tc);color:var(--ta);font-size:20rpx;line-height:1.2}
.demo-action-button::after{border:0}
.knowledge-scroll{height:100vh;background:var(--theme-page-bg)}
.knowledge-content{padding:24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}
.article-hero{position:relative;overflow:hidden;height:334rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:28rpx;box-shadow:0 18rpx 42rpx rgba(24,58,100,.16)}
.article-hero-image,.article-hero-shade{position:absolute;width:100%;height:100%}
.article-hero-shade{background:linear-gradient(180deg,rgba(3,9,20,.05) 8%,rgba(3,9,20,.22) 43%,rgba(3,9,20,.9) 100%);pointer-events:none}
.article-hero-copy{position:absolute;right:30rpx;bottom:28rpx;left:30rpx;color:#fff}
.article-tag,.section-number,.caution-label{font-size:19rpx;font-weight:700;letter-spacing:2rpx}
.article-tag{color:rgba(255,255,255,.72)}
.article-title{max-width:610rpx;margin-top:10rpx;font-size:42rpx;font-weight:700;letter-spacing:-.5rpx;line-height:1.3}
.article-lead{margin-top:28rpx;padding:0;color:var(--ts);font-size:30rpx;line-height:1.75}
.distance-visual-card{box-sizing:border-box;margin-top:20rpx;padding:30rpx;overflow:hidden;border:1rpx solid var(--td);border-radius:28rpx;background:var(--tv);box-shadow:inset 0 1rpx 0 var(--td),0 10rpx 30rpx var(--th)}
.distance-visual-kicker{color:var(--ta);font-size:19rpx;font-weight:700;letter-spacing:2rpx}
.distance-visual-title{margin-top:8rpx;color:var(--tx);font-size:31rpx;font-weight:650;line-height:1.35}
.fill-scene{position:relative;box-sizing:border-box;margin-top:24rpx;overflow:hidden;border:1rpx solid var(--td);border-radius:22rpx;background:var(--tc)}
.fill-scene{height:342rpx;border-color:var(--ty);background:var(--as)}
.fill-front-label,.fill-back-label{position:absolute;z-index:6;color:var(--ts);font-size:17rpx;font-weight:600}
.fill-front-label{top:12rpx;left:20rpx}
.fill-back-label{right:20rpx;bottom:12rpx}
.fill-main-field,.fill-support-field{position:absolute;right:54rpx;left:54rpx;opacity:1;transform-origin:center top}
.fill-main-field{top:45rpx;height:190rpx;background:linear-gradient(180deg,rgba(0,122,255,.42),rgba(0,122,255,.04));clip-path:polygon(12% 0,88% 0,100% 100%,0 100%);transform:scaleY(1)}
.fill-support-field{bottom:28rpx;height:128rpx;border-radius:44% 44% 18% 18%;background:linear-gradient(180deg,rgba(52,199,89,.42),rgba(52,199,89,.08));opacity:1;transform:scale(1)}
.fill-source{position:absolute;z-index:5;display:flex;width:38rpx;height:38rpx;align-items:center;justify-content:center;border:4rpx solid #fff;border-radius:50%;color:#fff;font-size:18rpx;font-weight:700;box-shadow:0 5rpx 14rpx rgba(25,55,91,.16)}
.fill-source-main-left,.fill-source-main-right{top:32rpx;background:var(--tp);color:#fff}
.fill-source-main-left{left:19%}
.fill-source-main-right{right:19%}
.fill-source-support-left,.fill-source-support-right{top:203rpx;background:var(--ty);color:var(--tv);opacity:1}
.fill-source-support-left{left:9%}
.fill-source-support-right{right:9%}
.fill-handoff-zone{position:absolute;z-index:4;top:178rpx;right:18rpx;left:18rpx;display:flex;height:52rpx;align-items:center;justify-content:center;border:2rpx dashed var(--tw);border-radius:18rpx;background:var(--tws);color:var(--tw);font-size:18rpx;font-weight:650;opacity:.88}
.fill-listener{position:absolute;z-index:3;width:14rpx;height:14rpx;border-radius:50%;background:#737b86}
.fill-listener-one{top:112rpx;left:30%}
.fill-listener-two{top:112rpx;right:30%}
.fill-listener-three{bottom:52rpx;left:32%}
.fill-listener-four{right:32%;bottom:52rpx}
.principle-animation-active .fill-main-field{animation:fill-main-spread 1s ease-out .08s both}
.principle-animation-active .fill-handoff-zone{animation:fill-handoff-pulse .55s ease-out .88s both}
.principle-animation-active .fill-support-field{animation:fill-support-spread .72s ease-out 1.25s both}
.principle-animation-active .fill-source-support-left,.principle-animation-active .fill-source-support-right{animation:fill-source-on .38s ease-out 1.18s both}
@keyframes fill-main-spread{from{opacity:0;transform:scaleY(.08)}
to{opacity:1;transform:scaleY(1)}
}
@keyframes fill-handoff-pulse{0%{opacity:.32;transform:scale(.97)}
55%{opacity:1;transform:scale(1.015)}
100%{opacity:.88;transform:scale(1)}
}
@keyframes fill-support-spread{from{opacity:0;transform:scale(.82)}
to{opacity:1;transform:scale(1)}
}
@keyframes fill-source-on{from{opacity:.35;transform:scale(.76)}
to{opacity:1;transform:scale(1)}
}
.article-section{margin-top:32rpx;padding:24rpx 0 0;border-top:1rpx solid var(--td)}
.section-number{color:var(--ta)}
.section-title{margin-top:0;color:var(--tx);font-size:32rpx;font-weight:650;line-height:1.35}
.section-paragraph{margin-top:20rpx;color:var(--ts);font-size:29rpx;line-height:1.8}
.formula-box{margin-top:20rpx;padding:22rpx 24rpx;border:1rpx solid var(--td);border-radius:14rpx;background:var(--as)}
.formula-line{display:block;color:var(--ta);font-size:25rpx;font-weight:600;line-height:1.75;overflow-wrap:anywhere;word-break:break-word}
.bullet-list{margin-top:20rpx;padding:12rpx 18rpx;border-radius:12rpx;background:var(--tv)}
.bullet-item{display:flex;align-items:flex-start;margin-top:10rpx}
.bullet-dot{flex:0 0 8rpx;width:8rpx;height:8rpx;margin:13rpx 14rpx 0 0;border-radius:50%;background:#007aff}
.bullet-text{color:var(--ts);font-size:28rpx;line-height:1.65}
.caution-card{margin-top:36rpx;padding:22rpx 24rpx;border:1rpx solid var(--tw);border-radius:14rpx;background:var(--tws)}
.caution-label{color:var(--tw);font-size:20rpx}
.caution-text{margin-top:10rpx;color:var(--ts);font-size:26rpx;line-height:1.7}
.related-button.related-button{display:flex;box-sizing:border-box;align-items:center;justify-content:center;width:100%;height:94rpx;min-height:44px;margin:24rpx 0 0;padding:0 32rpx;border-radius:24rpx;background:var(--tp);box-shadow:0 16rpx 32rpx rgba(0,95,220,.22);color:#fff;font-weight:600;line-height:1}
.related-button:active{opacity:.82}
.related-label{white-space:nowrap;font-size:27rpx;line-height:1.2}
.related-arrow{flex:0 0 auto;margin-left:14rpx;font-size:38rpx;font-weight:400;line-height:1}
.knowledge-error{display:flex;box-sizing:border-box;min-height:100vh;padding:180rpx 54rpx 80rpx;flex-direction:column;align-items:center;background:var(--theme-page-bg);text-align:center}
.knowledge-error-mark{display:flex;width:96rpx;height:96rpx;align-items:center;justify-content:center;border-radius:50%;background:var(--as);color:var(--ta);font-size:52rpx;font-weight:700}
.knowledge-error-title{margin-top:28rpx;color:var(--tx);font-size:34rpx;font-weight:650}
.knowledge-error-text{margin-top:14rpx;color:var(--ts);font-size:24rpx;line-height:1.6}
.knowledge-error-button.knowledge-error-button{display:flex;box-sizing:border-box;align-items:center;justify-content:center;width:320rpx;height:84rpx;min-height:44px;margin-top:40rpx;border-radius:22rpx;background:var(--tp);color:#fff;font-size:26rpx;font-weight:600;line-height:1}
.article-principle-note{box-sizing:border-box;margin-top:24rpx;padding:22rpx 24rpx;border-left:6rpx solid var(--tp);border-radius:12rpx;background:var(--as)}
.article-principle-note-lead,.article-principle-note-main,.article-principle-note-value{display:block}
.article-principle-note-lead{color:var(--ta);font-size:22rpx;font-weight:700;line-height:1.4}
.article-principle-note-main{margin-top:8rpx;color:var(--tx);font-size:28rpx;line-height:1.55}
.article-principle-note-value{color:var(--ta);font-size:28rpx;font-weight:700;line-height:1.55}
.section-heading{display:flex;align-items:baseline;gap:16rpx}
.distance-formula-section{display:block;margin-top:14rpx;color:var(--ts);font-size:21rpx;font-weight:700;line-height:1.45}
.distance-formula-section:first-child{margin-top:0}

