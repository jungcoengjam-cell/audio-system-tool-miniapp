<view wx:if="{{demo.type==='limiter'}}" class="kd-scene kd-limiter"><view class="kd-limit-head">限幅：输出上限 40V</view><view class="kd-limit-plot"><view class="kd-limit-col"><view class="kd-bar kd-request" style="height:{{demoFrame.requestH}}rpx"></view><view wx:if="{{demoFrame.overH}}" class="kd-over" style="height:{{demoFrame.overH}}rpx"></view></view><view class="kd-limit-col"><view class="kd-bar kd-actual" style="height:{{demoFrame.actualH}}rpx"></view></view><view class="kd-limit-line"></view></view><view class="kd-limit-labels"><view><text>请求输出</text><text class="kd-number">{{demoFrame.request}}</text></view><view><text>限幅后</text><text class="kd-number">{{demoFrame.actual}}</text></view></view></view>
<view wx:if="{{demo.type==='distance'}}" class="kd-scene kd-distance"><view class="kd-distance-plane"><view class="kd-source">音箱</view><view class="kd-axis-line"></view><view class="kd-wave" style="width:{{demoFrame.range}}%"></view><view class="kd-person" style="left:{{demoFrame.personX}}%"><view class="kd-person-pin"></view><text>测量点</text></view></view><view class="kd-readout"><text class="kd-number">{{demoFrame.reading}} dB</text><text>{{demoFrame.distance}}</text></view></view>
<view wx:if="{{demo.type==='cable'}}" class="kd-scene kd-cable"><view class="kd-cable-plane"><view class="kd-amp">功放<text>20V</text></view><view class="kd-wire" style="width:{{demoFrame.wireW}}%;height:{{demoFrame.lineWidth}}rpx"></view><view class="kd-speaker" style="left:{{demoFrame.speakerX}}%">音箱</view></view><view class="kd-voltage"><view class="kd-voltage-label"><text>端电压</text><text class="kd-number">{{demoFrame.voltage}}V</text></view><view class="kd-voltage-track"><view class="kd-voltage-fill" style="width:{{demoFrame.ratio}}%"></view></view></view><view class="kd-cable-meta">{{demoFrame.length}} · {{demoFrame.area}} · R {{demoFrame.resistance}}Ω</view></view>
<view wx:if="{{demo.type==='gain'}}" class="kd-scene kd-gain"><view class="kd-gain-head"><text>-6dBFS</text><text>→</text><text>+12.4dBu</text></view><view class="kd-gain-meter"><view class="kd-meter-fill kd-meter-{{demoIndex}}" style="height:{{demoFrame.level}}%"></view><view class="kd-gain-target"></view><text class="kd-meter-min">-6</text><text class="kd-meter-mid">+6dBu</text><text class="kd-meter-max">+12.4</text></view><view class="kd-gain-example">示例满功率输入 +6dBu · 有效输入 {{demoFrame.input}}dBu</view><view class="kd-controls"><text>DSP 最终衰减 {{demoFrame.dsp}}dB</text><text>功放衰减 {{demoFrame.amp}}dB</text></view></view>
<view wx:if="{{demo.type==='camera'}}" class="kd-scene kd-camera"><view class="kd-camera-plane"><view class="kd-camera-device" style="left:{{demoFrame.cameraX}}%"><view class="kd-lens"></view></view><view class="kd-cone" style="left:{{demoFrame.cameraX}}%;width:{{demoFrame.coneW}}%;height:{{demoFrame.coneH}}%;top:{{demoFrame.coneTop}}%"></view><view class="kd-camera-target"></view></view><view class="kd-camera-meta"><text>目标 4m · 覆盖 {{demoFrame.coverage}}</text><text>{{demoFrame.distance}} · {{demoFrame.fit}}</text></view></view>
<view wx:if="{{demo.type==='dmx'}}" class="kd-scene kd-dmx"><view class="kd-dmx-plane"><view class="kd-dmx-track kd-track-a"><text>A 域</text><view class="kd-track-fill" style="width:{{demoFrame.aFill}}%"></view><text class="kd-capacity">{{demoFrame.aCapacity}}</text></view><view class="kd-dmx-track kd-track-b"><text>B 域</text><view class="kd-track-fill" style="width:{{demoFrame.bFill}}%"></view><text class="kd-capacity">{{demoFrame.bCapacity}}</text></view><view class="kd-dmx-block" style="top:{{demoFrame.blockY}}rpx;left:{{demoFrame.blockX}}%;transform:translateX(-{{demoFrame.blockX}}%)">{{demoFrame.address}}</view><text wx:if="{{demoFrame.fast}}" class="kd-fast">{{demoFrame.fast==='快进'?'快进：第32台':'换到 B 域'}}</text></view></view>
<view wx:if="{{demo.type==='led'}}" class="kd-scene kd-led"><view class="kd-led-plane"><text class="kd-net-label">净屏 2.56 × 1.44m</text><view class="kd-wall" style="width:{{demoFrame.wallW}}%;height:{{demoFrame.wallH}}%"></view><view class="kd-net" style="width:85.3333%;height:72%"></view><view class="kd-outer {{demoFrame.alert?'kd-alert-border':'kd-safe-border'}}" style="width:{{demoFrame.outerW}}%;height:{{demoFrame.outerH}}%"><text>{{demoIndex===0?'尚未加入包边':'外尺寸 2.66 × 1.54m'}}</text></view></view><text class="kd-led-label">墙面 {{demoFrame.wall}} · {{demoFrame.alert?'宽超6cm（每边约5cm包边）':'尺寸匹配'}}</text></view>
