kground:#ffcc00}.kd-gain-target{position:absolute;right:0;bottom:65.2174%;left:0;border-top:2rpx dashed var(--ty)}.kd-meter-min,.kd-meter-mid,.kd-meter-max{position:absolute;font-size:18rpx}.kd-meter-min{bottom:-30rpx;left:0}.kd-meter-mid{bottom:65.2174%;right:0;color:var(--ty);transform:translateY(50%)}.kd-meter-max{top:-28rpx;right:0}.kd-gain-example{margin-top:36rpx;color:var(--ts);font-size:22rpx;text-align:center}.kd-controls{display:flex;justify-content:space-around;margin-top:12rpx;font-size:20rpx}.kd-camera{min-height:350rpx}.kd-camera-plane{position:relative;height:0;margin:8rpx 0 0;padding-bottom:50%;border:0;box-shadow:inset 0 0 0 1rpx var(--td);background:var(--tc)}.kd-camera-device{position:absolute;top:50%;width:62rpx;height:44rpx;border-radius:10rpx;background:#123b68;transform:translate(-50%,-50%);z-index:3}.kd-lens{position:absolute;top:12rpx;left:12rpx;width:20rpx;height:20rpx;border:4rpx solid #fff;border-radius:50%}.kd-cone{position:absolute;background:rgba(0,122,255,.2);clip-path:polygon(0 50%,100% 0,100% 100%);transform-origin:left center}.kd-camera-target{position:absolute;top:10%;left:80%;height:80%;border-left:3rpx dashed var(--ty)}.kd-camera-meta{display:flex;margin-top:18rpx;flex-direction:column;gap:8rpx;text-align:center;color:var(--ts);font-size:22rpx}.kd-dmx{min-height:270rpx;padding-top:22rpx}.kd-dmx-plane{position:absolute;top:0;right:22rpx;bottom:0;left:22rpx}.kd-dmx-track{position:absolute;right:0;left:0;height:50rpx;border-radius:8rpx;background:var(--as);font-size:21rpx}.kd-track-a{top:64rpx}.kd-track-b{top:164rpx}.kd-dmx-track>text:first-child{position:absolute;top:-30rpx;left:0;color:var(--ta)}.kd-track-fill{height:100%;border-radius:8rpx;background:rgba(88,86,214,.44)}.kd-capacity{position:absolute;right:8rpx;top:56rpx;color:var(--tx);font-size:18rpx} .kd-dmx-block{position:absolute;box-sizing:border-box;height:42rpx;width:210rpx;padding-top:8rpx;border:2rpx solid var(--ty);border-radius:7rpx;background:var(--tp);color:#fff!important;text-align:center;font-size:24rpx;white-space:nowrap;transform:translateX(0)}.kd-fast{position:absolute;top:14rpx;right:22rpx;color:var(--ta);font-size:20rpx}.kd-led{min-height:350rpx}.kd-led-plane{position:relative;height:0;margin:8rpx 0 0;padding-bottom:66.6667%;border:0;box-shadow:inset 0 0 0 1rpx var(--td);background:var(--tc)}.kd-wall,.kd-net,.kd-outer{position:absolute;top:50%;left:50%;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%)}.kd-wall{border:2rpx dashed var(--ts);background:transparent}.kd-net{box-sizing:border-box;border:2rpx solid var(--ty);background:repeating-linear-gradient(90deg,rgba(0,122,255,.25) 0,rgba(0,122,255,.25) 1rpx,transparent 1rpx,transparent 12.5%),repeating-linear-gradient(0deg,rgba(0,122,255,.25) 0,rgba(0,122,255,.25) 1rpx,transparent 1rpx,transparent 11.1111%);z-index:2}.kd-net-label{position:absolute;top:4rpx;left:0;right:0;text-align:center;color:var(--ts);font-size:22rpx;z-index:4}.kd-outer{box-sizing:border-box;border:4rpx solid var(--ty);z-index:3;font-size:22rpx}.kd-safe-border{border-color:#34c759}.kd-alert-border{border-color:#ff3b30}.kd-outer text{padding:4rpx;background:rgba(0,0,0,.58);color:#fff!important}.kd-net-label{background:transparent!important;padding:0!important}.kd-led-label{display:block;margin-top:18rpx;text-align:center;color:var(--ts);font-size:22rpx}@media (prefers-reduced-motion:reduce){.kd-bar,.kd-over,.kd-wave,.kd-wire,.kd-speaker,.kd-meter-fill,.kd-cone,.kd-camera-device,.kd-person,.kd-voltage-fill,.kd-track-fill,.kd-wall,.kd-net,.kd-outer,.kd-dmx-block{transition:none!important;animation:none!important}}
