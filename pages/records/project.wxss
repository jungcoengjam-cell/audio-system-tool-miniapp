@import "../../styles/homepage.wxss";

.interior-root{height:100vh;background:var(--theme-page-bg);color:var(--theme-text)}
.interior-scroll{height:100vh;background:var(--theme-page-bg);color:var(--theme-text)}
.interior-content{box-sizing:border-box;min-height:100vh;padding:18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));background:var(--theme-page-bg)}
.interior-hero{padding:18rpx 20rpx 20rpx;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface);box-shadow:0 7rpx 20rpx var(--theme-shadow)}
.interior-hero-heading,.interior-hero-actions,.interior-edit-heading,.interior-section-heading,.interior-item-title-row,.interior-sheet-actions{display:flex;align-items:center}
.interior-hero-heading{align-items:flex-start}
.interior-hero-heading,.interior-section-heading{justify-content:space-between;gap:12rpx}
.interior-title-block{min-width:0;flex:1}
.interior-project-title{overflow-wrap:anywhere;color:var(--theme-text);font-size:38rpx;font-weight:700;line-height:1.25}
.interior-updated{margin-top:6rpx;color:var(--theme-text-secondary);font-size:23rpx;line-height:1.35}
.interior-menu-button{display:flex;box-sizing:border-box;width:44px;max-width:44px;height:44px;min-width:44px;min-height:44px;flex:0 0 44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:24rpx;letter-spacing:2rpx;transition:opacity .14s ease,transform .14s ease}
.interior-menu-button::after,.interior-report-button::after,.interior-quiet-button::after,.interior-primary-button::after,.interior-retry::after,.interior-sheet-button::after{border:0}
.interior-menu-button:active,.interior-report-button:active,.interior-quiet-button:active,.interior-sheet-button:active{opacity:.76;transform:scale(.98)}
.interior-hero-actions{min-height:44px;margin-top:12rpx;justify-content:stretch;gap:12rpx}
.interior-report-button{display:flex;box-sizing:border-box;width:100%;min-width:0;max-width:none;height:44px;min-height:44px;flex:1 1 100%;margin:0;padding:0 18rpx;align-items:center;justify-content:center;gap:10rpx;border:1rpx solid var(--theme-divider);border-radius:15rpx;background:var(--theme-control);color:var(--theme-accent-text);font-size:14px;font-weight:650;line-height:44px;transition:opacity .14s ease,transform .14s ease}
.interior-report-icon{font-size:28rpx;line-height:1}
.interior-search-wrap{display:flex;box-sizing:border-box;min-height:48px;margin-top:16rpx;padding:0 18rpx;align-items:center;gap:12rpx;border:1rpx solid var(--theme-divider);border-radius:20rpx;background:var(--theme-control)}
.interior-search-icon{color:var(--theme-text-secondary);font-size:33rpx;line-height:1}
.interior-search-input{box-sizing:border-box;min-width:0;height:46px;flex:1;padding:0;border:0;background:transparent;color:var(--theme-text);font-size:16px;line-height:46px}
.interior-search-clear{display:flex;box-sizing:border-box;min-height:44px;padding:0 6rpx;align-items:center;color:var(--theme-accent-text);font-size:13px}
.interior-filter-scroll{width:100%;margin-top:12rpx;white-space:nowrap}
.interior-filter-row{display:flex;min-height:44px;gap:8rpx}
.interior-filter-row .home-chip{min-width:76rpx;flex:0 0 auto;font-size:14px}
.interior-section{margin-top:20rpx}
.interior-section-heading{min-height:44px;margin:0 4rpx 10rpx}
.interior-section-title{color:var(--theme-text);font-size:16px;font-weight:680;line-height:1.3}
.interior-section-subtitle{margin-top:6rpx;color:var(--theme-text-secondary);font-size:13px;line-height:1.4}
.interior-section-count{color:var(--theme-text-secondary);font-size:14px;white-space:nowrap}
.interior-record-group{margin-top:8rpx}
.interior-group-heading{display:flex;min-height:36px;padding:0 6rpx;align-items:center;gap:8rpx}
.interior-group-title{color:var(--theme-accent-text);font-size:14px;font-weight:650}
.interior-group-count{min-width:24rpx;color:var(--theme-text-tertiary);font-size:13px;text-align:center}
.interior-item{display:flex;box-sizing:border-box;min-height:80px;margin-top:8rpx;padding:14rpx 15rpx;align-items:center;gap:14rpx;border:1rpx solid var(--theme-divider);border-radius:19rpx;background:var(--theme-surface);box-shadow:0 5rpx 15rpx var(--theme-shadow);transition:opacity .14s ease,transform .14s ease}
.interior-item-pressed{opacity:.77;transform:scale(.99)}
.interior-swipe-row{position:relative;isolation:isolate;overflow:hidden;margin-top:8rpx;border-radius:19rpx;touch-action:pan-y}
.interior-swipe-row .interior-item{margin-top:0}
.interior-swipe-content{position:relative;z-index:1;transition:transform .18s ease;touch-action:pan-y}
.interior-swipe-pressed{opacity:.77}
.interior-swipe-row-dragging .interior-swipe-content{transition:none}
.interior-swipe-delete{position:absolute;z-index:0;top:0;right:0;bottom:0;display:flex;box-sizing:border-box;width:72px;min-width:72px;max-width:72px;min-height:44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:13rpx;background:#d70015;color:#fff;font-size:14px;font-weight:650;line-height:20px}
.interior-swipe-delete::after{border:0}
.interior-swipe-label{display:block;color:#fff;font-size:14px;font-weight:650;line-height:20px;white-space:nowrap}
.interior-record-symbol,.interior-kind-symbol{display:flex;box-sizing:border-box;width:44px;height:44px;flex:0 0 44px;align-items:center;justify-content:center;border-radius:15rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:22px;font-weight:650}
.interior-kind-wiring{background:rgba(255,159,10,.14);color:#b66a00}
.interior-kind-lighting{background:rgba(52,199,89,.14);color:#188548}
.interior-item-copy{min-width:0;flex:1}
.interior-item-title-row{min-width:0;flex-wrap:wrap;gap:6rpx 10rpx}
.interior-item-title{min-width:0;flex:1;color:var(--theme-text);font-size:15px;font-weight:650;line-height:1.4;overflow-wrap:anywhere}
.interior-module-chip{flex:0 0 auto;padding:5rpx 11rpx;border:1rpx solid var(--theme-divider);border-radius:999rpx;color:var(--theme-accent-text);font-size:13px;line-height:1.2}
.interior-item-subtitle{margin-top:4rpx;color:var(--theme-text-secondary);font-size:14px;line-height:1.4;overflow-wrap:anywhere}
.interior-item-time{margin-top:4rpx;color:var(--theme-text-tertiary);font-size:13px;line-height:1.35;overflow-wrap:anywhere}
.interior-project-notes{margin-top:12rpx;padding:15rpx;border:1rpx solid var(--theme-divider);border-radius:17rpx;background:var(--theme-surface)}
.interior-project-notes-label{color:var(--theme-text-secondary);font-size:13px;font-weight:650}
.interior-project-notes-copy{margin-top:6rpx;color:var(--theme-text);font-size:14px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}
.interior-chevron{flex:0 0 auto;color:var(--theme-text-tertiary);font-size:28px;line-height:1}
.interior-quiet-button{box-sizing:border-box;min-height:44px;margin:0;padding:0 12rpx;border:0;border-radius:13rpx;background:var(--theme-control);color:var(--theme-accent-text);font-size:13px;line-height:44px}
.interior-empty{min-height:26vh;padding:28rpx 10rpx}
.interior-content .home-empty-title{font-size:16px}
.interior-content .home-empty-copy{font-size:14px}
.interior-missing{padding:70rpx 28rpx}
.interior-edit-panel{padding:20rpx;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface);box-shadow:0 7rpx 20rpx var(--theme-shadow)}
.interior-edit-heading{justify-content:space-between;gap:10rpx}
.project-form-field{margin-top:18rpx}
.project-form-label{margin-bottom:8rpx;color:var(--theme-text-secondary);font-size:14px}
.project-form-label text{margin-left:6rpx;color:var(--theme-danger);font-size:13px}
.project-form-control,.project-form-textarea,.interior-form-control{box-sizing:border-box;width:100%;border:1rpx solid var(--theme-divider);border-radius:15rpx;background:var(--theme-control);color:var(--theme-text);font-size:16px}
.project-form-control,.interior-form-control{min-height:48px;padding:0 14rpx}
.project-form-textarea{min-height:140px;padding:12rpx 14rpx;line-height:1.5}
.project-dimension-row{display:flex;gap:8rpx}
.project-dimension-row .project-form-control{min-width:0;flex:1}
.project-date-control{display:flex;align-items:center;justify-content:space-between}
.project-form-arrow{font-size:26px}
.project-form-count{margin-top:5rpx;color:var(--theme-text-tertiary);font-size:13px;text-align:right}
.interior-edit-actions{margin-top:20rpx}
.interior-primary-button{display:flex;box-sizing:border-box;width:100%;min-height:48px;margin:0;padding:0 18rpx;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--theme-primary-fill);color:#fff;font-size:15px;font-weight:650;transition:opacity .14s ease,transform .14s ease}
.interior-primary-button:active{opacity:.78;transform:scale(.99)}
.interior-error{display:flex;min-height:56px;padding:10rpx 12rpx;align-items:center;gap:10rpx;border:1rpx solid var(--theme-divider);border-radius:16rpx;background:var(--theme-surface)}
.interior-error-copy{min-width:0;flex:1;color:var(--theme-danger);font-size:14px;line-height:1.4}
.interior-retry{box-sizing:border-box;min-height:44px;margin:0;padding:0 12rpx;border:0;border-radius:13rpx;background:var(--theme-primary-fill);color:#fff;font-size:13px;line-height:44px}
.interior-inline-error{padding:14rpx;border-radius:14rpx;background:var(--theme-warning-soft);color:var(--theme-warning);font-size:14px;line-height:1.5;overflow-wrap:anywhere}
.interior-overlay{position:fixed;z-index:20;top:0;right:0;bottom:0;left:0;display:flex;box-sizing:border-box;padding:40rpx 26rpx calc(28rpx + env(safe-area-inset-bottom));align-items:flex-end;justify-content:center;background:rgba(0,0,0,.42);animation:interior-fade-in .18s ease both}
.interior-rename-sheet{box-sizing:border-box;width:100%;padding:22rpx;border:1rpx solid var(--theme-divider);border-radius:24rpx;background:var(--theme-surface);box-shadow:0 18rpx 50rpx rgba(0,0,0,.2);animation:interior-sheet-in .22s ease both}
.interior-sheet-title{margin-bottom:14rpx;color:var(--theme-text);font-size:18px;font-weight:680}
.interior-sheet-actions{margin-top:16rpx;gap:10rpx}
.interior-sheet-button{display:flex;box-sizing:border-box;min-width:0;min-height:48px;flex:1;margin:0;padding:0 14rpx;align-items:center;justify-content:center;border:0;border-radius:15rpx;background:var(--theme-control);color:var(--theme-text);font-size:15px;font-weight:600;transition:opacity .14s ease,transform .14s ease}
.interior-sheet-primary{background:var(--theme-primary-fill);color:#fff}
.interior-sheet-button:active{opacity:.75;transform:scale(.99)}
.interior-overlay-closing{pointer-events:none;animation:interior-fade-out .18s ease both}
.interior-rename-sheet-closing{animation:interior-sheet-out .18s ease both}
@keyframes interior-fade-in{from{opacity:0}to{opacity:1}}
@keyframes interior-fade-out{from{opacity:1}to{opacity:0}}
@keyframes interior-sheet-in{from{transform:translateY(22px);opacity:.75}to{transform:translateY(0);opacity:1}}
@keyframes interior-sheet-out{from{transform:translateY(0);opacity:1}to{transform:translateY(22px);opacity:.72}}
@media (max-width:340px){
  .interior-content{padding-right:16rpx;padding-left:16rpx}
  .interior-project-title{font-size:17px}
  .interior-updated,.interior-section-count,.interior-group-title{font-size:13px}
  .interior-section-title{font-size:15px}
  .interior-item-title{font-size:14px}
  .interior-item-subtitle,.interior-item-time{font-size:13px}
  .interior-filter-row{gap:6rpx}
  .interior-filter-row .home-chip{padding-right:16rpx;padding-left:16rpx;font-size:13px}
}
@media (prefers-reduced-motion: reduce){
  .interior-menu-button,.interior-report-button,.interior-quiet-button,.interior-item,.interior-primary-button,.interior-sheet-button{transition:none}
  .interior-swipe-content,.interior-swipe-delete{transition:none}
  .interior-overlay,.interior-rename-sheet{animation:none}
  .interior-item-pressed,.home-chip-pressed{transform:none!important}
}
@media (prefers-color-scheme: dark){
  .interior-root,.interior-scroll,.interior-content{background:#000}
  .interior-hero,.interior-item,.interior-edit-panel,.interior-error,.interior-rename-sheet{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
  .interior-search-wrap,.interior-search-input,.interior-filter-row .home-chip,.interior-menu-button,.interior-report-button,.project-form-control,.project-form-textarea,.interior-form-control{border-color:var(--theme-divider);background:var(--theme-control);color:var(--theme-text)}
  .interior-filter-row .home-chip-active{background:var(--theme-primary-fill);color:#fff}
  .interior-section-title,.interior-project-title,.interior-item-title,.interior-sheet-title{color:var(--theme-text)}
  .interior-kind-wiring{background:rgba(255,159,10,.18);color:#ffb340}
  .interior-kind-lighting{background:rgba(52,199,89,.18);color:#63d391}
}
