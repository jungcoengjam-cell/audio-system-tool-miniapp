@import "../../styles/theme-page-shared.wxss";

.report-page{display:flex;box-sizing:border-box;width:100%;height:100vh;flex-direction:column;overflow:hidden;background:var(--theme-page-bg);color:var(--theme-text)}
.report-selection-scroll,.report-preview-scroll{box-sizing:border-box;min-height:0;flex:1}
.report-selection-scroll{padding:22rpx 24rpx 0}
.report-project-card,.report-select-all,.report-item,.report-state-card{border:1rpx solid var(--theme-divider);border-radius:24rpx;background:var(--theme-surface);box-shadow:0 8rpx 24rpx var(--theme-shadow)}
.report-project-card{padding:24rpx 26rpx}
.report-kicker{color:var(--theme-text-secondary);font-size:13px;font-weight:600}
.report-project-name{margin-top:7rpx;color:var(--theme-text);font-size:16px;font-weight:700;line-height:1.35;word-break:break-all;overflow-wrap:anywhere}
.report-project-id{margin-top:9rpx;color:var(--theme-text-tertiary);font-size:12px;line-height:1.4;word-break:break-all}
.report-select-all{display:flex;box-sizing:border-box;min-height:44px;margin-top:16rpx;padding:0 20rpx;align-items:center}
.report-check{display:flex;box-sizing:border-box;width:38rpx;height:38rpx;flex:0 0 38rpx;align-items:center;justify-content:center;border:2rpx solid var(--theme-divider);border-radius:11rpx;color:#fff;font-size:13px;font-weight:700}
.report-check-active{border-color:var(--theme-primary-fill);background:var(--theme-primary-fill)}
.report-select-all-title{margin-left:15rpx;color:var(--theme-text);font-size:14px;font-weight:650}
.report-select-all-count{margin-left:auto;color:var(--theme-text-secondary);font-size:12px}
.report-section{margin-top:20rpx}
.report-section-heading{display:flex;min-height:58rpx;padding:0 5rpx;align-items:center;justify-content:space-between}
.report-section-title{color:var(--theme-text);font-size:14px;font-weight:700}
.report-section-count{color:var(--theme-text-tertiary);font-size:12px}
.report-item{display:flex;box-sizing:border-box;min-height:98rpx;margin-top:11rpx;padding:17rpx 17rpx;align-items:center;transition:opacity .14s ease,transform .14s ease}
.report-item-selected{border-color:rgba(0,102,204,.24)}
.report-item-copy{min-width:0;flex:1;margin-left:15rpx}
.report-item-title{color:var(--theme-text);font-size:14px;font-weight:650;line-height:1.4;word-break:break-all;overflow-wrap:anywhere}
.report-item-subtitle{margin-top:5rpx;color:var(--theme-text-secondary);font-size:13px;line-height:1.45;word-break:break-all;overflow-wrap:anywhere}
.report-item-image-error{margin-top:8rpx;color:#b42318;font-size:12px;line-height:1.45;word-break:break-all;overflow-wrap:anywhere}
.report-item-chevron{margin-left:8rpx;color:var(--theme-text-tertiary);font-size:40rpx;line-height:1}
.report-pressed{opacity:.75;transform:scale(.99)}
.report-selection-bottom-space{height:35rpx}
.report-selection-footer,.report-preview-footer{box-sizing:border-box;flex:0 0 auto;padding:12rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--theme-divider);background:var(--theme-page-bg)}
.report-footer-status,.report-save-status{min-height:16px;color:var(--theme-text-secondary);font-size:12px;line-height:1.45}
.report-footer-count{margin-top:4rpx;color:var(--theme-text-secondary);font-size:12px;line-height:1.4;text-align:center}
.report-primary-button,.report-secondary-button{display:flex;box-sizing:border-box;min-height:44px;margin:0;padding:0 20rpx;align-items:center;justify-content:center;border:0;border-radius:19rpx;font-size:13px;font-weight:650;line-height:1.25;white-space:normal}
.report-primary-button::after,.report-secondary-button::after{border:0}
.report-primary-button{background:var(--theme-primary-fill);color:#fff}
.report-secondary-button{background:var(--theme-control);color:var(--theme-accent-text)}
.report-primary-button[disabled],.report-secondary-button[disabled]{opacity:.48}
.report-page button.report-generate-button{display:flex;box-sizing:border-box;width:100%;min-width:0;max-width:none;height:88rpx;min-height:44px;margin:10rpx 0 0;padding:0;flex:0 0 auto;align-items:center;justify-content:center;border-radius:22rpx;font-size:27rpx;font-weight:600;line-height:44px;text-align:center}
.report-state-wrap{display:flex;box-sizing:border-box;min-height:0;padding:24rpx;flex:1;align-items:center;justify-content:center}
.report-state-card{box-sizing:border-box;width:100%;max-width:680rpx;padding:35rpx 28rpx;text-align:center}
.report-state-title{color:var(--theme-text);font-size:14px;font-weight:700;line-height:1.4}
.report-state-copy{margin-top:10rpx;color:var(--theme-text-secondary);font-size:13px;line-height:1.55;word-break:break-all}
.report-page button.report-state-retry{display:flex;width:100%;min-width:0;max-width:none;height:88rpx;min-height:44px;margin-top:22rpx;padding:0;align-items:center;justify-content:center;line-height:44px}
.report-empty-card{margin-top:20rpx}
.report-rendering-wrap .report-state-card{padding-top:48rpx;padding-bottom:42rpx}
.report-rendering-indicator{width:44rpx;height:44rpx;margin:0 auto 18rpx;border:6rpx solid var(--theme-accent-soft);border-top-color:var(--theme-accent);border-radius:50%;animation:report-spin .9s linear infinite}
.report-page button.report-cancel-button{width:100%;min-width:0;max-width:none;margin-top:24rpx;padding:0;line-height:44px}
.report-preview-toolbar{display:flex;box-sizing:border-box;min-height:60px;padding:6rpx 20rpx;flex:0 0 auto;align-items:center;justify-content:space-between;gap:8rpx}
.report-page button.report-secondary-button.report-return-selection{display:flex;box-sizing:border-box;width:auto;min-width:90px;max-width:none;height:44px;min-height:44px;margin:0;padding:0 12rpx;flex:0 0 auto;align-items:center;justify-content:center;border-radius:16rpx;background:transparent;color:var(--theme-accent-text);font-size:13px;line-height:44px;white-space:nowrap}
.report-page-nav{display:flex;box-sizing:border-box;min-height:44px;padding:0 2rpx;flex:0 0 auto;align-items:center;justify-content:center;gap:0;border-radius:24rpx;background:var(--theme-control)}
.report-page button.report-page-arrow{display:flex;box-sizing:border-box;width:44px;height:44px;min-width:44px;max-width:44px;min-height:44px;flex:0 0 44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:transparent;color:var(--theme-accent-text);font-size:28px;line-height:1}
.report-page-arrow::after{border:0}
.report-page-arrow[disabled]{opacity:.35}
.report-page-counter{min-width:54px;color:var(--theme-text-secondary);font-size:12px;font-weight:600;text-align:center;white-space:nowrap}
.report-preview-scroll{box-sizing:border-box;margin:0;padding:12rpx 24rpx 24rpx;background:var(--theme-page-bg)}
.report-preview-image{display:block;width:100%;margin:0 auto;background:#fff}
.report-preview-footer{padding-top:8rpx}
.report-save-status{min-height:0;color:var(--theme-text-secondary);font-size:11px;line-height:16px;text-align:center}
.report-preview-actions{display:flex;gap:8px;margin-top:6rpx}
.report-page .report-preview-actions>button.report-preview-action{display:flex;box-sizing:border-box;width:auto;min-width:0;max-width:none;height:88rpx;min-height:44px;margin:0;padding:0;flex:1 1 0;align-items:center;justify-content:center;font-size:13px;line-height:44px;text-align:center}
.report-canvas-offscreen{position:fixed;z-index:-1;top:0;left:-2500px;pointer-events:none;opacity:0}

@keyframes report-spin{to{transform:rotate(360deg)}}

@media (prefers-color-scheme:dark){
  .report-page{background:#000;color:#fff}
  .report-selection-footer,.report-preview-footer{border-color:#38383a;background:#000}
  .report-project-card,.report-select-all,.report-item,.report-state-card{border-color:#38383a;background:#1c1c1e}
  .report-item-selected{border-color:#315c86}
  .report-item-image-error{color:#ff8a80}
}

@media (max-width:360px){
  .report-selection-scroll{padding-right:18rpx;padding-left:18rpx}
  .report-selection-footer,.report-preview-footer{padding-right:18rpx;padding-left:18rpx}
  .report-preview-toolbar{padding-right:14rpx;padding-left:14rpx}
  .report-preview-action{padding-right:12rpx;padding-left:12rpx;font-size:12px}
}

@media (prefers-reduced-motion:reduce){
  .report-item,.report-pressed{transition:none;transform:none}
  .report-rendering-indicator{animation:none}
}
