<view class="interior-root">
  <scroll-view class="interior-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{projectScrollTop}}" bindscroll="onProjectScroll">
    <view class="interior-content">
      <view wx:if="{{workspaceError}}" class="interior-error">
        <view class="interior-error-copy">{{workspaceError}}</view>
        <button class="interior-retry" bindtap="retryWorkspace">重试</button>
      </view>

      <block wx:if="{{project}}">
        <view wx:if="{{editing}}" class="interior-edit-panel">
          <view class="interior-edit-heading">
            <view>
              <view class="interior-section-title">编辑项目资料</view>
              <view class="interior-section-subtitle">只修改本项目资料，不影响已保存的计算内容。</view>
            </view>
            <button class="interior-quiet-button" bindtap="cancelEditProject">取消</button>
          </view>

          <view class="project-form-field">
            <view class="project-form-label">项目名称 <text>必填</text></view>
            <input class="project-form-control" maxlength="30" value="{{projectForm.name}}" data-field="name" bindinput="onProjectFieldInput" placeholder="输入项目名称" />
          </view>
          <view class="project-form-field">
            <view class="project-form-label">场地名称</view>
            <input class="project-form-control" maxlength="50" value="{{projectForm.venueName}}" data-field="venueName" bindinput="onProjectFieldInput" placeholder="例如：二楼报告厅" />
          </view>
          <view class="project-form-field">
            <view class="project-form-label">调试人员</view>
            <input class="project-form-control" maxlength="30" value="{{projectForm.engineer}}" data-field="engineer" bindinput="onProjectFieldInput" placeholder="输入姓名或团队" />
          </view>
          <view class="project-form-field">
            <view class="project-form-label">场地尺寸</view>
            <view class="project-dimension-row">
              <input class="project-form-control" type="digit" value="{{projectForm.roomLengthText}}" data-field="roomLengthText" bindinput="onProjectFieldInput" placeholder="长 m" />
              <input class="project-form-control" type="digit" value="{{projectForm.roomWidthText}}" data-field="roomWidthText" bindinput="onProjectFieldInput" placeholder="宽 m" />
              <input class="project-form-control" type="digit" value="{{projectForm.roomHeightText}}" data-field="roomHeightText" bindinput="onProjectFieldInput" placeholder="高 m" />
            </view>
          </view>
          <view class="project-form-field">
            <view class="project-form-label">调试日期</view>
            <picker mode="date" value="{{projectForm.projectDate}}" bindchange="onProjectDateChange">
              <view class="project-form-control project-date-control">
                <text>{{projectForm.projectDate || '选择日期'}}</text><text class="project-form-arrow">›</text>
              </view>
            </picker>
          </view>
          <view class="project-form-field">
            <view class="project-form-label">现场备注</view>
            <textarea class="project-form-textarea" maxlength="300" value="{{projectForm.notes}}" data-field="notes" bindinput="onProjectFieldInput" placeholder="记录现场条件或待处理事项" />
            <view class="project-form-count">{{projectForm.notes.length}} / 300</view>
          </view>
          <view class="interior-edit-actions">
            <button class="interior-primary-button" disabled="{{workspaceError}}" bindtap="saveProjectDetails">保存资料</button>
          </view>
        </view>

        <block wx:else>
          <view class="interior-hero">
            <view class="interior-hero-heading">
              <view class="interior-title-block">
                <view class="interior-project-title">{{project.name}}</view>
                <view class="interior-updated">最近更新 · {{project.timeText}}</view>
              </view>
              <button class="interior-menu-button" aria-label="项目管理" disabled="{{workspaceError}}" bindtap="openManagementMenu">•••</button>
            </view>
            <view class="interior-hero-actions">
              <button class="interior-report-button" disabled="{{workspaceError}}" bindtap="openProjectReport">
                <text class="interior-report-icon">▤</text><text>项目报告</text>
              </button>
            </view>
          </view>

          <view wx:if="{{project.notes}}" class="interior-project-notes"><view class="interior-project-notes-label">现场备注</view><view class="interior-project-notes-copy">{{project.notes}}</view></view>

          <view class="interior-search-wrap">
            <text class="interior-search-icon">⌕</text>
            <input class="interior-search-input" value="{{projectSearchText}}" placeholder="搜索项目内容" confirm-type="search" bindinput="onProjectSearchInput" />
            <text wx:if="{{projectSearchText}}" class="interior-search-clear" bindtap="clearProjectSearch">清除</text>
          </view>

          <scroll-view class="interior-filter-scroll" scroll-x show-scrollbar="{{false}}">
            <view class="interior-filter-row">
              <view wx:for="{{projectViewFilters}}" wx:key="key" class="home-chip {{projectViewFilter === item.key ? 'home-chip-active' : ''}}" hover-class="home-chip-pressed" data-key="{{item.key}}" bindtap="onProjectViewFilterTap">{{item.label}}</view>
            </view>
          </scroll-view>

          <view wx:if="{{showCalculations && recordGroups.length}}" class="interior-section">
            <view class="interior-section-heading">
              <view class="interior-section-title">计算记录</view>
              <view class="interior-section-count">{{visibleRecordCount}} 条</view>
            </view>
            <view wx:for="{{recordGroups}}" wx:key="module" wx:for-item="group" class="interior-record-group">
              <view class="interior-group-heading">
                <view class="interior-group-title">{{group.label}}</view>
                <view class="interior-group-count">{{group.records.length}}</view>
              </view>
              <view wx:for="{{group.records}}" wx:key="id" wx:for-item="record" class="interior-swipe-row {{record.swipeOpen ? 'interior-swipe-row-open' : ''}} {{record.swipeDragging ? 'interior-swipe-row-dragging' : ''}}" data-swipe-type="record" data-swipe-id="{{record.id}}" bindtouchstart="onProjectSwipeStart" bindtouchmove="onProjectSwipeMove" bindtouchend="onProjectSwipeEnd" bindtouchcancel="onProjectSwipeCancel">
                <view aria-role="button" wx:if="{{record.swipeOpen || (record.swipeDragging && record.swipeOffset < 0)}}" class="interior-swipe-delete" aria-label="从本项目移除{{record.title}}" data-swipe-type="record" data-swipe-id="{{record.id}}" catchtap="onProjectSwipeDelete"><text class="interior-swipe-label">移除</text></view>
                <view class="interior-item interior-record-item interior-swipe-content" hover-class="interior-swipe-pressed" style="transform:translateX({{record.swipeOffset}}px);" data-id="{{record.id}}" bindtap="onProjectItemTap">
                  <view class="interior-record-symbol">↗</view>
                  <view class="interior-item-copy">
                    <view class="interior-item-title-row">
                      <view class="interior-item-title">{{record.title}}</view>
                      <view class="interior-module-chip">{{record.moduleLabel}}</view>
                    </view>
                    <view wx:if="{{record.summary}}" class="interior-item-subtitle">{{record.summary}}</view>
                    <view wx:if="{{record.projectNote}}" class="interior-item-subtitle interior-item-note">{{record.projectNote}}</view>
                    <view class="interior-item-time">{{record.timeText}}</view>
                  </view>
                  <view class="interior-chevron">›</view>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{showWiring}}" class="interior-section">
            <view class="interior-section-heading">
              <view class="interior-section-title">通道与线缆</view>
              <view class="interior-section-count">{{wiringLines.length}} 条</view>
            </view>
            <view wx:for="{{wiringLines}}" wx:key="id" class="interior-swipe-row {{item.swipeOpen ? 'interior-swipe-row-open' : ''}} {{item.swipeDragging ? 'interior-swipe-row-dragging' : ''}}" data-swipe-type="line" data-swipe-id="{{item.id}}" bindtouchstart="onProjectSwipeStart" bindtouchmove="onProjectSwipeMove" bindtouchend="onProjectSwipeEnd" bindtouchcancel="onProjectSwipeCancel">
              <view aria-role="button" wx:if="{{item.swipeOpen || (item.swipeDragging && item.swipeOffset < 0)}}" class="interior-swipe-delete" aria-label="删除线路{{item.displayTitle}}" data-swipe-type="line" data-swipe-id="{{item.id}}" catchtap="onProjectSwipeDelete"><text class="interior-swipe-label">删除</text></view>
              <view class="interior-item interior-swipe-content" hover-class="interior-swipe-pressed" style="transform:translateX({{item.swipeOffset}}px);" data-id="{{item.id}}" bindtap="openProjectWiring">
                <view class="interior-kind-symbol interior-kind-wiring">⌁</view>
                <view class="interior-item-copy">
                  <view class="interior-item-title">{{item.displayTitle}}</view>
                  <view class="interior-item-subtitle">{{item.endpointSummary}}</view>
                  <view class="interior-item-time">{{item.materialSummary}}</view>
                </view>
                <view class="interior-chevron">›</view>
              </view>
            </view>
          </view>

          <view wx:if="{{showLighting}}" class="interior-section">
            <view class="interior-section-heading">
              <view class="interior-section-title">灯位方案</view>
              <view wx:if="{{!project.lightingReadError}}" class="interior-section-count">{{lightingFixtures.length}} 个</view>
            </view>
            <view wx:if="{{project.lightingReadError}}" class="interior-inline-error">{{project.lightingReadError}}</view>
            <view wx:for="{{lightingFixtures}}" wx:key="stableId" class="interior-swipe-row {{item.swipeOpen ? 'interior-swipe-row-open' : ''}} {{item.swipeDragging ? 'interior-swipe-row-dragging' : ''}}" data-swipe-type="lighting" data-swipe-id="{{item.stableId}}" bindtouchstart="onProjectSwipeStart" bindtouchmove="onProjectSwipeMove" bindtouchend="onProjectSwipeEnd" bindtouchcancel="onProjectSwipeCancel">
              <view aria-role="button" wx:if="{{item.swipeOpen || (item.swipeDragging && item.swipeOffset < 0)}}" class="interior-swipe-delete" aria-label="移出灯位{{item.displayTitle}}" data-swipe-type="lighting" data-swipe-id="{{item.stableId}}" catchtap="onProjectSwipeDelete"><text class="interior-swipe-label">移出灯位</text></view>
              <view class="interior-item interior-swipe-content" hover-class="interior-swipe-pressed" style="transform:translateX({{item.swipeOffset}}px);" data-id="{{item.stableId}}" bindtap="openProjectLighting">
                <view class="interior-kind-symbol interior-kind-lighting">✳</view>
                <view class="interior-item-copy">
                  <view class="interior-item-title">{{item.displayTitle}}</view>
                  <view class="interior-item-subtitle">{{item.modelSummary}}</view>
                  <view class="interior-item-time">{{item.addressSummary}}{{item.isPlaced ? '' : ' · 未上杆'}}</view>
                </view>
                <view class="interior-chevron">›</view>
              </view>
            </view>
          </view>

          <view wx:if="{{projectSearchEmpty}}" class="home-empty-state interior-empty">
            <view class="home-empty-title">没有匹配的项目内容</view>
            <view class="home-empty-copy">调整搜索词或切换内容筛选。</view>
          </view>
          <view wx:elif="{{projectTypeEmpty}}" class="home-empty-state interior-empty">
            <view class="home-empty-title">{{projectViewFilter === 'all' ? '这个项目还没有内容' : '此类内容暂未添加'}}</view>
            <view class="home-empty-copy">保存到本项目的计算结果、线路和灯位方案会显示在这里。</view>
          </view>
        </block>
      </block>

      <view wx:elif="{{missing}}" class="home-empty-state interior-missing">
        <view class="home-empty-title">项目不存在或已移入回收站</view>
        <view class="home-empty-copy">返回项目列表，或前往回收站恢复项目。</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{renameVisible}}" class="interior-overlay {{renameClosing ? 'interior-overlay-closing' : ''}}" bindtap="closeRenameProject" catchtouchmove="preventTouchMove">
    <view class="interior-rename-sheet {{renameClosing ? 'interior-rename-sheet-closing' : ''}}" catchtap="stopEvent">
      <view class="interior-sheet-title">重命名项目</view>
      <input class="interior-form-control" maxlength="30" focus value="{{renameDraft}}" bindinput="onRenameInput" placeholder="输入项目名称" confirm-type="done" bindconfirm="saveRenameProject" />
      <view class="interior-sheet-actions">
        <button class="interior-sheet-button" bindtap="closeRenameProject">取消</button>
        <button class="interior-sheet-button interior-sheet-primary" disabled="{{workspaceError}}" bindtap="saveRenameProject">保存</button>
      </view>
    </view>
  </view>
</view>
