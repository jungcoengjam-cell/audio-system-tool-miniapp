 .ts-scroll{height:100vh;background:var(--theme-page-bg)}.ts-page{box-sizing:border-box;min-height:100vh;padding:42rpx 32rpx calc(46rpx + env(safe-area-inset-bottom));color:var(--tx)}.ts-title{font-size:58rpx;font-weight:700;line-height:1.18}.ts-step{margin-top:34rpx;color:var(--ts);font-size:23rpx}.ts-card,.ts-result{margin-top:16rpx;padding:28rpx;border:1rpx solid var(--td);border-radius:22rpx;background:var(--tv)}.ts-question,.ts-result-title{font-size:34rpx;font-weight:650;line-height:1.4}.ts-hint,.ts-action{margin-top:16rpx;color:var(--ts);font-size:24rpx;line-height:1.6}.ts-option,.ts-tool,.ts-back,.ts-action-button{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;width:100%;height:88rpx;min-height:44px;margin:16rpx 0 0;padding:0 26rpx;border:0;border-radius:18rpx;background:var(--tc);color:var(--tx);font-size:28rpx;line-height:1.3}.ts-arrow{color:var(--ts);font-size:38rpx}.ts-actions{display:flex;gap:6px;margin-top:24rpx}.ts-action-button{justify-content:center;width:auto;flex:1;margin:0;font-size:23rpx}.ts-tool,.ts-back{justify-content:center;background:var(--as);color:var(--ta);font-size:25rpx}.ts-safe{margin-top:28rpx;color:var(--tt);font-size:21rpx;line-height:1.6}.ts-error{padding-top:170rpx;text-align:center}.ts-error-title{font-size:32rpx;font-weight:650}.ts-error-text{margin-top:14rpx;color:var(--ts);font-size:24rpx}.ts-back{width:280rpx;margin:34rpx auto 0}
.ts-check{display:flex;align-items:flex-start;margin-top:14rpx;color:var(--tx);font-size:25rpx;line-height:1.55}.ts-check-mark{display:flex;flex:0 0 34rpx;width:34rpx;height:34rpx;margin:2rpx 12rpx 0 0;align-items:center;justify-content:center;border-radius:50%;background:var(--as);color:var(--ta);font-size:20rpx;font-weight:650}.ts-path-toggle{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;height:88rpx;min-height:44px;margin-top:22rpx;padding:0 18rpx;border:0;border-radius:14rpx;background:var(--tc);color:var(--tx);font-size:24rpx;font-weight:650}.ts-path-row{position:relative;display:block;box-sizing:border-box;width:100%;min-height:44px;margin:0;padding:14rpx 100rpx 14rpx 0;border:0;border-bottom:1rpx solid var(--td);border-radius:0;background:transparent;color:var(--tx);text-align:left}.ts-path-question{color:var(--tx);font-size:23rpx;line-height:1.45}.ts-path-answer{margin-top:4rpx;color:var(--ts);font-size:22rpx;line-height:1.45}.ts-edit-label{position:absolute;top:50%;right:0;transform:translateY(-50%);color:var(--ta);font-size:22rpx}.ts-feedback{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--td)}.ts-feedback-title{font-size:24rpx;font-weight:650}.ts-feedback-actions{display:flex;gap:6px}.ts-feedback-button{display:flex;box-sizing:border-box;width:calc((100% - 6px)/2);height:88rpx;min-height:44px;margin:6px 0 0;padding:0;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--tc);color:var(--tx);font-size:26rpx;line-height:1}.ts-feedback-selected{background:var(--as);color:var(--ta)}.ts-feedback-note{margin-top:10rpx;color:var(--ts);font-size:22rpx;line-height:1.55}.ts-option-selected{background:var(--as)}.ts-selected-label{color:var(--ta);font-size:22rpx}
