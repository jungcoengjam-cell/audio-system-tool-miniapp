<include src="workspace-header.wxml" />
<view class="workspace-tabs" wx:if="{{project}}">
  <button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-tab {{workspaceTab === 'devices' ? 'workspace-tab-active' : ''}}" data-tab="devices" bindtap="onWorkspaceTab">设备<text>{{deviceCount}}</text></button>
  <button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-tab {{workspaceTab === 'lines' ? 'workspace-tab-active' : ''}}" data-tab="lines" bindtap="onWorkspaceTab">线路<text>{{lineCount}}</text></button>
</view>
<view wx:if="{{project}}" class="workspace-search">
  <view class="workspace-search-symbol"></view><input class="workspace-search-input" value="{{searchText}}" maxlength="100" placeholder="{{workspaceTab === 'devices' ? '搜索设备' : '搜索设备或端口'}}" bindinput="onSearchInput" bindconfirm="applySearch" confirm-type="search" />
  <button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{searchText}}" class="workspace-icon-button workspace-search-clear" aria-label="清除搜索" bindtap="clearSearch">×</button>
</view>
<scroll-view class="workspace-scroll" scroll-y enhanced show-scrollbar="{{false}}" bindtap="onWorkspaceBackgroundTap" bindscroll="onWorkspaceListScroll">
  <view class="workspace-content">
    <view wx:if="{{loading}}" class="workspace-state"><view class="workspace-state-title">正在读取项目</view></view>
      <view wx:elif="{{loadError && !(loadErrorTitle === '请选择项目' && selectionRequired && !canRetry && !project)}}" class="workspace-state"><view class="workspace-state-title">{{loadErrorTitle}}</view><view class="workspace-state-text">{{loadError}}</view><button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{canRetry}}" class="workspace-soft-button" bindtap="retryLoad">重试</button></view>
    <block wx:elif="{{project && workspaceTab === 'devices'}}"><view class="workspace-tab-content">
      <view wx:if="{{!devices.length}}" class="workspace-state"><view class="workspace-state-symbol">⌁</view><view class="workspace-state-title">{{searchText ? '没有匹配的设备' : '添加项目的第一台设备'}}</view><view class="workspace-state-text">{{searchText ? '试试其他名称。' : '选择类型并命名，然后开始接线。'}}</view></view>
      <view wx:for="{{devices}}" wx:key="key" class="workspace-swipe-row {{item.swipeDragging ? 'workspace-swipe-row-dragging' : ''}} workspace-device-swipe-row {{item.swipeOpen ? 'workspace-swipe-row-open' : ''}} {{item.retiring ? 'workspace-row-retiring' : ''}} {{item.removalPhase === 'exit' ? 'workspace-row-retiring-exit' : ''}}" data-swipe-type="device" data-swipe-id="{{item.id}}" data-swipe-revision="{{scheduleRevision}}" data-retiring="{{item.retiring}}" aria-hidden="{{item.retiring}}" catchtap="stopEvent" bindtouchstart="onSwipeTouchStart" bindtouchmove="onSwipeTouchMove" bindtouchend="onSwipeTouchEnd" bindtouchcancel="onSwipeTouchCancel">
        <view wx:if="{{!item.retiring}}" aria-hidden="{{!item.swipeOpen}}" class="workspace-swipe-actions"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-swipe-delete" style="transform:translateX({{72 - item.swipeOffset}}px);" aria-label="删除设备 {{item.name}}" data-delete-type="device" data-action-type="delete" data-project-id="{{project.id}}" data-device-key="{{item.key}}" data-id="{{item.id}}" data-revision="{{scheduleRevision}}" disabled="{{!item.swipeOpen || saving || workspaceDeletingId === item.id}}" catchtap="deleteWorkspaceRecord"><view class="workspace-swipe-delete-icon" /></button></view>
        <view class="workspace-device-card workspace-swipe-content {{item.swipeDragging ? 'workspace-swipe-dragging' : ''}}" data-tap-key="device:{{item.id}}" style="transform:translateX(-{{item.swipeOffset}}px);" bindtap="onWorkspaceRowTap">
          <view class="workspace-device-icon device-icon-{{item.type}}"><view class="device-icon-body"><view class="device-icon-slot"></view><view class="device-icon-dot"></view><view class="device-icon-dot"></view></view></view>
          <view class="workspace-device-copy"><block wx:if="{{inlineRenameKey === item.key}}"><input id="wiring-device-inline-rename-name" data-focus-id="wiring-device-inline-rename-name" class="workspace-device-inline-rename-input" maxlength="100" value="{{inlineRenameValue}}" focus="{{inlineRenameFocus}}" hold-keyboard="{{true}}" confirm-type="done" data-inline-rename-input="true" data-action-type="rename-device" data-device-key="{{item.key}}" data-id="{{item.id}}" data-device-id="{{item.id}}" data-project-id="{{project.id}}" data-revision="{{scheduleRevision}}" data-rename-session-id="{{inlineRenameSessionId}}" bindinput="onInlineRenameInput" bindblur="onInlineRenameBlur" bindconfirm="onInlineRenameConfirm" aria-label="重命名设备 {{item.name}}" /></block><view wx:else hover-class="workspace-pressed" hover-stay-time="80" class="workspace-device-name-action" role="button" aria-label="重命名设备 {{item.name}}" data-action-type="rename-device" data-project-id="{{project.id}}" data-device-key="{{item.key}}" data-id="{{item.id}}" data-device-id="{{item.id}}" data-revision="{{scheduleRevision}}" catchtap="renameDevice"><text class="workspace-device-name workspace-wrapping-text">{{item.name}}</text></view><view class="workspace-device-meta">{{item.typeLabel}}<text wx:if="{{item.lineCount}}"> · {{item.lineCount}} 条线路</text></view></view>
           <button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{!item.retiring}}" class="workspace-connect-button" data-action-type="connect" data-project-id="{{project.id}}" data-device-key="{{item.key}}" data-id="{{item.id}}" data-revision="{{scheduleRevision}}" disabled="{{loading || saving || projectCreating}}" catchtap="connectDevice">＋ 接线</button>
        </view>
      </view>
    </view></block>
    <block wx:elif="{{project && workspaceTab === 'lines'}}"><view class="workspace-tab-content">
      <view wx:if="{{!groups.length}}" class="workspace-state"><view class="workspace-state-symbol">⌁</view><view class="workspace-state-title">{{searchText ? '没有匹配的线路' : '还没有线路'}}</view><view class="workspace-state-text">{{searchText ? '试试其他设备或端口。' : '从设备的“接线”开始，或直接添加线路。'}}</view></view>
      <view wx:for="{{groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key" class="workspace-line-group {{group.retiring ? 'workspace-line-group-retiring' : ''}} {{group.retiring && group.removalPhase === 'exit' ? 'workspace-line-group-retiring-exit' : ''}}" aria-hidden="{{group.retiring}}" style="{{group.retiring ? 'pointer-events:none;' : ''}}">
        <view class="workspace-line-group-inner">
        <view class="workspace-group-header" hover-class="workspace-pressed" hover-stay-time="80" catchtap="toggleGroup" role="button" aria-expanded="{{!group.collapsed}}" aria-label="{{group.collapsed ? '展开线路组' : '收起线路组'}}" data-key="{{group.key}}" bindtouchstart="onLineTouchStart" bindtouchmove="onLineTouchMove" bindtouchend="onLineTouchEnd" bindtouchcancel="onLineTouchCancel">
          <view class="workspace-group-name workspace-wrapping-text">{{group.fromDevice}}</view><text class="workspace-group-arrow">→</text><view class="workspace-group-name workspace-group-target workspace-wrapping-text">{{group.toDevice}}</view><view class="workspace-group-count">{{group.lineCount}}条</view><text class="workspace-group-chevron {{group.collapsed ? 'workspace-group-chevron-collapsed' : ''}}">⌃</text>
        </view>
        <view class="workspace-group-lines {{group.collapsed ? 'workspace-group-lines-collapsed' : ''}}" aria-hidden="{{group.collapsed}}"><view class="workspace-group-lines-inner">
          <view wx:for="{{group.lines}}" wx:for-item="line" wx:key="id" class="workspace-swipe-row {{line.swipeDragging ? 'workspace-swipe-row-dragging' : ''}} workspace-line-swipe-row {{line.swipeOpen ? 'workspace-swipe-row-open' : ''}} {{line.retiring && !group.retiring ? 'workspace-row-retiring' : ''}} {{line.retiring && !group.retiring && line.removalPhase === 'exit' ? 'workspace-row-retiring-exit' : ''}}" data-swipe-type="line" data-swipe-id="{{line.id}}" data-swipe-revision="{{scheduleRevision}}" data-group-index="{{groupIndex}}" data-retiring="{{line.retiring}}" aria-hidden="{{line.retiring}}" catchtap="stopEvent" bindtouchstart="onSwipeTouchStart" bindtouchmove="onSwipeTouchMove" bindtouchend="onSwipeTouchEnd" bindtouchcancel="onSwipeTouchCancel">
            <view wx:if="{{!line.retiring}}" aria-hidden="{{!line.swipeOpen}}" class="workspace-swipe-actions"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-swipe-delete" style="transform:translateX({{72 - line.swipeOffset}}px);" aria-label="删除线路 {{line.circleLabel}}" data-delete-type="line" data-action-type="delete" data-project-id="{{project.id}}" data-id="{{line.id}}" data-revision="{{scheduleRevision}}" disabled="{{!line.swipeOpen || saving || workspaceDeletingId === line.id}}" catchtap="deleteWorkspaceRecord"><view class="workspace-swipe-delete-icon" /></button></view>
            <view class="workspace-line-row workspace-swipe-content {{line.swipeDragging ? 'workspace-swipe-dragging' : ''}}" hover-class="workspace-pressed" hover-stay-time="80" style="transform:translateX(-{{line.swipeOffset}}px);" role="button" aria-label="查看线路{{line.circleLabel}}详情" data-id="{{line.id}}" data-retiring="{{line.retiring}}" bindtap="onLineTap">
              <view class="workspace-circle {{line.circleNumeric ? 'workspace-circle-numeric' : ''}}">{{line.circleLabel}}</view><view class="workspace-line-ports"><view class="workspace-port-cell workspace-wrapping-text">{{line.fromPort || '待补'}}</view><view class="workspace-port-divider"></view><view class="workspace-port-cell workspace-wrapping-text">{{line.toPort || '待补'}}</view></view><text class="workspace-line-chevron">›</text>
            </view>
          </view>
        </view></view>
        </view>
      </view>
    </view></block>
  </view>
</scroll-view>
<view wx:if="{{project && !loading}}" class="workspace-bottom-bar"><button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{workspaceTab === 'devices'}}" class="workspace-primary-button" disabled="{{loading || saving || projectCreating}}" bindtap="openDeviceEditor">＋ 添加设备</button><button hover-class="workspace-pressed" hover-stay-time="80" wx:else class="workspace-primary-button" disabled="{{loading || saving || projectCreating}}" bindtap="openNewLine">＋ 添加线路</button></view>

<view wx:if="{{projectPickerVisible || workspaceOverlayPhases.projectPicker === 'closing'}}" aria-hidden="{{!projectPickerVisible}}" class="wiring-mask workspace-mask workspace-wheel-mask {{workspaceOverlayPhases.projectPicker === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.projectPicker === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.projectPicker === 'preparing' ? 'workspace-overlay-preparing' : ''}}">
  <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="cancelProjectPicker"></view>
  <view class="wiring-sheet workspace-wheel-sheet" style="{{projectWheelSheetStyle}}" catchtap="stopEvent"><view class="wiring-sheet-handle"></view>
    <view class="workspace-wheel-toolbar"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-text-button workspace-wheel-cancel" bindtap="cancelProjectPicker">取消</button><view class="workspace-section-title">选择项目</view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-text-button workspace-done" disabled="{{projectPickerLoading || !projectPickerProjects.length}}" bindtap="confirmProjectPicker">完成</button></view>
    <view wx:if="{{projectPickerLoading}}" class="workspace-state-text workspace-wheel-message">正在读取项目…</view>
    <view wx:elif="{{projectPickerError}}" class="wiring-form-error">{{projectPickerError}}</view>
    <picker-view wx:elif="{{projectPickerProjects.length}}" class="workspace-project-wheel" style="height:{{projectWheelHeight}}px;" value="{{wheelProjectIndex}}" indicator-style="{{projectWheelIndicatorStyle}}" mask-style="{{projectWheelMaskStyle}}" bindchange="onProjectWheelChange"><picker-view-column><view wx:for="{{projectPickerProjects}}" wx:key="id" class="workspace-wheel-item {{index === wheelProjectIndex[0] ? 'workspace-wheel-item-selected' : ''}}" style="height:{{projectWheelRowHeight}}px;line-height:{{projectWheelRowHeight}}px;">{{item.name}}</view></picker-view-column></picker-view>
    <view wx:else class="workspace-wheel-empty"><view class="workspace-state-text">还没有项目</view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-soft-button" bindtap="requestNewProject">新建项目</button></view>
  </view>
</view>

<view wx:if="{{newProjectVisible || workspaceOverlayPhases.newProject === 'closing'}}" aria-hidden="{{!newProjectVisible}}" class="wiring-mask workspace-mask {{workspaceOverlayPhases.newProject === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.newProject === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.newProject === 'preparing' ? 'workspace-overlay-preparing' : ''}}">
  <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="closeNewProject"></view>
  <view class="wiring-sheet workspace-new-project-sheet" catchtap="stopEvent"><view class="wiring-sheet-handle"></view><view class="workspace-sheet-heading"><view class="workspace-sheet-title">新建项目</view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-close-button" aria-label="关闭" disabled="{{projectCreating}}" bindtap="closeNewProject">×</button></view><view class="workspace-field-label">项目名称</view><input class="workspace-control" value="{{projectPickerName}}" maxlength="30" placeholder="输入项目名称" bindinput="onProjectNameInput" bindconfirm="createAndOpenProject" confirm-type="done" /><view wx:if="{{projectPickerError}}" class="wiring-form-error">{{projectPickerError}}</view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-primary-button workspace-new-project-save" loading="{{projectCreating}}" disabled="{{projectCreating}}" bindtap="createAndOpenProject">新建项目</button></view>
</view>

<view wx:if="{{deviceEditorVisible || workspaceOverlayPhases.deviceEditor === 'closing'}}" aria-hidden="{{!deviceEditorVisible}}" class="wiring-mask workspace-mask {{workspaceOverlayPhases.deviceEditor === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.deviceEditor === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.deviceEditor === 'preparing' ? 'workspace-overlay-preparing' : ''}}" style="{{formFrameStyle}}">
  <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="requestCloseDeviceEditor"></view>
  <view class="wiring-sheet workspace-device-sheet" style="{{formSheetStyle}}" catchtap="stopEvent"><view class="wiring-sheet-handle"></view><view class="workspace-sheet-heading workspace-centered-sheet-heading"><view class="workspace-editor-heading-space"></view><view class="workspace-centered-heading-copy"><view class="workspace-sheet-title">新增设备</view><view class="workspace-editor-project">{{project.name}}</view></view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-close-button" aria-label="关闭" disabled="{{saving}}" bindtap="requestCloseDeviceEditor">×</button></view>
    <scroll-view class="wiring-sheet-scroll wiring-batch-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{formScrollTop}}">
      <view class="workspace-field-label">设备类型</view><view class="workspace-device-types"><button hover-class="workspace-pressed" hover-stay-time="80" wx:for="{{deviceOptions}}" wx:key="id" class="workspace-type-tile {{deviceDraft.type === item.id ? 'workspace-type-selected' : ''}}" data-type="{{item.id}}" disabled="{{saving}}" bindtap="onDeviceType"><text wx:if="{{deviceDraft.type === item.id}}" class="workspace-type-check">✓</text><view class="workspace-device-icon device-icon-{{item.id}}"><view class="device-icon-body"><view class="device-icon-slot"></view><view class="device-icon-dot"></view><view class="device-icon-dot"></view></view></view><text>{{item.label}}</text></button></view>
      <view class="workspace-field-label workspace-field-label-spaced">设备名称</view><input id="wiring-device-name" data-focus-id="wiring-device-name" class="workspace-control" maxlength="100" value="{{deviceDraft.name}}" data-field="name" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDeviceDraftInput" placeholder="输入设备名称" />
      <view class="workspace-stepper-row"><view class="workspace-field-label">数量</view><view class="workspace-stepper"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-step-button" data-delta="-1" disabled="{{saving || deviceDraft.count <= 1}}" aria-label="减少设备数量" bindtap="onDeviceCountStep">−</button><input id="wiring-device-count" data-focus-id="wiring-device-count" class="workspace-step-input" type="number" maxlength="2" value="{{deviceDraft.count}}" data-field="count" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDeviceDraftInput" /><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-step-button" data-delta="1" disabled="{{saving || deviceDraft.count >= 32}}" aria-label="增加设备数量" bindtap="onDeviceCountStep">＋</button></view></view>
      <view class="workspace-preview-label">将添加</view><view class="workspace-device-preview"><view wx:for="{{deviceNamePreview}}" wx:key="*this" class="workspace-name-chip">{{item}}</view></view><view wx:if="{{deviceFormError}}" class="wiring-form-error">{{deviceFormError}}</view><view wx:if="{{batchError}}" class="wiring-save-error">{{batchError}}</view><view class="wiring-sheet-keyboard-space" style="height:{{formKeyboardSpacerHeight}}px;"></view>
    </scroll-view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-primary-button workspace-sheet-save" disabled="{{saving || !deviceNamePreview.length}}" loading="{{saving}}" bindtap="saveDevices">添加 {{deviceNamePreview.length || ''}} 台设备</button>
  </view>
</view>

<view wx:if="{{(detailVisible && detailLine) || workspaceOverlayPhases.lineDetails === 'closing'}}" aria-hidden="{{!detailVisible}}" class="wiring-mask workspace-mask workspace-detail-mask {{workspaceOverlayPhases.lineDetails === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.lineDetails === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.lineDetails === 'preparing' ? 'workspace-overlay-preparing' : ''}}">
  <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="closeLineDetails"></view><view class="wiring-sheet workspace-detail-sheet" catchtap="stopEvent"><view class="wiring-sheet-handle"></view>
    <view class="workspace-sheet-heading"><view class="workspace-detail-title"><view class="workspace-circle {{detailLine.circleNumeric ? 'workspace-circle-numeric' : ''}}">{{detailLine.circleLabel}}</view><view class="workspace-sheet-title">线路详情</view></view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-close-button" aria-label="关闭" bindtap="closeLineDetails">×</button></view>
    <view class="workspace-detail-route"><view class="workspace-detail-endpoint-column"><view class="workspace-field-label">来源</view><scroll-view class="workspace-detail-endpoint" scroll-x show-scrollbar="{{false}}"><view class="workspace-nowrap">{{detailLine.fromDeviceName}}<text class="workspace-endpoint-dot"> · </text>{{detailLine.fromPort || '待补'}}</view></scroll-view></view><view class="workspace-detail-direction">→</view><view class="workspace-detail-endpoint-column"><view class="workspace-field-label">去向</view><scroll-view class="workspace-detail-endpoint" scroll-x show-scrollbar="{{false}}"><view class="workspace-nowrap">{{detailLine.toDeviceName}}<text class="workspace-endpoint-dot"> · </text>{{detailLine.toPort || '待补'}}</view></scroll-view></view></view>
    <view class="workspace-detail-cable"><view class="workspace-cable-spec">{{detailLine.specLabel}}<text> · </text>{{detailLine.lengthLabel}}</view><view class="workspace-cable-stroke"><view class="workspace-cable-dot"></view><view class="workspace-cable-dot"></view></view><view class="workspace-cable-connectors"><view>{{detailLine.connectorALabel}}</view><view>{{detailLine.connectorBLabel}}</view></view></view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-primary-button" bindtap="editDetailLine">编辑线路</button>
  </view>
</view>

<view wx:if="{{(editorVisible && !continuousVisible) || workspaceOverlayPhases.lineEditor === 'closing'}}" aria-hidden="{{!editorVisible || continuousVisible}}" class="wiring-mask workspace-mask {{workspaceOverlayPhases.lineEditor === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.lineEditor === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.lineEditor === 'preparing' ? 'workspace-overlay-preparing' : ''}}" style="{{formFrameStyle}}">
  <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="requestCloseEditor"></view>
  <view class="wiring-sheet wiring-edit-sheet workspace-editor-sheet" style="{{formSheetStyle}}" catchtap="stopEvent"><view class="wiring-sheet-handle"></view>
    <view class="workspace-editor-heading"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-close-button" aria-label="关闭" disabled="{{saving}}" bindtap="requestCloseEditor">×</button><view class="workspace-editor-title-copy"><view class="workspace-editor-title"><view wx:if="{{!draftIsNew}}" class="workspace-circle {{draftCircleNumeric ? 'workspace-circle-numeric' : ''}}">{{draftCircleLabel}}</view><text>{{draftIsNew ? '添加线路' : '编辑线路'}}</text></view><view class="workspace-editor-project">{{project.name}}</view></view><view class="workspace-editor-heading-space"></view></view>
    <scroll-view class="wiring-sheet-scroll wiring-editor-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{formScrollTop}}" scroll-into-view="{{formScrollTarget}}">
      <view class="workspace-editor-section"><view class="workspace-section-title">连接设备</view><view class="workspace-endpoint-pickers">
        <view id="wiring-field-from-device" class="workspace-endpoint-picker"><view class="workspace-field-label">来源设备</view><picker range="{{fromDeviceChoices}}" range-key="choiceLabel" value="{{fromDeviceIndex}}" data-side="from" disabled="{{saving}}" bindchange="selectEndpoint"><view class="workspace-control workspace-picker-control {{formFieldErrors.fromDevice ? 'workspace-control-error' : ''}}"><text>{{draft.fromDevice || '选择设备'}}</text><text class="workspace-picker-arrow">⌄</text></view></picker></view><text class="workspace-endpoint-arrow">→</text><view id="wiring-field-to-device" class="workspace-endpoint-picker"><view class="workspace-field-label">去向设备</view><picker range="{{toDeviceChoices}}" range-key="choiceLabel" value="{{toDeviceIndex}}" data-side="to" disabled="{{saving}}" bindchange="selectEndpoint"><view class="workspace-control workspace-picker-control {{formFieldErrors.toDevice ? 'workspace-control-error' : ''}}"><text>{{draft.toDevice || '选择设备'}}</text><text class="workspace-picker-arrow">⌄</text></view></picker></view>
      </view><view wx:if="{{deviceChoices.length <= 1}}" class="workspace-no-devices">请先在设备页添加设备。</view></view>
      <view class="workspace-editor-section"><view class="workspace-section-heading"><view class="workspace-section-title">端口对应</view><button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{draftIsNew}}" class="workspace-text-button workspace-continuous-button" disabled="{{saving}}" bindtap="openContinuous">连续添加</button></view><view class="workspace-port-labels"><text>来源端口</text><text>去向端口</text></view>
        <view wx:for="{{draftPairs}}" wx:key="key" class="workspace-pair-row"><view class="workspace-pair-fields"><input id="wiring-pair-{{index}}-from" data-focus-id="wiring-pair-{{index}}-from" class="workspace-control {{pairErrors[index].fromPort ? 'workspace-control-error' : ''}}" value="{{item.fromPort}}" maxlength="80" data-index="{{index}}" data-field="fromPort" disabled="{{saving}}" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onPairInput" placeholder="填写端口" /><text class="workspace-pair-arrow">→</text><input id="wiring-pair-{{index}}-to" data-focus-id="wiring-pair-{{index}}-to" class="workspace-control {{pairErrors[index].toPort ? 'workspace-control-error' : ''}}" value="{{item.toPort}}" maxlength="80" data-index="{{index}}" data-field="toPort" disabled="{{saving}}" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onPairInput" placeholder="填写端口" /></view><button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{draftIsNew && draftPairs.length > 1}}" class="workspace-pair-remove" aria-label="移除这条草稿" data-index="{{index}}" disabled="{{saving}}" bindtap="removeDraftPair">−</button></view>
        <button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{draftIsNew}}" class="workspace-add-pair" disabled="{{saving || draftPairs.length >= 32}}" bindtap="addDraftPair">＋ 增加一条</button>
      </view>
      <view class="workspace-editor-section"><view class="workspace-section-title">线缆信息</view><view class="workspace-two-fields">
        <view class="workspace-field"><view class="workspace-field-label">来源接头</view><picker range="{{connectorOptions}}" range-key="label" value="{{connectorAIndex}}" data-field="connectorA" disabled="{{saving}}" bindchange="onOptionChange"><view class="workspace-control workspace-picker-control"><text>{{connectorOptions[connectorAIndex].label}}</text><text class="workspace-picker-arrow">⌄</text></view></picker><input wx:if="{{connectorAIndex === customConnectorIndex}}" id="wiring-editor-connector-a" data-focus-id="wiring-editor-connector-a" class="workspace-control workspace-custom-connector" maxlength="60" value="{{customConnectorA}}" data-field="connectorA" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onCustomConnectorInput" placeholder="填写接头" /></view>
        <view class="workspace-field"><view class="workspace-field-label">去向接头</view><picker range="{{connectorOptions}}" range-key="label" value="{{connectorBIndex}}" data-field="connectorB" disabled="{{saving}}" bindchange="onOptionChange"><view class="workspace-control workspace-picker-control"><text>{{connectorOptions[connectorBIndex].label}}</text><text class="workspace-picker-arrow">⌄</text></view></picker><input wx:if="{{connectorBIndex === customConnectorIndex}}" id="wiring-editor-connector-b" data-focus-id="wiring-editor-connector-b" class="workspace-control workspace-custom-connector" maxlength="60" value="{{customConnectorB}}" data-field="connectorB" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onCustomConnectorInput" placeholder="填写接头" /></view>
      </view><view class="workspace-spec-length-fields"><view class="workspace-field"><view class="workspace-field-label">规格</view><input id="wiring-editor-spec" data-focus-id="wiring-editor-spec" class="workspace-control" maxlength="120" value="{{draft.spec}}" data-field="spec" disabled="{{saving}}" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="待补" /></view><view class="workspace-field"><view class="workspace-field-label">{{draftIsNew ? '每条长度' : '长度'}}</view><view class="workspace-length-control"><input id="wiring-editor-length" data-focus-id="wiring-editor-length" class="workspace-control" type="digit" maxlength="24" value="{{draft.lengthText}}" data-field="lengthText" disabled="{{saving}}" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="待补" /><text>m</text></view></view></view></view>
      <view wx:if="{{formError}}" class="wiring-form-error">{{formError}}</view><view wx:if="{{saveError}}" class="wiring-save-error">{{saveError}}</view><button hover-class="workspace-pressed" hover-stay-time="80" wx:if="{{!draftIsNew}}" class="workspace-delete-button" disabled="{{saving || workspaceEditorDeleting}}" bindtap="deleteLine">删除线路</button><view class="wiring-sheet-keyboard-space" style="height:{{formKeyboardSpacerHeight}}px;"></view>
    </scroll-view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-primary-button workspace-sheet-save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveLine">{{draftIsNew ? '保存 ' + draftPairs.length + ' 条线路' : '保存修改'}}</button>
  </view>
</view>

<view wx:if="{{(editorVisible && continuousVisible) || workspaceOverlayPhases.continuous === 'closing'}}" aria-hidden="{{!continuousVisible}}" class="wiring-mask workspace-mask workspace-continuous-mask {{workspaceOverlayPhases.continuous === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.continuous === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.continuous === 'preparing' ? 'workspace-overlay-preparing' : ''}}" style="{{formFrameStyle}}"><view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="closeContinuous"></view><view class="wiring-sheet workspace-continuous-sheet" style="{{formSheetStyle}}" catchtap="stopEvent"><view class="wiring-sheet-handle"></view><view class="workspace-sheet-heading"><view class="workspace-sheet-title">连续添加端口</view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-close-button" aria-label="关闭" bindtap="closeContinuous">×</button></view><scroll-view class="wiring-sheet-scroll wiring-editor-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{formScrollTop}}">
  <view class="workspace-continuous-route">{{draft.fromDevice || '来源设备'}}<text> → </text>{{draft.toDevice || '去向设备'}}</view><view class="workspace-endpoint-pickers workspace-continuous-fields"><view class="workspace-endpoint-picker"><view class="workspace-field-label">来源起始端口</view><input id="wiring-continuous-from" data-focus-id="wiring-continuous-from" class="workspace-control" maxlength="80" value="{{continuousDraft.fromPort}}" data-field="fromPort" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onContinuousInput" placeholder="例如 OUT1" /></view><text class="workspace-endpoint-arrow">→</text><view class="workspace-endpoint-picker"><view class="workspace-field-label">去向起始端口</view><input id="wiring-continuous-to" data-focus-id="wiring-continuous-to" class="workspace-control" maxlength="80" value="{{continuousDraft.toPort}}" data-field="toPort" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onContinuousInput" placeholder="例如 IN1" /></view></view>
  <view class="workspace-stepper-row"><view class="workspace-field-label">数量</view><view class="workspace-stepper"><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-step-button" data-delta="-1" aria-label="减少线路数量" disabled="{{continuousDraft.count <= 1}}" bindtap="onContinuousCountStep">−</button><input id="wiring-continuous-count" data-focus-id="wiring-continuous-count" class="workspace-step-input" type="number" maxlength="2" value="{{continuousDraft.count}}" data-field="count" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onContinuousInput" /><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-step-button" data-delta="1" aria-label="增加线路数量" disabled="{{continuousDraft.count >= 32}}" bindtap="onContinuousCountStep">＋</button></view></view><view class="workspace-continuous-hint">端口末尾数字依次递增，填入后仍可修改。</view><view wx:if="{{continuousError}}" class="wiring-form-error">{{continuousError}}</view><view wx:if="{{continuousPairs.length}}" class="workspace-continuous-preview"><view class="workspace-preview-label">配对预览 · {{continuousPairs.length}} 条</view><view wx:for="{{continuousPairs}}" wx:key="index" class="workspace-continuous-preview-row"><text class="workspace-preview-ordinal">{{index + 1}}</text><text>{{item.fromPort}}</text><text class="workspace-pair-arrow">→</text><text>{{item.toPort}}</text></view></view><view class="wiring-sheet-keyboard-space" style="height:{{formKeyboardSpacerHeight}}px;"></view>
  </scroll-view><button hover-class="workspace-pressed" hover-stay-time="80" class="workspace-primary-button workspace-sheet-save" disabled="{{!continuousPairs.length}}" bindtap="fillContinuous">填入 {{continuousPairs.length || ''}} 条端口</button></view></view>
