<view class="wiring-page">
  <scroll-view class="wiring-scroll" scroll-y="{{!projectPickerVisible && !editorVisible && !batchVisible && !reportPreviewVisible}}" enhanced show-scrollbar="{{false}}" enable-flex="true">
    <view class="wiring-content">
      <block wx:if="{{project && !loadError}}">
        <view class="wiring-heading">
          <view class="wiring-title">通道与线缆</view>
          <view class="wiring-project-row">
            <view class="wiring-project-name">{{project.name}}</view>
            <button class="wiring-project-switch" bindtap="requestProjectPicker">切换项目</button>
          </view>
        </view>

        <view class="wiring-tabs" role="tablist">
          <button class="wiring-tab {{activeTab === 'lines' ? 'wiring-tab-active' : ''}}" data-tab="lines" bindtap="selectTab">线路</button>
          <button class="wiring-tab {{activeTab === 'materials' ? 'wiring-tab-active' : ''}}" data-tab="materials" bindtap="selectTab">材料</button>
        </view>

        <block wx:if="{{activeTab === 'lines'}}">
          <view class="wiring-summary-row">
            <view class="wiring-summary-count"><text class="wiring-summary-number">{{lineCount}}</text><text>条线路</text></view>
            <view class="wiring-summary-status">待接 {{statusCounts.pending}} · 已接 {{statusCounts.connected}} · 已核对 {{statusCounts.checked}}</view>
          </view>

          <view class="wiring-search">
            <text class="wiring-search-icon">⌕</text>
            <input class="wiring-search-input" value="{{searchText}}" confirm-type="search" bindinput="onSearchInput" bindconfirm="applySearch" placeholder="搜索设备、端口、线号或用途" />
            <button wx:if="{{searchText}}" class="wiring-search-clear" bindtap="clearSearch">清除</button>
          </view>

          <view class="wiring-list" wx:if="{{visibleLines.length}}">
            <view wx:for="{{visibleLines}}" wx:key="id" class="wiring-line-card" data-id="{{item.id}}" bindtap="editLine">
              <view class="wiring-line-top">
                <view class="wiring-line-code">{{item.code}}</view>
                <view class="wiring-status wiring-status-{{item.status}}">{{item.statusLabel}}</view>
              </view>
              <view wx:if="{{item.purpose}}" class="wiring-line-purpose">{{item.purpose}}</view>
              <view class="wiring-route">
                <view class="wiring-endpoint">
                  <view class="wiring-endpoint-label">来源</view>
                  <view class="wiring-endpoint-value">{{item.fromDevice}}</view>
                  <view class="wiring-endpoint-port">{{item.fromPort}}</view>
                </view>
                <view class="wiring-route-arrow">→</view>
                <view class="wiring-endpoint wiring-endpoint-right">
                  <view class="wiring-endpoint-label">去向</view>
                  <view class="wiring-endpoint-value">{{item.toDevice}}</view>
                  <view class="wiring-endpoint-port">{{item.toPort}}</view>
                </view>
              </view>
              <view class="wiring-line-meta">
                <text>{{item.cableTypeLabel}} · {{item.spec || '规格待填'}}</text>
                <text>{{item.lengthText ? item.lengthText + ' m' : '长度待填'}}</text>
              </view>
            </view>
          </view>

          <view wx:elif="{{lineCount}}" class="wiring-empty wiring-empty-small">
            <view class="wiring-empty-title">没有匹配的线路</view>
            <view class="wiring-empty-text">试试线号、设备名或端口名。</view>
          </view>
          <view wx:else class="wiring-empty">
            <view class="wiring-empty-icon">⌁</view>
            <view class="wiring-empty-title">从第一条线路开始</view>
            <view class="wiring-empty-text">填写来源、去向和线材信息，长度可以留空。</view>
            <button class="wiring-empty-action" bindtap="openNewLine">添加线路</button>
          </view>
        </block>

        <block wx:else>
          <view class="wiring-material-intro">
            <view class="wiring-material-title">材料清单</view>
            <view class="wiring-material-subtitle">成品线按长度和两端端头归类</view>
          </view>
          <view wx:if="{{materialGroups.length}}" class="wiring-material-list">
            <view wx:for="{{materialGroups}}" wx:key="key" class="wiring-material-card">
              <view class="wiring-material-card-top">
                <view class="wiring-material-name">{{item.title}}</view>
                <view class="wiring-material-count">{{item.count}}</view>
              </view>
              <view class="wiring-material-meta">{{item.subtitle}}</view>
            </view>
          </view>
          <view wx:else class="wiring-empty wiring-material-empty">
            <view class="wiring-empty-icon">▤</view>
            <view class="wiring-empty-title">暂时没有材料清单</view>
            <view class="wiring-empty-text">添加线路后，会按成品线长度和两端端头整理。</view>
          </view>
        </block>

        <view wx:if="{{activeTab === 'lines'}}" class="wiring-export-row">
          <picker range="{{exportTypes}}" range-key="label" value="{{exportTypeIndex}}" bindchange="selectExportType">
            <view class="wiring-export-picker"><text class="wiring-export-image-tag">图片内容</text><text>{{exportTypes[exportTypeIndex].label}}</text><text class="wiring-picker-arrow">⌄</text></view>
          </picker>
          <button class="wiring-export-button" bindtap="generateExport">导出{{exportTypes[exportTypeIndex].id === 'labels' ? '两端线号' : exportTypes[exportTypeIndex].label}}</button>
        </view>
      </block>

      <view wx:elif="{{loading}}" class="wiring-loading">正在读取项目布线…</view>
      <view wx:elif="{{selectionRequired}}" class="wiring-empty wiring-selection-empty">
        <view class="wiring-empty-icon">⌂</view>
        <view class="wiring-empty-title">先选择一个项目</view>
        <view class="wiring-empty-text">布线会保存到你选择的项目中。</view>
        <button class="wiring-empty-action" bindtap="requestProjectPicker">选择项目</button>
      </view>
      <view wx:else class="wiring-empty wiring-load-error">
        <view class="wiring-empty-icon">!</view>
        <view class="wiring-empty-title">{{loadErrorTitle}}</view>
        <view class="wiring-empty-text">{{loadError}}</view>
        <button wx:if="{{canRetry}}" class="wiring-empty-action" bindtap="retryLoad">重新读取</button>
        <button class="wiring-empty-action wiring-empty-action-secondary" bindtap="requestProjectPicker">重新选择项目</button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{project && !loadError && !editorVisible && !batchVisible && !reportPreviewVisible}}" class="wiring-bottom-bar">
    <block wx:if="{{activeTab === 'lines'}}">
      <button class="wiring-bottom-button wiring-bottom-secondary" bindtap="openBatch">批量添加</button>
      <button class="wiring-bottom-button wiring-bottom-primary" bindtap="openNewLine">添加线路</button>
    </block>
    <block wx:else>
      <button class="wiring-bottom-button wiring-bottom-primary" bindtap="generateMaterialList">生成清单</button>
      <button class="wiring-bottom-button wiring-bottom-secondary" bindtap="copyCurrentText">复制文字</button>
    </block>
  </view>

  <view wx:if="{{projectPickerVisible}}" class="wiring-mask wiring-project-picker-mask">
    <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="cancelProjectPicker"></view>
    <view class="wiring-sheet wiring-project-picker-sheet" catchtap="stopEvent">
      <view class="wiring-sheet-handle"></view>
      <view class="wiring-sheet-heading">
        <view>
          <view class="wiring-sheet-title">选择项目</view>
        </view>
        <button class="wiring-close-button" bindtap="cancelProjectPicker">关闭</button>
      </view>
      <scroll-view class="wiring-sheet-scroll wiring-project-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{projectPickerLoading}}" class="wiring-project-picker-message">正在读取项目…</view>
        <view wx:elif="{{projectPickerProjects.length}}" class="wiring-project-options">
          <button wx:for="{{projectPickerProjects}}" wx:key="id" class="wiring-project-option" data-id="{{item.id}}" bindtap="selectProject">
            <view class="wiring-project-option-copy">
              <view class="wiring-project-option-name">{{item.name}}</view>
            </view>
            <view class="wiring-project-option-meta">
              <view wx:if="{{project && item.id === project.id}}" class="wiring-project-current">正在查看</view>
              <view class="wiring-project-option-count">{{item.lineCount}} 条线路</view>
            </view>
          </button>
        </view>
        <view wx:elif="{{!projectPickerError}}" class="wiring-project-picker-message">还没有项目，可在下方新建。</view>
        <view class="wiring-sheet-bottom-space"></view>
      </scroll-view>
      <view class="wiring-project-create">
        <view class="wiring-field-label">新建项目</view>
        <input class="wiring-control" maxlength="30" value="{{projectPickerName}}" bindinput="onProjectNameInput" placeholder="输入项目名称" />
        <view wx:if="{{projectPickerError}}" class="wiring-form-error">{{projectPickerError}}</view>
      </view>
      <view class="wiring-sheet-actions wiring-project-picker-actions">
        <button class="wiring-sheet-action wiring-sheet-cancel" bindtap="cancelProjectPicker">取消</button>
        <button class="wiring-sheet-action wiring-sheet-primary" loading="{{projectCreating}}" disabled="{{projectCreating}}" bindtap="createAndOpenProject">新建并进入</button>
      </view>
    </view>
  </view>

  <view wx:if="{{editorVisible}}" class="wiring-mask" style="{{formFrameStyle}}">
    <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="requestCloseEditor"></view>
    <view class="wiring-sheet wiring-edit-sheet" style="{{formSheetStyle}}" catchtap="stopEvent">
      <view class="wiring-sheet-handle"></view>
      <view class="wiring-sheet-heading">
        <view>
          <view class="wiring-sheet-title">{{draftIsNew ? '添加线路' : '编辑线路'}}</view>
          <view class="wiring-sheet-subtitle">{{draftCode || '保存后自动分配线号'}}</view>
        </view>
        <button class="wiring-close-button" bindtap="requestCloseEditor">关闭</button>
      </view>
      <scroll-view class="wiring-sheet-scroll wiring-editor-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{formScrollTarget}}" scroll-top="{{formScrollTop}}">
        <view class="wiring-form-section wiring-editor-section wiring-editor-route-section" id="formScrollTarget">
          <view class="wiring-form-section-title">来源 → 去向 <text>必填设备和端口</text></view>
          <view class="wiring-editor-route-stack">
            <view class="wiring-editor-endpoint">
              <view class="wiring-editor-endpoint-title">来源</view>
              <view class="wiring-editor-endpoint-fields">
                <view class="wiring-form-field">
                  <view class="wiring-field-label">设备</view>
                  <view class="wiring-editor-input-row">
                    <input id="wiring-editor-from-device" data-focus-id="wiring-editor-from-device" class="wiring-control" maxlength="100" value="{{draft.fromDevice}}" data-field="fromDevice" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="输入设备名称" />
                    <picker wx:if="{{fromDeviceHistory.length}}" class="wiring-edit-history-picker" range="{{fromDeviceHistory}}" value="0" data-field="fromDevice" bindchange="chooseHistoryValue" aria-label="选择已有来源设备">
                      <view class="wiring-history-picker-trigger">选用</view>
                    </picker>
                  </view>
                </view>
                <view class="wiring-form-field">
                  <view class="wiring-field-label">端口</view>
                  <view class="wiring-editor-input-row">
                    <input id="wiring-editor-from-port" data-focus-id="wiring-editor-from-port" class="wiring-control" maxlength="80" value="{{draft.fromPort}}" data-field="fromPort" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="输入端口名称" />
                    <picker wx:if="{{fromPortHistory.length}}" class="wiring-edit-history-picker" range="{{fromPortHistory}}" value="0" data-field="fromPort" bindchange="chooseHistoryValue" aria-label="选择已有来源端口">
                      <view class="wiring-history-picker-trigger">选用</view>
                    </picker>
                  </view>
                </view>
              </view>
              <view class="wiring-editor-connector-field">
                <view class="wiring-field-label">来源端头</view>
                <picker range="{{connectorOptions}}" range-key="label" value="{{connectorAIndex}}" data-field="connectorA" bindchange="onOptionChange">
                  <view class="wiring-control wiring-picker-control wiring-editor-connector-picker"><text class="wiring-editor-connector-name">{{connectorOptions[connectorAIndex].label}}</text><text class="wiring-picker-arrow">⌄</text></view>
                </picker>
                <input wx:if="{{connectorAIndex === customConnectorIndex}}" id="wiring-editor-connector-a" data-focus-id="wiring-editor-connector-a" class="wiring-control wiring-custom-connector" maxlength="60" value="{{customConnectorA}}" data-field="connectorA" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onCustomConnectorInput" placeholder="输入来源端头名称" />
              </view>
            </view>

            <view class="wiring-editor-direction" aria-hidden="true">↓</view>

            <view class="wiring-editor-endpoint">
              <view class="wiring-editor-endpoint-title">去向</view>
              <view class="wiring-editor-endpoint-fields">
                <view class="wiring-form-field">
                  <view class="wiring-field-label">设备</view>
                  <view class="wiring-editor-input-row">
                    <input id="wiring-editor-to-device" data-focus-id="wiring-editor-to-device" class="wiring-control" maxlength="100" value="{{draft.toDevice}}" data-field="toDevice" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="输入设备名称" />
                    <picker wx:if="{{toDeviceHistory.length}}" class="wiring-edit-history-picker" range="{{toDeviceHistory}}" value="0" data-field="toDevice" bindchange="chooseHistoryValue" aria-label="选择已有去向设备">
                      <view class="wiring-history-picker-trigger">选用</view>
                    </picker>
                  </view>
                </view>
                <view class="wiring-form-field">
                  <view class="wiring-field-label">端口</view>
                  <view class="wiring-editor-input-row">
                    <input id="wiring-editor-to-port" data-focus-id="wiring-editor-to-port" class="wiring-control" maxlength="80" value="{{draft.toPort}}" data-field="toPort" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="输入端口名称" />
                    <picker wx:if="{{toPortHistory.length}}" class="wiring-edit-history-picker" range="{{toPortHistory}}" value="0" data-field="toPort" bindchange="chooseHistoryValue" aria-label="选择已有去向端口">
                      <view class="wiring-history-picker-trigger">选用</view>
                    </picker>
                  </view>
                </view>
              </view>
              <view class="wiring-editor-connector-field">
                <view class="wiring-field-label">去向端头</view>
                <picker range="{{connectorOptions}}" range-key="label" value="{{connectorBIndex}}" data-field="connectorB" bindchange="onOptionChange">
                  <view class="wiring-control wiring-picker-control wiring-editor-connector-picker"><text class="wiring-editor-connector-name">{{connectorOptions[connectorBIndex].label}}</text><text class="wiring-picker-arrow">⌄</text></view>
                </picker>
                <input wx:if="{{connectorBIndex === customConnectorIndex}}" id="wiring-editor-connector-b" data-focus-id="wiring-editor-connector-b" class="wiring-control wiring-custom-connector" maxlength="60" value="{{customConnectorB}}" data-field="connectorB" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onCustomConnectorInput" placeholder="输入去向端头名称" />
              </view>
            </view>
          </view>
          <view wx:if="{{formError}}" class="wiring-form-error">{{formError}}</view>
        </view>

        <view class="wiring-form-section wiring-editor-section">
          <view class="wiring-form-section-title">线材信息</view>
          <view class="wiring-option-grid wiring-editor-cable-grid">
            <view class="wiring-form-field">
              <view class="wiring-field-label">制作方式</view>
              <picker range="{{buildOptions}}" range-key="label" value="{{buildIndex}}" data-field="buildType" bindchange="onOptionChange">
                <view class="wiring-control wiring-picker-control">{{buildOptions[buildIndex].label}}<text class="wiring-picker-arrow">⌄</text></view>
              </picker>
            </view>
            <view class="wiring-form-field">
              <view class="wiring-field-label">线材类型</view>
              <picker range="{{cableOptions}}" range-key="label" value="{{cableIndex}}" data-field="cableType" bindchange="onOptionChange">
                <view class="wiring-control wiring-picker-control">{{cableOptions[cableIndex].label}}<text class="wiring-picker-arrow">⌄</text></view>
              </picker>
            </view>
            <view class="wiring-form-field wiring-field-wide">
              <view class="wiring-field-label">型号与规格</view>
              <input id="wiring-editor-spec" data-focus-id="wiring-editor-spec" class="wiring-control" maxlength="120" value="{{draft.spec}}" data-field="spec" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="{{specOptions.length ? '例如：' + specOptions[0] : '输入型号与规格'}}" />
              <view wx:if="{{specOptionViews.length}}" class="wiring-spec-options">
                <button wx:for="{{specOptionViews}}" wx:key="value" class="wiring-spec-option {{item.value === draft.spec ? 'wiring-spec-option-selected' : ''}}" hover-class="wiring-spec-option-pressed" data-value="{{item.value}}" bindtap="chooseSpecPreset">
                  <text class="wiring-spec-option-model">{{item.model}}</text>
                  <text class="wiring-spec-option-size">{{item.size}}</text>
                  <text wx:if="{{item.value === draft.spec}}" class="wiring-spec-option-check">✓</text>
                </button>
              </view>
            </view>
            <view class="wiring-form-field">
              <view class="wiring-field-label">长度（m，可留空）</view>
              <input id="wiring-editor-length" data-focus-id="wiring-editor-length" class="wiring-control" type="digit" maxlength="24" value="{{draft.lengthText}}" data-field="lengthText" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="例如：5" />
            </view>
            <view class="wiring-form-field">
              <view class="wiring-field-label">线路状态</view>
              <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" data-field="status" bindchange="onOptionChange">
                <view class="wiring-control wiring-picker-control">{{statusOptions[statusIndex].label}}<text class="wiring-picker-arrow">⌄</text></view>
              </picker>
            </view>
          </view>
        </view>

        <view class="wiring-form-section wiring-editor-section">
          <view class="wiring-form-section-title">补充信息</view>
          <view class="wiring-form-field">
            <view class="wiring-field-label">用途</view>
            <input id="wiring-editor-purpose" data-focus-id="wiring-editor-purpose" class="wiring-control" maxlength="100" value="{{draft.purpose}}" data-field="purpose" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="例如：调音台主输出" />
          </view>
          <view class="wiring-form-field">
            <view class="wiring-field-label">备注（可选）</view>
            <textarea id="wiring-editor-notes" data-focus-id="wiring-editor-notes" class="wiring-control wiring-notes-control" value="{{draft.notes}}" maxlength="300" data-field="notes" fixed="{{true}}" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onDraftInput" placeholder="记录安装位置或现场说明" />
          </view>
        </view>
        <view wx:if="{{saveError}}" class="wiring-save-error">{{saveError}}</view>
        <view wx:if="{{!draftIsNew}}" class="wiring-editor-extra-actions">
          <button class="wiring-sheet-action wiring-editor-operation wiring-editor-copy" bindtap="duplicateLine">复制线路</button>
          <button class="wiring-sheet-action wiring-editor-operation wiring-editor-delete" bindtap="deleteLine">删除线路</button>
        </view>
        <view class="wiring-sheet-bottom-space"></view>
        <view class="wiring-sheet-keyboard-space" style="height:{{formKeyboardSpacerHeight}}px;"></view>
      </scroll-view>
      <view class="wiring-sheet-actions wiring-editor-actions">
        <button class="wiring-sheet-action wiring-sheet-cancel" bindtap="requestCloseEditor">取消</button>
        <button class="wiring-sheet-action wiring-sheet-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveLine">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{batchVisible}}" class="wiring-mask" style="{{formFrameStyle}}">
    <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="requestCloseBatch"></view>
    <view class="wiring-sheet wiring-batch-sheet" style="{{formSheetStyle}}" catchtap="stopEvent">
      <view class="wiring-sheet-handle"></view>
      <view class="wiring-sheet-heading">
        <view><view class="wiring-sheet-title">批量添加线路</view><view class="wiring-sheet-subtitle">确认端口顺序后再一次保存</view></view>
        <button class="wiring-close-button" bindtap="requestCloseBatch">关闭</button>
      </view>
      <scroll-view class="wiring-sheet-scroll wiring-batch-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{formScrollTop}}">
        <view class="wiring-option-grid">
          <view class="wiring-form-field wiring-field-wide"><view class="wiring-field-label">数量（1–32）</view><input id="wiring-batch-count" data-focus-id="wiring-batch-count" class="wiring-control" type="number" value="{{batchDraft.count}}" data-field="count" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">来源设备</view><input id="wiring-batch-from-device" data-focus-id="wiring-batch-from-device" class="wiring-control" maxlength="100" value="{{batchDraft.fromDevice}}" data-field="fromDevice" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="设备名称" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">来源端口前缀</view><input id="wiring-batch-from-prefix" data-focus-id="wiring-batch-from-prefix" class="wiring-control" maxlength="60" value="{{batchDraft.fromPrefix}}" data-field="fromPrefix" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="例如：OUT-" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">来源起始端口号</view><input id="wiring-batch-from-start" data-focus-id="wiring-batch-from-start" class="wiring-control" type="number" value="{{batchDraft.fromStart}}" data-field="fromStart" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">去向设备</view><input id="wiring-batch-to-device" data-focus-id="wiring-batch-to-device" class="wiring-control" maxlength="100" value="{{batchDraft.toDevice}}" data-field="toDevice" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="设备名称" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">去向端口前缀</view><input id="wiring-batch-to-prefix" data-focus-id="wiring-batch-to-prefix" class="wiring-control" maxlength="60" value="{{batchDraft.toPrefix}}" data-field="toPrefix" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="例如：IN-" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">去向起始端口号</view><input id="wiring-batch-to-start" data-focus-id="wiring-batch-to-start" class="wiring-control" type="number" value="{{batchDraft.toStart}}" data-field="toStart" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" /></view>
          <view class="wiring-form-field wiring-field-wide"><view class="wiring-field-label">用途</view><input id="wiring-batch-purpose" data-focus-id="wiring-batch-purpose" class="wiring-control" maxlength="100" value="{{batchDraft.purpose}}" data-field="purpose" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="例如：调音台输入" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">制作方式</view><picker range="{{buildOptions}}" range-key="label" value="{{batchBuildIndex}}" bindchange="onBatchBuildChange"><view class="wiring-control wiring-picker-control">{{buildOptions[batchBuildIndex].label}}<text class="wiring-picker-arrow">⌄</text></view></picker></view>
          <view class="wiring-form-field"><view class="wiring-field-label">线材类型</view><picker range="{{cableOptions}}" range-key="label" value="{{batchCableIndex}}" bindchange="onBatchCableChange"><view class="wiring-control wiring-picker-control">{{cableOptions[batchCableIndex].label}}<text class="wiring-picker-arrow">⌄</text></view></picker></view>
          <view class="wiring-form-field"><view class="wiring-field-label">来源端头</view><picker range="{{batchConnectorOptions}}" range-key="label" value="{{batchConnectorAIndex}}" data-field="connectorA" bindchange="onBatchConnectorChange"><view class="wiring-control wiring-picker-control">{{batchConnectorOptions[batchConnectorAIndex].label}}<text class="wiring-picker-arrow">⌄</text></view></picker><input wx:if="{{batchConnectorAIndex === customConnectorIndex}}" id="wiring-batch-connector-a" data-focus-id="wiring-batch-connector-a" class="wiring-control wiring-custom-connector" maxlength="60" value="{{batchCustomConnectorA}}" data-field="connectorA" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchCustomConnectorInput" placeholder="输入来源端头名称" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">去向端头</view><picker range="{{batchConnectorOptions}}" range-key="label" value="{{batchConnectorBIndex}}" data-field="connectorB" bindchange="onBatchConnectorChange"><view class="wiring-control wiring-picker-control">{{batchConnectorOptions[batchConnectorBIndex].label}}<text class="wiring-picker-arrow">⌄</text></view></picker><input wx:if="{{batchConnectorBIndex === customConnectorIndex}}" id="wiring-batch-connector-b" data-focus-id="wiring-batch-connector-b" class="wiring-control wiring-custom-connector" maxlength="60" value="{{batchCustomConnectorB}}" data-field="connectorB" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchCustomConnectorInput" placeholder="输入去向端头名称" /></view>
          <view class="wiring-form-field"><view class="wiring-field-label">长度（m，可留空）</view><input id="wiring-batch-length" data-focus-id="wiring-batch-length" class="wiring-control" type="digit" maxlength="24" value="{{batchDraft.lengthText}}" data-field="lengthText" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="例如：5" /></view>
          <view class="wiring-form-field wiring-field-wide"><view class="wiring-field-label">型号与规格</view><input id="wiring-batch-spec" data-focus-id="wiring-batch-spec" class="wiring-control" maxlength="120" value="{{batchDraft.spec}}" data-field="spec" adjust-position="{{false}}" bindfocus="onFormInputFocus" bindblur="onFormInputBlur" bindkeyboardheightchange="onFormKeyboardHeightChange" bindinput="onBatchInput" placeholder="{{batchSpecOptions.length ? '例如：' + batchSpecOptions[0] : '输入型号与规格'}}" /><view wx:if="{{batchSpecOptionViews.length}}" class="wiring-spec-options"><button wx:for="{{batchSpecOptionViews}}" wx:key="value" class="wiring-spec-option {{item.value === batchDraft.spec ? 'wiring-spec-option-selected' : ''}}" hover-class="wiring-spec-option-pressed" data-value="{{item.value}}" bindtap="chooseBatchSpecPreset"><text class="wiring-spec-option-model">{{item.model}}</text><text class="wiring-spec-option-size">{{item.size}}</text><text wx:if="{{item.value === batchDraft.spec}}" class="wiring-spec-option-check">✓</text></button></view></view>
        </view>
        <view wx:if="{{batchError}}" class="wiring-form-error">{{batchError}}</view>
        <view wx:if="{{batchPreviewLines.length}}" class="wiring-batch-preview">
          <view class="wiring-batch-preview-title">预览 {{batchPreviewLines.length}} 条</view>
          <view wx:for="{{batchPreviewLines}}" wx:key="id" class="wiring-batch-preview-row"><text>{{item.code}}</text><text>{{item.fromDevice}} · {{item.fromPort}} → {{item.toDevice}} · {{item.toPort}}</text></view>
        </view>
        <view class="wiring-sheet-bottom-space"></view>
        <view class="wiring-sheet-keyboard-space" style="height:{{formKeyboardSpacerHeight}}px;"></view>
      </scroll-view>
      <view class="wiring-sheet-actions wiring-batch-actions">
        <button class="wiring-sheet-action wiring-sheet-cancel" bindtap="requestCloseBatch">取消</button>
        <button class="wiring-sheet-action wiring-sheet-secondary" bindtap="refreshBatchPreview">预览</button>
        <button class="wiring-sheet-action wiring-sheet-primary" loading="{{saving}}" disabled="{{saving || !batchPreviewLines.length}}" bindtap="commitBatch">确认添加</button>
      </view>
    </view>
  </view>

  <canvas id="wiringReportCanvas" canvas-id="wiringReportCanvas" class="wiring-report-canvas" width="{{reportCanvasWidth}}" height="{{reportCanvasHeight}}" style="width:{{reportCanvasWidth}}px;height:{{reportCanvasHeight}}px;"></canvas>
  <view wx:if="{{reportPreviewVisible}}" class="wiring-mask wiring-report-mask">
    <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="closeReportPreview"></view>
    <view class="wiring-sheet wiring-report-sheet" catchtap="stopEvent">
      <view class="wiring-sheet-handle"></view>
      <view class="wiring-sheet-heading"><view><view class="wiring-sheet-title">{{reportPageTitle}}</view><view class="wiring-sheet-subtitle">第 {{reportPageIndex + 1}} / {{reportImages.length}} 张 · 点击图片查看原图</view></view><button class="wiring-close-button" bindtap="closeReportPreview">关闭</button></view>
      <scroll-view class="wiring-report-image-scroll" scroll-y enhanced show-scrollbar="{{false}}"><image class="wiring-report-image" src="{{reportImagePath}}" mode="widthFix" bindtap="previewReportImage" /></scroll-view>
      <view class="wiring-report-page-controls"><button class="wiring-page-step" disabled="{{reportPageIndex === 0}}" bindtap="previousReportPage">上一张</button><button class="wiring-page-step" disabled="{{reportPageIndex >= reportImages.length - 1}}" bindtap="nextReportPage">下一张</button></view>
      <view class="wiring-sheet-actions"><button class="wiring-sheet-action wiring-sheet-secondary" bindtap="saveReportImage">保存当前张</button><button class="wiring-sheet-action wiring-sheet-primary" bindtap="shareReportImage">转发当前张</button></view>
    </view>
  </view>
</view>
