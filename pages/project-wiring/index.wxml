<view class="wiring-page" bindtap="onWorkspaceRootTap" capture-bind:tap="captureInlineRenameTap" capture-bind:touchstart="captureInlineRenameTouchStart" capture-bind:touchmove="captureInlineRenameTouchMove" capture-bind:touchend="captureInlineRenameTouchEnd" capture-bind:touchcancel="captureInlineRenameTouchCancel">
  <include src="workspace.wxml" />
  <canvas id="wiringReportCanvas" canvas-id="wiringReportCanvas" class="wiring-report-canvas" width="{{reportCanvasWidth}}" height="{{reportCanvasHeight}}" style="width:{{reportCanvasWidth}}px;height:{{reportCanvasHeight}}px;"></canvas>
  <view wx:if="{{reportPreviewVisible || workspaceOverlayPhases.report === 'closing'}}" aria-hidden="{{!reportPreviewVisible}}" class="wiring-mask wiring-report-mask workspace-mask result-sheet-overlay {{workspaceOverlayPhases.report === 'closing' ? 'workspace-overlay-closing' : workspaceOverlayPhases.report === 'opening' ? 'workspace-overlay-opening' : workspaceOverlayPhases.report === 'preparing' ? 'workspace-overlay-preparing' : ''}}">
    <view class="wiring-backdrop" catchtouchmove="preventTouchMove" bindtap="closeReportPreview"></view>
    <view class="wiring-sheet wiring-report-sheet result-sheet result-share" catchtap="stopEvent">
      <view class="wiring-sheet-handle"></view>
      <view class="wiring-sheet-heading result-header"><view class="wiring-sheet-title result-title">{{reportPageTitle}}</view><button hover-class="workspace-pressed" hover-stay-time="80" class="wiring-close-button panel-close-control" aria-label="关闭项目接线图预览" bindtap="closeReportPreview"><view class="panel-close-icon" aria-hidden="true"></view></button></view>
      <view class="wiring-report-page-hint"><view class="wiring-report-page-count result-copy">第 {{reportPageIndex + 1}} 张 / 共 {{reportImages.length}} 张</view><view class="wiring-report-swipe-help result-copy">左右滑动切换，点击图片放大</view></view>
      <swiper class="wiring-report-swiper result-scroll-swiper" current="{{reportPageIndex}}" duration="180" bindchange="onReportPageSwipe"><swiper-item wx:for="{{reportImages}}" wx:for-item="reportImage" wx:key="path" class="wiring-report-swiper-item"><scroll-view class="wiring-report-image-scroll" scroll-y enhanced show-scrollbar="{{false}}"><image class="wiring-report-image" src="{{reportImage.path}}" mode="widthFix" bindtap="previewReportImage" /></scroll-view></swiper-item></swiper>
      <view class="wiring-report-save-status"><view wx:if="{{reportSaveMessage}}" class="wiring-report-save-message result-copy">{{reportSaveMessage}}</view><view wx:else class="wiring-report-save-message result-copy">已保存 {{reportSavedPageIndices.length}} / {{reportImages.length}} 张</view><view wx:if="{{reportSaveError}}" class="wiring-report-save-error result-copy">{{reportSaveError}}</view></view>
      <view class="wiring-sheet-actions wiring-report-actions result-footer"><button hover-class="workspace-pressed" hover-stay-time="80" class="wiring-sheet-action wiring-sheet-primary" bindtap="shareReportImage">分享图片</button><button hover-class="workspace-pressed" hover-stay-time="80" class="wiring-sheet-action wiring-sheet-secondary" disabled="{{reportSaveRunning}}" bindtap="saveReportImage">保存到相册</button></view>
    </view>
  </view>
</view>
