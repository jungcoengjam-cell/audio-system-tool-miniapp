  .workspace-row-retiring-exit{grid-template-rows:minmax(0,0fr);height:0!important;min-height:0!important;margin:0!important;opacity:0;pointer-events:none}
  .workspace-row-retiring{grid-template-rows:minmax(0,0fr);height:0!important;min-height:0!important;margin:0!important;opacity:0;pointer-events:none}
  .workspace-row-retiring .workspace-device-card,.workspace-row-retiring .workspace-line-row{height:0;min-height:0!important;padding-top:0;padding-bottom:0;border-width:0}
