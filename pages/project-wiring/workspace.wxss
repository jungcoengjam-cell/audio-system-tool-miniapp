.workspace-device-name-action{display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:44px;align-items:center;border:0;border-radius:10px;background:transparent;color:inherit;text-align:left}
.workspace-device-name-action .workspace-device-name{display:block;min-width:0;flex:1}
.wiring-page input.workspace-device-inline-rename-input{display:block;box-sizing:border-box;width:100%;min-width:0;height:44px;min-height:44px;margin:0;padding:0 8rpx;border:1px solid var(--workspace-accent);border-radius:10px;background:var(--workspace-bg);color:var(--workspace-text);font-size:34rpx;font-weight:600;line-height:1.2}
.wiring-page input.workspace-device-inline-rename-input::placeholder{color:var(--workspace-muted)}

/* Static group labels wrap and stay inside the single parent toggle target. */
.workspace-group-header{cursor:pointer}
.workspace-group-name{display:block;width:0;min-width:0;flex:1 1 0;white-space:normal;overflow-wrap:anywhere;word-break:break-all;line-height:1.35}

