/* Grid tracks give groups and retiring rows a bounded, content-sized collapse. */
.workspace-tab-content{animation:workspaceTabIn 150ms ease both}
.workspace-tab{transition:color 140ms ease}
.workspace-tab::before{position:absolute;right:16%;bottom:-1px;left:16%;height:3px;border-radius:3px;background:var(--workspace-accent);opacity:0;content:"";transition:opacity 180ms ease}
