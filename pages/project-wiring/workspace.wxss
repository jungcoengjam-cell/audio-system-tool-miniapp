.workspace-mask .wiring-backdrop{opacity:1;transition:opacity 300ms cubic-bezier(.22,1,.36,1)}
.workspace-mask .wiring-sheet{transform:translateY(0);transition:transform 300ms cubic-bezier(.22,1,.36,1)}
