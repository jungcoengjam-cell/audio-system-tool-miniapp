.workspace-row-retiring .workspace-swipe-content{min-height:0;overflow:hidden}
.workspace-row-retiring-exit{grid-template-rows:minmax(0,0fr);margin-top:0!important;margin-bottom:0!important;opacity:0;pointer-events:none}

