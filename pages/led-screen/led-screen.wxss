@import "../../styles/theme-page-shared.wxss";

.page-root,.page-scroll{height:100vh;color:var(--theme-text)}
.page-scroll{background:radial-gradient(circle at 86% 2%,rgba(88,86,214,.1),transparent 31%),var(--theme-page-bg)}
.page-content{box-sizing:border-box;padding:12rpx 32rpx calc(8px + env(safe-area-inset-bottom))}
.card,.result-card,.warning-card{box-sizing:border-box;margin-bottom:20rpx;border:1rpx solid var(--theme-divider);border-radius:26rpx;background:var(--theme-surface);box-shadow:0 8rpx 22rpx var(--theme-shadow)}
.result-card{position:relative;padding:16rpx 24rpx 18rpx}
.result-content{min-width:0}
.action-rail{position:absolute;z-index:3;top:12px;right:12px;display:flex;box-sizing:border-box;width:44px;flex-direction:column;align-items:center;justify-content:flex-start;gap:4px}
.action-button.action-button{box-sizing:border-box;display:flex;flex:0 0 44px;align-items:center;justify-content:center;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;border:1rpx solid var(--theme-divider);border-radius:50%;background:var(--theme-surface);box-shadow:0 2px 8px rgba(0,0,0,.10);color:var(--theme-text-secondary);line-height:1}
.action-button.action-button::after{border:0}
.action-button.action-button[disabled]{opacity:.34}
.action-button.action-button:active{background:var(--theme-accent-soft);opacity:.72}
.action-icon{position:relative;display:flex;flex:none;align-items:center;justify-content:center;box-sizing:border-box;width:22px;height:22px;border-radius:50%;background:transparent;color:var(--theme-text-secondary);font-size:0;line-height:1}
.icon-reset,.icon-share,.icon-bookmark,.icon-folder{box-sizing:border-box;width:22px;height:22px;margin:0;border:0;border-radius:0;background-color:currentColor;-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-size:100% 100%;mask-size:100% 100%}
