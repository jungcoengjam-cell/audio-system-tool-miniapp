@import "../../styles/theme-page-shared.wxss";.page-root{height:100vh}.page-scroll{height:100vh;background:radial-gradient(circle at 86% 2%,rgba(88,86,214,.12),transparent 31%),#f5f5f7}.page-content{padding:28rpx 32rpx calc(52rpx + env(safe-area-inset-bottom))}.page-header{display:flex;min-height:116rpx;padding:8rpx 4rpx 16rpx;align-items:center;justify-content:space-between}.page-title{color:#1d1d1f;font-size:54rpx;font-weight:700;letter-spacing:-2rpx}.card,.warning-card{box-sizing:border-box;margin-bottom:24rpx;padding:28rpx;border:1rpx solid #e7e7eb;border-radius:28rpx;background:#fff;box-shadow:0 9rpx 24rpx rgba(28,45,73,.07)}.input-card{padding:25rpx 26rpx 26rpx}.section-label{margin-bottom:12rpx;color:#1d1d1f;font-size:26rpx;font-weight:650}.section-divider{height:1rpx;margin:19rpx 0;background:#e5e5ea}.field-grid{display:flex;gap:14rpx}.compact-row{margin-top:14rpx}.reserve-row{gap:10rpx}.field{min-width:0;flex:1}.field-label{margin-bottom:8rpx;color:#6e6e73;font-size:24rpx}.input-wrap,.picker-value{display:flex;box-sizing:border-box;min-height:44px;align-items:center;border:0;border-radius:16rpx;background:#f2f2f7}.input-wrap{padding-left:18rpx}.input-wrap input{min-width:0;height:44px;min-height:44px;flex:1;color:var(--tx);font-size:26rpx}.input-wrap text{padding:0 15rpx 0 7rpx;color:var(--ts);font-size:20rpx}.picker-value{padding:0 15rpx 0 18rpx;justify-content:space-between;color:#1d1d1f;font-size:26rpx}.picker-value text{min-width:0;overflow:visible;text-overflow:clip;white-space:normal;line-height:1.25}.picker-arrow{margin-left:8rpx;color:#a8a8ad;font-size:39rpx;line-height:1}.config-row{align-items:flex-end}.config-row .field:first-child{flex:0 0 178rpx}.warning-card{border-color:#ffb7b3;background:#fff2f2;box-shadow:none}.warning-title{color:#a12620;font-size:28rpx;font-weight:700}.warning-text{margin-top:10rpx;color:#8b3b37;font-size:22rpx;line-height:1.55}.result-card{margin-bottom:24rpx;padding:31rpx;border:1rpx solid #e7e7eb;border-radius:30rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(28,45,73,.08)}.result-heading,.viewing-heading,.diagram-heading{display:flex;align-items:flex-start;justify-content:space-between}.result-label{color:var(--ts);font-size:21rpx}.result-subtitle{margin-top:7rpx;color:#8e8e93;font-size:21rpx}.status-chip{margin-left:16rpx;padding:9rpx 15rpx;flex-shrink:0;border-radius:999rpx;background:var(--as);color:var(--ta);font-size:20rpx}.screen-dimension{margin-top:25rpx;color:var(--tx);font-size:52rpx;font-weight:700;letter-spacing:-1.8rpx;line-height:1.08}.screen-layout{margin-top:10rpx;color:var(--ts);font-size:23rpx}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rpx;margin-top:25rpx;overflow:hidden;border-radius:18rpx;background:#e5e5ea}.metric{min-width:0;padding:20rpx;background:#f5f5f7}.metric-value{color:var(--tx);font-size:25rpx;font-weight:450}.metric-install-size .metric-value{font-size:23rpx}.metric-label{margin-top:7rpx;color:var(--ts);font-size:18rpx;line-height:1.4}.viewing-result{margin-top:22rpx;padding:21rpx;border-radius:20rpx;background:var(--tc)}.viewing-label{color:var(--ts);font-size:18rpx}.viewing-pitch{margin-top:4rpx;color:var(--ta);font-size:35rpx;font-weight:700}.viewing-status{padding:8rpx 13rpx;border-radius:999rpx;background:var(--as);color:var(--ta);font-size:18rpx}.viewing-result-near,.viewing-result-avoid{background:var(--tws)}.viewing-result-near .viewing-pitch,.viewing-result-near .viewing-status,.viewing-result-avoid .viewing-pitch,.viewing-result-avoid .viewing-status{color:var(--tw)}.viewing-result-near .viewing-status,.viewing-result-avoid .viewing-status{background:var(--tws)}.viewing-line{display:flex;margin-top:12rpx;justify-content:space-between;color:var(--ts);font-size:21rpx}.viewing-line text:last-child{color:var(--tx)}.viewing-note{margin-top:13rpx;color:var(--ts);font-size:19rpx;line-height:1.5}.diagram-card{padding:27rpx 28rpx 25rpx}.card-title{color:#1d1d1f;font-size:29rpx;font-weight:650}.wall-width-label{margin:22rpx 0 9rpx;color:var(--ts);font-size:19rpx;text-align:center}.wall-diagram{position:relative;box-sizing:border-box;width:100%;overflow:hidden;border:3rpx solid #64748b;border-radius:4rpx;background:#f8fafc}.screen-frame{position:absolute;box-sizing:border-box;min-width:10rpx;min-height:10rpx;border:1rpx solid #8e8e93;background:#c7c7cc;box-shadow:0 7rpx 18rpx rgba(79,70,229,.18)}.screen-shape{position:absolute;display:flex;box-sizing:border-box;min-width:8rpx;min-height:8rpx;align-items:center;justify-content:center;border:2rpx solid #3730a3;background-color:#4f46e5;background-image:linear-gradient(to right,rgba(255,255,255,.2) 1rpx,transparent 1rpx),linear-gradient(to bottom,rgba(255,255,255,.2) 1rpx,transparent 1rpx);color:#fff}.screen-shape-label{padding:7rpx 10rpx;border-radius:10rpx;background:rgba(19,22,58,.65);color:#fff;font-size:18rpx;text-align:center}.wall-height-label{margin-top:9rpx;color:var(--ts);font-size:19rpx;text-align:center}.diagram-summary{display:flex;margin-top:17rpx;gap:9rpx 20rpx;flex-wrap:wrap;justify-content:center;color:var(--ts);font-size:18rpx}.report-action-row{margin-top:4rpx;margin-bottom:24rpx}.report-share-button,.report-save-button,.report-close-button{display:flex;box-sizing:border-box;margin:0;align-items:center;justify-content:center;line-height:1}.report-generate-button{background:var(--tp);box-shadow:0 10rpx 24rpx rgba(0,122,255,.2);color:#fff}.report-copy-button{border:0;background:var(--tc);color:var(--ta)}.report-generate-button:active,.report-copy-button:active,.report-share-button:active,.report-save-button:active,.report-close-button:active{opacity:.72;transform:scale(.99)}.report-generate-button[disabled]{background:var(--tmm);box-shadow:none;color:var(--tt)}.report-canvas-offscreen{position:fixed;left:-2000px;top:0;z-index:-1;pointer-events:none}.report-preview-overlay{position:fixed;z-index:1000;left:0;top:0;display:flex;box-sizing:border-box;width:100%;height:100%;padding:70rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(20,20,24,.34)}.report-preview-sheet{display:flex;box-sizing:border-box;width:100%;max-height:88vh;padding:26rpx 24rpx 22rpx;flex-direction:column;overflow:hidden;border:1rpx solid rgba(255,255,255,.72);border-radius:34rpx;background:rgba(250,250,252,.96);box-shadow:0 28rpx 90rpx rgba(18,27,48,.24)}.report-preview-header{display:flex;padding:0 4rpx 20rpx;flex-shrink:0;align-items:center;justify-content:space-between}.report-preview-title{color:var(--tx);font-size:30rpx;font-weight:680}.report-close-button{width:104rpx;min-height:44px;height:68rpx;padding:0;border:0;border-radius:999rpx;background:var(--tc);color:var(--ts);font-size:22rpx}.report-preview-scroll{height:820rpx;overflow:hidden;border-radius:22rpx;background:#e9e9ee}.report-preview-image{display:block;width:100%}.report-preview-actions{display:flex;padding-top:20rpx;flex-shrink:0;gap:14rpx}.report-share-button,.report-save-button{min-height:44px;height:88rpx;flex:1;border-radius:22rpx;font-size:27rpx;font-weight:650}.report-share-button{background:var(--tp);color:#fff}.report-save-button{border:0;background:var(--tc);color:var(--ta)}@media (prefers-color-scheme: dark){.page-root,.page-scroll{background:var(--theme-page-bg);color:var(--tx)}.input-card,.result-card,.warning-card,.report-preview-sheet{border-color:var(--td);background:var(--tv);color:var(--tx)}}
.screen-install-dimension{display:flex;box-sizing:border-box;margin-top:20rpx;padding:18rpx 20rpx;align-items:baseline;justify-content:space-between;border:1rpx solid var(--td);border-radius:18rpx;background:var(--as);gap:16rpx}.screen-install-label{color:var(--ts);font-size:22rpx}.screen-install-value{color:var(--ta);font-size:32rpx;font-weight:700;text-align:right}
@media (max-width:350px){.reserve-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.reserve-row .field:last-child{grid-column:1 / -1}.reserve-row .field:last-child .input-wrap{max-width:50%}}

.metric:last-child:nth-child(odd){grid-column:1 / -1}

.page-root{--led-screen:#4f46e5;--led-frame:#c7c7cc}
.section-label,.field-label,.input-wrap text,.picker-value,.field-error-text,.input-pending,.warning-text,.warning-suggestion{font-size:12px}
.field-error .input-wrap,.field-error .picker-value{background:var(--tws);box-shadow:inset 0 0 0 1px var(--tw)}
.field-error-text{margin-top:6rpx;color:var(--tw);line-height:1.35;overflow-wrap:anywhere}
.input-pending{margin-top:15rpx;color:var(--ts);line-height:1.4}
.warning-text,.warning-suggestion{line-height:1.45}
.warning-suggestion{margin-top:7rpx;color:var(--tw);font-weight:600}
.result-label,.result-subtitle,.status-chip,.screen-layout,.metric-label,.viewing-label,.viewing-status,.viewing-line,.viewing-note,.wall-width-label,.wall-height-label,.diagram-summary,.ratio-summary,.ratio-fallback-note,.diagram-offwall-label,.diagram-legend{font-size:12px}
.ratio-summary{box-sizing:border-box;margin-top:12rpx;padding:12rpx 14rpx;border-radius:14rpx;background:var(--tc);color:var(--ts);line-height:1.45}
.ratio-summary-fallback,.ratio-fallback-note{background:var(--tws);color:var(--tw)}
.ratio-fallback-note{margin-top:8rpx;padding:0 4rpx;font-weight:600;line-height:1.45}
.diagram-stage{position:relative;box-sizing:border-box;width:100%;height:420rpx;margin:10rpx auto 0;overflow:hidden}
.diagram-fit{position:absolute;top:50%;left:50%;box-sizing:border-box;transform:translate(-50%,-50%)}
.wall-diagram{position:relative;box-sizing:content-box;width:100%;height:0;overflow:hidden;border:0;border-radius:4rpx;background:var(--tc);box-shadow:inset 0 0 0 2rpx var(--ts)}
.screen-frame{min-width:0;min-height:0}
.screen-frame{border-color:var(--led-frame);background:var(--led-frame)}
.screen-shape{min-width:0;min-height:0;border-color:var(--led-screen);background-color:var(--led-screen)}
.screen-shape-label{max-width:100%;font-size:12px;line-height:1.3;overflow-wrap:anywhere}
.diagram-offwall-label{margin-top:10rpx;color:var(--ta);font-weight:650;text-align:center;line-height:1.4}
.diagram-legend{display:flex;margin-top:14rpx;gap:18rpx;flex-wrap:wrap;justify-content:center;color:var(--ts);line-height:1.4}
.diagram-legend>view{display:flex;min-height:24px;align-items:center;gap:6rpx}
.legend-swatch{display:inline-block;box-sizing:border-box;width:13px;height:13px;border-radius:3px}
.legend-wall{border:1px solid var(--ts);background:var(--tc)}
.legend-frame{border:1px solid var(--led-frame);background:var(--led-frame)}
.legend-screen{border:1px solid var(--led-screen);background:var(--led-screen)}
.diagram-summary{gap:8rpx 14rpx}
