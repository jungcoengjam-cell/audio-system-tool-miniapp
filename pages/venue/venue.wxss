.pag-nag-mode-option-active{background:var(--as);color:var(--ta);font-weight:650}
.pag-nag-guide-nom-scene{padding-bottom:10rpx}.pag-nag-guide-nom-scene .pag-nag-guide-plot{display:flex;height:auto;padding:18rpx 4% 12rpx;align-items:flex-start;justify-content:space-between}
.pag-nag-guide-nom-mic{position:relative;display:flex;box-sizing:border-box;width:46%;height:170rpx;align-items:center;flex-direction:column;color:var(--ts);font-size:28rpx;line-height:1.25;text-align:center}
.pag-nag-guide-nom-icon{position:relative;display:block;width:24rpx;height:38rpx;margin:0 0 48rpx;border:3rpx solid var(--ta);border-radius:14rpx 14rpx 7rpx 7rpx;background:var(--tv);font-size:0}
.pag-nag-guide-nom-icon:before{content:"";position:absolute;left:50%;top:34rpx;width:3rpx;height:22rpx;border-left:3rpx solid var(--ta);transform:translateX(-50%)}
.pag-nag-guide-nom-icon:after{content:"";position:absolute;left:50%;top:56rpx;width:42rpx;height:10rpx;border:2rpx solid var(--ta);border-top:0;border-radius:0 0 12rpx 12rpx;transform:translateX(-50%)}
.pag-nag-guide-nom-closed .pag-nag-guide-nom-icon{border-color:var(--tt)}.pag-nag-guide-nom-closed .pag-nag-guide-nom-icon:before{border-color:var(--tt)}.pag-nag-guide-nom-closed .pag-nag-guide-nom-icon:after{border-color:var(--tt)}
.pag-nag-guide-nom-label{display:block;width:100%;color:var(--ts);font-size:28rpx;line-height:1.25;white-space:normal}.pag-nag-guide-nom-state{display:block;margin-top:4rpx;color:var(--tt);font-size:28rpx;line-height:1.2}

