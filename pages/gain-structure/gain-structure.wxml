<view class="page-root">
  <view class="result-pane">
    <view class="action-rail" aria-label="结果操作">
      <button class="action-button" aria-label="重置本次计算" disabled="{{!canReset}}" bindtap="requestReset"><view class="action-icon icon-reset"></view></button>
      <button class="action-button" aria-label="分享结果图片" disabled="{{!hasValidResult}}" bindtap="openSharePreview"><view class="action-icon icon-share"><view class="icon-share-box"></view></view></button>
      <button class="action-button" aria-label="收藏当前配置" aria-pressed="{{currentFavorite}}" disabled="{{!hasValidResult}}" bindtap="toggleCurrentFavorite"><view class="action-icon {{currentFavorite ? 'icon-bookmark-active' : 'icon-bookmark'}}"></view></button>
      <button class="action-button" aria-label="保存到项目" disabled="{{!hasValidResult}}" bindtap="openProjectSheet"><view class="action-icon icon-folder"><view></view></view></button>
    </view>

    <view class="result-card result-card-{{calculationState}}" aria-live="polite">
      <view class="result-heading">
        <view wx:if="{{hasValidResult}}" class="status-chip status-chip-{{result.statusTone}}">{{result.statusLabel}}</view>
        <view wx:else class="output-status">{{outputStatus}}</view>
      </view>

      <block wx:if="{{hasValidResult}}">
        <view wx:if="{{result.alignmentMode === 'insufficientDrive'}}" class="result-primary">
          <text class="result-label">距离功放额定输出仍差</text>
          <view class="result-value">{{result.primaryValue}}<text class="result-unit"> dB</text></view>
        </view>
        <view wx:else class="result-primary">
          <text class="result-label">DSP 最终输出（限幅器后）</text>
          <view class="result-value"><text wx:if="{{result.alignmentMode === 'attenuate'}}">−</text>{{result.primaryValue}}<text class="result-unit"> dB</text></view>
        </view>

        <view class="result-facts">
          <view class="result-fact">
            <text class="result-fact-label">DSP 目标峰值</text>
            <text class="result-fact-value">{{result.targetPeakDbfs}} dBFS · {{result.targetDspOutputDbu}} dBu</text>
          </view>
          <view class="result-fact">
            <text class="result-fact-label">功放额定输入点</text>
            <text class="result-fact-value">{{result.fullPowerInputDbu}} dBu</text>
          </view>
        </view>
        <view class="amplifier-setting">功放输入控制保持 0 dB</view>
        <view class="placement-warning">{{result.placementWarning}}</view>
      </block>

      <view wx:elif="{{calculationState === 'invalid' || calculationState === 'incomplete'}}" class="result-message result-message-warning">
        <text class="result-message-title">{{result ? '请核对输入级档位' : '参数尚未齐全'}}</text>
        <text class="result-message-copy">{{outputHint}}</text>
      </view>
      <view wx:elif="{{calculationState === 'stale'}}" class="result-message">
        <text class="result-message-title">输入已改变</text>
        <text class="result-message-copy">{{outputHint}}</text>
      </view>
      <view wx:else class="result-message">
        <text class="result-message-title">等待输入</text>
        <text class="result-message-copy">{{outputHint}}</text>
      </view>

      <view wx:if="{{resetError}}" class="reset-error" role="alert">{{resetError}}</view>

      <view wx:if="{{loadReminderActive}}" class="load-reminder" role="status">
          请确认当前工作模式并选择负载阻抗，再计算。
      </view>
    </view>
  </view>

  <view class="input-pane">
    <view class="editor-heading">
      <text class="editor-title">输入设置</text>
      <text class="editor-caption">按设备说明书核对现场档位</text>
    </view>
    <view class="group-tabs" role="tablist">
      <button wx:for="{{groupTabs}}" wx:key="key" class="group-tab {{activeGroup === item.key ? 'group-tab-active' : ''}}" role="tab" aria-selected="{{activeGroup === item.key}}" data-group="{{item.key}}" bindtap="onGroupTap">{{item.label}}</button>
    </view>

    <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{activeGroup === 'amplifier'}}" class="editor-group">
        <view class="field-row">
          <text class="field-label">功放型号</text>
          <view class="field-control" role="button" aria-label="选择功放型号" bindtap="openAmplifierSelector">
            <view wx:if="{{selectedAmplifier}}" class="field-copy">
              <text class="field-value">{{selectedAmplifier.model}}</text>
              <text class="field-meta">{{selectedAmplifier.category}}</text>
            </view>
            <text wx:else class="field-placeholder">请选择功放型号</text>
            <text class="field-arrow">›</text>
          </view>
        </view>
        <view class="field-row field-row-stages">
          <text class="field-label">{{stageTypeLabel}}</text>
          <view wx:if="{{stageOptions.length}}" class="choice-grid">
            <button wx:for="{{stageOptions}}" wx:key="value" class="choice-card {{index === stageIndex ? 'choice-card-active' : ''}}" aria-pressed="{{index === stageIndex}}" data-index="{{index}}" bindtap="onStageTap">
              <text class="choice-label">{{item.label}}</text>
              <text class="choice-description">{{item.description}}</text>
            </button>
          </view>
          <text wx:else class="field-help">选择功放型号后显示说明书确认的输入级档位。</text>
        </view>
      </view>

      <view wx:elif="{{activeGroup === 'load'}}" class="editor-group">
        <block wx:if="{{showPowerContext}}">
          <view wx:if="{{loadReminderActive}}" class="load-reminder load-reminder-editor" role="status">
            请确认当前工作模式并选择负载阻抗，再计算。
          </view>
          <view class="field-row">
            <text class="field-label">功放模式</text>
            <view class="choice-grid choice-grid-modes">
              <button wx:for="{{modes}}" wx:key="value" class="choice-card {{index === modeIndex ? 'choice-card-active' : ''}}" aria-pressed="{{index === modeIndex}}" data-index="{{index}}" bindtap="onModeTap">
                <text class="choice-label">{{item.label}}</text>
              </button>
            </view>
          </view>
          <view class="field-row">
            <text class="field-label">通道负载阻抗</text>
            <picker range="{{loadOptions}}" range-key="label" value="{{loadIndex < 0 ? 0 : loadIndex}}" bindchange="onLoadChange">
              <view class="field-control {{loadIndex === 0 ? 'field-control-pending' : ''}}">
                <text class="field-value">{{loadOptions[loadIndex < 0 ? 0 : loadIndex].label}}</text>
                <text class="field-arrow">⌄</text>
              </view>
            </picker>
            <text class="field-help">按当前模式的说明书功率表选择，不对未列出的阻抗插值。</text>
          </view>
        </block>
      </view>

      <view wx:else class="editor-group">
        <view class="field-row">
          <text class="field-label">DSP 目标峰值</text>
          <view class="choice-grid choice-grid-targets">
            <button wx:for="{{targetPeaks}}" wx:key="value" class="choice-card {{index === targetPeakIndex ? 'choice-card-active' : ''}}" aria-pressed="{{index === targetPeakIndex}}" data-index="{{index}}" bindtap="onTargetPeakTap">
              <text class="choice-label">{{item.label}}</text>
              <text class="choice-description">{{item.description}}</text>
            </button>
          </view>
          <text class="field-help">标定基准：0 dBFS = +18.4 dBu。目标峰值保留相应的数字输出余量。</text>
        </view>
      </view>
    </scroll-view>

    <view class="calculate-bar">
      <button class="calculate-button" disabled="{{!canCalculate}}" bindtap="calculate">{{calculationState === 'stale' ? '重新计算' : '计算增益结构'}}</button>
    </view>
  </view>

  <page-container show="{{pageContainerSupported && (selectorVisible || shareSheetVisible || projectSheetVisible)}}" position="bottom" overlay="true" z-index="100" round="{{false}}" close-on-slide-down="{{false}}" overlay-style="background-color: rgba(18, 20, 27, .55);" custom-style="background-color: transparent; padding: 0;" bind:beforeleave="onPageContainerBeforeLeave" bind:afterleave="onPageContainerAfterLeave" bind:clickoverlay="onPageContainerClickOverlay">
    <view class="page-container-sheet-content {{projectKeyboardActive ? 'project-keyboard-open' : ''}}" catchtouchmove="preventTouchMove"><include src="./gain-overlays.wxml" /></view>
  </page-container>
  <view wx:if="{{!pageContainerSupported && (selectorVisible || shareSheetVisible || projectSheetVisible)}}" class="sheet-mask {{projectKeyboardActive ? 'project-keyboard-open' : ''}}" catchtap="onPageContainerClickOverlay" catchtouchmove="preventTouchMove"><include src="./gain-overlays.wxml" /></view>
  <canvas id="resultReportCanvas" canvas-id="resultReportCanvas" class="result-report-canvas-offscreen" width="{{resultReportCanvasWidth}}" height="{{resultReportCanvasHeight}}" style="width:{{resultReportCanvasWidth}}px;height:{{resultReportCanvasHeight}}px;"></canvas>
</view>
