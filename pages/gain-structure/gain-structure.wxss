@import "../../styles/theme-page-shared.wxss";

.page-root{--gain-output-bg:#edf2f6;--gain-input-bg:#f7f9fb;--gain-readout:#16836e;--gain-muted:#5f6f7a;--gain-radio:#91a0aa;--theme-page-bg:#f7f9fb;--theme-surface:#f7f9fb;--theme-text:#202b35;--theme-text-secondary:#52616d;--theme-text-tertiary:#687985;--theme-divider:#d6dfe5;--theme-control:#f9fbfc;--theme-accent:#3e7597;--theme-accent-text:#3e7597;--theme-accent-soft:#edf5f8;--theme-success:#16836e;--theme-warning:#9a5b00;box-sizing:border-box;display:flex;width:100%;height:100vh;min-height:0;padding:8rpx 0 calc(8rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;background:var(--gain-input-bg);color:var(--theme-text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC","Helvetica Neue",sans-serif}
.result-pane{position:relative;display:flex;box-sizing:border-box;flex:0 0 340px;min-height:0;padding:0;background:var(--gain-output-bg)}
.result-card{position:relative;display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:0;flex:1;padding:12px 16px 8px;flex-direction:column;overflow:hidden;border:0;border-bottom:1rpx solid var(--theme-divider);border-radius:0;background:var(--gain-output-bg);box-shadow:none}
.action-rail{position:absolute;z-index:2;top:12px;right:14px;display:flex;width:44px;flex-direction:column;align-items:center;justify-content:flex-start;gap:2px}
.action-button.action-button{box-sizing:border-box;display:flex;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;flex:0 0 44px;margin:0;padding:0;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:50%;background:var(--theme-control);box-shadow:none;color:var(--theme-text-secondary);line-height:1}
.action-button.action-button::after{border:0}
.action-button.action-button[disabled]{opacity:1;color:var(--theme-text-tertiary)}
.action-button.action-button:active{border-color:var(--theme-accent);background:var(--theme-accent-soft);opacity:1}
.action-button.action-button[aria-pressed="true"]{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.action-icon{position:relative;display:flex;box-sizing:border-box;width:22px;height:22px;flex:none;align-items:center;justify-content:center;background-color:currentColor;color:inherit;font-size:0;line-height:1}.icon-reset,.icon-share,.icon-bookmark,.icon-folder{border:0;border-radius:0;-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-size:100% 100%;mask-size:100% 100%}
