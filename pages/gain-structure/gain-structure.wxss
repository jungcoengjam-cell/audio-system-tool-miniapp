.icon-share-box,.icon-folder>view{display:none}
.icon-share,.icon-folder,.icon-bookmark:not(.icon-bookmark-active){color:var(--theme-accent-text)}

.result-heading{display:flex;box-sizing:border-box;flex:0 0 20px;min-width:0;min-height:20px;padding-right:52px;align-items:center;gap:8rpx}
.output-status{overflow:hidden;color:var(--theme-text-secondary);font-size:12px;font-weight:600;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}
.status-chip{flex:none;padding:0;border:0;border-radius:0;background:transparent;color:var(--gain-readout);font-size:12px;font-weight:650;line-height:20px;white-space:nowrap}
.status-chip-warning{color:var(--theme-warning)}
.page-root .result-card .status-chip{padding:0;border:0;border-radius:0;background:transparent;color:var(--gain-readout)}
.page-root .result-card .status-chip.status-chip-warning{color:var(--theme-warning)}
.reset-error{flex:none;margin-top:3px;padding-right:52px;color:var(--theme-warning);font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.result-primary{display:flex;box-sizing:border-box;min-width:0;min-height:0;flex:0 0 136px;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:0 44px;text-align:center}
.result-label{color:var(--theme-text-secondary);font-size:13px;font-weight:560;line-height:1.35;text-align:center}
.result-value{margin-top:7px;color:var(--gain-readout);font-size:55px;font-weight:690;letter-spacing:-2px;line-height:1.08;text-align:center;white-space:nowrap}
.result-unit{margin-left:3px;font-size:22px;font-weight:580;letter-spacing:0}
.result-message{display:flex;min-height:60px;flex:1 1 0;flex-direction:column;justify-content:center;padding:0 44px;text-align:center}
.result-message-title{color:var(--theme-text);font-size:18px;font-weight:650;line-height:1.3}
.result-message-copy{margin-top:5rpx;color:var(--theme-text-secondary);font-size:12px;line-height:1.45}
.result-message-warning .result-message-title{color:var(--theme-warning)}
.result-details-scroll{box-sizing:border-box;width:100%;height:0;min-height:0;flex:1 1 0;padding:0 44px}
.result-details-content{display:flex;box-sizing:border-box;min-width:0;min-height:100%;flex-direction:column}
.result-details-scroll-notice{height:0;min-height:0;flex:0 0 72px;padding:0 44px}
.result-facts{display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:88px;flex:0 0 88px;align-items:stretch;border-top:1rpx solid var(--theme-divider)}
.result-fact{display:flex;box-sizing:border-box;width:0;min-width:0;min-height:72px;flex:1 1 0;padding:5px 8px;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.result-fact+.result-fact{border-left:1rpx solid var(--theme-divider)}
.result-fact-label{color:var(--theme-text-secondary);font-size:12px;line-height:1.35}
.result-fact-value{margin-top:5px;color:var(--theme-text);font-size:18px;font-weight:650;line-height:1.2;text-align:center;white-space:nowrap}
.result-fact-subvalue{margin-top:3px;color:var(--theme-text-secondary);font-size:14px;font-weight:560;line-height:1.2;text-align:center;white-space:nowrap}
.amplifier-setting{flex:none;margin-top:8px;padding:10px 2px 0;border-top:1rpx solid var(--theme-divider);color:var(--theme-text-secondary);font-size:12px;font-weight:560;line-height:1.45;overflow-wrap:anywhere}
.placement-warning{flex:none;margin-top:4px;color:var(--theme-text-secondary);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.placement-warning.amplifier-setting{margin-top:8px}
.load-reminder{flex:none;margin-top:6px;padding:8px 10px;border:1rpx solid rgba(154,91,0,.25);border-radius:11px;background:rgba(255,190,70,.14);color:var(--theme-warning);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.load-reminder-editor{margin:0 0 12rpx}
.input-pane{display:flex;box-sizing:border-box;height:0;min-height:0;flex:1 1 0;flex-direction:column;padding:16px 20px 18px;background:var(--gain-input-bg)}
.editor-heading{display:flex;box-sizing:border-box;flex:0 0 24px;min-width:0;height:24px;align-items:baseline;justify-content:space-between;gap:12px}
.editor-title{color:var(--theme-text);font-size:18px;font-weight:680;line-height:1.3}
.amplifier-summary{display:block;min-width:0;max-width:55%;flex:0 1 auto;overflow:hidden;color:var(--theme-text-secondary);font-size:12px;line-height:1.3;text-align:right;text-overflow:ellipsis;white-space:nowrap}
.group-tabs{display:flex;box-sizing:border-box;flex:0 0 44px;height:44px;min-height:44px;margin-top:9px;align-items:stretch;border-bottom:1rpx solid var(--theme-divider)}
.group-tab{position:relative;display:flex;box-sizing:border-box;min-width:0;min-height:44px;flex:1;margin:0;padding:0 8rpx;align-items:center;justify-content:center;border:0;border-radius:0;background:transparent;color:var(--theme-text-secondary);font-size:13px;font-weight:560;line-height:1.2}
.group-tab::after{border:0}
.group-tab-active{color:var(--theme-accent-text);font-weight:680}
.group-tab-active::before{position:absolute;right:24%;bottom:0;left:24%;height:2px;border-radius:2px;background:var(--theme-accent);content:""}
.editor-scroll{box-sizing:border-box;width:100%;height:0;min-height:40px;flex:1 1 0}
.editor-group{box-sizing:border-box;min-height:0;padding:12rpx 0 10rpx}
.field-row{display:flex;min-width:0;margin:0 0 14rpx;flex-direction:column;gap:7rpx}
.field-row:last-child{margin-bottom:4rpx}
.field-label{color:var(--theme-text-secondary);font-size:12px;line-height:1.3}
.target-heading{display:flex;box-sizing:border-box;min-width:0;min-height:30px;align-items:center;justify-content:space-between;gap:8px}
.target-heading .field-label{color:var(--theme-text);font-size:13px;font-weight:650}
.calibration-standard{color:var(--gain-muted, #5f6f7a);font-size:11.5px;line-height:1.3;white-space:nowrap}
.field-control{box-sizing:border-box;display:flex;min-width:0;min-height:48px;padding:8rpx 14rpx;align-items:center;justify-content:space-between;gap:10rpx;border:1rpx solid var(--theme-divider);border-radius:12px;background:var(--theme-control);color:var(--theme-text)}
.field-picker-load{display:block;box-sizing:border-box;width:100%;min-width:0}
.field-control-pending{border-color:rgba(154,91,0,.5);background:rgba(255,190,70,.10)}
.field-copy{display:flex;min-width:0;flex:1;flex-direction:column}
.field-value{color:var(--theme-text);font-size:14px;font-weight:600;line-height:1.3;overflow-wrap:anywhere}
.field-value-load{display:block;box-sizing:border-box;min-width:0;max-width:100%;flex:1 1 0;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.field-meta{margin-top:3rpx;color:var(--theme-text-secondary);font-size:11px;line-height:1.25}
.field-placeholder,.field-help{color:var(--theme-text-secondary);font-size:12px;line-height:1.45}
.field-arrow{flex:none;color:var(--theme-text-tertiary);font-size:22px;line-height:1}
.choice-grid{display:grid;box-sizing:border-box;width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:7rpx}
.choice-grid-modes{display:flex;box-sizing:border-box;flex-wrap:wrap;gap:0}
.choice-grid-modes .mode-choice-cell{box-sizing:border-box;min-width:0;max-width:100%;flex:0 0 50%;padding:0 4px 8px}
.choice-grid-modes .mode-choice-cell-full{flex-basis:100%}
.choice-grid-modes .mode-choice-card.mode-choice-card{box-sizing:border-box;display:flex;width:100%;max-width:100%;min-width:0;min-height:56px;margin:0;flex-direction:column}
.choice-grid-modes .mode-choice-card .choice-label{display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.choice-card{box-sizing:border-box;display:flex;min-width:0;min-height:52px;margin:0;padding:7rpx 8rpx;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:12px;background:var(--theme-surface);color:var(--theme-text-secondary);line-height:1.2}
.choice-card::after{border:0}
.choice-card:active{opacity:.78}
.choice-card-active{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text);box-shadow:inset 0 0 0 1rpx rgba(62,117,151,.10)}
.choice-label{font-size:13px;font-weight:650;line-height:1.25}
.choice-description{margin-top:3rpx;color:var(--theme-text-secondary);font-size:10px;line-height:1.25;text-align:center}
.choice-card-active .choice-description{color:var(--theme-accent-text)}
.field-row-stages .choice-grid{display:flex;box-sizing:border-box;width:100%;flex-wrap:wrap;gap:0}
.field-row-stages .stage-choice-cell{box-sizing:border-box;min-width:0;max-width:100%;flex:0 0 50%;padding:0 4px 8px}
.field-row-stages .stage-choice-cell-full{flex-basis:100%}
.field-row-stages .stage-choice-card.stage-choice-card{box-sizing:border-box;display:flex;width:100%;max-width:100%;min-width:0;min-height:56px;margin:0;flex-direction:column}
.field-row-stages .stage-choice-card .choice-label,.field-row-stages .stage-choice-card .choice-description{display:block;box-sizing:border-box;width:100%;max-width:100%;min-width:0;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.choice-grid-targets{display:flex;box-sizing:border-box;width:100%;align-items:stretch;flex-direction:column;gap:8px}
.choice-grid-targets .choice-card{box-sizing:border-box;display:flex;width:100%;min-width:0;min-height:64px;flex:0 0 auto;margin:0;padding:9px 14px;flex-direction:row;align-items:center;justify-content:flex-start;gap:12px;border-radius:11px}
.target-radio{position:relative;width:18px;height:18px;flex:0 0 18px;border:1.5px solid var(--gain-radio);border-radius:50%}
.choice-card-active .target-radio{border:2px solid var(--theme-accent)}
.choice-card-active .target-radio::after{position:absolute;inset:3px;border-radius:50%;background:var(--theme-accent);content:""}
.target-copy{display:flex;box-sizing:border-box;min-width:0;flex:1;align-items:baseline;justify-content:space-between;gap:12px}
.choice-grid-targets .choice-label,.choice-grid-targets .choice-description{display:block;box-sizing:border-box;min-width:0;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
.choice-grid-targets .choice-label{font-size:16px;text-align:left}
.choice-grid-targets .choice-description{margin:0;color:var(--theme-text-secondary);font-size:13px;line-height:1.3;text-align:right}
.choice-card-active.choice-card .choice-description{color:var(--theme-accent-text);font-weight:620}
.load-not-required{display:flex;min-height:96px;padding:20rpx;flex-direction:column;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:18rpx;background:var(--theme-surface)}
.load-not-required-title{color:var(--theme-text);font-size:15px;font-weight:650}
.load-not-required-copy{margin-top:7rpx;color:var(--theme-text-secondary);font-size:12px;line-height:1.5}

@media(max-height:680px){
  .page-root{--gain-page-top-gap:3rpx;padding-top:3rpx}
  .result-pane{flex-basis:300px;padding-bottom:0}
  .result-card{padding-top:8px;padding-bottom:6px}
  .result-heading{flex-basis:20px;min-height:20px}
  .result-primary{flex-basis:100px}
  .result-value{font-size:50px}
  .result-facts{min-height:72px;flex-basis:72px}
