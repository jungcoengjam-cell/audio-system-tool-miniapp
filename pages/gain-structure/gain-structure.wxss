@import "../../styles/theme-page-shared.wxss";

page{--gain-action-accent:var(--theme-accent)}

.page-root{--gain-page-top-gap:8rpx;--gain-output-bg:#edf2f6;--gain-input-bg:#f7f9fb;--gain-readout:#16836e;--gain-muted:#5f6f7a;--gain-radio:#91a0aa;--theme-page-bg:#f7f9fb;--theme-surface:#f7f9fb;--theme-text:#202b35;--theme-text-secondary:#52616d;--theme-text-tertiary:#687985;--theme-divider:#d6dfe5;--theme-control:#f9fbfc;--theme-accent:#3e7597;--theme-accent-text:#3e7597;--theme-accent-soft:#edf5f8;--theme-success:#16836e;--theme-warning:#9a5b00;box-sizing:border-box;display:flex;width:100%;height:100vh;min-height:0;padding:8rpx 0 calc(8rpx + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;background:var(--gain-input-bg);color:var(--theme-text);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC","Helvetica Neue",sans-serif}
.result-pane{position:relative;display:flex;box-sizing:border-box;flex:0 0 340px;min-height:0;padding:0;flex-direction:column;background:var(--gain-output-bg)}
.result-card{position:relative;display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:0;flex:1;padding:12px 16px 8px;flex-direction:column;overflow:hidden;border:0;border-bottom:1rpx solid var(--theme-divider);border-radius:0;background:var(--gain-output-bg);box-shadow:none}
.action-rail{position:absolute;z-index:3;top:calc(8px - var(--gain-page-top-gap));right:12px;display:flex;box-sizing:border-box;width:44px;flex-direction:column;align-items:center;justify-content:flex-start;gap:2px;--theme-surface:var(--tv);--theme-text-secondary:var(--ts);--theme-divider:var(--td);--theme-accent-text:var(--ta);--theme-accent-soft:var(--as);--theme-accent:var(--gain-action-accent)}
.action-button.action-button{box-sizing:border-box;display:flex;flex:0 0 44px;align-items:center;justify-content:center;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;border:1rpx solid var(--theme-divider);border-radius:50%;background:var(--theme-surface);box-shadow:0 2px 8px rgba(0,0,0,.10);color:var(--theme-text-secondary);line-height:1}
.action-button.action-button::after{border:0}
.action-button.action-button[disabled]{opacity:.34}
.action-button.action-button:active{background:var(--theme-accent-soft);opacity:.72}
.action-icon{position:relative;display:flex;flex:none;align-items:center;justify-content:center;box-sizing:border-box;width:22px;height:22px;border-radius:50%;background:transparent;color:var(--theme-text-secondary);font-size:0;line-height:1}
