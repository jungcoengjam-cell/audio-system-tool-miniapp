<view class="page-root">
<scroll-view class="page-scroll" scroll-y>
  <view class="page-content">
    <view class="page-header">
      <view class="page-title">声压级估算</view>
    </view>

    <view class="section-label">估算条件</view>
    <view class="card settings-card">

      <view class="field speaker-field">
        <view class="field-label">音箱型号</view>
        <view class="picker-value equipment-value" bindtap="openSpeakerSelector">
          <view>
            <view class="equipment-model">{{selectedSpeaker.model}}</view>
            <view class="equipment-category">{{selectedSpeaker.category}}</view>
          </view>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <view class="field-grid compact-grid {{showSummationMode ? 'parameter-grid' : ''}}">
        <view class="field field-half">
          <view class="field-label">音箱数量</view>
          <picker range="{{counts}}" value="{{countIndex}}" data-field="countIndex" bindchange="onPickerChange">
            <view class="picker-value">{{counts[countIndex]}} 只<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view wx:if="{{showSummationMode}}" class="field field-half">
          <view class="field-label">叠加方式</view>
          <picker range="{{summationModes}}" range-key="label" value="{{summationModeIndex}}" data-field="summationModeIndex" bindchange="onPickerChange">
            <view class="picker-value">{{summationModes[summationModeIndex].shortLabel}}<text class="picker-arrow">›</text></view>
          </picker>
        </view>
        <view class="field field-half">
          <view class="field-label">测量距离</view>
          <view class="distance-input-wrap">
            <input
              class="distance-input {{distanceError ? 'distance-input-error' : ''}}"
              type="digit"
              value="{{distanceText}}"
              placeholder="1–1000"
              bindinput="onDistanceInput"
              bindblur="onDistanceBlur"
            />
            <view class="distance-unit">m</view>
          </view>
          <view wx:if="{{distanceError}}" class="field-error">{{distanceError}}</view>
        </view>
      </view>

      <view wx:if="{{showSummationMode}}" class="summation-hint">{{summationModes[summationModeIndex].description}}</view>
    </view>

    <view wx:if="{{result}}" class="result-card">
      <view class="result-heading">
        <view>
          <view class="result-label">{{result.distanceMeters}} m 理论声压级</view>
          <view class="result-title">{{result.model}} · {{result.speakerCount}} 只同型号音箱</view>
        </view>
        <view class="status-chip">{{result.speakerCount == 1 ? '单只基准' : result.summationModeShortLabel}}</view>
      </view>

      <view class="spl-value">{{result.selectedSpl}}<text class="spl-unit"> dB SPL</text></view>
      <view class="result-grid">
        <view class="metric">
          <view class="metric-value">{{result.sensitivityDb}} dB</view>
          <view class="metric-label">灵敏度 @ 1W/1m</view>
        </view>
        <view class="metric">
          <view class="metric-value">{{result.totalRatedPower}} W</view>
          <view class="metric-label">总额定功率（{{result.speakerCount}} 只）</view>
        </view>
        <view class="metric">
          <view class="metric-value">+{{result.summationGainDb}} dB</view>
          <view class="metric-label">本次叠加增益</view>
        </view>
        <view class="metric">
          <view class="metric-value">{{result.oneMeterSpl}} dB SPL</view>
          <view class="metric-label">{{result.speakerCount}} 只音箱在额定功率下 1 m 理论声压级</view>
        </view>
      </view>
      <view wx:if="{{result.speakerCount > 1}}" class="result-note">单只音箱在此距离的理论声压级为 {{result.singleSelectedSpl}} dB SPL；{{result.summationModeDescription}}</view>
      <view class="result-trust">
        <view class="result-trust-badge">自由场理论估算</view>
        <view class="result-trust-text">按说明书灵敏度、额定功率与自由场距离衰减估算；该数值不是现场实测声压级。</view>
      </view>
    </view>

    <view wx:if="{{result}}" class="utility-action-row result-actions-after-main">
        <view class="result-output-actions">
          <button class="result-image-button" disabled="{{isGeneratingResultReport}}" bindtap="generateResultReportImage">{{isGeneratingResultReport ? '正在生成…' : '生成结果图片'}}</button>
          <button class="copy-result-button" bindtap="copyResult">复制文字</button>
        </view>
        <include src="../../templates/result-record-actions.wxml" />
    </view>

    <view wx:if="{{result}}" class="reference-card">
      <view class="reference-heading">
        <view class="reference-copy">
          <view class="reference-title">{{result.humanReference.title}}；{{result.meetingReference.title}}</view>
        </view>
        <view class="reference-chip">{{result.humanReference.level}}</view>
      </view>
      <view class="meeting-text">仅比较最大声压级数值，不代表工程验收结论。</view>
      <view class="reference-scale">约 60 dB：日常交谈　·　约 80 dB：明显偏响　·　约 100 dB：高声压扩声</view>
    </view>

    <view wx:if="{{result}}" class="card distance-card">
      <view class="distance-heading">
        <view>
          <view class="card-title distance-title">不同距离声压级</view>
          <view wx:if="{{result.speakerCount == 1}}" class="distance-source">每增加一倍距离，理论声压级降低约 6 dB</view>
        </view>
        <view class="distance-tag">{{result.speakerCount}} 只 · 自由场</view>
      </view>

      <view class="distance-table">
        <view wx:for="{{result.distanceRows}}" wx:key="distanceMeters" class="distance-row {{item.isSelected ? 'distance-row-active' : ''}}">
          <view class="distance-value">{{item.distanceMeters}} m</view>
          <view class="distance-spl">{{item.spl}}<text> dB SPL</text></view>
          <view wx:if="{{item.isSelected}}" class="distance-current">当前</view>
        </view>
      </view>
    </view>

  </view>

  <view wx:if="{{selectorVisible}}" class="selector-mask" catchtap="closeSpeakerSelector">
    <view class="selector-panel" catchtap="stopTap">
      <view class="selector-header">
        <view class="selector-title">选择音箱型号</view>
        <view class="selector-close" catchtap="closeSpeakerSelector">×</view>
      </view>

      <input
        class="selector-search"
        value="{{selectorKeyword}}"
        placeholder="输入型号关键词，例如 TS-803、KF-D"
        confirm-type="search"
        bindinput="onSelectorInput"
      />

      <scroll-view class="category-scroll" scroll-x>
        <view class="category-list">
          <view
            wx:for="{{speakerCategories}}"
            wx:key="label"
            class="category-chip {{index == selectorCategoryIndex ? 'category-chip-active' : ''}}"
            data-index="{{index}}"
            catchtap="onSelectorCategoryTap"
          >{{item.label}}</view>
        </view>
      </scroll-view>

      <view class="selector-count">共 {{selectorTotalCount}} 个已录入灵敏度的型号</view>

      <scroll-view class="selector-list" scroll-y bindscrolltolower="appendSelectorItems">
        <view
          wx:for="{{selectorItems}}"
          wx:key="model"
          class="selector-row"
          data-index="{{item.index}}"
          catchtap="selectSpeaker"
        >
          <view class="selector-row-copy">
            <view class="selector-model">{{item.model}}</view>
            <view class="selector-meta">{{item.sensitivityDb}} dB @ 1W/1m · {{item.category}}</view>
          </view>
          <view class="selector-row-actions">
            <button class="selector-detail" data-model="{{item.model}}" catchtap="openSpeakerDetail">资料</button>
            <view class="selector-row-arrow">›</view>
          </view>
        </view>

        <view wx:if="{{selectorItems.length == 0}}" class="selector-empty">
          没有匹配型号，请换一个关键词或选择“全部”分类。
        </view>
      </scroll-view>
    </view>
  </view>
</scroll-view>

<include src="../../templates/result-report-preview.wxml" />
</view>
