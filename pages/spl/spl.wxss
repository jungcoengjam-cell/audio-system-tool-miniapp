.result-primary{box-sizing:border-box;width:auto;margin:0 0 15px;text-align:center}.result-primary-empty{margin:0}
.result-label{display:block;color:var(--theme-text-secondary);font-size:13px;font-weight:500;line-height:1.35}
.result-model{margin-top:3px;color:var(--theme-text);font-size:18px;font-weight:650;line-height:1.25}
.result-condition{margin-top:4px;color:var(--theme-text-secondary);font-size:12px;line-height:1.3}
.spl-value{margin-top:12px;color:var(--theme-text);font-size:68rpx;font-weight:750;letter-spacing:-1.5rpx;line-height:1.08;text-align:center;overflow-wrap:anywhere}
.spl-unit{color:var(--theme-text-secondary);font-size:24rpx;font-weight:650;letter-spacing:0}
.result-hero-caption{margin-top:4px;color:var(--theme-text-tertiary);font-size:11px;line-height:1.35;text-align:center}
.result-subtitle{display:block;max-width:calc(100% - 64px);margin:7px auto 0;color:var(--theme-text-secondary);font-size:13px;line-height:1.45;text-align:center;overflow-wrap:anywhere}
.result-grid{display:grid;width:100%;margin-top:52px;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;overflow:hidden;border:1px solid var(--theme-divider);border-radius:15px;background:var(--theme-divider)}
.metric{box-sizing:border-box;min-width:0;padding:9px 7px;background:var(--theme-surface-muted);text-align:center}
.metric-value{color:var(--theme-text);font-size:14px;font-weight:650;line-height:1.35;overflow-wrap:anywhere}
.metric-label{margin-top:2px;color:var(--theme-text-secondary);font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.result-note{margin-top:10px;color:var(--theme-text-secondary);font-size:11px;line-height:1.5;overflow-wrap:anywhere}
.result-trust{display:flex;align-items:flex-start;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid var(--theme-divider)}
.result-trust-badge{flex:none;padding:4px 7px;border-radius:999px;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:10px;font-weight:650;line-height:1.3}
.result-trust-text{color:var(--theme-text-tertiary);font-size:10px;line-height:1.45}
.card{box-sizing:border-box;margin:0 0 14rpx;padding:16px;border:1px solid var(--theme-divider);border-radius:20px;background:var(--theme-surface);box-shadow:0 4px 14px var(--theme-shadow)}
.card-title{margin:0 0 11px;color:var(--theme-text);font-size:16px;font-weight:650;line-height:1.3}.settings-card{padding:13px 14px 11px}
.settings-card .field,.settings-card .field-grid .field{min-width:0;margin:0}
.settings-card .speaker-field{display:flex;min-height:51px;align-items:center;border-bottom:1px solid var(--theme-divider)}
.settings-card .speaker-field .field-label{flex:0 0 82px;margin:0;color:var(--theme-text-secondary);font-size:13px;line-height:1.3}
.picker-value,.distance-input-wrap{box-sizing:border-box;min-height:44px;border:1px solid var(--theme-divider);border-radius:13px;background:var(--theme-control);color:var(--theme-text)}
.picker-value{display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-size:14px;line-height:1.25}.picker-value:active{opacity:.72}
.equipment-value{flex:1;min-width:0;min-height:44px;padding:0;background:transparent;border:0;text-align:right}
.equipment-value>view:first-child{min-width:0;overflow:hidden}.equipment-model,.equipment-category{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.equipment-model{color:var(--theme-text);font-size:14px;font-weight:600}.equipment-category{margin-top:2px;color:var(--theme-text-tertiary);font-size:10px}
.picker-arrow{flex:none;margin-left:7px;color:var(--theme-text-tertiary);font-size:22px;line-height:1}
.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.settings-card .compact-grid{padding-top:11px}
.settings-card .parameter-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
.field-label{display:block;margin:0 0 5px;color:var(--theme-text-secondary);font-size:12px;line-height:1.3}
.settings-card .compact-grid .field-label.field-label{overflow:hidden;margin-bottom:5px;font-size:11px;text-overflow:ellipsis;white-space:nowrap}
.settings-card .compact-grid .picker-value,.settings-card .compact-grid .distance-input-wrap{min-height:44px}
.settings-card .compact-grid .picker-value{padding:0 7px;font-size:12px}.settings-card .parameter-grid .picker-value{font-size:11px}
.distance-input-wrap{display:flex;align-items:center;padding-left:9px}
.distance-input{box-sizing:border-box;min-width:0;height:42px;flex:1;font-size:15px;color:var(--theme-text)}
.distance-unit{padding:0 10px 0 5px;color:var(--theme-text-secondary);font-size:13px}
.distance-input-error{border-color:var(--theme-danger)!important;background:rgba(198,58,50,.08)!important}
.field-error,.form-error{display:block;margin-top:6px;color:var(--theme-danger);font-size:12px;line-height:1.4;overflow-wrap:anywhere}
.summation-hint{margin:7px 0 0;color:var(--theme-text-tertiary);font-size:10px;line-height:1.4}.reset-error{margin-top:8px}
.reference-card{box-sizing:border-box;margin:0 0 14rpx;padding:14px;border:1px solid var(--theme-divider);border-radius:18px;background:var(--theme-surface);box-shadow:0 3px 12px var(--theme-shadow)}
.reference-heading,.distance-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.reference-copy{min-width:0;flex:1}
.reference-title.reference-title{color:var(--theme-text);font-size:14px;font-weight:650;line-height:1.4;overflow-wrap:anywhere}
.reference-chip,.distance-tag{flex:none;padding:5px 8px;border-radius:999px;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:10px;font-weight:650;line-height:1.3}
.meeting-text{margin-top:7px;color:var(--theme-text-secondary);font-size:11px;line-height:1.4}
.reference-scale{margin-top:8px;padding:7px 9px;border-radius:11px;background:var(--theme-control);color:var(--theme-text-secondary);font-size:10px;line-height:1.45}
.distance-card{margin-bottom:0}.distance-title{margin-bottom:3px}.distance-source{color:var(--theme-text-secondary);font-size:11px;line-height:1.35}
.distance-row{display:flex;min-height:43px;padding:0 10px;align-items:center;border-bottom:1px solid var(--theme-divider)}.distance-row:last-child{border-bottom:0}
.distance-value{width:76px;color:var(--theme-text-secondary);font-size:13px;font-weight:600}
.distance-spl{flex:1;color:var(--theme-accent-text);font-size:16px;font-weight:700;text-align:right}.distance-spl text{font-size:10px;font-weight:600}
.distance-current{margin-left:9px;padding:3px 7px;border-radius:999px;background:var(--theme-primary-fill);color:#fff;font-size:10px}.distance-row-active{background:var(--theme-accent-soft)}
.selector-mask,.spl-overlay{position:fixed;z-index:100;inset:0;display:flex;box-sizing:border-box;padding:0 12px calc(10px + env(safe-area-inset-bottom));align-items:flex-end;background:rgba(18,20,27,.52)}
.selector-panel,.spl-sheet{display:flex;box-sizing:border-box;width:100%;max-height:88vh;min-height:0;padding:15px 14px calc(12px + env(safe-area-inset-bottom));flex-direction:column;overflow:hidden;border:1px solid var(--theme-divider);border-radius:24px 24px 0 0;background:var(--theme-surface);box-shadow:0 -12px 38px rgba(0,0,0,.18);color:var(--theme-text)}
.selector-header,.sheet-header{display:flex;box-sizing:border-box;flex:none;min-height:44px;margin-bottom:9px;align-items:center;justify-content:space-between;gap:10px}
.selector-title,.sheet-title{color:var(--theme-text);font-size:16px;font-weight:700;line-height:1.3}.sheet-subtitle{display:block;margin-top:3px;color:var(--theme-text-secondary);font-size:11px;line-height:1.35}
.selector-close.selector-close,.sheet-close.sheet-close{box-sizing:border-box;display:flex;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:var(--theme-control);color:var(--theme-text-secondary);font-size:26px;line-height:1}
.selector-close.selector-close::after,.sheet-close.sheet-close::after{border:0}
.selector-search,.project-search{box-sizing:border-box;width:100%;height:44px;min-height:44px;padding:0 12px;border:1px solid var(--theme-divider);border-radius:13px;background:var(--theme-control);color:var(--theme-text);font-size:14px;line-height:44px}
.category-scroll{box-sizing:border-box;flex:none;margin-top:9px;white-space:nowrap}.category-list{display:flex;gap:7px}
.category-chip{display:flex;box-sizing:border-box;min-width:44px;min-height:44px;flex:none;margin:0;padding:0 13px;align-items:center;border:1px solid var(--theme-divider);border-radius:999px;background:var(--theme-control);color:var(--theme-text-secondary);font-size:12px}
.category-chip-active{border-color:transparent;background:var(--theme-accent);color:#fff}
.selector-count{flex:none;margin:9px 0 7px;color:var(--theme-text-secondary);font-size:11px}
.selector-list{box-sizing:border-box;width:100%;height:0;min-height:140px;flex:1;border:1px solid var(--theme-divider);border-radius:15px;background:var(--theme-surface)}
.selector-row{display:flex;box-sizing:border-box;min-height:58px;padding:7px 10px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--theme-divider)}
.selector-row-copy{min-width:0;flex:1}.selector-model{color:var(--theme-text);font-size:14px;font-weight:650;line-height:1.25}
.selector-meta{margin-top:3px;color:var(--theme-text-secondary);font-size:11px;line-height:1.2}.selector-row-actions{display:flex;align-items:center;margin-left:8px}
.selector-detail.selector-detail{display:flex;box-sizing:border-box;flex:0 0 58px;width:58px;min-width:58px;max-width:58px;height:44px;min-height:44px;max-height:44px;margin:0 5px 0 0;padding:0;align-items:center;justify-content:center;border:0;border-radius:12px;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:11px;font-weight:600}
.selector-detail.selector-detail::after{border:0}.selector-row-arrow{color:var(--theme-text-tertiary);font-size:25px}
.selector-empty{padding:36px 12px;color:var(--theme-text-secondary);font-size:13px;line-height:1.5;text-align:center}
.share-panel{gap:0}.share-state{display:flex;box-sizing:border-box;min-height:120px;flex:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;color:var(--theme-text-secondary);font-size:13px;line-height:1.45;text-align:center}
.share-error{color:var(--theme-danger)}.loading-dot{width:20px;height:20px;border:2px solid var(--theme-divider);border-top-color:var(--theme-accent);border-radius:50%;animation:spl-spin .8s linear infinite}
@keyframes spl-spin{to{transform:rotate(360deg)}}
.share-image{display:block;width:100%}.share-actions,.project-footer{display:flex;box-sizing:border-box;flex:none;gap:8px;padding-top:10px}
.share-action.share-action,.share-retry.share-retry{box-sizing:border-box;display:flex;width:auto;min-width:0;max-width:none;height:auto;min-height:44px;flex:1 1 0;margin:0;padding:7px 9px;align-items:center;justify-content:center;border:0;border-radius:14px;background:var(--theme-control);color:var(--theme-accent-text);font-size:13px;font-weight:650;line-height:1.35;text-align:center;white-space:normal}
.share-action.share-action::after,.share-retry.share-retry::after{border:0}.share-action-primary.share-action-primary{background:var(--theme-primary-fill);color:#fff}
.share-action[disabled],.share-retry[disabled]{opacity:.42}.share-retry.share-retry{max-width:170px;flex:none;margin-top:8px}
.project-overlay{z-index:110}.project-overlay.project-keyboard-open{padding-bottom:10px}.project-panel{max-height:90vh}
.project-panel .project-sheet-body{box-sizing:border-box;display:block;width:100%;height:auto;max-height:55vh;min-height:0;flex:0 1 auto;overflow:hidden;-webkit-overflow-scrolling:touch}
.project-panel.project-keyboard-open{min-height:0;padding-bottom:12px}.project-panel.project-keyboard-open .project-sheet-body{min-height:54px;max-height:45vh}
.project-create-body,.project-details-body{padding-top:2px;padding-bottom:5px}.project-name-input,.project-config-name{margin-top:4px}.project-note-label{margin-top:13px}
.project-note{box-sizing:border-box;display:block;width:100%;height:78px;min-height:78px;margin-top:4px;padding:10px 12px;border:1px solid var(--theme-divider);border-radius:13px;background:var(--theme-control);color:var(--theme-text);font-size:14px;line-height:1.4}
.project-state{display:flex;min-height:72px;padding:10px 2px;align-items:center;justify-content:center;flex-direction:column;color:var(--theme-text-secondary);font-size:13px;line-height:1.45;text-align:center}
.project-state-error{color:var(--theme-danger)}.project-list{display:flex;flex-direction:column;gap:6px;padding:8px 0}
.project-row.project-row{display:flex;box-sizing:border-box;width:100%;min-width:0;height:auto;min-height:48px;flex:0 0 auto;margin:0;padding:7px 11px;align-items:center;gap:8px;border:1px solid var(--theme-divider);border-radius:13px;background:var(--theme-surface);color:var(--theme-text);font-size:14px;text-align:left}
.project-row.project-row::after{border:0}.project-row.project-row-selected{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.project-row>text:first-child{min-width:0;flex:1;overflow-wrap:anywhere}.field-arrow{color:var(--theme-text-tertiary);font-size:22px}
.project-target{display:flex;box-sizing:border-box;min-width:0;margin-bottom:10px;align-items:center;gap:8px}.project-target-label{flex:none;color:var(--theme-text-secondary);font-size:13px}
.project-target-name{min-width:0;flex:1;color:var(--theme-text);font-size:14px;font-weight:650;overflow-wrap:anywhere}
.text-action.text-action{box-sizing:border-box;width:auto;min-width:58px;max-width:76px;height:44px;min-height:44px;max-height:44px;flex:0 0 auto;margin:0;padding:4px 7px;border:0;background:transparent;color:var(--theme-accent-text);font-size:12px}.text-action.text-action::after{border:0}
.project-preview{display:flex;flex-direction:column;gap:4px;margin-top:12px;padding:10px 11px;border:1px solid var(--theme-divider);border-radius:13px;background:var(--theme-surface-muted);color:var(--theme-text);font-size:12px;line-height:1.4}
.preview-title{font-size:13px;font-weight:700}.project-preview-title{font-weight:650;overflow-wrap:anywhere}.project-preview-summary{color:var(--theme-text-secondary);overflow-wrap:anywhere}
.project-preview-result{padding-top:4px;border-top:1px solid var(--theme-divider);white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}
.project-footer{padding-top:9px}.project-success{display:flex;min-height:130px;flex-direction:column;align-items:center;justify-content:center;gap:7px;color:var(--theme-text);font-size:14px;text-align:center}
.success-title{color:var(--theme-success);font-size:18px;font-weight:700}.success-project,.saved-config-name,.saved-at{max-width:100%;overflow-wrap:anywhere;word-break:break-word}
.saved-config-name{font-weight:650}.saved-at{color:var(--theme-text-secondary);font-size:12px}
.result-report-canvas-offscreen{position:fixed;z-index:-1;top:0;left:-10000px;pointer-events:none;opacity:0}
@media (prefers-color-scheme:dark){
.page-root,.page-scroll{background:var(--theme-page-bg);color:var(--theme-text)}
.result-card,.card,.reference-card,.distance-row,.selector-panel,.spl-sheet,.project-row{border-color:var(--theme-divider);background:var(--theme-surface);color:var(--theme-text)}
.settings-card .compact-grid .picker-value,.settings-card .speaker-field .equipment-value,.distance-input-wrap,.selector-search,.project-search,.project-note{background:var(--theme-control);color:var(--theme-text)}
.settings-card .speaker-field .equipment-model,.result-model,.spl-value,.metric-value,.reference-title.reference-title,.project-target-name,.project-preview{color:var(--theme-text)}
.settings-card .speaker-field .field-label,.settings-card .compact-grid .field-label.field-label,.result-label,.result-condition,.result-hero-caption,.metric-label,.result-note,.result-trust-text,.meeting-text,.reference-scale,.distance-value,.distance-source,.sheet-subtitle{color:var(--theme-text-secondary)}
.spl-unit{color:var(--theme-text-secondary)}.distance-spl{color:var(--theme-accent-text)}
.distance-current{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.reference-scale,.metric,.project-preview{background:var(--theme-surface-muted)}
}
@media(max-width:360px){.spl-value{font-size:62rpx}}
@media(prefers-reduced-motion:reduce){.loading-dot,.spl-sheet,.spl-sheet.spl-sheet-closing{animation-duration:.01ms!important;animation-iteration-count:1!important}.page-root,.page-scroll{scroll-behavior:auto!important}}

.result-section{display:flex;box-sizing:border-box;margin-top:16px;padding-top:12px;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid var(--theme-divider)}
.result-section-title{color:var(--theme-text);font-size:14px;font-weight:650;line-height:1.35}
.distance-heading{align-items:flex-start}
.distance-source{margin-top:3px}
.reference-scale{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;text-align:center}
.meeting-text{font-size:11px}
.equipment-placeholder{color:var(--theme-text-tertiary);font-size:14px}

.spl-overlay{padding:0;opacity:1;animation:spl-overlay-in 180ms ease-out both}
.spl-overlay.spl-closing{padding:0;opacity:1;animation:spl-overlay-out 320ms ease-in both;pointer-events:auto}
.spl-sheet{width:100%;max-height:90vh;padding:15px 16px calc(12px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0;animation:spl-sheet-slide-in 320ms cubic-bezier(.2,.72,.25,1) both}
.spl-sheet.spl-sheet-closing{animation:spl-sheet-slide-out 320ms ease-in both;pointer-events:none}
.share-panel{height:auto;max-height:90vh;min-height:0}
.share-image-frame{display:flex;box-sizing:border-box;width:100%;height:auto;min-height:0;flex:none;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--theme-divider);border-radius:16px;background:var(--theme-control)}
.share-image{display:block;max-width:100%;max-height:100%;flex:none}
.reference-chips{display:flex;flex:none;align-items:flex-end;flex-direction:column;gap:4px}
.reference-chips .reference-chip{max-width:110px;text-align:center;white-space:normal;overflow-wrap:anywhere}
.result-card .reference-heading{margin-top:8px}
.project-overlay.project-keyboard-open{padding:0}
.project-panel{max-height:90vh}
.project-panel.project-keyboard-open{padding-bottom:12px}
@keyframes spl-sheet-slide-in{from{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}to{transform:translateY(0)}}
@keyframes spl-sheet-slide-out{from{transform:translateY(0)}to{transform:translateY(calc(100% + env(safe-area-inset-bottom)))}}
@keyframes spl-overlay-in{from{opacity:0}to{opacity:1}}
@keyframes spl-overlay-out{from{opacity:1}to{opacity:0}}
.selector-mask{animation:spl-selector-mask-in 180ms ease-out both}
.selector-mask.selector-closing{animation:spl-selector-mask-out 180ms ease-in both}
.selector-panel{animation:spl-sheet-slide-in 180ms cubic-bezier(.2,.72,.25,1) both}
.selector-panel.selector-panel-closing{animation:spl-sheet-slide-out 180ms ease-in both;pointer-events:none}
@keyframes spl-selector-mask-in{from{opacity:0}to{opacity:1}}
@keyframes spl-selector-mask-out{from{opacity:1}to{opacity:0}}
@media(prefers-reduced-motion:reduce){.selector-mask,.selector-panel,.selector-mask.selector-closing,.selector-panel.selector-panel-closing,.spl-overlay,.spl-overlay.spl-closing{animation-duration:.01ms!important;animation-iteration-count:1!important}}

@media(max-width:360px){
  .result-grid{margin-top:68px}
  .distance-list .distance-row{padding-right:5px;padding-left:5px;gap:3px}
  .distance-list .distance-value{min-width:0;font-size:11px}
  .distance-list .distance-spl{font-size:12px}
  .distance-list .distance-spl text{font-size:8px}
  .distance-list .distance-current{padding:3px 4px;font-size:8px}
}

/* SPL 首页在一屏内呈现结果和估算条件，补充信息由三个结果页签承载。 */
.page-root{overflow:visible}
.page-scroll{height:100vh;overflow:visible}
.page-content{display:flex;box-sizing:border-box;width:100%;height:100vh;min-height:100vh;padding:6px 28rpx calc(16px + env(safe-area-inset-bottom));align-items:stretch;justify-content:center;flex-direction:column}
.result-pane{display:flex;min-height:0;flex:0 0 auto;margin-bottom:8px;flex-direction:column}
.result-card{display:flex;min-height:0;flex:0 0 auto;padding:20px 16px 12px;flex-direction:column}
.result-card-pending,.result-card-invalid{min-height:0;align-items:stretch;justify-content:flex-start}
.result-primary.result-primary{display:flex;box-sizing:border-box;min-height:180px;flex:0 0 auto;margin:0 56px;align-items:center;justify-content:center;flex-direction:column;text-align:center}
.result-primary-empty.result-primary-empty{margin-right:56px;margin-left:56px}
.result-model{max-width:100%;overflow-wrap:anywhere}
.result-condition{max-width:100%;margin-top:4px;overflow-wrap:anywhere;text-align:center}
.spl-value{margin-top:8px}
.result-hero-caption{margin-top:5px}
.result-grid-home{display:grid;box-sizing:border-box;width:100%;min-height:0;flex:none;margin-top:8px;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px}
.result-grid-home .metric{display:flex;min-width:0;min-height:53px;padding:7px 4px;align-items:center;justify-content:center;flex-direction:column}
.settings-card{flex:none;margin-bottom:0;padding:8px 12px}
.settings-card .speaker-field{min-height:44px}
.settings-card .speaker-field .field-label{flex:0 0 34px;font-size:12px;line-height:1.2}
.settings-card .speaker-field .equipment-value{height:auto;min-height:44px;padding:4px 0;align-items:center;text-align:left}
.settings-card .equipment-value>view:first-child{min-width:0;overflow:visible}
.settings-card .equipment-model{overflow:visible;text-overflow:clip;white-space:normal;overflow-wrap:anywhere;line-height:1.2}
.settings-card .equipment-category{display:none}
.settings-card .compact-grid{gap:6px;padding-top:7px}
.settings-card .parameter-grid{gap:4px}
.settings-card .compact-grid .field-label.field-label{margin-bottom:3px;font-size:11px}
.settings-card .compact-grid .picker-value,.settings-card .compact-grid .distance-input-wrap{min-height:44px}
.settings-card .compact-grid .picker-value{padding-right:5px;padding-left:5px;font-size:11px}
.settings-card .parameter-grid .picker-value{font-size:11px}
.reference-description{margin-top:4px;color:var(--theme-text-secondary);font-size:12px;line-height:1.45;overflow-wrap:anywhere}
@media(max-width:360px){
  .page-content{padding-right:12px;padding-left:12px}
  .result-card{padding-right:10px;padding-left:10px}
  .result-grid-home .metric{padding-right:2px;padding-left:2px}
}
@media(max-height:560px){
  .page-content{padding-top:4px;padding-bottom:calc(10px + env(safe-area-inset-bottom))}
  .result-pane{margin-bottom:5px}
  .result-card{padding:5px 10px}
  .result-primary.result-primary{min-height:191px}
  .result-primary-empty.result-primary-empty{min-height:191px}
  .result-grid-home{margin-top:6px}
  .result-grid-home .metric{min-height:47px;padding:6px 2px}
  .settings-card{padding:6px 10px 7px}
  .settings-card .compact-grid{padding-top:6px}
}
@media (prefers-color-scheme:dark){
  .reference-description{color:var(--theme-text-secondary)}
}

/* 结果区页签与静态结果面板 */
.result-card-tabs{padding:5px 10px 10px}
.result-tabs{display:flex;box-sizing:border-box;width:100%;min-height:44px;margin:0 0 2px;gap:2px;border-radius:12px;background:var(--theme-surface-muted)}
.result-tab{display:flex;box-sizing:border-box;min-width:0;min-height:44px;flex:1 1 0;padding:0 3px;align-items:center;justify-content:center;border-radius:10px;color:var(--theme-text-secondary);font-size:12px;font-weight:550;line-height:1.2;text-align:center;white-space:nowrap}
.result-tab-active{background:var(--theme-accent-soft);color:var(--theme-accent-text);font-weight:700}
.result-tab-disabled{opacity:.45}
.result-tab-panel{box-sizing:border-box;min-width:0;flex:none}
.result-tab-spl{width:100%}
.result-primary.result-primary{display:flex;box-sizing:border-box;min-height:0;flex:0 0 auto;margin:0;align-items:center;justify-content:center;flex-direction:column;text-align:center}
.result-primary-home{width:auto;padding:0}
.result-state{display:flex;box-sizing:border-box;min-height:0;margin:0;align-items:center;justify-content:center;flex-direction:column;text-align:center}
.result-grid-home{display:grid;box-sizing:border-box;width:100%;min-height:0;flex:none;margin-top:8px;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px}
.result-grid-home .metric{display:flex;min-width:0;min-height:52px;padding:7px 3px;align-items:center;justify-content:center;flex-direction:column}
.distance-tab-condition,.reference-tab-condition{box-sizing:border-box;width:100%;margin:0 0 5px;color:var(--theme-text-secondary);font-size:11px;line-height:1.3;overflow-wrap:anywhere}
.distance-list{display:flex;box-sizing:border-box;width:100%;margin:6px 0 0;flex-direction:column}
.distance-list .distance-row{display:flex;box-sizing:border-box;width:100%;min-width:0;min-height:32px;padding:4px 8px;align-items:center;justify-content:space-between;flex-direction:row;gap:8px;border:0;border-bottom:1px solid var(--theme-divider);background:transparent}
.distance-list .distance-row:last-child{border-bottom:0}
.distance-list .distance-row-active{border-radius:9px;background:var(--theme-accent-soft)}
.distance-list .distance-row-head{display:flex;min-width:0;flex:1 1 auto;align-items:center;justify-content:flex-start;gap:8px}
.distance-list .distance-value{width:auto;min-width:0;flex:0 1 auto;font-size:12px;line-height:1.35;white-space:normal;overflow-wrap:anywhere}
.distance-list .distance-result{display:flex;box-sizing:border-box;width:auto;min-width:0;flex:0 0 auto;align-items:center;justify-content:flex-end;gap:3px;flex-wrap:nowrap}
.distance-list .distance-spl{min-width:0;flex:0 0 auto;font-size:14px;white-space:nowrap}
.distance-list .distance-spl text{font-size:9px}
.distance-list .distance-current{flex:none;margin:0;padding:3px 5px;font-size:9px}
.distance-mode-note{margin-top:6px;color:var(--theme-text-secondary);font-size:11px;line-height:1.35;overflow-wrap:anywhere}
.reference-tab-condition{margin-bottom:4px}
.reference-tab-main{display:flex;box-sizing:border-box;width:100%;min-height:0;flex-direction:column;gap:6px}
.reference-tab-item{min-width:0}
.reference-tab-main .reference-heading{margin-top:0;gap:5px}
.reference-tab-main .reference-title.reference-title{font-size:12px;line-height:1.3}
.reference-tab-main .reference-chip{padding:3px 5px;font-size:9px;line-height:1.25}
.reference-tab-main .reference-description{margin-top:3px;font-size:11px;line-height:1.35}
.reference-tab-footer{box-sizing:border-box;width:100%;margin-top:6px}
.reference-tab-footer .meeting-text{margin-top:0;font-size:11px;line-height:1.3}
.reference-tab-footer .reference-scale{margin-top:5px;padding:5px 6px;font-size:9px;line-height:1.3}
.reference-tab-footer .reference-scale>view{min-width:0;overflow-wrap:anywhere}
.reference-tab-footer .result-trust{margin-top:6px;padding-top:6px;gap:6px}
.reference-tab-footer .result-trust-badge{padding:3px 6px;font-size:9px}
.reference-tab-footer .result-trust-text{font-size:10px;line-height:1.35}
@media(max-width:360px){
  .distance-list .distance-row{padding-right:5px;padding-left:5px;gap:3px}
  .distance-list .distance-value{min-width:39px;font-size:11px}
  .distance-list .distance-spl{font-size:14px}
  .distance-list .distance-spl text{font-size:8px}
  .distance-list .distance-current{padding:3px 4px;font-size:8px}
