@import "../../styles/theme-page-shared.wxss";
.page-root{box-sizing:border-box;width:100%;height:100vh;overflow:hidden;background:var(--theme-page-bg);color:var(--theme-text)}
.page-scroll{box-sizing:border-box;width:100%;height:100vh;background:var(--theme-page-bg);-webkit-overflow-scrolling:touch}
.page-content{box-sizing:border-box;padding:10rpx 28rpx calc(38rpx + env(safe-area-inset-bottom))}
.result-pane{position:relative;width:100%;margin-bottom:16rpx;overflow:visible}
.result-card{box-sizing:border-box;width:100%;min-height:216px;padding:20px 16px 18px;border:1px solid var(--theme-divider);border-radius:22px;background:var(--theme-surface);color:var(--theme-text);box-shadow:0 5px 18px var(--theme-shadow)}
.result-card-pending,.result-card-invalid{display:flex;min-height:216px;align-items:center;justify-content:center}
.action-rail{position:absolute;z-index:3;top:0;right:0;display:flex;width:44px;flex-direction:column;align-items:center;gap:4px}
.action-button.action-button{box-sizing:border-box;display:flex;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;margin:0;padding:0;align-items:center;justify-content:center;border:1px solid var(--theme-divider);border-radius:50%;background:var(--theme-surface);box-shadow:0 2px 8px rgba(0,0,0,.1);color:var(--theme-accent-text);line-height:1;transition:opacity .14s ease,transform .14s ease}
.action-button.action-button::after{border:0}.action-button.action-button[disabled]{opacity:.34;box-shadow:none}
.action-icon{display:block;width:22px;height:22px;background-color:currentColor;-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-size:100% 100%;mask-size:100% 100%}
