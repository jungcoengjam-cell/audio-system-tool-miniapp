<view class="page-shell"><scroll-view class="page-scroll" scroll-y="{{scrollEnabled}}" enhanced show-scrollbar="{{false}}" bindscroll="onPageScroll"><view class="page-content"><view class="page-heading"><view class="page-title">灯具位置图</view></view><view wx:if="{{!hasPlan}}" class="empty-card"><view class="empty-title">暂无可用编址方案</view><view class="empty-text">{{errorText}}</view></view><block wx:if="{{hasPlan}}"><view class="settings-card"><view class="section-title">场地与排布</view><view class="dimension-row"><view class="compact-field"><view class="field-label">舞台宽度</view><view class="number-control"><input class="number-input" type="digit" value="{{stageWidthText}}" data-key="stageWidthText" bindinput="onStageInput" bindblur="onStageBlur" /><text>m</text></view></view><view class="compact-field"><view class="field-label">舞台纵深</view><view class="number-control"><input class="number-input" type="digit" value="{{stageDepthText}}" data-key="stageDepthText" bindinput="onStageInput" bindblur="onStageBlur" /><text>m</text></view></view></view><view class="choice-row"><picker class="choice-picker" mode="selector" range="{{schemeOptions}}" value="{{schemeIndex}}" bindchange="onSchemeChange"><view class="choice-control"><view><text class="choice-label">灯位方案</text><text class="choice-value">{{schemeOptions[schemeIndex]}}</text></view><text>›</text></view></picker><picker class="choice-picker" mode="selector" range="{{frontOptions}}" value="{{frontIndex}}" bindchange="onFrontChange"><view class="choice-control"><view><text class="choice-label">舞台前沿</text><text class="choice-value">{{frontOptions[frontIndex]}}</text></view><text>›</text></view></picker></view><view class="choice-row"><picker class="choice-picker" mode="selector" range="{{rowOptions}}" value="{{rowIndex}}" bindchange="onRowChange"><view class="choice-control"><view><text class="choice-label">顶光杆排数</text><text class="choice-value">{{rowOptions[rowIndex]}}</text></view><text>›</text></view></picker><picker wx:if="{{schemeIndex === 2}}" class="choice-picker" mode="selector" range="{{sidePairOptions}}" value="{{sidePairIndex}}" bindchange="onSidePairChange"><view class="choice-control"><view><text class="choice-label">侧光位置</text><text class="choice-value">{{sidePairOptions[sidePairIndex]}}</text></view><text>›</text></view></picker><view wx:else class="choice-placeholder"></view></view><view class="plan-summary">{{totalGroups}} 组 · {{totalFixtures}} 台 · {{addressRangeText}}</view></view><view class="map-card"><view class="map-toolbar"><view><view class="section-title">位置示意</view><view class="section-note">点按选择，按住拖动调整位置</view></view><view class="landscape-switch" role="button" aria-label="进入横屏布置" bindtap="openLandscapeLayout" hover-class="landscape-switch-pressed">横屏 <text>›</text></view></view><view class="map-actions"><button class="address-button" bindtap="toggleAddressLabels">{{addressLabelModeText}}</button><button class="auto-button" bindtap="toggleBarConfiguration">{{barConfigurationExpanded ? '收起配置' : '灯位配置'}}</button><button class="clear-button" bindtap="clearLayout">清空位置</button><button wx:if="{{viewZoomed}}" class="view-reset-button" bindtap="resetCanvasView">适应屏幕</button></view><view wx:if="{{barConfigurationExpanded}}" class="bar-config-panel"><view class="bar-config-head"><view><view class="bar-config-title">灯位灯具配置</view><view class="bar-config-note">每个灯具组需完整分配，可拆分到不同灯位</view></view><button class="balance-button" bindtap="balanceBarConfiguration">均匀分配</button></view><view wx:for="{{barRows}}" wx:key="barIndex" wx:for-item="bar" class="bar-config-row"><view class="bar-config-row-title">{{bar.label}}</view><view class="bar-group-grid"><view wx:for="{{bar.groups}}" wx:key="groupIndex" wx:for-item="group" class="bar-group-field"><view class="bar-group-name">{{group.name}}</view><view class="bar-count-control"><input class="bar-count-input" type="number" value="{{group.countText}}" data-bar-index="{{bar.barIndex}}" data-group-index="{{group.groupIndex}}" bindinput="onBarCountInput" /><text>/ {{group.total}}</text></view></view></view></view><view class="bar-config-status {{barConfigurationValid ? 'bar-config-status-valid' : 'bar-config-status-error'}}">{{barConfigurationStatusText}}</view><button class="apply-bar-button" bindtap="applyBarConfiguration">按配置生成位置图</button></view><view wx:if="{{unplacedFixtureCount > 0}}" class="fixture-palette"><view class="fixture-palette-head"><view><view class="fixture-palette-title">待布置灯具</view></view><view class="fixture-palette-head-actions"><view class="fixture-palette-count">{{unplacedFixtureCount}} 台</view><button class="batch-open-button" bindtap="openBatchPlacement">批量上杆</button></view></view><scroll-view class="palette-group-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="palette-group-track"><view
wx:for="{{paletteGroups}}"
wx:key="groupIndex"
class="palette-group-chip {{item.groupIndex === paletteGroupIndex ? 'palette-group-chip-active' : ''}}"
data-group-index="{{item.groupIndex}}"
bindtap="selectPaletteGroup"
>{{item.name}} · {{item.remainingCount}}</view></view></scroll-view><scroll-view class="palette-fixture-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="palette-fixture-track"><view
wx:for="{{paletteFixtures}}"
wx:key="key"
class="palette-fixture-chip"
data-key="{{item.key}}"
bindtouchstart="onPaletteTouchStart"
catchtouchmove="onPaletteTouchMove"
bindtouchend="onPaletteTouchEnd"
bindtouchcancel="cancelPaletteDrag"
>{{item.addressText}}</view></view></scroll-view><view wx:if="{{paletteMoreText}}" class="palette-more-text">{{paletteMoreText}}</view></view><view class="search-row"><input class="search-input" value="{{searchText}}" placeholder="搜索 A001 或灯具组" confirm-type="search" bindinput="onSearchInput" bindconfirm="searchFixture" /><button class="search-button" bindtap="searchFixture">定位</button></view><view wx:if="{{searchResultText}}" class="search-result">{{searchResultText}}</view><view id="dmxLayoutCanvasShell" class="layout-canvas-shell" style="height: {{canvasDisplayHeight}}px;"><canvas
hidden="{{previewVisible || batchVisible}}"
id="dmxLayoutCanvas"
canvas-id="dmxLayoutCanvas"
class="layout-canvas"
width="{{canvasWidth}}"
height="{{canvasHeight}}"
disable-scroll="{{!scrollEnabled}}"
bindtouchstart="onCanvasTouchStart"
bindtouchmove="onCanvasTouchMove"
bindtouchend="onCanvasTouchEnd"
bindtouchcancel="onCanvasTouchCancel"
></canvas></view></view><view wx:if="{{selectedFixture}}" class="selected-card"><view class="selected-head"><view><view class="selected-address">{{selectedFixture.addressText}}</view><view class="selected-group">{{selectedFixture.groupName}} · 第 {{selectedFixture.fixtureIndex}} 台</view></view><view class="selected-status {{selectedFixture.completed ? 'selected-status-done' : ''}}">{{selectedFixture.completed ? '已设置' : '待设置'}}</view></view><view class="selected-meta">占用 {{selectedFixture.rangeText}} · {{selectedFixture.channelCount}} CH</view><button class="progress-button" bindtap="toggleSelectedProgress">{{selectedFixture.completed ? '取消完成标记' : '标记为已设置'}}</button></view><button class="generate-button" disabled="{{isGeneratingImage}}" bindtap="generateLayoutImage">{{isGeneratingImage ? '正在生成…' : '生成灯具位置图'}}</button></block></view></scroll-view><cover-view wx:if="{{paletteDragging}}" class="fixture-drag-ghost" style="left: {{paletteDragLeft}}px; top: {{paletteDragTop}}px;">{{paletteDragAddress}}</cover-view><view wx:if="{{batchVisible}}" class="batch-sheet-overlay" bindtap="closeBatchPlacement" catchtouchmove="preventTouchMove"><view class="batch-sheet" catchtap="stopTap"><view class="batch-sheet-header"><view><view class="batch-sheet-title">批量上杆</view><view class="batch-sheet-subtitle">{{paletteGroups[paletteGroupIndex].name}} · 仅含尚未布置灯具</view></view><button class="batch-sheet-close" bindtap="closeBatchPlacement">关闭</button></view><view class="batch-field-label">连续地址范围</view><view class="batch-picker-row"><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchStartIndex}}" bindchange="onBatchStartChange"><view class="batch-picker-value">起始 {{batchStartOptions[batchStartIndex]}} ›</view></picker><text class="batch-range-arrow">至</text><picker class="batch-picker" mode="selector" range="{{batchStartOptions}}" value="{{batchEndIndex}}" bindchange="onBatchEndChange"><view class="batch-picker-value">结束 {{batchStartOptions[batchEndIndex]}} ›</view></picker></view><view class="batch-field-label">目标灯位</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchPositionOptions}}" value="{{batchPositionIndex}}" bindchange="onBatchPositionChange"><view class="batch-picker-value">{{batchPositionOptions[batchPositionIndex]}} ›</view></picker><view class="batch-field-label">物理排列</view><picker class="batch-picker batch-picker-wide" mode="selector" range="{{batchDirectionOptions}}" value="{{batchDirectionIndex}}" bindchange="onBatchDirectionChange"><view class="batch-picker-value">{{batchDirectionOptions[batchDirectionIndex]}}（按地址排序）›</view></picker><view class="batch-preview">{{batchPreviewText}}</view><view class="batch-sheet-actions"><button class="batch-clear-button" bindtap="clearBatchPosition">清空本杆</button><button class="batch-apply-button" bindtap="applyBatchPlacement">确认上杆</button></view></view></view><canvas
hidden="{{!exportCanvasActive}}"
id="dmxLayoutExportCanvas"
canvas-id="dmxLayoutExportCanvas"
class="result-report-canvas-offscreen"
width="{{canvasWidth}}"
height="{{canvasHeight}}"
style="width:{{canvasWidth}}px;height:{{canvasHeight}}px;"
></canvas><view wx:if="{{previewVisible}}" class="result-report-preview-overlay" bindtap="closePreview" catchtouchmove="preventTouchMove"><view class="result-report-preview-sheet" catchtap="stopTap"><view class="result-report-preview-header"><view><view class="result-report-preview-title">灯具位置图已生成</view></view><button class="result-report-preview-close" bindtap="closePreview">关闭</button></view><scroll-view class="result-report-preview-scroll" scroll-y enhanced show-scrollbar="{{false}}"><image class="result-report-preview-image" src="{{layoutImagePath}}" mode="widthFix" bindtap="previewImage"></image></scroll-view><view class="result-report-preview-actions"><button class="result-report-preview-action result-report-preview-action-primary" bindtap="shareImage">转发图片</button><button class="result-report-preview-action result-report-preview-action-secondary" bindtap="saveImage">保存到相册</button></view></view></view></view>
