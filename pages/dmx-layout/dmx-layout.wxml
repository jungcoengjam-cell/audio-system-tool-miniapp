<view class="layout-page {{isLandscape ? 'landscape' : ''}} {{darkMode ? 'dark-mode' : ''}}">
  <view class="layout-nav" style="height:{{navigationHeight}}px;">
    <view class="nav-back" style="top:{{shareTop}}px" bindtap="goBack"><view class="nav-back-icon"></view></view>
    <view class="nav-title" style="left:{{navTitleCenter}}px;top:{{shareTop + 9}}px">灯位图</view>
  </view>
  <view class="context-row">
    <picker class="context-native-picker" mode="selector" range="{{lightingContexts}}" range-key="name" value="{{contextPickerIndex}}" bindchange="onLightingContextPickerChange">
      <view class="context-selector"><text>{{contextLabel}}</text><text class="context-chevron">⌄</text></view>
    </picker>
    <view class="context-share {{isGeneratingImage ? 'context-share-disabled' : ''}}" bindtap="generateLayoutImage"><view class="share-glyph"><view class="share-tray"></view><view class="share-stem"></view><view class="share-head"></view></view></view>
  </view>

  <view wx:if="{{!hasPlan}}" class="empty-card">
    <view class="empty-title">暂无可用编址方案</view>
    <view class="empty-text">{{errorText}}</view>
  </view>

  <view wx:if="{{hasPlan}}" id="dmxLayoutCanvasShell" class="canvas-shell {{layoutUndoVisible ? 'canvas-shell-has-undo' : ''}} {{saveNotice ? 'canvas-shell-has-save-notice' : ''}}" style="height: {{canvasShellHeight}}px;">
    <canvas wx:if="{{!layoutPanelVisible && !locateVisible && !placementVisible && !previewVisible && !isGeneratingImage && !exportCanvasActive}}" type="2d" id="dmxLayoutCanvas" class="layout-canvas"
      disable-scroll="{{!scrollEnabled}}"
      bindtouchstart="onCanvasTouchStart" catchtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd" bindtouchcancel="onCanvasTouchCancel"></canvas>
    <view class="canvas-badge">舞台 · {{layout.stageWidthText || '12'}} m × {{layout.stageDepthText || '8'}} m</view>
    <view wx:if="{{!layoutPanelVisible && !locateVisible && !placementVisible && !previewVisible && !isGeneratingImage && !exportCanvasActive && layoutLegend.length}}" class="canvas-legend">
      <view class="canvas-legend-title">灯具图例</view>
      <view class="canvas-legend-list">
        <view wx:for="{{layoutLegend}}" wx:key="id" class="canvas-legend-row">
          <view class="canvas-legend-color" style="background:{{item.color}}"></view>
          <view class="fixture-thumbnail-small fixture-type-{{item.fixtureType}} canvas-legend-sprite" style="border-color:{{item.color}}"><image class="fixture-sprite-image" src="/assets/lighting/fixture-types.png" mode="scaleToFill" /></view>
          <text class="canvas-legend-name">{{item.fixtureDisplayTitle}}</text>
          <text class="canvas-legend-count">{{item.count}}台</text>
        </view>
        <view wx:if="{{layoutLegendOverflowCount}}" class="canvas-legend-overflow">另有 {{layoutLegendOverflowCount}} 个灯具组</view>
      </view>
    </view>
    <view wx:if="{{saveNotice}}" class="save-notice" bindtap="retryLayoutSave">{{saveNotice}}<text wx:if="{{saveRetryVisible}}" class="retry-label">重试</text></view>
    <view wx:if="{{layoutUndoVisible}}" class="layout-undo-note" catchtap="stopTap"><text>{{layoutUndoLabel}}</text><button class="layout-undo-action" bindtap="undoLayoutArrangement">撤销</button></view>
    <view wx:if="{{manipulationText}}" class="manipulation-indicator"><view class="manipulation-pulse"></view>{{manipulationText}}</view>
  </view>

  <view wx:if="{{hasPlan}}" class="bottom-toolbar" style="height:{{toolbarHeight}}px;padding-bottom:{{toolbarContentBottomPadding}}px;">
    <button class="toolbar-action" bindtap="openLayoutSettings"><view class="toolbar-icon settings-icon"><view></view><view></view><view></view></view><text>布局设置</text></button>
  </view>

  <view wx:if="{{placementVisible}}" class="overlay placement-overlay {{placementClosing ? 'overlay-closing' : ''}}" style="padding-top:{{overlaySafeTop + 12}}px;" bindtap="closePlacementPanel">
    <view class="placement-card {{placementClosing ? 'sheet-closing' : ''}}" style="max-height:{{placementCardMaxHeight}}px;" catchtap="stopTap">
      <view class="sheet-handle"></view>
      <view class="placement-heading">
        <view class="placement-title-wrap">
          <view class="placement-titlebar"><view class="placement-title">{{selectedRodName}}</view><view class="placement-actions"><button class="placement-clear-button placement-clear-rod-button" disabled="{{selectedRodCount === 0 || clearLayoutPending}}" bindtap="clearSelectedRodLayout">清空当前杆</button><button class="placement-clear-button" disabled="{{placedFixtureCount === 0 || clearLayoutPending}}" bindtap="clearLayoutImage">清空全图</button></view></view>
          <view class="placement-subtitle">{{previewRangeText}}</view>
        </view>
      </view>
      <view class="rod-overview">
        <view class="overview-track">
          <view class="overview-rail"></view>
          <view wx:for="{{previewItems}}" wx:key="id" class="overview-tick {{item.id === selectedFixtureId ? 'overview-tick-selected' : ''}}" style="left: {{item.t * 100}}%; background: {{item.color}}"></view>
          <view wx:if="{{selectedRodCount > 0}}" class="overview-viewport" style="left:{{previewViewportLeft}}%;width:{{previewViewportWidth}}%;"></view>
          <view wx:if="{{selectedRodCount === 0}}" class="overview-empty">此灯杆暂无灯具</view>
        </view>
      </view>

      <scroll-view class="placement-preview-strip" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{previewScrollIntoView}}" bindscroll="onPreviewScroll">
        <view class="preview-track">
          <view wx:if="{{previewItems.length}}" class="preview-rail"></view>
          <view wx:for="{{previewItems}}" wx:key="id" id="{{item.scrollId}}" class="preview-light-column {{item.id === selectedFixtureId ? 'preview-light-selected' : ''}}" data-fixture-id="{{item.id}}" bindtap="onPreviewFixtureTap">
            <view class="preview-light-head fixture-thumbnail fixture-type-{{item.fixtureType}}" style="border-color:{{item.color}};"><image class="fixture-sprite-image" src="/assets/lighting/fixture-types.png" mode="scaleToFill" /></view>
            <text class="preview-light-address" style="color:{{item.color}}">{{item.addressText}}</text>
          </view>
          <view wx:if="{{selectedRodCount === 0}}" class="preview-empty">上杆后在此查看整杆布局</view>
        </view>
      </scroll-view>

      <view class="placement-search"><text>⌕</text><input value="{{placementFilterText}}" placeholder="搜索地址、灯具组或型号" confirm-type="search" bindinput="onPlacementFilterInput" /></view>
      <scroll-view class="fixture-selection-list" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{panelScrollIntoView}}">
        <view wx:for="{{placementGroups}}" wx:key="id" class="fixture-group">
          <view class="fixture-group-heading">
            <view class="group-color-dot" style="background: {{item.color}}"></view>
            <view class="fixture-group-copy"><view class="fixture-group-name">{{item.fixtureDisplayTitle}}</view><view class="fixture-group-meta">{{item.channelCount}} CH · {{item.fixtures.length}} 台</view></view>
          </view>
          <view class="fixture-address-grid">
            <view wx:for="{{item.fixtures}}" wx:for-item="fixture" wx:key="id" id="fixture-{{fixture.id}}"
              class="fixture-address-chip {{fixture.placedOnSelectedRod ? 'fixture-chip-placed' : ''}} {{fixture.placedElsewhere ? 'fixture-chip-other-rod' : ''}} {{selectedFixtureId === fixture.id ? 'fixture-address-selected' : ''}}"
              style="--fixture-color:{{fixture.color}};"
              data-fixture-id="{{fixture.id}}" bindtap="onPanelFixtureTap">
              <text class="fixture-chip-address">{{fixture.addressText}}</text>
              <view wx:if="{{selectedFixtureId === fixture.id}}" class="fixture-chip-selected-marker">选</view>
              <view wx:if="{{fixture.placedOnSelectedRod}}" class="fixture-chip-check">✓</view>
              <text wx:elif="{{fixture.placedElsewhere}}" class="fixture-chip-origin">{{fixture.shortRodName}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{placementGroups.length === 0}}" class="no-fixture-results">没有匹配的灯具</view>
        <view class="fixture-list-tail"></view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{layoutPanelVisible}}" class="overlay settings-overlay {{layoutPanelClosing ? 'overlay-closing' : ''}}" style="padding-top:{{overlaySafeTop + 12}}px;" bindtap="closeLayoutSettings">
    <view class="settings-card {{layoutPanelClosing ? 'sheet-closing' : ''}}" catchtap="stopTap">
      <view class="sheet-handle"></view>
      <view class="settings-heading"><view class="settings-title">布局设置</view><button class="sheet-close" bindtap="closeLayoutSettings">取消</button></view>
      <scroll-view class="settings-scroll" style="max-height:{{settingsBodyMaxHeight}}px;" scroll-y scroll-into-view="{{layoutErrorScrollIntoView}}" enhanced show-scrollbar="{{false}}">
        <view class="settings-section">
          <view class="settings-section-title">场地尺寸</view>
          <view class="dimension-fields">
            <view class="dimension-field"><text>宽度</text><view class="dimension-input-wrap"><input type="digit" value="{{layoutDraft.stageWidthText}}" data-key="stageWidthText" bindinput="onDraftStageInput"/><text>m</text></view></view>
            <view class="dimension-field"><text>进深</text><view class="dimension-input-wrap"><input type="digit" value="{{layoutDraft.stageDepthText}}" data-key="stageDepthText" bindinput="onDraftStageInput"/><text>m</text></view></view>
          </view>
          <view class="settings-section-title apron-title">台口 / 观众方向</view>
          <view class="direction-grid">
            <view wx:for="{{draftDirectionOptions}}" wx:key="value" class="direction-choice {{layoutDraft.apronDirection === item.value ? 'direction-choice-active' : ''}}"
              data-direction="{{item.value}}" bindtap="onDraftDirectionTap"><view class="direction-arrow">{{item.text === '上' ? '↑' : item.text === '下' ? '↓' : item.text === '左' ? '←' : '→'}}</view>{{item.text}}</view>
          </view>
        </view>

        <view class="settings-section">
          <view class="rod-editor-heading"><view class="settings-section-title">舞台内灯杆</view></view>
          <view class="rod-count-control"><text>灯杆数量</text><view class="count-stepper"><button data-kind="internalRods" data-delta="-1" bindtap="changeDraftRodCount">−</button><text>{{layoutDraft.internalRods.length}}</text><button data-kind="internalRods" data-delta="1" bindtap="changeDraftRodCount">＋</button></view></view>
          <block wx:for="{{layoutDraft.internalRods}}" wx:key="id"><view class="rod-editor-row">
            <view class="rod-editor-label">灯杆{{index + 1}}</view>
            <text class="rod-distance-caption">距台口</text>
            <view class="rod-distance-input"><input type="digit" value="{{item.distanceText}}" data-kind="internalRods" data-index="{{index}}" bindinput="onDraftDistanceInput"/><text>m</text></view>
          </view><view wx:if="{{layoutValidationErrorsById[item.id]}}" id="rod-error-{{item.id}}" class="rod-inline-error">{{layoutValidationErrorsById[item.id]}}</view></block>
        </view>

        <view class="settings-section">
          <view class="rod-editor-heading"><view class="settings-section-title">面光杆</view></view>
          <view class="rod-count-control"><text>面光杆数量</text><view class="count-stepper"><button data-kind="frontRods" data-delta="-1" bindtap="changeDraftRodCount">−</button><text>{{layoutDraft.frontRods.length}}</text><button data-kind="frontRods" data-delta="1" bindtap="changeDraftRodCount">＋</button></view></view>
          <block wx:for="{{layoutDraft.frontRods}}" wx:key="id"><view class="rod-editor-row">
            <view class="rod-editor-label">面光杆{{index + 1}}</view>
            <text class="rod-distance-caption">台口外</text>
            <view class="rod-distance-input"><input type="digit" value="{{item.distanceText}}" data-kind="frontRods" data-index="{{index}}" bindinput="onDraftDistanceInput"/><text>m</text></view>
          </view><view wx:if="{{layoutValidationErrorsById[item.id]}}" id="rod-error-{{item.id}}" class="rod-inline-error">{{layoutValidationErrorsById[item.id]}}</view></block>
        </view>
        <view class="settings-section">
          <view class="settings-section-title">灯具排列</view>
          <view class="arrangement-options">
            <view class="arrangement-choice {{arrangementMode === 'preserve' ? 'arrangement-choice-active' : ''}}" data-mode="preserve" bindtap="onDraftArrangementTap">保留现有位置</view>
            <view class="arrangement-choice {{arrangementMode === 'uniform' ? 'arrangement-choice-active' : ''}}" data-mode="uniform" bindtap="onDraftArrangementTap">重新均匀排列</view>
          </view>
        </view>
        <view class="settings-bottom-space"></view>
      </scroll-view>
      <view class="settings-actions"><button class="settings-apply" bindtap="applyLayoutSettings">应用布局</button></view>

      <view wx:if="{{reductionConfirm}}" class="reduction-overlay {{reductionClosing ? 'reduction-closing' : ''}}">
        <view class="reduction-card" catchtap="stopTap">
          <view class="reduction-title">确认移除灯杆</view>
          <view class="reduction-note">{{reductionConfirm.note}}</view>
          <view wx:for="{{reductionConfirm.rods}}" wx:key="*this" class="reduction-rod">移除：{{item}}</view>
          <scroll-view class="reduction-fixtures" scroll-y enhanced show-scrollbar="{{false}}">
            <view wx:for="{{reductionConfirm.fixtures}}" wx:key="id" class="reduction-fixture"><text>{{item.addressText}}</text><text>{{item.groupName}}</text></view>
          </scroll-view>
          <view class="reduction-actions"><button class="reduction-cancel" bindtap="cancelLayoutReduction">返回修改</button><button class="reduction-confirm" bindtap="confirmLayoutReduction">{{reductionConfirm.confirmText}}</button></view>
        </view>
      </view>
    </view>
  </view>

  <canvas wx:if="{{exportCanvasActive}}" type="2d" id="dmxLayoutExportCanvas"
    class="export-canvas" style="width:1px;height:1px;"></canvas>

  <view wx:if="{{previewVisible}}" class="export-overlay {{previewClosing ? 'overlay-closing' : ''}}" style="padding-top:{{overlaySafeTop + 12}}px;">
    <view class="export-sheet {{previewClosing ? 'sheet-closing' : ''}}">
      <view class="sheet-handle"></view>
      <view class="export-heading"><view class="export-heading-copy"><view class="export-title">灯位图已生成</view><view class="export-subtitle">{{contextLabel}}</view></view><button class="sheet-close" bindtap="closePreview">关闭</button></view>
      <scroll-view class="export-image-scroll" style="height:{{(canvasWidth > 706 ? 654 : canvasWidth - 50) * exportCanvasHeight / exportCanvasWidth}}px;" scroll-y enhanced show-scrollbar="{{false}}">
        <image class="export-image" src="{{layoutImagePath}}" mode="widthFix" bindtap="previewImage"></image>
      </scroll-view>
      <view class="export-actions">
        <button class="export-share" bindtap="shareImage">转发图片</button>
        <button class="export-save-current" bindtap="saveImage">保存图片</button>
      </view>
    </view>
  </view>
</view>
