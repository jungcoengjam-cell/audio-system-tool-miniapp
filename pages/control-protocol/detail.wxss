@import "../../styles/theme-page-shared.wxss";

.protocol-page{height:100vh;background:var(--theme-page-bg);color:var(--theme-text)}
.protocol-content{box-sizing:border-box;min-height:100%;padding:30rpx 28rpx calc(52rpx + env(safe-area-inset-bottom))}
.page-heading{margin-bottom:19rpx}
.page-title{min-width:0;font-size:40rpx;font-weight:720;line-height:1.2}
.safety-note{display:flex;gap:13rpx;padding:18rpx 20rpx;align-items:flex-start;border:1rpx solid rgba(196,133,31,.22);border-radius:20rpx;background:var(--theme-warning-soft);color:var(--theme-warning);font-size:19rpx;line-height:1.5}
.safety-mark{display:flex;flex:0 0 30rpx;height:30rpx;align-items:center;justify-content:center;border:2rpx solid currentColor;border-radius:50%;font-size:19rpx;font-weight:750}
.safety-copy{flex:1}
.appearance-photos{width:100%;margin-top:18rpx}
.appearance-photo-track{display:flex;flex-direction:column;gap:16rpx}
.appearance-photo-card{display:flex;overflow:hidden;box-sizing:border-box;width:100%;flex-direction:column;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface)}
.appearance-photo{display:block;width:100%;height:auto;background:var(--theme-surface-muted)}
.photo-zoom-hint{padding:0 18rpx 12rpx;color:var(--theme-text-tertiary);font-size:15rpx;line-height:1.3}
.photo-missing-card,.invalid-card{display:flex;box-sizing:border-box;margin-top:18rpx;padding:28rpx;flex-direction:column;align-items:center;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface);text-align:center}
.photo-missing-mark,.invalid-mark{color:var(--theme-text-tertiary);font-size:45rpx}
.photo-missing-title,.invalid-title{margin-top:8rpx;font-size:22rpx;font-weight:680}
.photo-missing-copy,.invalid-copy{margin-top:8rpx;color:var(--theme-text-secondary);font-size:18rpx;line-height:1.5}
.return-button{display:flex;box-sizing:border-box;min-height:46px;margin-top:19rpx;padding:0 24rpx;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:19rpx;font-weight:650}
.return-button::after{border:0}
.resolution-card{margin-top:20rpx;padding:22rpx;border:1rpx solid rgba(196,133,31,.22);border-radius:21rpx;background:var(--theme-warning-soft);color:var(--theme-warning)}
.resolution-mark{font-size:26rpx;font-weight:750}
.resolution-title{margin-top:5rpx;font-size:23rpx;font-weight:700}
.resolution-copy{margin-top:8rpx;font-size:19rpx;line-height:1.5}
.draft-material-card{margin-top:20rpx;padding:22rpx;border:1rpx solid rgba(196,133,31,.22);border-radius:21rpx;background:var(--theme-warning-soft);color:var(--theme-warning)}
.draft-material-title{font-size:21rpx;font-weight:700}
.draft-material-copy,.draft-material-warning{margin-top:10rpx;font-size:18rpx;line-height:1.5}
.draft-material-warning{font-weight:700}
.development-manual-card{margin-top:18rpx;padding:14rpx;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface)}
.manual-meta{margin-top:9rpx;color:var(--theme-text-secondary);font-size:16rpx;line-height:1.45}
.manual-connection-params{color:var(--theme-text);font-size:26rpx;font-weight:600;line-height:1.55}
.manual-mac-input-card{margin-top:14rpx;padding:12rpx;border:1rpx solid var(--theme-divider);border-radius:14rpx;background:var(--theme-surface-muted)}
.manual-mac-label{color:var(--theme-text);font-size:18rpx;font-weight:700}
.manual-mac-row{display:flex;gap:9rpx;margin-top:8rpx;align-items:center}
.manual-mac-input{box-sizing:border-box;min-width:0;height:44px;padding:0 12rpx;flex:1;border:1rpx solid var(--theme-divider);border-radius:11rpx;background:var(--theme-surface);color:var(--theme-text);font-family:monospace;font-size:19rpx}
.manual-mac-clear{display:flex;box-sizing:border-box;min-height:42px;margin:0;padding:0 14rpx;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:11rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:17rpx}
.manual-mac-clear::after{border:0}
.manual-transport{margin-top:20rpx;padding-top:17rpx;border-top:1rpx solid var(--theme-divider)}
.manual-transport-tabs{display:flex;gap:9rpx;margin-top:11rpx}
.manual-transport-tab{display:flex;box-sizing:border-box;min-width:0;min-height:44px;margin:0;padding:0 8rpx;flex:1;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:13rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:23rpx;font-weight:650;white-space:nowrap}
.manual-transport-tab::after{border:0}
.manual-transport-tab-active{border-color:var(--theme-accent);background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.manual-section-title{margin-top:16rpx;color:var(--theme-text);font-size:25rpx;font-weight:700}
.manual-command{box-sizing:border-box;min-width:0;margin-top:12rpx;padding:10rpx;border:1rpx solid var(--theme-divider);border-radius:15rpx;background:var(--theme-surface-muted)}
.manual-command-featured{border:1rpx solid var(--theme-accent);background:var(--theme-accent-soft)}
.manual-command-head{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:10rpx}
.manual-command-label{min-width:0;flex:1;color:var(--theme-text);font-size:24rpx;font-weight:680;line-height:1.4}
.manual-command-frame{box-sizing:border-box;max-width:100%;margin-top:9rpx;color:var(--theme-text);font-family:monospace;font-size:28rpx;line-height:1.5;white-space:normal;word-break:normal;overflow-wrap:normal}
.loop-title{margin-bottom:9rpx}
.loop-picker{margin-top:4rpx}
.loop-picker-value{display:flex;box-sizing:border-box;min-height:46px;padding:0 15rpx;align-items:center;justify-content:space-between;border:1rpx solid var(--theme-divider);border-radius:13rpx;background:var(--theme-control);color:var(--theme-text);font-size:24rpx;font-weight:650}
.loop-picker-arrow{color:var(--theme-accent-text);font-size:22rpx}
.manual-section-toggle{display:flex;box-sizing:border-box;width:100%;min-height:44px;margin-top:10rpx;padding:0 14rpx;align-items:center;justify-content:space-between;border:1rpx solid var(--theme-divider);border-radius:13rpx;background:var(--theme-control);color:var(--theme-text);font-size:22rpx;font-weight:650;text-align:left}
.manual-section-toggle::after{border:0}
.manual-copy-button{display:flex;box-sizing:border-box;width:auto;min-width:44px;height:44px;min-height:44px;margin:0;padding:0 12rpx;flex:0 0 auto;align-items:center;justify-content:center;border:1rpx solid var(--theme-primary-fill);border-radius:12rpx;background:var(--theme-primary-fill);color:#fff;font-size:26rpx;font-weight:700;line-height:1.2}
.manual-copy-button::after{border:0}
.manual-copy-button[disabled]{opacity:1;border-color:var(--theme-divider);background:var(--theme-control);color:var(--theme-text-secondary)}
.resolution-hint{margin-top:10rpx;color:var(--theme-text-secondary);font-size:16rpx;line-height:1.45}
.protocol-card{margin-top:20rpx;padding:22rpx;border:1rpx solid var(--theme-divider);border-radius:21rpx;background:var(--theme-surface)}
.protocol-card-title{font-size:24rpx;font-weight:700}
.protocol-meta{margin-top:10rpx;color:var(--theme-text-secondary);font-size:16rpx;line-height:1.5}
.protocol-row{display:flex;gap:12rpx;margin-top:15rpx;justify-content:space-between;color:var(--theme-text);font-size:18rpx}
.protocol-label{color:var(--theme-text-secondary)}
.command-row{box-sizing:border-box;min-width:0;margin-top:13rpx;padding:10rpx;border:1rpx solid var(--theme-divider);border-radius:13rpx;background:var(--theme-surface-muted)}
.command-head{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:10rpx}
.command-label{min-width:0;flex:1;font-size:24rpx;font-weight:680;line-height:1.4}
.command-value{max-width:100%;margin-top:9rpx;color:var(--theme-text);font-family:monospace;font-size:28rpx;line-height:1.5;white-space:normal;word-break:normal;overflow-wrap:normal}
.command-copy-button,.copy-button{display:flex;box-sizing:border-box;width:auto;min-width:44px;height:44px;min-height:44px;margin:0;padding:0 12rpx;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:12rpx;background:var(--theme-control);color:var(--theme-accent-text);font-size:22rpx;font-weight:700;line-height:1.2;flex:0 0 auto}
.copy-button{margin-top:16rpx}
.copy-button::after{border:0}
@media (prefers-color-scheme: dark){
  .protocol-page{color:var(--theme-text)}
  .appearance-photo-card,.photo-missing-card,.invalid-card,.protocol-card,.development-manual-card{background:var(--theme-surface);border-color:var(--theme-divider)}
  .return-button{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
}
