@import "../../styles/theme-page-shared.wxss";

.protocol-entry{display:flex;box-sizing:border-box;min-height:100vh;padding:24rpx;align-items:center;justify-content:center;background:var(--theme-page-bg);color:var(--theme-text-secondary);font-size:14px}

@media (prefers-color-scheme: dark) {
  page {
    background: var(--theme-page-bg);
    color: var(--theme-text);
  }
  .protocol-entry {
    background: var(--theme-page-bg);
    color: var(--theme-text-secondary);
  }
}
