@import "../../styles/theme-page-shared.wxss";

.protocol-page{height:100vh;background:var(--theme-page-bg);color:var(--theme-text)}
.protocol-content{box-sizing:border-box;min-height:100%;padding:30rpx 28rpx calc(64rpx + env(safe-area-inset-bottom))}
.page-heading{margin-bottom:22rpx}
.page-title{font-size:46rpx;font-weight:720;line-height:1.2}
.category-scroll{width:100%;margin-top:22rpx;white-space:nowrap}
.category-row{display:inline-flex;padding-right:24rpx}
.category-chip{display:flex;min-height:44px;margin-right:8px;padding:0 19rpx;align-items:center;border-radius:999rpx;background:var(--theme-control);color:var(--theme-text-secondary);font-size:20rpx;font-weight:600}
.category-chip-active{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.search-card{display:flex;box-sizing:border-box;min-height:88rpx;margin-top:19rpx;padding:0 21rpx;align-items:center;border:1rpx solid var(--theme-divider);border-radius:21rpx;background:var(--theme-surface)}
.search-icon{margin-right:12rpx;color:var(--theme-text-tertiary);font-size:36rpx}
.search-input{flex:1;min-width:0;height:88rpx;background:transparent;color:var(--theme-text);font-size:22rpx}
.search-clear{display:flex;width:44px;height:44px;flex:0 0 44px;align-items:center;justify-content:center;border-radius:50%;background:var(--theme-text-tertiary);color:#fff;font-size:27rpx}
.section-heading{display:flex;margin:34rpx 2rpx 15rpx;align-items:baseline;justify-content:space-between}
.section-title{font-size:28rpx;font-weight:680}
.result-count{color:var(--theme-text-tertiary);font-size:19rpx}
.gallery-scroll{width:100%;margin-right:-28rpx;white-space:nowrap}
.gallery-track{display:flex;box-sizing:border-box;gap:16rpx;align-items:stretch;padding:0 28rpx 12rpx 0}
.gallery-card{position:relative;overflow:hidden;box-sizing:border-box;width:72vw;max-width:560rpx;min-width:240rpx;flex:0 0 72vw;border:1rpx solid var(--theme-divider);border-radius:23rpx;background:var(--theme-surface);box-shadow:0 7rpx 20rpx var(--theme-shadow);white-space:normal}
.gallery-card:active{opacity:.78}
.gallery-photo{display:flex;box-sizing:border-box;width:100%;height:520rpx;align-items:center;justify-content:center;background:var(--theme-surface-muted)}
.gallery-image{display:block;width:100%;height:100%}
.gallery-photo-missing{display:flex;width:100%;height:100%;box-sizing:border-box;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;color:var(--theme-text-tertiary);font-size:19rpx}
.missing-icon{font-size:48rpx}
.gallery-card-copy{box-sizing:border-box;min-height:78rpx;padding:17rpx 34rpx 18rpx 17rpx}
.gallery-title{overflow:hidden;font-size:23rpx;font-weight:680;text-overflow:ellipsis;white-space:nowrap}
.gallery-arrow{position:absolute;right:13rpx;bottom:23rpx;color:var(--theme-text-tertiary);font-size:31rpx}
.empty-card{display:flex;box-sizing:border-box;width:100%;margin-top:12rpx;padding:54rpx 30rpx 48rpx;flex-direction:column;align-items:center;border:1rpx solid var(--theme-divider);border-radius:24rpx;background:var(--theme-surface);text-align:center}
.empty-mark{color:var(--theme-accent);font-size:47rpx;line-height:1}
.empty-title{margin-top:15rpx;font-size:25rpx;font-weight:680}
.empty-copy{max-width:520rpx;margin-top:9rpx;color:var(--theme-text-secondary);font-size:20rpx;line-height:1.55}
.clear-filters-button{display:flex;box-sizing:border-box;min-height:44px;margin-top:21rpx;padding:0 24rpx;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:19rpx;font-weight:650}
.clear-filters-button::after{border:0}
@media (prefers-color-scheme: dark){
  .protocol-page{background:var(--theme-page-bg);color:var(--theme-text)}
  .search-card,.gallery-card,.empty-card{background:var(--theme-surface);border-color:var(--theme-divider)}
  .gallery-photo{background:var(--theme-surface-muted)}
}
@media (max-width:360px){.protocol-content{padding-left:22rpx;padding-right:22rpx}.gallery-scroll{margin-right:-22rpx}.gallery-track{gap:12rpx;padding-right:22rpx}.gallery-card{width:76vw;flex-basis:76vw}.gallery-card-copy{padding-left:13rpx}.gallery-title{font-size:21rpx}}
