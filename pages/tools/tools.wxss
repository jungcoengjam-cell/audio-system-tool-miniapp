@import "../../styles/homepage.wxss";

.home-header-action{display:flex;box-sizing:border-box;width:88rpx;height:88rpx;min-width:44px;min-height:44px;margin-right:-12rpx;align-items:center;justify-content:center;border-radius:999rpx;color:var(--theme-text)}
.tools-settings-glyph{font-size:38rpx;line-height:1}
.home-category-strip{height:54px;margin:16rpx -4rpx 12rpx;white-space:nowrap}
.home-category-track{display:inline-flex;box-sizing:border-box;min-width:100%;height:54px;padding:5px 4rpx;align-items:center;gap:12rpx}
.tools-visibility-warning{display:flex;box-sizing:border-box;min-height:44px;margin:0 0 12rpx;padding:10rpx 14rpx;align-items:center;border:1rpx solid var(--theme-divider);border-radius:16rpx;background:var(--theme-warning-soft);color:var(--theme-warning);font-size:14px;line-height:1.45}
.tools-empty-state{display:flex;box-sizing:border-box;min-height:36vh;padding:30rpx 18rpx;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.tools-empty-state .home-empty-title{font-size:16px}
.tools-empty-state .home-empty-copy{font-size:14px;line-height:1.45}
.tools-empty-state button{display:flex;box-sizing:border-box;width:100%;max-width:220px;height:44px;min-height:44px;margin:16rpx 0 0;padding:0 16rpx;align-items:center;justify-content:center;font-size:14px;line-height:44px}
.home-tool-grid{display:grid;box-sizing:border-box;width:100%;grid-template-columns:repeat(4,minmax(0,1fr));column-gap:16rpx;row-gap:16rpx}
.home-tool-card{display:flex;box-sizing:border-box;width:100%;height:200rpx;min-width:0;min-height:200rpx;flex:0 0 auto;padding:10rpx 6rpx;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid var(--theme-divider);border-radius:26rpx;background:var(--theme-surface);box-shadow:0 5rpx 16rpx var(--theme-shadow);transition:opacity .14s ease,transform .14s ease}
.home-tool-icon-wrap{display:flex;box-sizing:border-box;width:88rpx;height:88rpx;margin-bottom:6rpx;align-items:center;justify-content:center}
.home-tool-icon{display:block;width:84rpx;height:84rpx}
.home-tool-title{display:flex;box-sizing:border-box;width:100%;min-height:32px;flex-direction:column;align-items:center;justify-content:center;color:var(--theme-text);font-size:13px;font-weight:650;line-height:1.2;text-align:center;white-space:normal;overflow-wrap:anywhere}
.home-tool-title-line{display:block;box-sizing:border-box;width:100%;min-width:0;font-size:13px;line-height:1.2;text-align:center;white-space:normal;overflow-wrap:anywhere}
