.tools-scroll{height: 100vh;background: var(--theme-page-bg)}.tools-content{padding: 42rpx 24rpx calc(54rpx + env(safe-area-inset-bottom))}.page-title{color: var(--theme-text);font-size: 58rpx;font-weight: 700;letter-spacing: -1.6rpx;line-height: 1.18}.tool-domain{margin-top: 32rpx}.page-header + .tool-domain{margin-top:var(--tab-header-gap)}.domain-title{margin-bottom: 16rpx;color: var(--theme-text);font-size: 30rpx;font-weight: 680;letter-spacing: -.7rpx}.module-row{display:flex;gap:16rpx}.module-card{display:flex;overflow:hidden;box-sizing:border-box;width:196rpx;height:234rpx;margin:0;flex:0 0 196rpx;flex-direction:column;align-items:center;border: 1rpx solid rgba(29,29,31,.045);border-radius: 32rpx;background: var(--theme-surface);box-shadow: 0 7rpx 22rpx rgba(28,45,73,.065);transition: opacity .14s ease,transform .14s ease}.card-pressed{opacity: .9;transform: scale(.992)}.module-visual{display:flex;overflow:hidden;box-sizing:border-box;width:100%;height:164rpx;padding:8rpx 12rpx 0;flex:0 0 164rpx;align-items:center;justify-content:center}.module-image{width:152rpx;height:152rpx;flex-shrink:0}.module-title{display:flex;box-sizing:border-box;flex:1;width:100%;min-width:0;min-height:0;padding:0 10rpx 24rpx;align-items:center;justify-content:center;color:var(--theme-text);font-size:24rpx;font-weight:650;line-height:1.35;text-align:center;white-space:nowrap}.module-strip{width:100%;white-space:nowrap}.module-track{display:inline-flex;padding:0 0 16rpx}.module-track .module-card + .module-card{margin-left:16rpx}.library-heading{margin-top: 48rpx}.product-library-card{display: flex;box-sizing: border-box;width: 100%;min-height: 132rpx;padding: 25rpx;align-items: center;border: 1rpx solid #dceaff;border-radius: 26rpx;background: #fff;box-shadow: 0 8rpx 22rpx rgba(28,75,128,.065)}.product-library-copy{ min-width: 0;flex: 1}.product-library-title{ color: #1d1d1f;font-size: 30rpx;font-weight: 680}.product-library-arrow{ margin-left: 20rpx;color: var(--theme-text-tertiary);font-size: 40rpx}.tools-footer{margin-top: 40rpx;padding: 26rpx 0 6rpx;border-top: 1rpx solid #e2e2e7;color: var(--theme-text-secondary);font-size: 18rpx;text-align: center}.footer-actions{display: flex;gap:6px;margin-top: 18rpx;justify-content: center}.footer-action{display: flex;box-sizing: border-box;min-height: 44px;margin: 0;padding: 0 22rpx;align-items: center;justify-content: center;border:0;border-radius: 18rpx;background: #fff;color: var(--theme-accent-text);font-size: 21rpx;font-weight: 550;line-height: 1}.footer-action::after{ border: 0}.footer-action-muted{ color: var(--theme-text-secondary)}.footer-action:active{ opacity: .72}@media (max-width:374px){.module-title{font-size:12px}}@media (prefers-color-scheme: dark){ .tools-scroll{ background: var(--theme-page-bg)}.page-title,.domain-title,.module-title,.product-library-title{ color: var(--theme-text)}.module-card,.product-library-card{ border-color: var(--theme-divider);background: var(--theme-surface);box-shadow: 0 7rpx 22rpx var(--theme-shadow)}.footer-action{ background: var(--theme-surface);box-shadow: 0 7rpx 22rpx var(--theme-shadow)}.product-library-card{ border-color: #315b88}.footer-action{ color: var(--theme-accent-text)}.footer-action-muted{ color: var(--theme-text-secondary);}.module-visual{ background: var(--theme-surface)}.tools-footer{ border-color: var(--theme-divider);color: var(--theme-text-tertiary)}}

.project-wiring-visual{position:relative;box-sizing:border-box;width:136rpx;height:126rpx;border:1rpx solid #dbe6f3;border-radius:20rpx;background:#f2f6fc}
.wiring-device{position:absolute;z-index:2;top:29rpx;display:flex;box-sizing:border-box;width:25rpx;height:58rpx;flex-direction:column;align-items:center;justify-content:space-evenly;border:2rpx solid #8b9bb1;border-radius:8rpx;background:#fff}
.wiring-device-source{left:8rpx}.wiring-device-destination{right:8rpx}
.wiring-device-port{width:5rpx;height:5rpx;border-radius:50%;background:#8394aa}
.wiring-cable{position:absolute;left:31rpx;right:31rpx;height:15rpx}
.wiring-cable::before{position:absolute;top:6rpx;left:0;right:0;height:3rpx;border-radius:999rpx;background:#2878d0;content:''}
.wiring-cable::after,.wiring-cable-end{position:absolute;top:3rpx;right:0;width:9rpx;height:9rpx;border:2rpx solid #2878d0;border-radius:50%;background:#f2f6fc;content:''}
.wiring-cable-one{top:34rpx}.wiring-cable-two{top:52rpx}.wiring-cable-three{top:70rpx}
.wiring-cable-two::before{background:#20a48b}.wiring-cable-two::after{border-color:#20a48b}.wiring-cable-three::before{background:#d38c27}.wiring-cable-three::after{border-color:#d38c27}
.wiring-list-mark{position:absolute;left:35rpx;right:35rpx;bottom:9rpx;display:flex;gap:6rpx;align-items:center;justify-content:space-between}
.wiring-list-row{position:relative;box-sizing:border-box;width:17rpx;height:9rpx;border-radius:3rpx;background:#b8c6d8}
.wiring-list-row::before{position:absolute;top:3rpx;left:4rpx;width:2rpx;height:2rpx;border-radius:50%;background:#fff;content:''}
@media (prefers-color-scheme: dark){.project-wiring-visual{border-color:#40536c;background:#253349}.wiring-device{border-color:#8296b3;background:#354960}.wiring-device-port{background:#adbed4}.wiring-cable::after{background:#253349}.wiring-list-row{background:#627994}}
