.report-bridge-page{display:flex;box-sizing:border-box;width:100%;height:100vh;padding:24rpx;align-items:center;justify-content:center;background:#f5f7f8;color:#20242a}
.report-bridge-card{box-sizing:border-box;width:100%;max-width:680rpx;padding:40rpx 30rpx;border:1rpx solid #dce2e8;border-radius:26rpx;background:#fff;text-align:center;box-shadow:0 10rpx 28rpx rgba(0,0,0,.07)}
.report-bridge-title{font-size:16px;font-weight:700;line-height:1.45}
.report-bridge-copy{margin-top:12rpx;color:#66717d;font-size:13px;line-height:1.55}
.report-bridge-page button.report-bridge-cancel{display:flex;box-sizing:border-box;width:100%;min-width:0;max-width:none;height:44px;min-height:44px;margin:24rpx 0 0;padding:0;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:#e9edf2;color:#263342;font-size:14px;font-weight:650;line-height:44px;text-align:center}
.report-bridge-cancel::after{border:0}
.report-bridge-canvas{position:fixed;z-index:-1;top:0;left:-2500px;pointer-events:none;opacity:0}
@media(prefers-color-scheme:dark){.report-bridge-page{background:#000;color:#f5f5f7}.report-bridge-card{border-color:#38383a;background:#1c1c1e}.report-bridge-copy{color:#aeb5bf}.report-bridge-cancel{background:#33363a;color:#edf1f6}}
