<view class="wiring-page page-root {{resultReportPreviewClosing ? 'result-report-preview-closing' : ''}}" style="{{resultReportPreviewStyle}}">
  <scroll-view class="wiring-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-content">
      <view wx:if="{{wiringStorageWarning}}" class="wiring-storage-warning">{{wiringStorageWarning}}</view>
      <include src="../../templates/result-record-actions.wxml" />
      <view class="diagram-card">
        <view class="diagram-body">
          <view class="diagram-main">
        <view class="diagram-heading">
          <view class="diagram-title">接线图</view>
        </view>
            <view wx:if="{{supported}}" class="diagram-canvas-wrap" style="height:{{diagramCanvasHeight}}px;">
              <canvas type="2d" id="wiringDiagramCanvas" class="diagram-canvas" style="height:{{diagramCanvasHeight}}px;" hidden="{{selectorVisible || resultReportPreviewVisible || projectDialogVisible || diagramError}}" bindtouchstart="onDiagramTouchStart" bindtouchend="onDiagramTouchEnd" bindtouchcancel="onDiagramTouchCancel"></canvas>
              <view wx:if="{{diagramError}}" class="diagram-error" bindtap="retryDiagram">{{diagramError}} · 点按重试</view>
            </view>
            <view wx:elif="{{!hasBothEndpoints}}" class="unsupported-state">
              <view class="unsupported-mark">↔</view>
              <view class="unsupported-title">先选择两端接口</view>
              <view class="unsupported-reason">请选择输出端和输入端，查看对应的焊接端接线图。</view>
            </view>
            <view wx:else class="unsupported-state">
              <view class="unsupported-mark">↔</view>
              <view class="unsupported-title">此组合暂未提供接法</view>
              <view class="unsupported-reason">{{model.reason || '请重新选择两端接口。'}}</view>
              <view class="unsupported-tip">请分别选择输出端与输入端，查看可用的接口和信号类型。</view>
            </view>
            <view wx:if="{{supported && wiringGuide}}" class="wiring-route-guide">{{wiringGuide}}</view>
            <view wx:if="{{selectedConnection}}" class="selected-mapping">
              <view class="selected-mapping-swatch" style="background:{{selectedConnection.color}};"></view>
              <view class="selected-mapping-copy">
                <view class="selected-mapping-title">已选 · {{selectedConnection.label}}</view>
                <view class="selected-mapping-text">{{selectedConnection.mappingText}}</view>
              </view>
            </view>
          </view>
          <view class="wiring-action-rail" aria-label="方案操作">
            <button class="action-button" aria-label="重置接线方案" disabled="{{!outputId && !inputId && !manualSelected.output && !manualSelected.input}}" bindtap="resetWiring"><view class="action-icon icon-reset"></view></button>
            <button class="action-button" aria-label="分享接线方案图片" disabled="{{!supported || isGeneratingResultReport}}" bindtap="generateResultReportImage"><view class="action-icon icon-share"></view></button>
            <button class="action-button" aria-label="收藏当前接线方案" aria-pressed="{{currentFavorite}}" disabled="{{!supported}}" bindtap="toggleCurrentFavorite"><view class="action-icon icon-bookmark {{currentFavorite ? 'icon-bookmark-active' : ''}}"></view></button>
            <button class="action-button" aria-label="保存接线方案到项目" disabled="{{!supported}}" bindtap="saveToActiveProject"><view class="action-icon icon-folder"></view></button>
          </view>
        </view>
      </view>

      <view class="endpoint-row">
        <view class="endpoint-card" data-side="output" bindtap="openEndpointSelector" hover-class="endpoint-card-pressed">
          <view class="endpoint-card-heading">输出端</view>
          <view class="endpoint-selection-state">{{outputId ? (manualSelected.output ? '已选择' : '默认示例') : '未选择'}}</view>
          <image wx:if="{{outputEndpoint.image}}" class="endpoint-image" src="{{outputEndpoint.image}}" mode="aspectFit" lazy-load></image>
          <view class="endpoint-device">{{outputEndpoint.displayConnectorType || outputEndpoint.connectorType || '选择输出端接口'}}</view>
          <view wx:if="{{outputEndpoint.deviceLabel}}" class="endpoint-device-hint">常见于{{outputEndpoint.deviceLabel}}</view>
          <view class="endpoint-meta-row">
            <view class="endpoint-meta">
              <view class="endpoint-signal">{{outputSignalPortLabel || outputEndpoint.signalLabel}}</view>
              <view class="endpoint-signal-type">{{outputSignalTypeLabel}}</view>
            </view>
            <view class="endpoint-chevron">›</view>
          </view>
        </view>
        <view class="endpoint-card" data-side="input" bindtap="openEndpointSelector" hover-class="endpoint-card-pressed">
          <view class="endpoint-card-heading">输入端</view>
          <view class="endpoint-selection-state">{{inputId ? (manualSelected.input ? '已选择' : '默认示例') : '未选择'}}</view>
          <image wx:if="{{inputEndpoint.image}}" class="endpoint-image" src="{{inputEndpoint.image}}" mode="aspectFit" lazy-load></image>
          <view class="endpoint-device">{{inputEndpoint.displayConnectorType || inputEndpoint.connectorType || '选择输入端接口'}}</view>
          <view wx:if="{{inputEndpoint.deviceLabel}}" class="endpoint-device-hint">常见于{{inputEndpoint.deviceLabel}}</view>
          <view class="endpoint-meta-row">
            <view class="endpoint-meta">
              <view class="endpoint-signal">{{inputSignalPortLabel || inputEndpoint.signalLabel}}</view>
              <view class="endpoint-signal-type">{{inputSignalTypeLabel}}</view>
            </view>
            <view class="endpoint-chevron">›</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{selectorVisible}}" class="selector-mask {{selectorClosing ? 'selector-closing' : 'selector-opening'}}" bindtap="closeEndpointSelector" catchtouchmove="preventTouchMove">
    <view class="selector-panel" catchtap="stopTap">
      <view class="selector-header">
        <view class="selector-title">{{selectorTitle}}</view>
        <view class="selector-close" role="button" aria-label="关闭接口选择" bindtap="closeEndpointSelector">
          <view class="selector-close-icon"></view>
        </view>
      </view>
      <scroll-view class="selector-list" scroll-y enhanced show-scrollbar="{{false}}" style="height:55vh;">
        <block wx:for="{{selectorOptions}}" wx:for-item="option" wx:key="id">
        <view wx:if="{{option.groupStart}}" class="selector-group-title">{{option.groupTitle}}</view>
        <view class="selector-row {{option.id === (selectorSide === 'input' ? inputId : outputId) ? 'selector-row-active' : ''}}" data-id="{{option.id}}" bindtap="selectEndpointOption">
          <image class="selector-image" src="{{option.image}}" mode="aspectFit"></image>
          <view class="selector-copy">
            <view class="selector-label">{{option.selectorLabel || option.label}}</view>
            <view class="selector-signal">{{option.selectorDetail || option.signalLabel}}</view>
          </view>
          <view class="selector-check">{{option.id === (selectorSide === 'input' ? inputId : outputId) ? '✓' : '›'}}</view>
        </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <include src="../../templates/result-report-preview.wxml" />
  <include src="./wiring-overlays.wxml" />
  <include src="../../templates/editor-navigation-guard.wxml" />
</view>
