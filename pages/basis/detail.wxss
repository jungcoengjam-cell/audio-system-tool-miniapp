@import "../../styles/homepage.wxss";

.basis-detail-heading{margin:2rpx 2rpx 14px}
.basis-detail-heading-main{display:flex;min-width:0;align-items:center;gap:10px}
.basis-detail-icon-wrap{display:flex;box-sizing:border-box;width:40px;height:40px;flex:0 0 40px;align-items:center;justify-content:center;border-radius:12px;background:var(--theme-accent-soft)}
.basis-detail-icon{display:block;width:32px;height:32px}
.basis-detail-heading-copy{min-width:0;flex:1}
.basis-detail-title{margin:0;color:var(--theme-text);font-size:20px;font-weight:700;line-height:1.25;text-align:left;overflow-wrap:anywhere;word-break:break-word}
.basis-detail-kicker{margin-top:3px;color:var(--theme-accent-text);font-size:12px;font-weight:600;line-height:1.3}
.basis-detail-subtitle{margin-top:8px;padding:0 2rpx;color:var(--theme-text-secondary);font-size:15px;line-height:1.65;text-align:left;overflow-wrap:anywhere;word-break:break-word}

.basis-section{min-width:0;margin-top:14px;padding:24rpx 28rpx 28rpx}
.basis-section-heading{display:flex;justify-content:center}
.home-section-title{display:flex;align-items:center;gap:10rpx;color:var(--theme-text);font-size:17px;font-weight:700;line-height:1.4}
.basis-section-index{display:flex;width:38rpx;height:38rpx;flex:0 0 38rpx;align-items:center;justify-content:center;border-radius:12rpx;background:var(--theme-accent-soft);color:var(--theme-accent-text);font-size:11px;font-weight:700;font-variant-numeric:tabular-nums}

.basis-figure-panel{padding:22rpx 22rpx 20rpx}
.basis-figure-panel .home-section-title{margin-bottom:15px}
.basis-figure{display:block;box-sizing:border-box;width:100%;max-width:100%;height:auto;margin:0 auto;border-radius:15px}
.basis-figure-caption{margin:12px 2rpx 0;color:var(--theme-text-secondary);font-size:15px;line-height:1.65;text-align:left;overflow-wrap:anywhere;word-break:break-word}

.basis-copy-flow{min-width:0;color:var(--theme-text);font-size:15px;line-height:1.7;text-align:left;overflow-wrap:anywhere;word-break:normal}
.basis-quick-method{margin-top:12px;color:var(--theme-text)}
.basis-formula-hint{margin-top:8px;color:var(--theme-text-secondary);font-size:12px;line-height:1.4;text-align:right}
.basis-copy-paragraph{min-width:0;line-height:inherit}
.basis-copy-paragraph+.basis-copy-paragraph{margin-top:7px}
.basis-copy-text{color:inherit;line-height:inherit;overflow-wrap:anywhere;word-break:normal}
.basis-formula-scroll{display:block;box-sizing:border-box;width:100%;height:auto;min-height:48px;margin:12px 0;padding:12px 0;color:var(--theme-accent-text);line-height:1.55;white-space:nowrap}
.basis-formula-scroll-compact{height:auto;min-height:44px;margin:10px 0;padding:10px 0;line-height:1.55}
.basis-formula-row{display:inline-block;min-width:max-content;line-height:inherit;vertical-align:middle;white-space:nowrap}
.basis-formula-text{display:inline-block;min-width:max-content;color:var(--theme-accent-text);font-size:15px;font-weight:650;line-height:inherit;white-space:nowrap;word-break:keep-all;overflow-wrap:normal;font-variant-numeric:tabular-nums}

.basis-parameter-table{margin-top:16px;border-top:1px solid var(--theme-divider)}
.basis-parameter{display:flex;box-sizing:border-box;width:100%;min-width:0;gap:12px;padding:11px 2px;align-items:flex-start;border-bottom:1px solid var(--theme-divider)}
.basis-parameter-label{box-sizing:border-box;width:34%;min-width:82px;padding-top:2px;color:var(--theme-text-secondary);font-size:13px;line-height:1.45;overflow-wrap:anywhere;word-break:break-word}
.basis-parameter-value{min-width:0;flex:1;color:var(--theme-text);font-size:15px;font-weight:560;line-height:1.5;overflow-wrap:anywhere;word-break:normal}
.basis-parameter-value .basis-copy-paragraph+.basis-copy-paragraph{margin-top:0}

.basis-source-panel{padding-top:22rpx}
.basis-reference-title{margin-bottom:5px;color:var(--theme-text);font-size:15px;font-weight:700;line-height:1.4}
.basis-reference-copy{color:var(--theme-text-secondary);font-size:15px;line-height:1.7}
.basis-limit-block{margin-top:15px;padding-top:14px;border-top:1px solid var(--theme-divider)}
.basis-limit-block .basis-reference-title{color:var(--theme-warning)}
.basis-limit-block .basis-reference-copy{color:var(--theme-text-secondary)}
.basis-full-toggle{margin-top:14px}
.basis-full-panel{padding-top:24rpx}
.basis-full-field{min-width:0;padding:14px 0;border-bottom:1px solid var(--theme-divider)}
.basis-full-field-last{padding-bottom:0;border-bottom:0}
.basis-full-label{margin-bottom:7px;color:var(--theme-accent-text);font-size:14px;font-weight:700;line-height:1.45}
.basis-full-copy{color:var(--theme-text);font-size:15px;line-height:1.7;overflow-wrap:anywhere;word-break:normal}
.basis-full-reference-copy{color:var(--theme-text-secondary)}
.basis-full-copy .basis-copy-paragraph+.basis-copy-paragraph{margin-top:7px}
.basis-open-button{margin-top:16px}
.basis-detail-page .home-secondary-button.basis-full-toggle{display:flex;box-sizing:border-box;width:100%;max-width:none;min-height:44px;flex:0 0 100%;align-items:center;justify-content:center;text-align:center}
.basis-detail-page .home-primary-button.basis-open-button{display:flex;box-sizing:border-box;width:100%;max-width:none;min-height:44px;flex:0 0 100%;align-items:center;justify-content:center;text-align:center}

@media (max-width:374px){
  .basis-detail-title{font-size:20px}
  .basis-copy-flow,.basis-detail-subtitle,.basis-full-copy,.basis-reference-copy,.basis-figure-caption{font-size:15px}
  .basis-parameter-label{font-size:13px}
  .basis-formula-text{font-size:15px}
}

@media (prefers-reduced-motion:reduce){.basis-open-button,.basis-full-toggle{transition:none}}
