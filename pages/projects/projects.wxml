<scroll-view class="home-scroll projects-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}">
  <view class="home-page projects-content">
    <view class="home-header home-main-header project-header">
      <view class="home-title home-main-title">项目</view>
      <view class="project-header-actions">
        <button class="project-recovery-button" hover-class="project-control-pressed" bindtap="openRecovery">回收站 {{recoveryCount}}</button>
        <button wx:if="{{tabIndex === 0}}" class="home-primary-button project-create-button" hover-class="project-control-pressed" bindtap="createProject">＋ 新建</button>
      </view>
    </view>

    <view wx:if="{{workspaceError}}" class="home-panel project-error">
      <view class="project-error-title">无法读取本地项目数据</view>
      <view class="project-error-copy">{{workspaceError}}</view>
      <button class="home-secondary-button" bindtap="retryWorkspace">重试</button>
    </view>

    <view class="project-tabs" role="tablist">
      <view wx:for="{{tabs}}" wx:key="*this" class="project-tab {{tabIndex === index ? 'project-tab-active' : ''}}" hover-class="project-control-pressed" data-index="{{index}}" bindtap="onTabTap">{{item}}</view>
    </view>

    <view class="project-search home-panel">
      <text class="project-search-icon">⌕</text>
      <input value="{{searchText}}" placeholder="搜索项目或计算收藏" confirm-type="search" bindinput="onSearchInput" />
      <button wx:if="{{searchText}}" class="project-search-clear" hover-class="project-control-pressed" catchtap="clearSearch">清除</button>
    </view>

    <block wx:if="{{tabIndex === 0}}">
      <scroll-view class="project-filter-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="project-filter-row">
          <view wx:for="{{projectFilters}}" wx:key="key" class="home-chip {{projectFilter === item.key ? 'home-chip-active' : ''}}" hover-class="home-chip-pressed" data-key="{{item.key}}" bindtap="onProjectFilterTap">{{item.label}}</view>
        </view>
      </scroll-view>
      <view wx:if="{{lightingWarning}}" class="project-inline-warning">{{lightingWarning}}</view>
      <view wx:if="{{projects.length}}" class="project-card-list">
        <view wx:for="{{projects}}" wx:key="id" class="home-panel project-list-card" hover-class="home-pressed" data-id="{{item.id}}" bindtap="openProject">
          <view class="project-card-top">
            <view class="project-card-title">{{item.name}}</view>
            <text class="project-card-chevron">›</text>
          </view>
          <view wx:if="{{item.venueName}}" class="project-card-venue">{{item.venueName}}</view>
          <view class="project-card-summary">{{item.contentText}}</view>
          <view class="project-card-updated">更新于 {{item.timeText}}</view>
        </view>
      </view>
      <view wx:elif="{{!workspaceError}}" class="home-empty-state home-panel">
        <view class="home-empty-state-title">{{searchText || projectFilter !== 'all' ? '没有匹配的项目' : '还没有现场项目'}}</view>
        <view class="home-empty-state-copy">{{searchText || projectFilter !== 'all' ? '调整搜索词或筛选条件。' : '新建项目后，可整理计算记录、线路和灯位方案。'}}</view>
      </view>
    </block>

    <block wx:else>
      <scroll-view class="project-filter-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="project-filter-row">
          <view wx:for="{{favoriteModules}}" wx:key="key" class="home-chip {{favoriteFilter === item.key ? 'home-chip-active' : ''}}" hover-class="home-chip-pressed" data-key="{{item.key}}" bindtap="onFavoriteFilterTap">{{item.label}}</view>
        </view>
      </scroll-view>
      <view wx:if="{{favorites.length}}" class="favorite-card-list">
        <view wx:for="{{favorites}}" wx:key="id" class="home-panel favorite-list-card favorite-card-{{item.theme}}" hover-class="home-pressed" data-id="{{item.id}}" bindtap="openFavorite">
          <view class="favorite-card-top">
            <text class="favorite-module">{{item.moduleLabel}}</text>
            <text class="favorite-card-time">{{item.timeText}}</text>
          </view>
          <view class="favorite-card-title">{{item.title}}</view>
          <view class="favorite-card-summary">{{item.summary}}</view>
          <view class="favorite-card-footer">独立计算快照 · 点开查看参数和结果</view>
        </view>
      </view>
      <view wx:elif="{{!workspaceError}}" class="home-empty-state home-panel">
        <view class="home-empty-state-title">{{searchText || favoriteFilter !== 'all' ? '没有匹配的收藏' : '还没有计算收藏'}}</view>
        <view class="home-empty-state-copy">收藏的是计算结果和参数方案。你可以在工具结果页保存，之后独立查看或复制到项目。</view>
      </view>
    </block>
    <view class="home-bottom-space"></view>
  </view>
</scroll-view>
