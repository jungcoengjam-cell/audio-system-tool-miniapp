@import "../../styles/homepage.wxss";
.projects-scroll{height:100vh;background:var(--theme-page-bg)}
.project-header-actions{display:flex;flex:0 0 auto;min-width:0;gap:8px;align-items:center;justify-content:flex-end}
.project-header .home-title{flex:0 0 auto;white-space:nowrap}
.project-header .project-header-actions button{flex:0 0 auto;width:auto;min-width:64px;max-width:112px}
.project-header .project-header-actions button.project-recovery-button,.project-header .project-header-actions button.project-create-button{display:flex;box-sizing:border-box;width:auto;height:44px;min-height:44px;max-height:44px;margin:0;padding:0 14px;align-items:center;justify-content:center;border-radius:999rpx;font-size:13px;line-height:44px;vertical-align:top;white-space:nowrap}
.project-recovery-button{border:1rpx solid var(--theme-divider);background:var(--theme-surface);color:var(--theme-text-secondary)}
.project-create-button{background:var(--theme-primary-fill);color:#fff}
.project-tabs{display:flex;box-sizing:border-box;gap:4rpx;margin:14rpx 0;padding:4rpx;border:1rpx solid var(--theme-divider);border-radius:16rpx;background:var(--theme-surface-muted)}
.project-tab{display:flex;box-sizing:border-box;min-width:0;min-height:44px;flex:1;align-items:center;justify-content:center;border-radius:12rpx;color:var(--theme-text-secondary);font-size:14px;font-weight:600}
.project-tab-active{background:var(--theme-surface);box-shadow:0 2rpx 8rpx var(--theme-shadow);color:var(--theme-text)}
.project-control-pressed{opacity:.72;transform:scale(.98)}
.project-search{display:flex;box-sizing:border-box;gap:12rpx;min-height:44px;align-items:center;padding:0 14rpx;border-radius:14rpx}
.project-search-icon{font-size:28rpx;color:var(--theme-text-secondary);line-height:1}
.project-search input{box-sizing:border-box;min-width:0;min-height:44px;flex:1;color:var(--theme-text);font-size:14px}
.project-search-clear{display:flex;box-sizing:border-box;width:auto;min-width:44px;height:44px;margin:0;padding:0 8px;align-items:center;justify-content:center;border:0;background:transparent;color:var(--theme-accent-text);font-size:12px;white-space:nowrap}
.project-search-clear::after{border:0}
.project-filter-scroll{margin:10rpx -4rpx 12rpx;white-space:nowrap}
.project-filter-row{display:inline-flex;gap:8rpx;padding:4rpx}
.project-filter-row .home-chip{font-size:13px}
.project-card-list,.favorite-card-list{display:flex;flex-direction:column;gap:10rpx}
.project-list-card,.favorite-list-card{margin:0;padding:16rpx 18rpx;border-radius:18rpx}
.project-card-top,.favorite-card-top{display:flex;align-items:center;gap:10rpx}
.project-card-title,.favorite-card-title{flex:1;min-width:0;color:var(--theme-text);font-size:16px;font-weight:650;line-height:1.35;overflow-wrap:anywhere}
.project-card-chevron{color:var(--theme-text-tertiary);font-size:28rpx;line-height:1}
.project-card-venue{margin-top:5rpx;color:var(--theme-text-secondary);font-size:13px}
.project-card-summary{margin-top:7rpx;color:var(--theme-text-secondary);font-size:13px;line-height:1.4}
.project-card-updated,.favorite-card-time{margin-top:7rpx;color:var(--theme-text-tertiary);font-size:12px;line-height:1.35}
.favorite-module{color:var(--theme-accent-text);font-size:13px;font-weight:650}
.favorite-card-time{margin:0;white-space:nowrap}
.favorite-card-title{margin-top:6rpx}
.favorite-card-summary{margin-top:5rpx;color:var(--theme-text-secondary);font-size:13px;line-height:1.4;white-space:pre-wrap;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.favorite-card-footer{margin-top:9rpx;padding-top:8rpx;border-top:1rpx solid var(--theme-divider);color:var(--theme-text-tertiary);font-size:12px;line-height:1.35}
.project-error{margin:10rpx 0;padding:16rpx}
.project-error-title{color:var(--theme-danger);font-size:15px;font-weight:650}
.project-error-copy,.project-inline-warning{margin-top:7rpx;color:var(--theme-text-secondary);font-size:14px;line-height:1.45}
.project-inline-warning{padding:0 6rpx;color:var(--theme-warning)}
@media(max-width:340px){.project-card-summary,.favorite-card-summary{font-size:13px}.project-card-updated,.favorite-card-time{font-size:12px}}
@media(prefers-color-scheme:dark){.project-recovery-button{background:var(--theme-surface);color:var(--theme-text-secondary)}.favorite-card-footer{border-color:var(--theme-divider)}}
