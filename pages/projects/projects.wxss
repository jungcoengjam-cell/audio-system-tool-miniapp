.projects-scroll{height: 100vh;background: var(--theme-page-bg)}.projects-content{padding: 42rpx 24rpx calc(54rpx + env(safe-area-inset-bottom))}.page-title{color: var(--theme-text);font-size: 58rpx;font-weight: 700;letter-spacing: -1.6rpx;line-height: 1.18}.records-tabs{display: flex;margin: var(--tab-header-gap) 0 22rpx;padding: 6rpx;border: 1rpx solid rgba(255,255,255,.9);border-radius: 20rpx;background: rgba(229,229,234,.72);box-shadow: inset 0 1rpx 0 rgba(255,255,255,.85)}.records-tab{box-sizing: border-box;min-height: 88rpx;flex: 1;border-radius: 15rpx;color: var(--theme-text-secondary);font-size: 20rpx;font-weight: 550;line-height: 88rpx;text-align: center}.records-tab-active{background: var(--theme-surface);box-shadow: 0 3rpx 10rpx rgba(0,0,0,.1);color: #1d1d1f}.record-card,.project-toolbar,.project-card,.records-empty{border: 1rpx solid #e7e7eb;background: var(--theme-surface);box-shadow: 0 9rpx 24rpx rgba(28,45,73,.07)}.record-card{position: relative;overflow: hidden;margin-bottom: 16rpx;padding: 23rpx 24rpx 20rpx;border-radius: 23rpx}.record-card::before{position: absolute;top: 0;bottom: 0;left: 0;width: 7rpx;background: #34c3d9;content: ''}.record-card-violet::before{ background: #6f6ce8}.record-card-amber::before{ background: #e8a327}.record-card-green::before{ background: #37a67a}.record-card-blue::before{ background: #007aff}.record-card-teal::before{ background: #087f70}.record-card-indigo::before{ background: #5856d6}.record-heading,.project-card-heading,.project-toolbar,.record-actions,.project-actions,.active-project-strip,.project-open-hint{display: flex;align-items: center}.record-heading,.project-card-heading,.project-toolbar,.project-open-hint{ justify-content: space-between}.record-module{ color: var(--theme-accent-text);font-size: 17rpx;font-weight: 700;letter-spacing: 1rpx}.record-time,.project-meta{ color: var(--theme-text-secondary);font-size: 18rpx}.record-title{ margin-top: 11rpx;color: #1d1d1f;font-size: 26rpx;font-weight: 650}.record-summary{ margin-top: 6rpx;color: var(--theme-text-secondary);font-size: 20rpx;line-height: 1.45}.record-trust{display: inline-flex;margin-top: 12rpx;padding: 7rpx 12rpx;border-radius: 999rpx;background: #f0f5ff;color: #2869d8;font-size: 18rpx;font-weight: 600}.record-project{ margin-top: 12rpx;color: var(--theme-success);font-size: 18rpx}.record-actions,.project-actions{ flex-wrap: wrap;margin-top: 17rpx}.record-action,.project-action{display:flex;box-sizing: border-box;min-height: 44px;margin: 0 8px 8px 0;padding: 0 18rpx;align-items:center;justify-content:center;border:0;border-radius: 16rpx;background: #f2f2f7;color: #52525a;font-size: 18rpx;line-height: 1.2}.record-action::after,.project-action::after,.project-create::after{ border: 0}.record-action-primary{ background: #e8f2ff;color: var(--theme-accent-text)}.record-action-danger,.project-action-danger{ color: #c63a32}.records-empty{padding: 64rpx 32rpx;border-radius: 25rpx;text-align: center}.records-empty-mark{ color: #007aff;font-size: 48rpx}.records-empty-title{ margin-top: 15rpx;color: #1d1d1f;font-size: 27rpx;font-weight: 650}.records-empty-text{ margin-top: 9rpx;color: var(--theme-text-tertiary);font-size: 20rpx;line-height: 1.55}.project-toolbar{padding: 23rpx;border-radius: 23rpx}.project-toolbar-title{ color: #1d1d1f;font-size: 27rpx;font-weight: 650}.project-create{box-sizing: border-box;min-height: 88rpx;margin: 0;padding: 0 22rpx;border-radius: 17rpx;background: var(--theme-primary-fill);color: #fff;font-size: 20rpx;font-weight: 600;line-height: 88rpx}.active-project-strip{margin: 16rpx 3rpx;padding: 17rpx 20rpx;border-radius: 18rpx;background: #eaf8ef}.active-project-label{ color: var(--theme-success);font-size: 18rpx;font-weight: 600}.active-project-name{ margin-left: 13rpx;color: #1d1d1f;font-size: 21rpx;font-weight: 600}.project-card{margin-top: 15rpx;padding: 22rpx 23rpx 17rpx;border-radius: 23rpx;transition: opacity .14s ease,transform .14s ease}.project-card:active{ opacity: .9;transform: scale(.994)}.project-name{ color: #1d1d1f;font-size: 26rpx;font-weight: 650}.project-active-chip{padding: 6rpx 12rpx;border-radius: 999rpx;background: #eaf8ef;color: var(--theme-success);font-size: 17rpx;font-weight: 600}.project-meta{ margin-top: 9rpx}.project-detail-preview{display: flex;flex-wrap: wrap;margin-top: 12rpx;align-items: center;color: #626269;font-size: 19rpx;line-height: 1.5}.project-detail-preview-dot{ margin: 0 8rpx;color: var(--theme-text-tertiary)}.project-detail-preview-engineer{ width: 100%;margin-top: 3rpx;color: var(--theme-text-tertiary)}.project-open-hint{margin-top: 7rpx;padding-top: 14rpx;border-top: 1rpx solid #ededf0;color: var(--theme-accent-text);font-size: 18rpx;font-weight: 600}.project-open-arrow{ font-size: 28rpx;font-weight: 400;line-height: 1}.records-empty-project{ margin-top: 15rpx}.record-action:active,.project-action:active,.project-create:active{ opacity: .72}@media (prefers-color-scheme: dark){ .projects-scroll{ background: var(--theme-page-bg)}.page-title,.record-title,.records-empty-title,.project-toolbar-title,.active-project-name,.project-name,.records-tab-active{ color: var(--theme-text)}.records-tabs{ border-color: var(--theme-divider);background: #2c2c2e;box-shadow: inset 0 1rpx 0 rgba(255,255,255,.08)}.records-tab{ color: var(--theme-text-secondary)}.records-tab-active,.record-card,.project-toolbar,.project-card,.records-empty{ border-color: var(--theme-divider);background: var(--theme-surface);box-shadow: 0 9rpx 24rpx var(--theme-shadow)}.record-summary,.project-detail-preview{ color: var(--theme-text-secondary)}.record-time,.project-meta,.records-empty-text,.project-detail-preview-engineer{ color: var(--theme-text-secondary)}.record-action,.project-action{ background: var(--theme-control);color: var(--theme-text-secondary)}.record-action-primary{ background: var(--theme-accent-soft);color: var(--theme-accent-text)}.record-action-danger,.project-action-danger{ color: var(--theme-danger)}.record-trust{ background: #193b60;color: #b8dcff}.record-project,.active-project-label{ color: var(--theme-success)}.project-open-hint{ border-color: var(--theme-divider);color: var(--theme-accent-text)}.active-project-strip,.project-active-chip{ background: #173d2b;color: var(--theme-success)}}

.project-primary-actions{display:flex;gap:10px;margin-top:16rpx;align-items:stretch}
.project-primary-actions .project-action{box-sizing:border-box;flex:1;min-width:0;height:88rpx;min-height:44px;margin:0;padding:0 12rpx;border-radius:22rpx;font-size:27rpx;font-weight:600;line-height:1}
.project-action-primary{background:var(--theme-primary-fill);color:#fff}
.project-action-secondary{background:var(--theme-accent-soft);color:var(--theme-accent-text)}
.project-actions{gap:8px;margin-top:8px}
.project-actions .project-action{margin-right:0;margin-bottom:0}
@media (prefers-color-scheme: dark){.project-action-primary{background:var(--theme-primary-fill);color:#fff}.project-action-secondary{background:var(--theme-accent-soft);color:var(--theme-accent-text)}}

.workspace-error{display:flex;gap:14rpx;align-items:center;justify-content:space-between;margin:10rpx 0 16rpx;padding:18rpx 20rpx;border:1rpx solid var(--theme-warning);border-radius:18rpx;background:var(--theme-warning-soft)}
.workspace-error-copy{flex:1;min-width:0}
.workspace-error-title{color:var(--theme-warning);font-size:21rpx;font-weight:650}
.workspace-error-text{margin-top:5rpx;color:var(--theme-text-secondary);font-size:18rpx;line-height:1.45}
.workspace-retry{flex:none;margin:0;white-space:nowrap}
