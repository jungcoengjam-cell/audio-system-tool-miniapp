<scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="home-page basis-index-page">
    <view class="home-header home-main-header">
      <view class="home-title home-main-title">计算依据</view>
    </view>

    <view class="home-basis-list">
      <navigator wx:for="{{basisTools}}" wx:key="id" class="home-basis-row" url="{{item.path}}" hover-class="home-pressed" aria-label="查看{{item.title}}计算依据：{{item.summary}}">
        <view class="home-basis-card-heading">
          <view class="home-basis-icon-wrap"><image class="home-basis-icon" src="{{item.icon}}" mode="aspectFit" lazy-load aria-hidden="true" /></view>
          <view class="home-basis-heading-copy">
            <view class="home-basis-title">{{item.title}}</view>
            <view class="home-basis-subtitle">{{item.subject}}</view>
          </view>
        </view>
        <view class="home-basis-summary">{{item.summary}}</view>
        <view class="home-basis-card-footer"><view>查看图解与说明</view><view class="home-basis-arrow" aria-hidden="true">›</view></view>
      </navigator>
    </view>
    <view class="home-bottom-space"></view>
  </view>
</scroll-view>
