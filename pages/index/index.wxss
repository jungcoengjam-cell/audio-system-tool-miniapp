@import "../../styles/homepage.wxss";
.home-basis-list{display:flex;margin-top:22rpx;flex-direction:column;gap:12rpx}
.home-basis-row{display:flex;box-sizing:border-box;width:100%;min-height:144rpx;padding:18rpx 20rpx 16rpx;flex-direction:column;border:1rpx solid var(--theme-divider);border-radius:22rpx;background:var(--theme-surface);box-shadow:0 5rpx 16rpx var(--theme-shadow);text-decoration:none;transition:opacity .14s ease,transform .14s ease}
.home-basis-card-heading{display:flex;min-width:0;align-items:center}
.home-basis-icon-wrap{display:flex;box-sizing:border-box;width:68rpx;height:68rpx;margin-right:14rpx;flex:0 0 68rpx;align-items:center;justify-content:center;border-radius:18rpx;background:var(--theme-accent-soft)}
.home-basis-icon{display:block;width:52rpx;height:52rpx}
.home-basis-heading-copy{min-width:0;flex:1}
.home-basis-title{min-width:0;flex:1;color:var(--theme-text);font-size:36rpx;font-weight:680;line-height:1.25;overflow-wrap:anywhere}
.home-basis-subtitle{margin-top:4rpx;color:var(--theme-text-secondary);font-size:28rpx;line-height:1.35;overflow-wrap:anywhere}
.home-basis-summary{margin-top:12rpx;color:var(--theme-text);font-size:26rpx;line-height:1.4;overflow-wrap:anywhere}
.home-basis-card-footer{display:flex;min-height:24px;margin-top:10rpx;align-items:center;justify-content:flex-end;gap:6rpx;color:var(--theme-accent-text);font-size:26rpx;line-height:1.3}
.home-basis-arrow{font-size:30rpx;line-height:1}
@media (max-width: 374px){
  .home-basis-row{padding:14rpx 14rpx 12rpx}
  .home-basis-title{font-size:17px}
  .home-basis-summary,.home-basis-card-footer{font-size:13px}
  .home-basis-subtitle{font-size:14px}
}
@media (prefers-reduced-motion: reduce){.home-basis-row{transition:none}}
