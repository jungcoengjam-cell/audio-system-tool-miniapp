{
  "version": "1.0",
  "phase": "P2-A",
  "purpose": "离线标注与未来评估规则；当前阶段不得调用推理模型。",
  "planned_model": {
    "name": "jev",
    "version": "1.13.0",
    "phase": "P2-B only"
  },
  "inference_policy": {
    "enabled": false,
    "network": false,
    "api_key_access": false
  },
  "thresholds": {
    "Noul": {
      "positive_decision_inclusive": 0.5,
      "low_confidence": {
        "minimum_exclusive": 0.2,
        "maximum_exclusive": 0.8
      }
    },
    "Choice": {
      "confidence_below": 0.6
    },
    "Score": {
      "confidence_below": 0.6
    },
    "route_selection": "Select the highest-probability registered route option; do not threshold the Choice distribution at 0.5."
  },
  "normalization": {
    "duplicate_text": "Unicode NFKC, then collapse all whitespace runs to one ASCII space, then trim"
  },
  "states": {
    "allowed": [
      "user_request"
    ],
    "forbidden": [
      "gold",
      "case_metadata",
      "provenance",
      "expected",
      "label",
      "target"
    ]
  },
  "presence_policy": [
    "只有用户明确表达、且角色和值或范围/选项均明确的字段才记为 true。",
    "产品目录、默认值、计算派生量均不算用户明确提供。",
    "用户说出的数值即使超出物理范围仍算已提供；范围检查和澄清另行标注。",
    "数值范围已提供但范围不完整或有歧义时可要求澄清。",
    "缺少可选字段不触发澄清；反向摄像机距离是输出，不是缺失输入。",
    "不得要求模型进行没有规则依据的工程判断。",
    "明确写出的数值（包括负 dBu）仍算用户已提供；正负号本身不改变显式性，也不自动判为无效。"
  ],
