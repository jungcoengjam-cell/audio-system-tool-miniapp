{
  "pages": [
    "pages/tools/tools",
    "pages/projects/projects",
    "pages/index/index",
    "pages/settings/settings",
    "pages/projects/favorite-detail",
    "pages/projects/recovery",
    "pages/records/report",
    "pages/limiter/limiter",
    "pages/spl/spl",
    "pages/cable/cable",
    "pages/camera/camera",
    "pages/led-screen/led-screen",
    "pages/gain-structure/gain-structure",
    "pages/dmx-layout/dmx-layout",
    "pages/products/library",
    "pages/products/detail",
    "pages/records/project",
    "pages/knowledge/detail",
    "pages/troubleshoot/index"
  ],
  "subPackages": [
    {
      "root": "pages/dmx-address",
      "pages": [
        "dmx-address",
        "channel-guide"
      ]
    },
    {
      "root": "pages/audio-wiring",
      "pages": [
        "index",
        "report-bridge"
      ]
    },
    {
      "root": "pages/project-wiring",
      "pages": [
        "index",
        "report-bridge"
      ]
    },
    {
      "root": "pages/control-protocol",
      "pages": [
        "index",
        "detail"
      ]
    },
    {
      "root": "pages/basis",
      "pages": [
        "detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/tools/tools": {
      "network": "wifi",
      "packages": [
        "pages/audio-wiring",
        "pages/project-wiring",
        "pages/dmx-address",
        "pages/control-protocol"
      ]
    }
  },
  "window": {
    "navigationBarTextStyle": "@navTextColor",
    "navigationBarTitleText": "音频工具",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@pageBgColor",
    "backgroundTextStyle": "@bgTextStyle"
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "componentFramework": "glass-easel",
  "tabBar": {
    "color": "@tabTextColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderColor",
    "position": "bottom",
    "list": [
      {
        "pagePath": "pages/tools/tools",
        "text": "工具",
        "iconPath": "@toolsIcon",
        "selectedIconPath": "@toolsSelectedIcon"
      },
      {
        "pagePath": "pages/projects/projects",
        "text": "项目",
        "iconPath": "@projectsIcon",
        "selectedIconPath": "@projectsSelectedIcon"
      },
      {
        "pagePath": "pages/index/index",
        "text": "依据",
        "iconPath": "@basisIcon",
        "selectedIconPath": "@basisSelectedIcon"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
